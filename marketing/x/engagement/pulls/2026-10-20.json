        },
        "referenced_tweets": [
          {
            "id": "2112256493034623098",
            "type": "replied_to"
          }
        ],
        "text": "What the opening is allowed to be: https://t.co/9PkBIH6oWG",
        "url": "https://x.com/Heroes0fcrypto/status/2112256603600638111"
      },
      {
        "author_id": "1768370292353884160",
        "created_at": "2026-10-19T18:56:06.000Z",
        "edit_history_tweet_ids": [
          "2112256493034623098"
