###################################
# .env.test (staging rig — test.heroesofcrypto.io)
#
# ONE hostname serves everything on staging: nginx sends /v1/* to the single
# all-roles testapi process, so every API origin below is the same host. Built
# via `vite build --mode test` (game/core "build:test", deploy --client-test).
###################################
# Server-side – keep if used elsewhere:
PROD=1
HOST_AUTH_API=https://test.heroesofcrypto.io
HOST_MATCHMAKING_API=https://test.heroesofcrypto.io
HOST_GAME_API=https://test.heroesofcrypto.io
PICK_EVENT_SOURCE=https://test.heroesofcrypto.io/v1/pick-events

# Client-side (Vite):
VITE_HOST_AUTH_API=https://test.heroesofcrypto.io
VITE_HOST_MATCHMAKING_API=https://test.heroesofcrypto.io
VITE_HOST_GAME_API=https://test.heroesofcrypto.io
VITE_PICK_EVENT_SOURCE=https://test.heroesofcrypto.io/v1/pick-events
VITE_GOOGLE_CLIENT_ID=541514408236-789upk3bve5s2l9iq1d741bo4d5ltie7.apps.googleusercontent.com
VITE_IS_PROD=true
