export const BATTLEFIELD_SHADOW_TUNING_BY_CREATURE: Readonly<Record<string, BattlefieldShadowTuning>> = Object.freeze(
    Object.fromEntries([
        ...LEVEL_ONE_CREATURE_NAMES.map((name) => [name, DEFAULT_BATTLEFIELD_SHADOW_TUNING] as const),
        ...Object.entries(FINALIZED_EDITOR_SHADOW_TUNING),
        ["Black Dragon", BLACK_DRAGON_SHADOW_TUNING],
        ["Frenzied Boar", FRENZIED_BOAR_SHADOW_TUNING],
        ["Cyclops", CYCLOPS_SHADOW_TUNING],
        ["Arachna Queen", ARACHNA_SHADOW_TUNING],
        ["Mantis", MANTIS_SHADOW_TUNING],
        ["Hydra", HYDRA_SHADOW_TUNING],
        ["Behemoth", BEHEMOTH_SHADOW_TUNING],
        ["Gargantuan", GARGANTUAN_SHADOW_TUNING],
        ["Abomination", ABOMINATION_SHADOW_TUNING],
        ["Magic Dragon", MAGIC_DRAGON_SHADOW_TUNING],
    ]),
);

const approvedBattlefieldShadowTuning = (unitName?: string): BattlefieldShadowTuning =>
    normalizeBattlefieldShadowTuning(
        unitName ? BATTLEFIELD_SHADOW_TUNING_BY_CREATURE[unitName] : DEFAULT_BATTLEFIELD_SHADOW_TUNING,
    );

const isBattlefieldShadowProductionBuild = (): boolean =>
    String(import.meta.env.PROD).toLowerCase() === "true" ||
    String(import.meta.env.VITE_IS_PROD).toLowerCase() === "true";

let battlefieldShadowEditorActive = false;
const battlefieldShadowVisualBounds = new Map<string, BattlefieldShadowVisualBounds>();

export const setBattlefieldShadowEditorActive = (active: boolean): void => {
    battlefieldShadowEditorActive = active;
    if (!active) battlefieldShadowVisualBounds.clear();
};

export const isBattlefieldShadowEditorActive = (): boolean => battlefieldShadowEditorActive;

export const publishBattlefieldShadowVisualBounds = (
    unitName: string,
    bounds: Omit<BattlefieldShadowVisualBounds, "updatedAt">,
): void => {
    if (!battlefieldShadowEditorActive) return;
    battlefieldShadowVisualBounds.set(unitName, { ...bounds, updatedAt: performance.now() });
};

export const readBattlefieldShadowVisualBounds = (unitName: string): BattlefieldShadowVisualBounds | undefined =>
    battlefieldShadowVisualBounds.get(unitName);

let storedCache: Record<string, BattlefieldShadowTuning> | undefined;
let sharedDevTunings: Record<string, BattlefieldShadowTuning> = {};
let sharedDevPollingStarted = false;

const normalizeTuningMap = (value: unknown): Record<string, BattlefieldShadowTuning> => {
    if (!value || typeof value !== "object" || Array.isArray(value)) return {};
    return Object.fromEntries(
        Object.entries(value as Record<string, Partial<BattlefieldShadowTuning>>).map(([name, tuning]) => [
            name,
            normalizeBattlefieldShadowTuning(tuning),
        ]),
    );
};

const refreshSharedDevTunings = async (): Promise<void> => {
    try {
        const response = await fetch(DEV_BATTLEFIELD_SHADOW_TUNING_ENDPOINT, { cache: "no-store" });
        if (!response.ok) return;
        const next = normalizeTuningMap(await response.json());
        if (JSON.stringify(next) === JSON.stringify(sharedDevTunings)) return;
        sharedDevTunings = next;
        window.dispatchEvent(new CustomEvent(BATTLEFIELD_SHADOW_TUNING_CHANGE_EVENT));
    } catch {
        // A static preview or a dev server started before this endpoint existed can safely fall back to
        // the browser-local draft and approved profiles.
    }
};

const ensureSharedDevTuningPolling = (): void => {
    if (sharedDevPollingStarted || typeof window === "undefined" || isBattlefieldShadowProductionBuild()) return;
    sharedDevPollingStarted = true;
    void refreshSharedDevTunings();
    window.setInterval(() => void refreshSharedDevTunings(), DEV_BATTLEFIELD_SHADOW_TUNING_POLL_MS);
};

/** Start the single file-backed development channel used by every editor window and gameplay port. */
export const startBattlefieldShadowTuningSync = (): void => {
    ensureSharedDevTuningPolling();
};

const patchSharedDevTuning = (unitName: string, value: BattlefieldShadowTuning): void => {
    const normalized = normalizeBattlefieldShadowTuning(value);
    sharedDevTunings = { ...sharedDevTunings, [unitName]: normalized };
    if (typeof window !== "undefined") {
        window.dispatchEvent(new CustomEvent(BATTLEFIELD_SHADOW_TUNING_CHANGE_EVENT));
    }
    if (typeof window === "undefined") return;
    void fetch(DEV_BATTLEFIELD_SHADOW_TUNING_ENDPOINT, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ unitName, value: normalized }),
    }).catch(() => undefined);
};

/**
 * Development editors and the playable sandbox are often served by two Vite instances (for example
 * 127.0.0.1:5173 and :5175). localStorage is isolated by port, while host cookies deliberately are not.
 * Keep one small cookie per creature so a profile edited on either port is the profile gameplay resolves.
 * Production never reads this draft channel (see resolveBattlefieldShadowTuningForBuild below).
 */
const sharedCookieName = (unitName: string): string =>
    `${BATTLEFIELD_SHADOW_TUNING_COOKIE_PREFIX}${encodeURIComponent(unitName)}`;

const readSharedCookieTuning = (unitName?: string): BattlefieldShadowTuning | undefined => {
    if (!unitName || typeof document === "undefined") return undefined;
    const name = `${sharedCookieName(unitName)}=`;
    const entry = document.cookie
        .split(";")
        .map((part) => part.trim())
        .find((part) => part.startsWith(name));
    if (!entry) return undefined;
    try {
        return normalizeBattlefieldShadowTuning(JSON.parse(decodeURIComponent(entry.slice(name.length))));
    } catch {
        return undefined;
    }
};

const writeSharedCookieTuning = (unitName: string, value: BattlefieldShadowTuning): void => {
    if (typeof document === "undefined") return;
    const encoded = encodeURIComponent(JSON.stringify(normalizeBattlefieldShadowTuning(value)));
    document.cookie = `${sharedCookieName(unitName)}=${encoded}; Path=/; Max-Age=${BATTLEFIELD_SHADOW_TUNING_COOKIE_MAX_AGE_SECONDS}; SameSite=Lax`;
};

const readStoredMap = (): Record<string, BattlefieldShadowTuning> => {
    if (storedCache) return storedCache;
    if (typeof window === "undefined" || typeof window.localStorage === "undefined") {
        storedCache = {};
        return storedCache;
    }
    try {
        const currentRaw = window.localStorage.getItem(BATTLEFIELD_SHADOW_TUNING_STORAGE_KEY);
        const legacyRaw = window.localStorage.getItem(LEGACY_BATTLEFIELD_SHADOW_TUNING_STORAGE_KEY);
        const parseStoredMap = (raw: string | null): Record<string, BattlefieldShadowTuning> => {
            const parsed = raw ? JSON.parse(raw) : {};
            // Migrate the first global editor draft without losing the owner's top-row work.
            if (parsed && typeof parsed === "object" && "top" in parsed) {
                return { "*": normalizeBattlefieldShadowTuning(parsed) };
            }
            return Object.fromEntries(
                Object.entries(parsed as Record<string, Partial<BattlefieldShadowTuning>>).map(([name, value]) => [
                    name,
                    normalizeBattlefieldShadowTuning(value),
                ]),
            );
        };
        // Recover missing profiles from v7, while keeping the complete v8 set from the Centaur checkpoint
        // authoritative for every creature that was already tuned there.
        storedCache = { ...parseStoredMap(legacyRaw), ...parseStoredMap(currentRaw) };
        if (legacyRaw && !currentRaw) {
            window.localStorage.setItem(BATTLEFIELD_SHADOW_TUNING_STORAGE_KEY, JSON.stringify(storedCache));
        }
    } catch {
        storedCache = {};
    }
    return storedCache;
};

export const readStoredBattlefieldShadowTuning = (unitName?: string): BattlefieldShadowTuning => {
    const shared = unitName ? (sharedDevTunings[unitName] ?? sharedDevTunings["*"]) : sharedDevTunings["*"];
    if (shared) return normalizeBattlefieldShadowTuning(shared);
    const values = readStoredMap();
    const stored = unitName ? (values[unitName] ?? values["*"]) : values["*"];
    return stored ? normalizeBattlefieldShadowTuning(stored) : approvedBattlefieldShadowTuning(unitName);
};

export const writeStoredBattlefieldShadowTuning = (unitName: string, value: BattlefieldShadowTuning): void => {
    const normalized = normalizeBattlefieldShadowTuning(value);
    const values = { ...readStoredMap(), [unitName]: normalized };
    delete values["*"];
    storedCache = values;
    if (typeof window !== "undefined" && typeof window.localStorage !== "undefined") {
        window.localStorage.setItem(BATTLEFIELD_SHADOW_TUNING_STORAGE_KEY, JSON.stringify(values));
    }
    writeSharedCookieTuning(unitName, normalized);
    patchSharedDevTuning(unitName, normalized);
};

/** Publish every editor draft from this origin to all dev servers on the same host, regardless of port. */
export const publishStoredBattlefieldShadowTunings = (): void => {
    const values = readStoredMap();
    for (const [unitName, value] of Object.entries(values)) {
        if (unitName !== "*") writeSharedCookieTuning(unitName, value);
    }
    // Publish the complete effective table, not only explicit editor overrides. This deliberately masks a
    // stale localStorage draft left behind on a different port/browser even when the current editor has no
    // per-creature override yet.
    const normalized = normalizeTuningMap({
        "*": values["*"] ?? DEFAULT_BATTLEFIELD_SHADOW_TUNING,
        ...BATTLEFIELD_SHADOW_TUNING_BY_CREATURE,
        ...Object.fromEntries(Object.entries(values).filter(([name]) => name !== "*")),
    });
    sharedDevTunings = normalized;
    if (typeof window !== "undefined") {
        void fetch(DEV_BATTLEFIELD_SHADOW_TUNING_ENDPOINT, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(normalized),
        }).catch(() => undefined);
    }
};

export const resetStoredBattlefieldShadowTuning = (unitName: string): void => {
    const values = { ...readStoredMap() };
    delete values[unitName];
    storedCache = values;
    if (typeof window !== "undefined" && typeof window.localStorage !== "undefined") {
        window.localStorage.setItem(BATTLEFIELD_SHADOW_TUNING_STORAGE_KEY, JSON.stringify(values));
    }
    // Publish the approved fallback explicitly. Otherwise a stale localStorage draft on another dev port
    // would become visible again immediately after Reset.
    writeSharedCookieTuning(unitName, approvedBattlefieldShadowTuning(unitName));
    patchSharedDevTuning(unitName, approvedBattlefieldShadowTuning(unitName));
};

/**
 * Development gameplay must resolve the exact same saved profile as the shadow editor. The editor authors
 * the upper-row endpoint; RenderableUnit then interpolates that shared profile toward the lower-row values.
 * Production remains pinned to the reviewed table because browser-local drafts are not a deployable asset.
 */
export const resolveBattlefieldShadowTuning = (unitName?: string): BattlefieldShadowTuning => {
    return resolveBattlefieldShadowTuningForBuild(unitName, isBattlefieldShadowProductionBuild());
};

export const resolveBattlefieldShadowTuningForBuild = (
    unitName: string | undefined,
    productionBuild: boolean,
): BattlefieldShadowTuning => {
    if (productionBuild) {
        return approvedBattlefieldShadowTuning(unitName);
    }
    ensureSharedDevTuningPolling();
    const shared = unitName ? (sharedDevTunings[unitName] ?? sharedDevTunings["*"]) : sharedDevTunings["*"];
    if (shared) return normalizeBattlefieldShadowTuning(shared);
    const cookie = readSharedCookieTuning(unitName);
    if (cookie) return cookie;
    return readStoredBattlefieldShadowTuning(unitName);
};
