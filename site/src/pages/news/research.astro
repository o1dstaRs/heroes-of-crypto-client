---
import ResearchPage from "../../components/ResearchPage.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { content } from "../../lib/site-data";

// Research lives inside the News section now (owner 2026-08-08) — same content, one feed.
// The legacy /research URL 301s here (astro.config redirects).
const lang = "en";
const page = content[lang].pages.research;
const researchStructuredData = {
    "@type": "CollectionPage",
    name: "Heroes of Crypto AI Research",
    description: page.description,
    url: new URL("/news/research/", Astro.site ?? "https://heroesofcrypto.io").toString(),
    inLanguage: "en",
    hasPart: {
        "@type": "TechArticle",
        headline: "A13 — Inside the Heroes of Crypto v0.8 AI",
        url: new URL("/news/research/#a13", Astro.site ?? "https://heroesofcrypto.io").toString(),
        datePublished: "2026-07-22",
        inLanguage: "en",
    },
};
---

<BaseLayout lang={lang} title={page.title} description={page.description} structuredData={researchStructuredData}>
    <ResearchPage lang={lang} />
</BaseLayout>
