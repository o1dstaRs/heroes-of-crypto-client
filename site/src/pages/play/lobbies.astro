---
import BaseLayout from "../../layouts/BaseLayout.astro";

const lang = "en";
const isProd =
    import.meta.env.PROD ||
    import.meta.env.VITE_IS_PROD === "true" ||
    import.meta.env.VITE_IS_PROD === true;
// Strip any trailing "/play" or slash so we have the game client's root and can append the lobby path.
const clientRoot = (url: string) => String(url).replace(/\/+$/, "").replace(/\/play$/, "");
const configuredGameClientUrls = [
    import.meta.env.VITE_GAME_CLIENT_RANKED,
    import.meta.env.VITE_GAME_CLIENT,
    import.meta.env.VITE_HOST_GAME_CLIENT,
]
    .filter(Boolean)
    .map((url) => clientRoot(String(url)));
const fallbackGameClientUrls = isProd
    ? ["https://beta.heroesofcrypto.io"]
    : [
          "http://127.0.0.1:5175",
          "http://localhost:5175",
          "http://127.0.0.1:5174",
          "http://localhost:5174",
          "http://127.0.0.1:5173",
          "http://localhost:5173",
      ];
const gameClientRoots = [...new Set([...configuredGameClientUrls, ...fallbackGameClientUrls])];
const fallbackUrl = `${gameClientRoots[0]}/lobbies`;
---

<BaseLayout lang={lang} title="Play with friends" description="Open Heroes of Crypto custom-game lobbies.">
    <section class="redirect-page" data-lobbies-redirect data-game-client-roots={JSON.stringify(gameClientRoots)}>
        <h1>Opening lobbies</h1>
        <p>Redirecting to Heroes of Crypto lobbies.</p>
        <p><a href={fallbackUrl}>Open lobbies</a></p>
    </section>
</BaseLayout>

<script>
    import { withGameAuthToken } from "../../lib/auth-handoff";

    const localHosts = new Set(["127.0.0.1", "localhost", "::1"]);
    const redirectPage = document.querySelector<HTMLElement>("[data-lobbies-redirect]");
    const gameClientRoots = JSON.parse(redirectPage?.dataset.gameClientRoots ?? "[]") as string[];

    // A specific lobby (?lobby=<id>) deep-links into that lobby room; otherwise open the browse list.
    const params = new URLSearchParams(window.location.search);
    const lobbyId = params.get("lobby");
    const subPath = lobbyId ? `/lobby/${encodeURIComponent(lobbyId)}` : "/lobbies";

    function targetWithToken(root: string): URL {
        const target = new URL(`${root}${subPath}`, window.location.href);

        for (const [key, value] of params) {
            if (key === "lobby") continue;
            target.searchParams.set(key, value);
        }

        // Carry the music volume across the origin boundary. The game client is a different origin, so it
        // cannot read this site's localStorage — without this the player sets the volume here and the lobby
        // screen next door starts over at the default. Keys match ThemeMusic.astro and the client's
        // themeMusic module; absent values simply mean "never set one", so the client keeps its own.
        try {
            const storedVolume = localStorage.getItem("hoc:themeVolume");
            if (storedVolume !== null) {
                target.searchParams.set("vol", storedVolume);
                target.searchParams.set("muted", localStorage.getItem("hoc:themeMuted") === "1" ? "1" : "0");
            }
        } catch {
            // Storage unavailable — the client falls back to its own stored setting or the default.
        }

        return withGameAuthToken(target);
    }

    async function canReach(url: string): Promise<boolean> {
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), 700);
        try {
            await fetch(url, { cache: "no-store", mode: "no-cors", signal: controller.signal });
            return true;
        } catch {
            return false;
        } finally {
            window.clearTimeout(timeout);
        }
    }

    async function resolveTarget(): Promise<URL> {
        for (const root of gameClientRoots) {
            const candidate = targetWithToken(root);
            if (candidate.href === window.location.href) continue;
            if (!localHosts.has(candidate.hostname)) return candidate;
            if (!localHosts.has(window.location.hostname) || (await canReach(candidate.href))) return candidate;
        }
        return targetWithToken(gameClientRoots[0] ?? window.location.origin);
    }

    resolveTarget().then((target) => window.location.replace(target.toString()));
</script>

<style>
    .redirect-page {
        min-height: 52vh;
        display: grid;
        align-content: center;
        gap: 12px;
        width: min(720px, calc(100% - 40px));
        margin: 0 auto;
        padding: 64px 0;
    }

    .redirect-page h1 {
        margin: 0;
        font-size: clamp(2rem, 5vw, 4rem);
    }

    .redirect-page p {
        margin: 0;
        color: var(--muted);
    }
</style>
