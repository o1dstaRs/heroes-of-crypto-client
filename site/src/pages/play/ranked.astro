---
import BaseLayout from "../../layouts/BaseLayout.astro";

const lang = "en";
const isProd =
    import.meta.env.PROD ||
    import.meta.env.VITE_IS_PROD === "true" ||
    import.meta.env.VITE_IS_PROD === true;
const rankedPath = (url: string) => {
    const cleanUrl = url.replace(/\/$/, "");
    return cleanUrl.endsWith("/play") ? cleanUrl : `${cleanUrl}/play`;
};
const configuredGameClientUrls = [
    import.meta.env.VITE_GAME_CLIENT_RANKED,
    import.meta.env.VITE_GAME_CLIENT,
    import.meta.env.VITE_HOST_GAME_CLIENT,
]
    .filter(Boolean)
    .map((url) => rankedPath(String(url)));
const fallbackGameClientUrls = isProd
    ? ["https://app.heroesofcrypto.io/play"]
    : [
          "http://127.0.0.1:5175/play",
          "http://localhost:5175/play",
          "http://127.0.0.1:5174/play",
          "http://localhost:5174/play",
          "http://127.0.0.1:5173/play",
          "http://localhost:5173/play",
      ];
// An EXPLICIT VITE_GAME_CLIENT* build wins outright rather than being a suggestion: a staging
// build that still carried the production URL as a fallback would quietly send testers to prod.
const gameClientUrls = configuredGameClientUrls.length
    ? [...new Set(configuredGameClientUrls)]
    : [...new Set(fallbackGameClientUrls)];
const fallbackUrl = gameClientUrls[0];
---

<BaseLayout
    lang={lang}
    title="Play Ranked"
    description="Open Heroes of Crypto ranked matchmaking."
>
    <section class="redirect-page" data-ranked-redirect data-game-client-urls={JSON.stringify(gameClientUrls)}>
        <h1>Opening Ranked</h1>
        <p>Redirecting to Heroes of Crypto ranked matchmaking.</p>
        <p><a href={fallbackUrl}>Open ranked</a></p>
    </section>
</BaseLayout>

<script>
    import { withGameAuthToken } from "../../lib/auth-handoff";

    const localHosts = new Set(["127.0.0.1", "localhost", "::1"]);
    const redirectPage = document.querySelector<HTMLElement>("[data-ranked-redirect]");
    const gameClientUrls = JSON.parse(redirectPage?.dataset.gameClientUrls ?? "[]") as string[];

    function targetWithToken(url: string): URL {
        const target = new URL(url, window.location.href);

        for (const [key, value] of new URLSearchParams(window.location.search)) {
            target.searchParams.set(key, value);
        }

        return withGameAuthToken(target);
    }

    async function canReach(url: string): Promise<boolean> {
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), 700);

        try {
            await fetch(url, {
                cache: "no-store",
                mode: "no-cors",
                signal: controller.signal,
            });
            return true;
        } catch {
            return false;
        } finally {
            window.clearTimeout(timeout);
        }
    }

    async function resolveTarget(): Promise<URL> {
        for (const url of gameClientUrls) {
            const candidate = targetWithToken(url);
            if (candidate.href === window.location.href) continue;
            if (!localHosts.has(candidate.hostname)) return candidate;
            if (!localHosts.has(window.location.hostname) || await canReach(candidate.href)) return candidate;
        }

        return targetWithToken(gameClientUrls[0] ?? "/play");
    }

    resolveTarget().then((target) => window.location.replace(target.toString()));
</script>

<style>
    .redirect-page {
        min-height: 52vh;
        display: grid;
        align-content: center;
        gap: 12px;
        width: min(720px, calc(100% - 40px));
        margin: 0 auto;
        padding: 64px 0;
    }

    .redirect-page h1 {
        margin: 0;
        font-size: clamp(2rem, 5vw, 4rem);
    }

    .redirect-page p {
        margin: 0;
        color: var(--muted);
    }
</style>
