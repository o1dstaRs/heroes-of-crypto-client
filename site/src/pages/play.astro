---
import BaseLayout from "../layouts/BaseLayout.astro";
import { content, links } from "../lib/site-data";
import ThemeMusic from "../components/ThemeMusic.astro";

const lang = "en";
const copy = content[lang];
---

<BaseLayout
    lang={lang}
    title="Play Heroes of Crypto"
    description={copy.play.modeBody}
>
    <section class="mode-select-page">
        <img class="mode-select-bg" src="/assets/images/preview_game.webp" alt="" width="1200" height="630" />
        <div class="mode-select-shade"></div>
        <div class="page-shell mode-select-layout">
            <div class="mode-select-copy">
                <p class="eyebrow">{copy.play.startLabel}</p>
                <h1>{copy.play.modeTitle}</h1>
                <p>{copy.play.modeBody}</p>
                <div class="hero-highlights" aria-label={copy.hero.availability}>
                    {copy.hero.highlights.map((item) => <span>{item}</span>)}
                </div>

                <div class="play-account" data-play-account hidden>
                    <p class="play-account-greeting">
                        {copy.play.signedInAs} <strong data-play-username>Player</strong>
                    </p>
                    <dl class="play-account-stats">
                        <div><dt>{copy.play.statWins}</dt><dd data-play-wins>0</dd></div>
                        <div><dt>{copy.play.statLosses}</dt><dd data-play-losses>0</dd></div>
                        <div><dt>{copy.play.statGames}</dt><dd data-play-games>0</dd></div>
                    </dl>
                    <div class="play-account-actions">
                        <a class="play-account-profile" href="/profile/">{copy.play.fullProfileCta} →</a>
                        <button type="button" class="play-account-logout" data-play-logout>{copy.nav.logout}</button>
                    </div>
                </div>
                <p class="play-account-guest" data-play-guest hidden>
                    {copy.play.guestPrompt} <a href="/auth/login/">{copy.play.guestPromptCta}</a>
                </p>
            </div>

            <div class="mode-card-grid" aria-label={copy.play.startLabel}>
                <a class="mode-card mode-card-ranked" href={links.rankedApp}>
                    <span class="mode-card-top">
                        <span class="mode-card-icon">
                            <img src="/assets/icons/navbar/joystick.svg" alt="" width="28" height="28" />
                        </span>
                        <em>{copy.play.rankedBadge}</em>
                    </span>
                    <strong>{copy.play.rankedCta}</strong>
                    <span>{copy.play.rankedHint}</span>
                </a>
                <a class="mode-card mode-card-sandbox" href={links.sandboxApp}>
                    <span class="mode-card-top">
                        <span class="mode-card-icon">
                            <img src="/assets/icons/navbar/settings.svg" alt="" width="28" height="28" />
                        </span>
                        <em>{copy.play.sandboxBadge}</em>
                    </span>
                    <strong>{copy.play.sandboxCta}</strong>
                    <span>{copy.play.sandboxHint}</span>
                </a>
                <a class="mode-card mode-card-lobbies" href={links.lobbiesApp}>
                    <span class="mode-card-top">
                        <span class="mode-card-icon">
                            <img src="/assets/icons/navbar/joystick.svg" alt="" width="28" height="28" />
                        </span>
                        <em>{copy.play.lobbiesBadge}</em>
                    </span>
                    <strong>{copy.play.lobbiesCta}</strong>
                    <span>{copy.play.lobbiesHint}</span>
                </a>
            </div>
        </div>

        <div class="page-shell lobbies-section">
            <h2 class="lobbies-section-title">{copy.play.lobbiesSectionTitle}</h2>
            <div id="open-lobbies" class="open-lobbies" data-lobbies-app={links.lobbiesApp}>
                <p class="open-lobbies-empty">Loading lobbies…</p>
            </div>
        </div>
    </section>
    <ThemeMusic />
</BaseLayout>

<script>
    import { LobbyList } from "@heroesofcrypto/common/src/generated/protobuf/v1/messages_reexports";
    import { displayName, getAuthUser, isLoggedIn, logout, onAuthStateChange } from "../lib/auth-state";

    // Reflect the signed-in account on the play hub: greet by name + show ranked record, or nudge a
    // guest to log in. Both blocks ship hidden so neither flashes before we know the session state.
    const accountPanel = document.querySelector<HTMLElement>("[data-play-account]");
    const guestPrompt = document.querySelector<HTMLElement>("[data-play-guest]");
    const playUsername = document.querySelector<HTMLElement>("[data-play-username]");
    const playWins = document.querySelector<HTMLElement>("[data-play-wins]");
    const playLosses = document.querySelector<HTMLElement>("[data-play-losses]");
    const playGames = document.querySelector<HTMLElement>("[data-play-games]");

    document.querySelector<HTMLButtonElement>("[data-play-logout]")?.addEventListener("click", () => logout("/"));

    onAuthStateChange(() => {
        const loggedIn = isLoggedIn();
        if (loggedIn) {
            const user = getAuthUser();
            if (playUsername) playUsername.textContent = displayName(user);
            if (playWins) playWins.textContent = String(user?.wins ?? 0);
            if (playLosses) playLosses.textContent = String(user?.losses ?? 0);
            if (playGames) playGames.textContent = String(user?.total_games_played ?? 0);
        }
        if (accountPanel) accountPanel.hidden = !loggedIn;
        if (guestPrompt) guestPrompt.hidden = loggedIn;
    });

    const isProd =
        import.meta.env.PROD || import.meta.env.VITE_IS_PROD === "true" || import.meta.env.VITE_IS_PROD === true;
    // In dev the matchmaking API runs on :3001 (a separate origin from the Astro site on :4321), so
    // never fall back to the site's own origin — that has no /v1 API and 404s the lobby list.
    const mmBaseUrl =
        import.meta.env.VITE_HOST_MATCHMAKING_API ||
        import.meta.env.VITE_MATCHMAKING_API ||
        (isProd ? "https://mm.heroesofcrypto.io" : "http://localhost:3001");
    const lobbiesEndpoint = `${mmBaseUrl.replace(/\/+$/, "")}${isProd ? "/v1/lobbies" : "/v1/mm/lobbies"}`;

    const escapeHtml = (value: string): string =>
        value.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

    const container = document.getElementById("open-lobbies");
    const lobbiesApp = container?.dataset.lobbiesApp ?? "/play/lobbies";

    async function refreshLobbies(): Promise<void> {
        if (!container) return;
        try {
            const res = await fetch(lobbiesEndpoint, { headers: { Accept: "application/octet-stream" } });
            if (!res.ok) throw new Error(String(res.status));
            const bytes = new Uint8Array(await res.arrayBuffer());
            const lobbies = LobbyList.deserializeBinary(bytes).toObject().lobbies ?? [];
            if (lobbies.length === 0) {
                container.innerHTML = '<p class="open-lobbies-empty">No open lobbies right now.</p>';
                return;
            }
            container.innerHTML = lobbies
                .map((lobby: any) => {
                    const host = lobby.host ?? {};
                    const name = escapeHtml(lobby.name || `${host.username ?? "Player"}'s lobby`);
                    const meta = escapeHtml(
                        `${host.username ?? "Player"} · ${host.league ?? "Unranked"} · ${host.rating ?? 0}`,
                    );
                    const href = `${lobbiesApp}?lobby=${encodeURIComponent(lobby.id)}`;
                    return `<a class="open-lobby" href="${href}"><span class="open-lobby-name">${name}</span><span class="open-lobby-meta">${meta}</span></a>`;
                })
                .join("");
        } catch {
            container.innerHTML = '<p class="open-lobbies-empty">Could not load lobbies.</p>';
        }
    }

    void refreshLobbies();
    window.setInterval(() => void refreshLobbies(), 4000);
</script>

<style>
    .mode-select-page {
        isolation: isolate;
        position: relative;
        overflow: hidden;
        min-height: calc(100svh - 68px);
        background: #070504;
    }

    .mode-select-page::before {
        position: absolute;
        z-index: 0;
        inset: 0;
        background-image:
            linear-gradient(rgba(220, 177, 88, 0.025) 1px, transparent 1px),
            linear-gradient(90deg, rgba(220, 177, 88, 0.025) 1px, transparent 1px);
        background-size: 48px 48px;
        mask-image: linear-gradient(90deg, transparent 2%, #000 45%, transparent 96%);
        content: "";
        pointer-events: none;
    }

    .mode-select-bg,
    .mode-select-shade {
        position: absolute;
        inset: 0;
    }

    .mode-select-bg {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.5;
        filter: saturate(0.72) sepia(0.1) contrast(1.12);
        transform: scale(1.015);
    }

    .mode-select-shade {
        background:
            radial-gradient(circle at 74% 36%, rgba(255, 143, 0, 0.08), transparent 32%),
            linear-gradient(90deg, rgba(7, 5, 4, 0.98) 0%, rgba(7, 5, 4, 0.85) 48%, rgba(7, 5, 4, 0.68) 100%),
            linear-gradient(180deg, rgba(7, 5, 4, 0.2), #070504 94%);
    }

    .mode-select-layout {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: minmax(0, 0.88fr) minmax(390px, 0.72fr);
        gap: clamp(32px, 5vw, 72px);
        align-items: center;
        min-height: calc(100svh - 68px);
        padding: 58px 0 48px;
    }

    .mode-select-copy {
        min-width: 0;
    }

    .mode-select-copy h1 {
        max-width: 720px;
        margin-bottom: 20px;
        font-size: clamp(2.8rem, 5.6vw, 5.3rem);
    }

    .mode-select-copy .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .mode-select-copy .eyebrow::before {
        width: 26px;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--gold));
        box-shadow: 0 0 8px rgba(220, 177, 88, 0.45);
        content: "";
    }

    .mode-select-copy p:not(.eyebrow) {
        max-width: 620px;
        color: rgba(239, 228, 204, 0.76);
        font-size: 1.02rem;
        line-height: 1.65;
    }

    .hero-highlights {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 22px;
    }

    .hero-highlights span {
        position: relative;
        padding: 7px 11px 6px 19px;
        border: 1px solid rgba(112, 75, 42, 0.58);
        border-radius: 2px;
        background: linear-gradient(180deg, rgba(48, 32, 20, 0.82), rgba(14, 9, 5, 0.9));
        color: rgba(239, 228, 204, 0.72);
        font-size: 0.72rem;
        letter-spacing: 0.09em;
        line-height: 1.2;
        text-transform: uppercase;
        box-shadow: inset 0 1px rgba(255, 231, 190, 0.04);
    }

    .hero-highlights span::before {
        position: absolute;
        top: 50%;
        left: 8px;
        width: 5px;
        height: 5px;
        background: var(--gold);
        box-shadow: 0 0 7px rgba(220, 177, 88, 0.64);
        content: "";
        transform: translateY(-50%) rotate(45deg);
    }

    .play-account {
        position: relative;
        display: grid;
        gap: 13px;
        max-width: 620px;
        margin-top: 26px;
        padding: 16px 18px;
        border: 1px solid rgba(220, 177, 88, 0.36);
        border-radius: 2px;
        background:
            linear-gradient(90deg, rgba(220, 177, 88, 0.11), transparent 30%),
            linear-gradient(180deg, rgba(37, 23, 13, 0.95), rgba(10, 7, 5, 0.96));
        box-shadow:
            inset 0 1px rgba(239, 228, 204, 0.05),
            inset 0 0 24px rgba(0, 0, 0, 0.3),
            0 16px 28px rgba(0, 0, 0, 0.26);
    }

    .play-account::before,
    .play-account::after {
        position: absolute;
        width: 30px;
        height: 5px;
        background: var(--gold);
        content: "";
        opacity: 0.58;
    }

    .play-account::before {
        top: -1px;
        left: -1px;
    }

    .play-account::after {
        right: -1px;
        bottom: -1px;
    }

    .play-account[hidden],
    .play-account-guest[hidden] {
        display: none;
    }

    .play-account-greeting {
        margin: 0;
        color: rgba(239, 228, 204, 0.72);
        font-size: 0.92rem;
        letter-spacing: 0.04em;
    }

    .play-account-greeting strong {
        color: var(--gold, #dcb158);
        font-size: 1.08rem;
        font-weight: 400;
        letter-spacing: 0.07em;
    }

    .play-account-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 7px;
        margin: 0;
    }

    .play-account-stats div {
        display: grid;
        gap: 2px;
        padding: 8px 10px;
        border-left: 2px solid rgba(220, 177, 88, 0.32);
        background: rgba(0, 0, 0, 0.24);
    }

    .play-account-stats dt {
        color: rgba(239, 228, 204, 0.5);
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.11em;
    }

    .play-account-stats dd {
        margin: 0;
        color: var(--ink-strong, #f8edd8);
        font-size: 1.22rem;
        font-weight: 400;
    }

    .play-account-logout {
        border: 0;
        background-color: transparent;
        background-image:
            linear-gradient(rgba(5, 6, 6, 0.28), rgba(5, 6, 6, 0.28)),
            url("/assets/images/ui/ui_start_button_plate_trimmed.webp");
        background-position: center;
        background-repeat: no-repeat;
        background-size: 100% 100%;
        color: var(--hoc-bronze, #cda078);
        filter: brightness(0.8) saturate(0.7);
    }

    .play-account-profile,
    .play-account-logout {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 34px;
        padding: 7px 15px;
        border-radius: 0;
        font: inherit;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.09em;
        line-height: 1;
        text-transform: uppercase;
        -webkit-text-stroke: 0.035em rgba(43, 25, 15, 0.92);
        paint-order: stroke fill;
        text-shadow: 0 0.075em #070504;
        transition:
            filter 0.16s ease,
            transform 0.16s ease;
    }

    .play-account-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px;
    }

    .play-account-profile {
        background-image:
            linear-gradient(rgba(105, 48, 18, 0.38), rgba(105, 48, 18, 0.38)),
            url("/assets/images/ui/ui_start_button_plate_trimmed.webp");
        background-position: center;
        background-repeat: no-repeat;
        background-size: 100% 100%;
        color: var(--hoc-bronze-bright, #e1b780);
        filter: brightness(0.98) saturate(0.94);
    }

    .play-account-profile:hover,
    .play-account-logout:hover {
        filter: brightness(1.13) saturate(1.02) drop-shadow(0 0 8px rgba(255, 126, 31, 0.28));
        transform: translateY(-1px);
    }

    .play-account-guest {
        max-width: 620px;
        margin-top: 22px;
        padding: 12px 15px;
        border-left: 2px solid rgba(220, 177, 88, 0.5);
        background: linear-gradient(90deg, rgba(220, 177, 88, 0.09), transparent 70%);
        color: rgba(239, 228, 204, 0.64);
        font-size: 0.9rem;
    }

    .play-account-guest a {
        color: var(--gold);
        letter-spacing: 0.04em;
        text-decoration: underline;
        text-decoration-color: rgba(220, 177, 88, 0.4);
        text-underline-offset: 3px;
    }

    .mode-card-grid {
        display: grid;
        gap: 9px;
        min-width: 0;
        padding: 9px;
        border: 15px solid transparent;
        border-image-source: url("/assets/images/ui/pick_phase_ember_panel_frame_9slice.webp");
        border-image-slice: 140 160;
        border-image-width: 17px;
        border-image-repeat: stretch;
        background:
            radial-gradient(circle at 50% 0, rgba(255, 143, 0, 0.08), transparent 46%),
            rgba(9, 7, 5, 0.92);
        box-shadow: 0 28px 58px rgba(0, 0, 0, 0.54);
    }

    .mode-card {
        --mode-accent: #dcb158;
        --mode-accent-rgb: 220, 177, 88;
        --mode-accent-secondary: var(--mode-accent);
        position: relative;
        display: grid;
        gap: 9px;
        min-height: 148px;
        padding: 15px 17px 16px;
        overflow: hidden;
        border: 1px solid color-mix(in srgb, var(--mode-accent) 42%, #503723);
        border-radius: 2px;
        background:
            radial-gradient(circle at 5% 0, rgba(var(--mode-accent-rgb), 0.16), transparent 38%),
            linear-gradient(135deg, rgba(42, 28, 17, 0.96), rgba(9, 7, 5, 0.98));
        box-shadow:
            inset 0 1px rgba(239, 228, 204, 0.04),
            inset 0 0 30px rgba(0, 0, 0, 0.34);
        transition:
            transform 0.16s ease,
            border-color 0.18s ease,
            filter 0.18s ease,
            box-shadow 0.18s ease;
    }

    .mode-card::before {
        position: absolute;
        top: 0;
        right: 0;
        left: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--mode-accent), var(--mode-accent-secondary));
        box-shadow: 0 0 14px rgba(var(--mode-accent-rgb), 0.46);
        content: "";
    }

    .mode-card::after {
        position: absolute;
        right: -24px;
        bottom: -24px;
        width: 66px;
        height: 66px;
        border: 1px solid rgba(var(--mode-accent-rgb), 0.2);
        content: "";
        pointer-events: none;
        transform: rotate(45deg);
    }

    .mode-card:hover,
    .mode-card:focus-visible {
        border-color: color-mix(in srgb, var(--mode-accent) 78%, white);
        box-shadow:
            inset 0 1px rgba(239, 228, 204, 0.08),
            inset 0 0 34px rgba(var(--mode-accent-rgb), 0.08),
            0 8px 22px rgba(0, 0, 0, 0.38),
            0 0 14px rgba(var(--mode-accent-rgb), 0.13);
        filter: brightness(1.08);
        transform: translateY(-2px);
    }

    .mode-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .mode-card-icon {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border: 1px solid rgba(var(--mode-accent-rgb), 0.38);
        border-radius: 2px;
        background: rgba(0, 0, 0, 0.38);
        box-shadow:
            inset 0 0 12px rgba(var(--mode-accent-rgb), 0.08),
            0 0 10px rgba(0, 0, 0, 0.28);
    }

    .mode-card-icon img {
        width: 23px;
        height: 23px;
        filter: invert(85%) sepia(18%) saturate(646%) hue-rotate(354deg) brightness(98%) contrast(89%);
        opacity: 0.86;
    }

    .mode-card em {
        padding: 5px 8px 4px;
        border: 1px solid rgba(var(--mode-accent-rgb), 0.38);
        border-radius: 2px;
        background: rgba(var(--mode-accent-rgb), 0.1);
        color: color-mix(in srgb, var(--mode-accent) 78%, white);
        font-size: 0.65rem;
        font-style: normal;
        font-weight: 400;
        letter-spacing: 0.12em;
        line-height: 1;
        text-transform: uppercase;
    }

    .mode-card strong {
        color: var(--hoc-bronze-bright, #e1b780);
        font-size: 1.28rem;
        font-weight: 400;
        letter-spacing: 0.08em;
        line-height: 1.1;
        text-transform: uppercase;
        -webkit-text-stroke: 0.035em rgba(43, 25, 15, 0.9);
        paint-order: stroke fill;
        text-shadow:
            0 0.075em #070504,
            0 0 12px rgba(var(--mode-accent-rgb), 0.12);
    }

    .mode-card span:last-child {
        max-width: 42ch;
        color: rgba(239, 228, 204, 0.63);
        font-size: 0.86rem;
        font-weight: 400;
        line-height: 1.42;
    }

    .mode-card-ranked {
        --mode-accent: #ff5a3f;
        --mode-accent-rgb: 255, 90, 63;
        --mode-accent-secondary: #46d160;
        background:
            radial-gradient(circle at 4% 0, rgba(70, 209, 96, 0.13), transparent 34%),
            radial-gradient(circle at 96% 0, rgba(255, 90, 63, 0.12), transparent 38%),
            linear-gradient(135deg, rgba(38, 25, 16, 0.98), rgba(9, 7, 5, 0.98));
    }

    .mode-card-sandbox {
        --mode-accent: #dcb158;
        --mode-accent-rgb: 220, 177, 88;
        --mode-accent-secondary: #ff8f00;
    }

    .mode-card-lobbies {
        --mode-accent: #67aef6;
        --mode-accent-rgb: 103, 174, 246;
        --mode-accent-secondary: #7bd8ff;
    }

    .lobbies-section {
        position: relative;
        z-index: 1;
        padding: 18px 0 68px;
    }

    .lobbies-section-title {
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 0 0 18px;
        color: var(--hoc-bronze, #cda078);
        font-size: 1.28rem;
        letter-spacing: 0.09em;
        text-transform: uppercase;
    }

    .lobbies-section-title::after {
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, rgba(220, 177, 88, 0.42), transparent);
        content: "";
    }

    .open-lobbies {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
        min-width: 0;
    }

    .open-lobbies :global(.open-lobby) {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 5px;
        min-width: 0;
        min-height: 74px;
        padding: 12px 14px 11px 18px;
        overflow: hidden;
        border: 1px solid rgba(103, 174, 246, 0.26);
        border-radius: 2px;
        background:
            linear-gradient(90deg, rgba(103, 174, 246, 0.08), transparent 44%),
            linear-gradient(180deg, rgba(32, 28, 22, 0.94), rgba(9, 7, 5, 0.96));
        box-shadow: inset 0 1px rgba(239, 228, 204, 0.04);
        transition:
            transform 0.16s ease,
            border-color 0.18s ease,
            box-shadow 0.18s ease;
    }

    .open-lobbies :global(.open-lobby)::before {
        position: absolute;
        inset: 0 auto 0 0;
        width: 3px;
        background: #67aef6;
        box-shadow: 0 0 10px rgba(103, 174, 246, 0.48);
        content: "";
    }

    .open-lobbies :global(.open-lobby:hover),
    .open-lobbies :global(.open-lobby:focus-visible) {
        border-color: rgba(103, 174, 246, 0.68);
        box-shadow:
            inset 0 0 22px rgba(103, 174, 246, 0.06),
            0 8px 20px rgba(0, 0, 0, 0.28);
        transform: translateY(-2px);
    }

    .open-lobbies :global(.open-lobby-name) {
        overflow: hidden;
        color: var(--ink-strong, #f8edd8);
        font-size: 0.88rem;
        font-weight: 400;
        letter-spacing: 0.045em;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .open-lobbies :global(.open-lobby-meta) {
        overflow: hidden;
        color: rgba(239, 228, 204, 0.5);
