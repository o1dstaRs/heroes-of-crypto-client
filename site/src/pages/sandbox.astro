---
import BaseLayout from "../layouts/BaseLayout.astro";

const lang = "en";
const sandboxPath = (url: string) => url.replace(/\/play\/?$/, "/");
// A configured client wins outright over the production default, and VITE_HOST_GAME_CLIENT counts
// here as well as locally — a staging build sets that one, and without it the sandbox kept sending
// testers to production no matter how the build was configured.
const configuredRemoteGameClientUrls = [
    import.meta.env.VITE_GAME_CLIENT_SANDBOX,
    import.meta.env.VITE_HOST_GAME_CLIENT,
    import.meta.env.VITE_GAME_CLIENT,
].filter(Boolean);
const remoteGameClientUrls = (
    configuredRemoteGameClientUrls.length ? configuredRemoteGameClientUrls : ["https://app.heroesofcrypto.io/"]
).map((url) => sandboxPath(String(url)));
const localGameClientUrls = [
    import.meta.env.VITE_HOST_GAME_CLIENT,
    import.meta.env.VITE_GAME_CLIENT,
    "http://127.0.0.1:5175/",
    "http://localhost:5175/",
    "http://127.0.0.1:5174/",
    "http://localhost:5174/",
    "http://127.0.0.1:5173/",
    "http://localhost:5173/",
]
    .filter(Boolean)
    .map((url) => sandboxPath(String(url)));
const fallbackUrl = remoteGameClientUrls[0];
---

<BaseLayout
    lang={lang}
    title="Play Sandbox Beta"
    description="Open the Heroes of Crypto sandbox beta."
>
    <section
        class="redirect-page"
        data-sandbox-redirect
        data-local-game-client-urls={JSON.stringify([...new Set(localGameClientUrls)])}
        data-remote-game-client-urls={JSON.stringify([...new Set(remoteGameClientUrls)])}
    >
        <h1>Opening Sandbox Beta</h1>
        <p>Redirecting to the Heroes of Crypto sandbox beta.</p>
        <p><a href={fallbackUrl}>Open sandbox beta</a></p>
    </section>
</BaseLayout>

<script>
    import { withGameAuthToken } from "../lib/auth-handoff";

    const localHosts = new Set(["127.0.0.1", "localhost", "::1"]);
    const redirectPage = document.querySelector<HTMLElement>("[data-sandbox-redirect]");
    const localGameClientUrls = JSON.parse(redirectPage?.dataset.localGameClientUrls ?? "[]") as string[];
    const remoteGameClientUrls = JSON.parse(redirectPage?.dataset.remoteGameClientUrls ?? "[]") as string[];

    function targetWithToken(url: string): URL {
        const target = new URL(url, window.location.href);
        return withGameAuthToken(target);
    }

    async function canReach(url: string): Promise<boolean> {
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), 700);

        try {
            await fetch(url, {
                cache: "no-store",
                mode: "no-cors",
                signal: controller.signal,
            });
            return true;
        } catch {
            return false;
        } finally {
            window.clearTimeout(timeout);
        }
    }

    async function resolveTarget(): Promise<URL> {
        const isLocalSite = localHosts.has(window.location.hostname);
        const gameClientUrls = isLocalSite ? localGameClientUrls : remoteGameClientUrls;

        for (const url of gameClientUrls) {
            const candidate = targetWithToken(url);
            if (candidate.href === window.location.href) continue;
            if (!isLocalSite || await canReach(candidate.href)) return candidate;
        }

        return targetWithToken(gameClientUrls[0] ?? "/");
    }

    resolveTarget().then((target) => window.location.replace(target.toString()));
</script>

<style>
    .redirect-page {
        min-height: 52vh;
        display: grid;
        align-content: center;
        gap: 12px;
        width: min(720px, calc(100% - 40px));
        margin: 0 auto;
        padding: 64px 0;
    }

    .redirect-page h1 {
        margin: 0;
        font-size: clamp(2rem, 5vw, 4rem);
    }

    .redirect-page p {
        margin: 0;
        color: var(--muted);
    }
</style>
