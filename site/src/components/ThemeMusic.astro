---
/**
 * Ranked-arena theme ("The Besieged Town") plus the volume control that governs it.
 *
 * Included only on the screens that should sing — the home page, where the ranked arena lives. Deliberately
 * NOT in BaseLayout: the blog, the codex and the docs pages have no business playing music. The same playlist
 * continues in the game client; a reload of this page resumes the song that was already playing.
 *
 * Two sources: Opus/WebM (~1.7 MB) is picked by Chrome, Firefox, Edge and Safari 17+; the MP3 (~3.1 MB) is
 * the fallback everywhere else. The browser downloads only the one it chooses, so most visitors pay the
 * smaller price. `preload="none"` means nobody pays anything until the track is actually wanted.
 *
 * VOLUME IS SHARED WITH THE GAME CLIENT, which is a different ORIGIN (heroesofcrypto.io vs
 * beta.heroesofcrypto.io) and therefore cannot see this localStorage. The redirect pages under /play carry
 * the setting across in the query string instead — see THEME_VOLUME_PARAM below, and keep the two in step.
 */
---

<div class="theme-music" data-theme-music>
    <!-- No `loop`: the playlist below hands one track to the next, and loop would pin us to the first.
         Sources are set by the script so the track can be swapped without rebuilding the element.
         The second element is silent until a song is about to end, then the two overlap. -->
    <audio data-theme-audio preload="none">
        <source data-theme-src-webm src="/assets/audio/the_besieged_town.webm" type="audio/webm; codecs=opus" />
        <source data-theme-src-mp3 src="/assets/audio/the_besieged_town.mp3" type="audio/mpeg" />
    </audio>
    <audio data-theme-audio-next preload="none">
        <source data-theme-next-webm type="audio/webm; codecs=opus" />
        <source data-theme-next-mp3 type="audio/mpeg" />
    </audio>

    <button
        class="theme-music-toggle"
        type="button"
        data-theme-toggle
        aria-pressed="false"
        title="Music volume"
        aria-label="Toggle music"
    >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" data-theme-icon-on>
            <path
                d="M4 9v6h4l5 4V5L8 9H4z"
                fill="currentColor"></path>
            <path
                d="M16.5 8.5a4.5 4.5 0 0 1 0 7M19 6a8 8 0 0 1 0 12"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"></path>
        </svg>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" data-theme-icon-off hidden>
            <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"></path>
            <path
                d="M16 9.5l5 5m0-5l-5 5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"></path>
        </svg>
    </button>

    <label class="theme-music-slider">
        <span class="sr-only">Music volume</span>
        <input
            type="range"
            min="0"
            max="100"
            step="1"
            value="50"
            data-theme-volume
            aria-label="Music volume"
            aria-orientation="vertical"
        />
    </label>
</div>

<script>
    import {
        createThemeMusicPlayer,
        toggleThemeMusicSettings,
        type ThemePlaybackSnapshot,
    } from "../lib/theme-music-player";

    // Kept in step with the client's own copy (game/core/src/ui/audio/themeMusic.ts) and with the redirect
    // pages under /play, which hand these across the origin boundary in the query string.
    const VOLUME_KEY = "hoc:themeVolume";
    const MUTED_KEY = "hoc:themeMuted";
    const PLAYBACK_KEY = "hoc:arenaTheme";
    const DEFAULT_VOLUME = 0.2; // owner call 2026-10-02: the theme opens quieter
    const FADE_MS = 900;
    const CROSSFADE_MS = 2200;

    // Opens on the arena theme, then the older menu songs, then back. Kept in step with the client's copy
    // in game/core/src/ui/audio/ThemeMusic.tsx, which serves the same files from /audio.
    const PLAYLIST = [
        { webm: "/assets/audio/the_besieged_town.webm", mp3: "/assets/audio/the_besieged_town.mp3" },
        { webm: "/assets/audio/the_last_stand.webm", mp3: "/assets/audio/the_last_stand.mp3" },
        { webm: "/assets/audio/the_stone_lullaby.webm", mp3: "/assets/audio/the_stone_lullaby.mp3" },
    ];

    const readPlayback = (): ThemePlaybackSnapshot | null => {
        try {
            const raw = window.sessionStorage.getItem(PLAYBACK_KEY);
            if (!raw) return null;
            const parsed = JSON.parse(raw) as Partial<ThemePlaybackSnapshot>;
            if (!Number.isInteger(parsed.index) || parsed.index === undefined) return null;
            if (parsed.index < 0 || parsed.index >= PLAYLIST.length) return null;
            if (typeof parsed.time !== "number" || !Number.isFinite(parsed.time) || parsed.time < 0) return null;
            return { index: parsed.index, time: parsed.time };
        } catch {
            return null;
        }
    };

    const writePlayback = (snapshot: ThemePlaybackSnapshot): void => {
        try {
            window.sessionStorage.setItem(PLAYBACK_KEY, JSON.stringify(snapshot));
        } catch {
            // Private mode still plays; the next reload just starts the theme again.
        }
    };

    const root = document.querySelector<HTMLElement>("[data-theme-music]");
    const audio = document.querySelector<HTMLAudioElement>("[data-theme-audio]");
    const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
    const slider = document.querySelector<HTMLInputElement>("[data-theme-volume]");
    const iconOn = document.querySelector<SVGElement>("[data-theme-icon-on]");
    const iconOff = document.querySelector<SVGElement>("[data-theme-icon-off]");
    const srcWebm = document.querySelector<HTMLSourceElement>("[data-theme-src-webm]");
    const srcMp3 = document.querySelector<HTMLSourceElement>("[data-theme-src-mp3]");
    const nextAudio = document.querySelector<HTMLAudioElement>("[data-theme-audio-next]");
    const nextWebm = document.querySelector<HTMLSourceElement>("[data-theme-next-webm]");
    const nextMp3 = document.querySelector<HTMLSourceElement>("[data-theme-next-mp3]");

    if (root && audio && toggle && slider && iconOn && iconOff && srcWebm && srcMp3 && nextAudio && nextWebm && nextMp3) {
        const clamp01 = (value: number) => Math.min(1, Math.max(0, value));

        const readStored = (): { volume: number; muted: boolean } => {
            // A URL parameter wins over stored state: it is how the site hands the setting to the client (and
            // back), so arriving with one means "the player just set this next door".
            const params = new URLSearchParams(window.location.search);
            const fromUrl = params.get("vol");
            let volume = DEFAULT_VOLUME;
            let muted = false;
            try {
                const storedVolume = window.localStorage.getItem(VOLUME_KEY);
                if (storedVolume !== null && Number.isFinite(Number(storedVolume))) {
                    volume = clamp01(Number(storedVolume));
                }
                muted = window.localStorage.getItem(MUTED_KEY) === "1";
            } catch {
                // Private mode / storage disabled: fall back to the default rather than breaking the page.
            }
            if (fromUrl !== null && Number.isFinite(Number(fromUrl))) {
                volume = clamp01(Number(fromUrl));
                muted = params.get("muted") === "1";
            }
            return { volume, muted };
        };

        const persist = (volume: number, muted: boolean) => {
            try {
                window.localStorage.setItem(VOLUME_KEY, String(volume));
                window.localStorage.setItem(MUTED_KEY, muted ? "1" : "0");
            } catch {
                // Nothing to do — the session still works, the choice just will not outlive it.
            }
        };

        let { volume, muted } = readStored();
        let fadeFrame: number | null = null;
        let gestureListenersArmed = false;

        const paint = () => {
            slider.value = String(Math.round(volume * 100));
            const silent = muted || volume === 0;
            iconOn.hidden = silent;
            iconOff.hidden = !silent;
            toggle.setAttribute("aria-pressed", silent ? "true" : "false");
            root.dataset.silent = silent ? "true" : "false";
        };

        const effectiveVolume = () => (muted ? 0 : volume);

        const stopFade = () => {
            if (fadeFrame !== null) {
                cancelAnimationFrame(fadeFrame);
                fadeFrame = null;
            }
        };

        // Fade rather than snap: the theme arriving at full volume the instant someone clicks a menu button
        // is startling, and that click is usually aimed at something else entirely.
        // The crossfade hands the audible element from one <audio> to the other. The slider has to follow
        // whichever one is actually playing, or a later volume change would turn the silent element up.
        let output: HTMLAudioElement = audio;
        const playback = readPlayback();
        let lastWrite = 0;
        const remember = (snapshot: ThemePlaybackSnapshot, force = false) => {
            const now = Date.now();
            if (!force && now - lastWrite < 1000) return;
            lastWrite = now;
            writePlayback(snapshot);
        };

        const fadeTo = (target: number) => {
            const media = output;
            const clampedTarget = clamp01(target);
            stopFade();
            if (media.paused && clampedTarget === 0) {
                media.volume = 0;
                return;
            }
            const from = media.volume;
            const startedAt = performance.now();
            const step = (now: number) => {
                const t = Math.min(1, (now - startedAt) / FADE_MS);
                media.volume = clamp01(from + (clampedTarget - from) * t);
                if (t < 1) {
                    fadeFrame = requestAnimationFrame(step);
                    return;
                }
                fadeFrame = null;
                if (clampedTarget === 0) {
                    media.pause();
                }
            };
            fadeFrame = requestAnimationFrame(step);
        };

        // Touch playback is unlocked on touchend/click rather than touchstart in mobile browsers. Keep these
        // capture listeners until play ACTUALLY succeeds: a blocked autoplay attempt must not consume the
        // only retry and force the player to jiggle the volume control.
        const unlockEvents = ["click", "keydown", "touchend"] as const;
        const onUnlockGesture = () => {
            const target = effectiveVolume();
            if (target > 0) {
                void player.start(target, true);
            }
        };
        const armGestureUnlock = () => {
            if (gestureListenersArmed) return;
            gestureListenersArmed = true;
            for (const event of unlockEvents) {
                window.addEventListener(event, onUnlockGesture, { capture: true, passive: true });
            }
        };
        const disarmGestureUnlock = () => {
            if (!gestureListenersArmed) return;
            gestureListenersArmed = false;
            for (const event of unlockEvents) {
                window.removeEventListener(event, onUnlockGesture, true);
            }
        };

        const player = createThemeMusicPlayer({
            audio,
            webmSource: srcWebm,
            mp3Source: srcMp3,
            playlist: PLAYLIST,
            getTargetVolume: effectiveVolume,
            fadeTo,
            onPlaybackStarted: disarmGestureUnlock,
            onPlaybackBlocked: armGestureUnlock,
            initialIndex: playback?.index ?? 0,
            initialTime: playback?.time ?? 0,
            onProgress: (snapshot) => remember(snapshot),
            onOutputChange: (element) => {
                output = element as HTMLAudioElement;
            },
            crossfade: { ms: CROSSFADE_MS, audio: nextAudio, webmSource: nextWebm, mp3Source: nextMp3 },
        });
        window.addEventListener("pagehide", () => remember(player.snapshot(), true));

        armGestureUnlock();

        toggle.addEventListener("click", () => {
            ({ volume, muted } = toggleThemeMusicSettings({ volume, muted }, DEFAULT_VOLUME));
            persist(volume, muted);
            paint();
            const target = effectiveVolume();
            player.setTargetVolume(target);
            if (target === 0) {
                fadeTo(0);
                return;
            }
            void player.start(target, true);
        });

        slider.addEventListener("input", () => {
            volume = clamp01(Number(slider.value) / 100);
            if (volume > 0) muted = false;
            persist(volume, muted);
            paint();
            // Dragging is continuous, so track it directly instead of fading to each intermediate value.
            const target = effectiveVolume();
            player.setTargetVolume(target);
            stopFade();
            if (target === 0) {
                output.volume = 0;
                output.pause();
                nextAudio.pause();
            } else if (output.paused) {
                void player.start(target, true);
            } else {
                output.volume = target;
            }
        });

        paint();
        audio.volume = 0;
        // Browsers that already granted this origin autoplay can begin immediately. Everyone else falls
        // through to the retained gesture listeners above and starts on the first valid click/touchend.
        void player.start();
    }
</script>

<style>
    .theme-music {
        position: fixed;
        right: clamp(0.75rem, 2vw, 1.5rem);
        bottom: clamp(0.75rem, 2vw, 1.5rem);
        z-index: 60;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.32rem;
        border: 1px solid rgba(220, 177, 88, 0.46);
        border-radius: 2px;
        clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
        background: linear-gradient(145deg, rgba(66, 39, 18, 0.96), rgba(12, 8, 5, 0.97));
        box-shadow:
            0 9px 22px rgba(0, 0, 0, 0.46),
            inset 0 0 12px rgba(255, 143, 0, 0.04);
        color: var(--hoc-bronze, #cda078);
    }

    .theme-music-toggle {
        display: grid;
        place-items: center;
        width: 2.1rem;
        height: 2.1rem;
        padding: 0;
        border: 0;
        border: 1px solid rgba(112, 75, 42, 0.42);
        border-radius: 1px;
        background: rgba(7, 5, 4, 0.58);
        color: inherit;
        cursor: pointer;
    }

    .theme-music-toggle:hover,
    .theme-music-toggle:focus-visible {
        border-color: rgba(220, 177, 88, 0.72);
        color: var(--gold-soft, #efd49a);
        box-shadow: inset 0 0 9px rgba(255, 143, 0, 0.09);
    }

    .theme-music-toggle svg {
        width: 1.15rem;
        height: 1.15rem;
    }

    /* Keep the speaker anchored while the same 5.5rem slider opens vertically above it. Rotating the
       native horizontal control makes its minimum sit at the bottom and its maximum at the top. */
    .theme-music-slider {
        position: absolute;
        left: 50%;
        bottom: calc(100% + 0.35rem);
        width: 2.1rem;
        height: 5.5rem;
        opacity: 0;
        pointer-events: none;
        transform: translateX(-50%);
        transition: opacity 160ms ease;
    }

    .theme-music:hover .theme-music-slider,
    .theme-music:focus-within .theme-music-slider {
        opacity: 1;
        pointer-events: auto;
    }

    .theme-music-slider input {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 5.5rem;
        margin: 0;
        transform: translate(-50%, -50%) rotate(-90deg);
        transform-origin: center;
        accent-color: var(--gold, #dcb158);
        cursor: pointer;
    }

    @media (max-width: 560px) {
        .theme-music {
            right: max(0.65rem, env(safe-area-inset-right));
            bottom: max(0.65rem, env(safe-area-inset-bottom));
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .theme-music-slider {
            transition: none;
        }
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
    }
</style>
