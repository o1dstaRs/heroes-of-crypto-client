---
import type { KnowledgeSection } from "../lib/knowledge-base";

interface Props {
    section: KnowledgeSection;
    size?: number;
    class?: string;
}

const { section, size = 24, class: className } = Astro.props;
---

<svg
    class:list={["knowledge-icon", className]}
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
>
    <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.45">
        {
            section === "overview" && (
                <>
                    <path
                        d="M3.25 4.8c3.6-.65 6.5.1 8.75 2.15v12.3c-2.25-2.05-5.15-2.8-8.75-2.15V4.8Zm17.5 0c-3.6-.65-6.5.1-8.75 2.15v12.3c2.25-2.05 5.15-2.8 8.75-2.15V4.8Z"
                        fill="currentColor"
                        opacity="0.16"
                    />
                    <path d="M3.25 4.8c3.6-.65 6.5.1 8.75 2.15v12.3c-2.25-2.05-5.15-2.8-8.75-2.15V4.8Zm17.5 0c-3.6-.65-6.5.1-8.75 2.15v12.3c2.25-2.05 5.15-2.8 8.75-2.15V4.8ZM12 6.95v12.3" />
                    <path d="M5.8 8.15c1.35-.05 2.5.22 3.45.8M5.8 11c1.35-.05 2.5.22 3.45.8M18.2 8.15c-1.35-.05-2.5.22-3.45.8" opacity="0.8" />
                </>
            )
        }
        {
            section === "rules" && (
                <>
                    <path d="M6.2 3.5h10.25a2 2 0 0 1 2 2v14.8H7.7a2.15 2.15 0 0 1-2.15-2.15V5.5a2 2 0 0 1 2-2Z" fill="currentColor" opacity="0.15" />
                    <path d="M6.2 3.5h10.25a2 2 0 0 1 2 2v14.8H7.7a2.15 2.15 0 0 1-2.15-2.15V5.5a2 2 0 0 1 2-2ZM5.55 17.9c.45-.75 1.17-1.12 2.15-1.12h10.75" />
                    <path d="m9 9.15 1.25 1.25 2.3-2.55M9 13.4h5.9M14.2 6.2l2.05 2.05" />
                </>
            )
        }
        {
            section === "units" && (
                <>
                    <path d="M6.1 12.4V8.9a5.9 5.9 0 0 1 11.8 0v3.5c-1.5 1.75-3.47 2.63-5.9 2.63s-4.4-.88-5.9-2.63Z" fill="currentColor" opacity="0.16" />
                    <path d="M6.1 12.4V8.9a5.9 5.9 0 0 1 11.8 0v3.5c-1.5 1.75-3.47 2.63-5.9 2.63s-4.4-.88-5.9-2.63ZM8 7.6h8M9 4.35 12 2l3 2.35M8.3 18.15h7.4M6.35 21h11.3" />
                    <path d="m8.3 18.15-2.15-2.1M15.7 18.15l2.15-2.1M9.5 10.45h.01M14.5 10.45h.01" stroke-width="1.8" />
                </>
            )
        }
        {
            section === "abilities" && (
                <>
                    <path d="m12 2.8 1.7 5.15 5.3-1.1-3.6 4.05 3.6 4.05-5.3-1.1L12 19l-1.7-5.15-5.3 1.1 3.6-4.05L5 6.85l5.3 1.1L12 2.8Z" fill="currentColor" opacity="0.17" />
                    <path d="m12 2.8 1.7 5.15 5.3-1.1-3.6 4.05 3.6 4.05-5.3-1.1L12 19l-1.7-5.15-5.3 1.1 3.6-4.05L5 6.85l5.3 1.1L12 2.8Z" />
                    <path d="m12 7.7 1.02 2.12 2.33.32-1.7 1.62.42 2.3L12 12.95l-2.07 1.11.42-2.3-1.7-1.62 2.33-.32L12 7.7ZM4 19.8h16" />
                </>
            )
        }
        {
            section === "spells" && (
                <>
                    <path d="M4 8.1c3.15-.6 5.82.08 8 2.05v9.1c-2.18-1.97-4.85-2.65-8-2.05V8.1Zm16 0c-3.15-.6-5.82.08-8 2.05v9.1c2.18-1.97 4.85-2.65 8-2.05V8.1Z" fill="currentColor" opacity="0.15" />
                    <path d="M4 8.1c3.15-.6 5.82.08 8 2.05v9.1c-2.18-1.97-4.85-2.65-8-2.05V8.1Zm16 0c-3.15-.6-5.82.08-8 2.05v9.1c2.18-1.97 4.85-2.65 8-2.05V8.1ZM12 10.15v9.1" />
                    <path d="M12 2.5c.25 1.5 2.05 2.15 2.05 3.65A2.05 2.05 0 0 1 12 8.2a2.05 2.05 0 0 1-2.05-2.05C9.95 4.65 11.75 4 12 2.5Z" fill="currentColor" opacity="0.3" />
                </>
            )
        }
        {
            section === "artifacts" && (
                <>
                    <path d="m12 5.2 5.2 4.2-2 7.45L12 21l-3.2-4.15-2-7.45L12 5.2Z" fill="currentColor" opacity="0.17" />
                    <path d="M8.2 5.25 12 2l3.8 3.25M12 5.2l5.2 4.2-2 7.45L12 21l-3.2-4.15-2-7.45L12 5.2ZM6.8 9.4h10.4M8.8 16.85 12 9.4l3.2 7.45M12 9.4V21" />
                </>
            )
        }
    </g>
</svg>

<style>
    .knowledge-icon {
        display: block;
        flex: 0 0 auto;
    }
</style>
