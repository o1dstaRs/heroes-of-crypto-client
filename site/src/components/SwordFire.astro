<sword-fire aria-hidden="true">
    <canvas width="500" height="300"></canvas>
</sword-fire>

<style>
    sword-fire {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
    }

    canvas {
        position: absolute;
        display: none;
    }

    @media (prefers-reduced-motion: reduce) {
        canvas {
            display: none !important;
        }
    }

    @media (min-width: 1081px) {
        sword-fire {
            top: -68px;
        }
    }
</style>

<script>
    class SwordFire extends HTMLElement {
        private dispose?: () => void;

        connectedCallback() {
            const canvas = this.querySelector("canvas");
            const background = this.parentElement?.querySelector<HTMLImageElement>(".hero-bg");
            const context = canvas?.getContext("2d");
            if (!canvas || !background || !context || this.dispose) return;

            const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
            const atlas = new Image();
            let loaded = false;
            let visible = false;
            let frameRequest = 0;
            let phase = 0;
            let lastTime = 0;
            let disposed = false;

            const layout = () => {
                const imageBox = background.getBoundingClientRect();
                const box = this.getBoundingClientRect();
                const scale = Math.max(imageBox.width / 1750, imageBox.height / 899);
                const position = getComputedStyle(background).objectPosition.split(" ").map(parseFloat);
                canvas.style.width = `${500 * scale}px`;
                canvas.style.height = `${300 * scale}px`;
                canvas.style.left = `${imageBox.left - box.left + (imageBox.width - 1750 * scale) * position[0] / 100}px`;
                canvas.style.top = `${imageBox.top - box.top + (imageBox.height - 899 * scale) * position[1] / 100}px`;
            };

            const draw = (time: number) => {
                frameRequest = 0;
                if (!loaded || !visible || document.hidden || reducedMotion.matches || disposed) return;
                if (lastTime) phase = (phase + Math.min(time - lastTime, 80) * 9 / 1000) % 16;
                lastTime = time;
                const frame = Math.floor(phase);
                const mix = phase - frame;
                context.clearRect(0, 0, 500, 300);
                // Add weighted premultiplied frames so the static clean plate never flickers.
                context.globalCompositeOperation = "lighter";
                for (const [index, weight] of [[frame, 1 - mix], [(frame + 1) % 16, mix]]) {
                    context.globalAlpha = weight;
                    context.drawImage(atlas, (index % 4) * 500, Math.floor(index / 4) * 300, 500, 300, 0, 0, 500, 300);
                }
                context.globalAlpha = 1;
                canvas.style.display = "block";
                this.dataset.frame = String(frame);
                frameRequest = requestAnimationFrame(draw);
            };

            const sync = () => {
                cancelAnimationFrame(frameRequest);
                lastTime = 0;
                if (reducedMotion.matches) canvas.style.display = "none";
                if (loaded && visible && !document.hidden && !reducedMotion.matches) frameRequest = requestAnimationFrame(draw);
            };
            // Multi-megabyte decorative art: it must never race the hero plate the page is judged on.
            // Requested the first time this element is actually on screen AND motion is allowed, so a
            // visitor who never reaches the hero, or who asked for reduced motion, never pays for it.
            const requestAtlas = () => {
                if (disposed || atlas.src || !visible || reducedMotion.matches) return;
                atlas.fetchPriority = "low";
                atlas.decoding = "async";
                atlas.src = "/assets/images/home/hero/generated/sword-fire-v6-atlas.webp";
            };

            const resize = new ResizeObserver(layout);
            resize.observe(background);
            const intersection = new IntersectionObserver(([entry]) => {
                visible = entry.isIntersecting;
                requestAtlas();
                sync();
            });
            intersection.observe(this);
            document.addEventListener("visibilitychange", sync);
            reducedMotion.addEventListener("change", sync);
            atlas.onload = () => {
                if (disposed) return;
                loaded = true;
                layout();
                sync();
            };
            const loadOnMotionChange = () => requestAtlas();
            reducedMotion.addEventListener("change", loadOnMotionChange);
            this.dispose = () => {
                disposed = true;
                cancelAnimationFrame(frameRequest);
                resize.disconnect();
                intersection.disconnect();
                document.removeEventListener("visibilitychange", sync);
                reducedMotion.removeEventListener("change", sync);
                reducedMotion.removeEventListener("change", loadOnMotionChange);
            };
        }

        disconnectedCallback() {
            this.dispose?.();
            this.dispose = undefined;
        }
    }

    if (!customElements.get("sword-fire")) customElements.define("sword-fire", SwordFire);
</script>
