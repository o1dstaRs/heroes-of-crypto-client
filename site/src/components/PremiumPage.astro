---
import PremiumSearch from "./PremiumSearch.astro";
import PremiumIcon from "./PremiumIcon.astro";
import { premiumCatalog } from "../lib/premium-catalog";
import { premiumSections } from "../lib/premium-copy";
import { type Language } from "../lib/site-data";
import "../styles/premium.css";
interface Props { lang: Language }
const { lang } = Astro.props;
const t = (en: string, ru: string) => lang === "ru" ? ru : en;
const home = lang === "ru" ? "/ru" : "";
const catalog = premiumCatalog(lang);
const loginHref = `${home}/auth/login/?redirect=${encodeURIComponent(`${home}/premium/`)}`;
---
<div class="premium-page" data-premium-page data-language={lang}>
    <script type="application/json" id="premium-catalog" set:html={JSON.stringify(catalog).replace(/</g, "\\u003c")} />
    <section class="premium-hero">
        <div class="premium-hero-grid" aria-hidden="true"></div>
        <div class="premium-hero-copy">
            <p class="premium-eyebrow">HEROES OF CRYPTO</p>
            <h1>Premium</h1>
            <p class="premium-intro">{t("Compare units, artifacts, and army builds using results from simulated battles. Get advice during draft, setup, and combat.", "Сравнивайте юнитов, артефакты и составы армий по результатам симуляций. Получайте подсказки во время драфта, расстановки и боя.")}</p>
            <a class="premium-button premium-hero-login" data-premium-login href={loginHref} hidden>{t("Sign in to check access", "Войти и проверить доступ")} <span aria-hidden="true">→</span></a>
        </div>
        <div class="premium-emblem" aria-hidden="true"><PremiumIcon size="216px" /></div>
    </section>

    <div class="premium-status" role="status" aria-live="polite"><span class="premium-status-dot"></span><span data-premium-status>{t("Checking your access…", "Проверяем доступ…")}</span><button class="premium-text-button" type="button" data-premium-retry hidden>{t("Try again", "Повторить")}</button></div>

    <section class="premium-gate" data-premium-gate hidden aria-labelledby="premium-gate-title">
        <h2 id="premium-gate-title">{t("What’s included", "Что входит в Premium")}</h2>
        <div class="premium-feature-grid">
            {[
                ["01", "Unit rankings", "Рейтинги юнитов", "Compare results by draft level and army type. Each ranking shows sample sizes and confidence intervals.", "Сравнивайте результаты по уровню драфта и типу армии. В рейтингах указаны объём выборки и доверительные интервалы."],
                ["02", "Unit combinations", "Комбинации юнитов", "See how armies performed with specific unit pairs, trios, and active faction synergies.", "Смотрите результаты армий с конкретными парами, тройками юнитов и активными синергиями фракций."],
                ["03", "Artifacts and upgrades", "Артефакты и усиления", "Compare both artifact tiers, doctrines, and complete upgrade plans for the same army type and battlefield.", "Сравнивайте оба уровня артефактов, доктрины и планы усилений для одного типа армии и поля боя."],
                ["04", "Ask Premium AI", "Вопросы к Premium AI", "Ask about game rules, strategy, or the results in the selected dataset.", "Задавайте вопросы о правилах игры, стратегии и результатах выбранной выборки."],
            ].map(([number, en, ru, desc, descRu]) => <article class="premium-feature"><span aria-hidden="true">{number}</span><h3>{t(en, ru)}</h3><p>{t(desc, descRu)}</p></article>)}
        </div>
        <div class="premium-access-panel" id="premium-access">
            <h2>{t("Premium access", "Доступ к Premium")}</h2>
            <p>{t("Premium is included during initial calibration and recalibration. After calibration, access requires an active Premium account.", "Premium доступен во время первой и повторной калибровки. После неё доступ сохраняется у аккаунтов с активным Premium.")}</p>
            <p class="premium-fine">{t("Premium subscriptions are coming soon.", "Подписка Premium скоро появится.")}</p>
        </div>
    </section>

    <section class="premium-workspace" data-premium-workspace hidden>
        <nav class="premium-section-nav" aria-label={t("Premium sections", "Разделы Premium")}>
            <a class="premium-nav-ai" href="#premium-search">{t("Ask Premium AI", "Спросить AI")}</a>
            {premiumSections.map(([id, en, ru], index) => <a data-premium-library-nav href={`#premium-${id}`}><small>{String(index + 1).padStart(2, "0")}</small>{t(en, ru)}</a>)}
            <a class="premium-nav-play" href={`${home}/play/`}>{t("Play", "Перейти к игре")} ↗</a>
        </nav>
        <div class="premium-main">
            <form class="premium-filters" data-premium-filters>
                <label>{t("Snapshot", "Снимок")}<select name="snapshot" aria-label={t("Snapshot", "Снимок")}></select></label>
                <label>{t("Army type", "Тип армии")}<select name="cohort"><option value="ranked-draft">{t("Ranked draft", "Рейтинговый драфт")}</option><option value="uniform-mixed">{t("Mixed armies", "Смешанные армии")}</option><option value="ranged-heavy">{t("Ranged heavy", "Стрелковые")}</option><option value="ground-melee">{t("Ground melee", "Наземный ближний бой")}</option><option value="flyer-heavy">{t("Flyer heavy", "Летающие")}</option><option value="caster-support">{t("Caster & support", "Магия и поддержка")}</option><option value="cross-archetype">{t("Cross-archetype", "Разные архетипы")}</option></select></label>
                <label>{t("Battlefield", "Поле боя")}<select name="map"><option value="all">{t("All live maps", "Все активные карты")}</option><option value="1">{t("Normal", "Обычная")}</option><option value="3">{t("Lava Center", "Лава в центре")}</option><option value="4">{t("Block Center", "Блок в центре")}</option></select></label>
                <label>{t("Min. battle pairs", "Мин. пар боёв")}<select name="minimum"><option value="50">50+</option><option value="20">20+</option><option value="1">1+</option></select></label>
            </form>
            <div class="premium-refresh" data-premium-refresh hidden>
                <p data-premium-refresh-status role="status" aria-atomic="true"></p>
                <button class="premium-text-button" type="button" data-premium-refresh-retry hidden>{t("Try again", "Повторить")}</button>
            </div>
            <div data-premium-content aria-busy="false"></div>
            <PremiumSearch lang={lang} />
        </div>
    </section>
    <noscript><p class="premium-status">{t("Enable JavaScript to check Premium access and load the battle statistics.", "Включите JavaScript для проверки доступа к Premium и загрузки графиков.")}</p></noscript>
</div>
<script>
    import { initPremiumPage } from "../lib/premium-page";
    initPremiumPage();
</script>
