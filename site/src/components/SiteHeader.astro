---
import corePackage from "../../../game/core/package.json";
import { content, languageSwitchPath, links, localPath, type Language } from "../lib/site-data";

interface Props {
    lang: Language;
    currentPath: string;
}

const { lang, currentPath } = Astro.props;
const copy = content[lang];
const versionLabel = `v${corePackage.version}`;
const mainNavigationLabel = lang === "ru" ? "Основная навигация" : "Main navigation";
const playHref = lang === "ru" ? "/ru/play/" : links.play;
const profileHref = lang === "ru" ? "/ru/profile/" : "/profile/";
const knowledgeBaseHref = localPath(lang, "knowledge-base");
const searchLabel = lang === "ru" ? "Поиск" : "Search";
const languageMenuLabel = lang === "ru" ? "Выбрать язык" : "Choose language";
const navItems = [
    { label: copy.nav.game, href: localPath(lang, "game") },
    { label: copy.nav.knowledgeBase, href: knowledgeBaseHref },
    { label: copy.nav.news, href: `${localPath(lang, "home")}news/` },
    { label: copy.nav.seasons, href: `${localPath(lang, "home")}seasons/` },
    { label: copy.nav.token, href: localPath(lang, "token") },
    // Patches intentionally omitted from the main nav to keep it uncluttered — the version badge
    // (below, in .brand-lockup) links to the patches page instead.
];

const normalizedPath = currentPath.endsWith("/") && currentPath !== "/" ? currentPath.slice(0, -1) : currentPath;
const localePrefix = lang === "ru" ? "/ru" : "";
const legacyKnowledgePaths = new Set(
    ["rules", "units", "abilities", "spells", "artifacts"].map((slug) => `${localePrefix}/${slug}`),
);
---

<header class="site-header">
    <div class="brand-lockup">
        <a class="brand" href={localPath(lang, "game")} aria-label="Heroes of Crypto">
            <img src="/assets/images/home/logo/hocai_logo_96.png" alt="" width="32" height="32" />
        </a>
        <a class="version-badge" href={localPath(lang, "patches")} aria-label={`${copy.nav.patches} ${versionLabel}`}>
            {versionLabel}
        </a>
    </div>

    <nav class="main-nav" aria-label={mainNavigationLabel}>
        {
            navItems.map((item) => {
                const itemPath = item.href.endsWith("/") && item.href !== "/" ? item.href.slice(0, -1) : item.href;
                const isActive =
                    normalizedPath === itemPath ||
                    (item.href === knowledgeBaseHref && legacyKnowledgePaths.has(normalizedPath)) ||
                    (item.href === localPath(lang, "game") && (normalizedPath === "" || normalizedPath === "/ru"));

                return (
                    <a class:list={["nav-link", { active: isActive }]} href={item.href}>
                        {item.label}
                    </a>
                );
            })
        }
    </nav>

    <div class="header-actions">
        <a class="nav-link header-start header-play-button" href={playHref} aria-label={copy.play.startLabel}>
            <span>{copy.play.startCta}</span>
        </a>
        <a class="header-icon-button header-search-link" href={`${knowledgeBaseHref}#kb-search`} aria-label={searchLabel} title={searchLabel}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="10.8" cy="10.8" r="6.7"></circle>
                <path d="m16 16 4.2 4.2"></path>
            </svg>
        </a>
        <a
            class="header-icon-button header-login-link"
            data-auth-login
            href={`${localPath(lang, "home")}auth/login/`}
            aria-label={copy.nav.login}
            title={copy.nav.login}
        >
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="7.4" r="3.6"></circle>
                <path d="M5.7 20c.5-4 2.6-6.2 6.3-6.2s5.8 2.2 6.3 6.2"></path>
            </svg>
        </a>
        <div class="header-account" data-auth-account hidden>
            <a class="header-icon-button header-account-name" href={profileHref} aria-label={copy.nav.profile}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="7.4" r="3.6"></circle>
                    <path d="M5.7 20c.5-4 2.6-6.2 6.3-6.2s5.8 2.2 6.3 6.2"></path>
                </svg>
                <span class="sr-only" data-auth-username>Account</span>
            </a>
            <button type="button" class="header-logout" data-auth-logout data-logout-redirect={localPath(lang, "home")}>
                {copy.nav.logout}
            </button>
        </div>
        <div class="header-language" data-language-menu>
            <div class="language-drawer" id="header-language-drawer" data-language-drawer aria-hidden="true">
                <a class:list={["language-option", { active: lang === "en" }]} href={languageSwitchPath(currentPath, "en")}>
                    {copy.ui.english}
                </a>
                <a class:list={["language-option", { active: lang === "ru" }]} href={languageSwitchPath(currentPath, "ru")}>
                    {copy.ui.russian}
                </a>
            </div>
            <button
                type="button"
                class="header-icon-button language-toggle"
                data-language-toggle
                aria-label={languageMenuLabel}
                aria-controls="header-language-drawer"
                aria-expanded="false"
                title={languageMenuLabel}
            >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="8.3"></circle>
                    <path d="M3.9 12h16.2M12 3.7c2.2 2.3 3.3 5 3.3 8.3S14.2 18 12 20.3M12 3.7C9.8 6 8.7 8.7 8.7 12s1.1 6 3.3 8.3"></path>
                </svg>
            </button>
        </div>
    </div>
</header>

<script>
    import { displayName, getAuthUser, isLoggedIn, logout, onAuthStateChange } from "../lib/auth-state";

    const loginLink = document.querySelector<HTMLElement>("[data-auth-login]");
    const account = document.querySelector<HTMLElement>("[data-auth-account]");
    const usernameEl = document.querySelector<HTMLElement>("[data-auth-username]");
    const logoutBtn = document.querySelector<HTMLButtonElement>("[data-auth-logout]");
    const languageMenu = document.querySelector<HTMLElement>("[data-language-menu]");
    const languageDrawer = document.querySelector<HTMLElement>("[data-language-drawer]");
    const languageToggle = document.querySelector<HTMLButtonElement>("[data-language-toggle]");

    const setLanguageMenuOpen = (open: boolean) => {
        languageMenu?.classList.toggle("is-open", open);
        languageToggle?.setAttribute("aria-expanded", String(open));
        languageDrawer?.setAttribute("aria-hidden", String(!open));
    };

    languageToggle?.addEventListener("click", () => {
        setLanguageMenuOpen(languageToggle.getAttribute("aria-expanded") !== "true");
    });

    document.addEventListener("click", (event) => {
        if (languageMenu && !languageMenu.contains(event.target as Node)) setLanguageMenuOpen(false);
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setLanguageMenuOpen(false);
    });

    logoutBtn?.addEventListener("click", () => logout(logoutBtn.dataset.logoutRedirect || "/"));

    onAuthStateChange(() => {
        const loggedIn = isLoggedIn();
        if (usernameEl && loggedIn) {
            const name = displayName(getAuthUser());
            usernameEl.textContent = name;
            usernameEl.closest("a")?.setAttribute("title", name);
        }
        if (loginLink) loginLink.hidden = loggedIn;
        if (account) account.hidden = !loggedIn;
    });
</script>

<style>
    .nav-link {
        font-size: 1.0465rem;
    }

    .version-badge {
        font-size: 0.897rem;
    }

    .main-nav .nav-link.active {
        border-color: transparent;
        background: transparent;
        color: var(--gold-soft, #f4d58a);
        box-shadow: none;
        text-shadow: 0 0 12px rgba(239, 178, 70, 0.58);
    }

    .header-actions .header-play-button {
        min-height: 38px;
        padding: 8px 15px;
        border-color: rgba(220, 177, 88, 0.42);
        background: linear-gradient(180deg, rgba(122, 68, 5, 0.38), rgba(45, 24, 5, 0.5));
        color: var(--gold-soft, #f4d58a);
        box-shadow:
            inset 0 0 11px rgba(255, 143, 0, 0.08),
            0 0 14px rgba(141, 73, 15, 0.1);
    }

    .header-actions .header-play-button:hover,
    .header-actions .header-play-button:focus-visible {
        border-color: rgba(229, 184, 93, 0.72);
        background: linear-gradient(180deg, rgba(142, 79, 8, 0.52), rgba(52, 27, 5, 0.62));
        color: #ffe2a0;
    }

    .header-icon-button {
        display: inline-flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        padding: 0;
        border: 1px solid transparent;
        border-radius: 50%;
        background: transparent;
        color: rgba(239, 228, 204, 0.7);
        transition:
            color 0.18s ease,
            border-color 0.18s ease,
            background 0.18s ease,
            box-shadow 0.18s ease;
    }

    .header-icon-button svg {
        width: 23px;
        height: 23px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.65;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .header-icon-button:hover,
    .header-icon-button:focus-visible,
    .header-language.is-open .language-toggle {
        border-color: rgba(220, 177, 88, 0.34);
        background: rgba(91, 49, 10, 0.24);
        color: var(--gold-soft, #f4d58a);
        box-shadow:
            inset 0 0 12px rgba(255, 143, 0, 0.08),
            0 0 14px rgba(168, 91, 25, 0.14);
    }

    .header-login-link {
        min-width: 38px;
    }

    /* The login link is display:inline-flex (global.css), which overrides the plain [hidden] attribute
       the auth script sets once logged in — so it stayed visible next to the account chip. Force it
       hidden here (higher specificity than the global rule), same guard as .header-account below. */
    .header-login-link[hidden] {
        display: none;
    }

    .header-account {
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    /* Higher specificity than .header-account so the hidden attribute still wins over display:flex. */
    .header-account[hidden] {
        display: none;
    }

    .header-account-name {
        color: var(--gold, #f2c75d);
    }

    .header-language {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

    .language-drawer {
        display: inline-grid;
        grid-template-columns: repeat(2, 43px);
        max-width: 0;
        margin-right: 0;
        overflow: hidden;
        border: 1px solid transparent;
        border-radius: 3px;
        background: rgba(10, 7, 5, 0.92);
        opacity: 0;
        transform: translateX(12px);
        pointer-events: none;
        transition:
            max-width 0.24s ease,
            margin-right 0.24s ease,
            border-color 0.18s ease,
            opacity 0.18s ease,
            transform 0.24s ease;
    }

    .header-language.is-open .language-drawer {
        max-width: 92px;
        margin-right: 6px;
        border-color: var(--line, rgba(112, 75, 42, 0.46));
        opacity: 1;
        transform: translateX(0);
        pointer-events: auto;
    }

    .header-logout {
        padding: 6px 10px;
        border: 1px solid var(--line, rgba(112, 75, 42, 0.46));
        border-radius: 2px;
        background: linear-gradient(180deg, rgba(76, 45, 22, 0.42), rgba(9, 7, 5, 0.78));
        color: var(--muted, rgba(239, 228, 204, 0.66));
        font: inherit;
        font-size: 0.82rem;
        letter-spacing: 0.055em;
        transition:
            border-color 0.18s ease,
            background 0.18s ease;
    }

    .header-logout:hover {
        border-color: rgba(220, 177, 88, 0.56);
        background: linear-gradient(180deg, rgba(105, 48, 18, 0.54), rgba(20, 12, 7, 0.88));
        color: var(--ink, #efe4cc);
    }

    @media (max-width: 720px) {
        .nav-link {
            font-size: 1.0005rem;
        }

        .version-badge {
            font-size: 0.851rem;
        }

        .header-icon-button {
            width: 34px;
            height: 34px;
        }

        .header-icon-button svg {
            width: 21px;
            height: 21px;
        }

        .header-actions .header-play-button {
            display: inline-flex;
            min-height: 34px;
            max-width: none;
            padding: 8px 12px;
            font-size: 0.966rem;
        }
    }
</style>
