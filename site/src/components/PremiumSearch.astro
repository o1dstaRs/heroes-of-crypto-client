---
import type { Language } from "../lib/site-data";
interface Props { lang: Language }
const { lang } = Astro.props;
const t = (en: string, ru: string) => lang === "ru" ? ru : en;
const suggestions = [
    ["Compare unit pairs", "Сравнить пары юнитов", "Which unit pairs work well together mechanically, and why? Distinguish measured results from strategic reasoning.", "Какие пары юнитов хорошо сочетаются по механикам и почему? Отдели измеренные результаты от стратегических рассуждений."],
    ["Compare artifacts", "Сравнить артефакты", "Compare Tier 2 artifact mechanics and explain which armies suit them.", "Сравни механики артефактов второго уровня и объясни, каким армиям они подходят."],
    ["Faction synergies", "Синергии фракций", "Explain active faction synergies and the tradeoffs of building an army around them.", "Объясни активные синергии фракций и компромиссы при построении армии вокруг них."],
    ["Choose upgrades", "Выбрать усиления", "How should I choose an augment plan for my army? Explain the tradeoffs and what information you need.", "Как выбрать план усилений для моей армии? Объясни компромиссы и какие сведения тебе нужны."],
];
---
<section class="premium-ai" id="premium-search" data-premium-ai hidden aria-labelledby="premium-search-title">
    <div class="premium-ai-heading">
        <h2 id="premium-search-title">{t("Ask Premium AI", "Спросить Premium AI")}</h2>
        <button type="button" class="premium-text-button" data-ai-clear>{t("New conversation", "Новый разговор")}</button>
    </div>
    <p class="premium-ai-intro">{t("Ask about game rules, army builds, or the selected battle results.", "Задайте вопрос о правилах игры, составе армии или выбранных результатах боёв.")}</p>
    <p class="premium-ai-scope" data-ai-scope></p>
    <div class="premium-ai-suggestions">
        {suggestions.map(([en, ru, prompt, promptRu]) => <button type="button" data-ai-prompt={t(prompt, promptRu)}>{t(en, ru)} <span aria-hidden="true">↗</span></button>)}
    </div>
    <div class="premium-ai-transcript" data-ai-transcript role="region" aria-label={t("Premium conversation", "Разговор с Premium")}></div>
    <form class="premium-ai-form" data-ai-form>
        <label for="premium-question">{t("Your question", "Ваш вопрос")}</label>
        <textarea id="premium-question" data-ai-question rows="2" maxlength="2000" required placeholder={t("How does Smoke affect ranged attacks?", "Как Smoke влияет на дальние атаки?")} aria-describedby="premium-ai-help"></textarea>
        <div class="premium-ai-form-footer"><p id="premium-ai-help">{t("Enter to send. Shift + Enter for a new line.", "Enter — отправить. Shift + Enter — новая строка.")}</p><button type="button" class="premium-secondary" data-ai-stop hidden>{t("Stop", "Остановить")}</button><button type="submit" class="premium-button" data-ai-submit>{t("Send", "Отправить")} <span aria-hidden="true">↑</span></button></div>
    </form>
    <p class="premium-ai-status" data-ai-status role="status" aria-live="polite"></p>
</section>
