---
import type { Language } from "../lib/site-data";
import PremiumIcon from "./PremiumIcon.astro";
interface Props { lang: Language }
const { lang } = Astro.props;
const t = (en: string, ru: string) => lang === "ru" ? ru : en;
const suggestions = [
    ["Find strong combos", "Найти комбинации", "Which unit pairs work well together mechanically, and why? Distinguish measured results from strategic reasoning.", "Какие пары юнитов хорошо сочетаются по механикам и почему? Отдели измеренные результаты от стратегических рассуждений."],
    ["Compare artifacts", "Сравнить артефакты", "Compare Tier 2 artifact mechanics and explain which armies suit them.", "Сравни механики артефактов второго уровня и объясни, каким армиям они подходят."],
    ["Explore synergies", "Изучить синергии", "Explain active faction synergies and the tradeoffs of building an army around them.", "Объясни активные синергии фракций и компромиссы при построении армии вокруг них."],
    ["Plan my upgrades", "Выбрать усиления", "How should I choose an augment plan for my army? Explain the tradeoffs and what information you need.", "Как выбрать план усилений для моей армии? Объясни компромиссы и какие сведения тебе нужны."],
];
---
<section class="premium-ai" id="premium-search" data-premium-ai hidden aria-labelledby="premium-search-title">
    <div class="premium-ai-heading">
        <div><p class="premium-eyebrow"><PremiumIcon size="18px" /> {t("YOUR META, EXPLAINED", "ВАША МЕТА, С ОБЪЯСНЕНИЯМИ")}</p><h2 id="premium-search-title">{t("Ask Premium", "Спросить Premium")} <span>AI</span></h2></div>
        <button type="button" class="premium-text-button" data-ai-clear><PremiumIcon size="16px" /> {t("New conversation", "Новый разговор")} ↗</button>
    </div>
    <p class="premium-ai-intro">{t("Ask about strategies, combinations, artifacts or builds. Explore current game mechanics and, when available, the selected statistical evidence.", "Спрашивайте о стратегиях, комбинациях, артефактах и билдах. Изучайте актуальные игровые механики и, когда доступны, выбранные статистические данные.")}</p>
    <p class="premium-ai-scope" data-ai-scope></p>
    <div class="premium-ai-suggestions">
        {suggestions.map(([en, ru, prompt, promptRu]) => <button type="button" data-ai-prompt={t(prompt, promptRu)}><PremiumIcon size="16px" /> {t(en, ru)}</button>)}
    </div>
    <div class="premium-ai-transcript" data-ai-transcript role="region" aria-label={t("Premium conversation", "Разговор с Premium")}></div>
    <form class="premium-ai-form" data-ai-form>
        <label for="premium-question">{t("Your question", "Ваш вопрос")}</label>
        <textarea id="premium-question" data-ai-question rows="2" maxlength="2000" required placeholder={t("What should I build around, and why?", "Вокруг чего построить армию и почему?")} aria-describedby="premium-ai-help"></textarea>
        <div class="premium-ai-form-footer"><p id="premium-ai-help">{t("Follow-ups welcome · Enter to send · Shift + Enter for a new line", "Можно задавать уточнения · Enter — отправить · Shift + Enter — новая строка")}</p><button type="button" class="premium-secondary" data-ai-stop hidden><PremiumIcon size="16px" /> {t("Stop", "Остановить")}</button><button type="submit" class="premium-button" data-ai-submit><PremiumIcon size="18px" /> {t("Ask Premium", "Спросить Premium")} <span>↑</span></button></div>
    </form>
    <p class="premium-ai-status" data-ai-status role="status" aria-live="polite"></p>
    <p class="premium-fine">{t("Without a statistical library, advice uses game rules and strategic reasoning, not measured win rates. When a snapshot is selected, check sample sizes and uncertainty before making a pick.", "Без статистической библиотеки советы основаны на правилах и стратегических рассуждениях, а не на измеренных шансах победы. При выборе снимка проверяйте объём выборки и неопределённость перед пиком.")}</p>
</section>
