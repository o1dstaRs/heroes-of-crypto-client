---
import RankedArena from "./RankedArena.astro";
import CreaturePortrait from "./CreaturePortrait.astro";
import DeferredMedia from "./DeferredMedia.astro";
import { knowledgePath } from "../lib/knowledge-base";
import { content, contractAddress, links, localPath, type Language } from "../lib/site-data";
import FactionArtwork from "./FactionArtwork.astro";
import featureArt from "../data/feature-art.json";
import GameModes from "./GameModes.astro";
import TavernBackdrop from "./TavernBackdrop.astro";
import HeroButtonPicker from "./HeroButtonPicker.astro";
import CtaDesignPicker from "./CtaDesignPicker.astro";

interface Props {
    lang: Language;
}

const { lang } = Astro.props;
const copy = content[lang];
const featureVisuals = [
    {
        variant: "board",
    },
    {
        variant: "factions",
    },
    {
        variant: "abilities",
    },
] as const;
const featureCards = copy.features.items.map((item, index) => ({
    ...item,
    visual: featureVisuals[index] ?? featureVisuals[0],
}));
const heroPitchLines =
    lang === "en" ? copy.hero.pitch.replace(" single‑session", "|single‑session").split("|") : [copy.hero.pitch];
const rulesHref = knowledgePath(lang, { section: "rules" });
const playHref = lang === "ru" ? "/ru/play/" : links.play;
---

<section class="hero">
    <TavernBackdrop lang={lang} />
    <div class="hero-shade"></div>
    <h1 class="sr-only">{copy.hero.title}</h1>
    <HeroButtonPicker lang={lang} />
    <div class="hero-grid hero-grid-bottom page-shell">
        <div class="hero-content hero-content-bottom">
            <div class="hero-actions">
                <a class="button hero-play" href={playHref} aria-label={copy.hero.primaryCta}>
                    <img class="hero-play-art" src="/assets/images/home/hero/taverns/buttons/06-espresso-gold.webp?v=simple-2" alt="" width="2172" height="402" aria-hidden="true" />
                    <span>{copy.hero.primaryCta}</span>
                </a>
            </div>
        </div>
    </div>
    <ul class="hero-claims hero-claims-bottom">
        {copy.hero.claims.map((claim) => <li>{claim}</li>)}
    </ul>
</section>

<section class="feature-section hero-intro-section" id="features">
    <div class="page-shell feature-intro-heading">
        <div class="section-heading centered">
            <h2>{copy.features.title}</h2>
        </div>
    </div>

    <div class="page-shell hero-feature-content">
        <div class="feature-grid mechanic-grid">
            {
                featureCards.map((item) => (
                    <article class={`feature-card mechanic-card is-${item.visual.variant}`}>
                        <div class="mechanic-visual" aria-hidden="true">
                            <DeferredMedia>
                            {
                                item.visual.variant === "board" && (
                                    <div class="mechanic-board mechanic-board-closeup">
                                        <img
                                            src="/assets/images/home/features/battle_cinematic_abomination_v2_20261024.webp"
                                            alt=""
                                            width="1619"
                                            height="971"
                                            loading="lazy"
                                        />
                                    </div>
                                )
                            }
                            {
                                item.visual.variant === "factions" && (
                                    <div class="mechanic-factions"><FactionArtwork lang={lang} /></div>
                                )
                            }
                            {
                                item.visual.variant === "abilities" && (
                                    <div class="mechanic-abilities">
                                        <img
                                            src={featureArt.spellVariant ? `/assets/images/home/features/spells_variant_${featureArt.spellVariant}.webp` : "/assets/images/home/features/spells_cinematic.webp"}
                                            alt=""
                                            width="1586"
                                            height="992"
                                            loading="lazy"
                                        />
                                    </div>
                                )
                            }
                            </DeferredMedia>
                        </div>
                        <div class="mechanic-copy">
                            <h3>{item.title}</h3>
                            <p>{item.description}</p>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>

</section>

<GameModes lang={lang} />

<RankedArena lang={lang} />

<section class="final-cta" id="cta-design">
    {import.meta.env.DEV && <CtaDesignPicker />}
    <div class="page-shell final-cta-inner">
        <div>
            <p class="eyebrow">{copy.hero.kicker}</p>
            <h2>{copy.hero.tagline}</h2>
        </div>
        <div class="final-cta-actions">
            <a class="button primary" href={playHref}>
                <img src="/assets/icons/navbar/joystick.svg" alt="" width="22" height="22" />
                {copy.hero.primaryCta}
            </a>
            <a class="button secondary" href={rulesHref}>
                {copy.hero.secondaryCta}
            </a>
        </div>
    </div>
</section>

<section class="feature-section hero-intro-section pre-roadmap-pitch" id="game-pitch">
    <div class="hero-pitch-band">
        <div class="page-shell">
            <p class="hero-tagline hero-tagline-bottom">
                {heroPitchLines.map((line) => <span>{line}</span>)}
            </p>
        </div>
    </div>
</section>

<section class="section roadmap-section">
    <div class="page-shell">
        <div class="section-heading centered">
            <p class="eyebrow">{copy.roadmap.eyebrow}</p>
            <h2>{copy.roadmap.title}</h2>
        </div>
        <div class="roadmap-grid">
            {
                copy.roadmap.items.map((item) => (
                    <article class="roadmap-item">
                        <time>{item.time}</time>
                        <h3>{item.title}</h3>
                        <p>{item.description}</p>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    .pre-roadmap-pitch .hero-pitch-band {
        padding-block: clamp(36px, 4vw, 64px);
    }
</style>
