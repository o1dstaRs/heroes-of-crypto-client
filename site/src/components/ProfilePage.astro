    .season-row .season-gold,
    .match-gold {
        color: #f2c75d;
        white-space: nowrap;
    }

    .season-row .season-games {
        color: rgba(251, 244, 232, 0.45);
        text-align: right;
    }

    .ranked-standing__season {
        display: block;
        margin-top: 4px;
        color: rgba(251, 244, 232, 0.55);
        letter-spacing: 0.04em;
    }

    @media (max-width: 720px) {
        .season-row {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        }

        .season-row .season-games {
            text-align: left;
        }
    }

    .profile-note {
        color: rgba(251, 244, 232, 0.68);
    }

    .profile-note[data-profile-loading] {
        width: fit-content;
        padding: 10px 14px;
        border-left: 2px solid var(--gold, #dcb158);
        background: linear-gradient(90deg, rgba(76, 45, 22, 0.5), transparent);
        color: var(--muted, rgba(239, 228, 204, 0.66));
        letter-spacing: 0.055em;
    }

    .profile-summary-notice {
        margin: 0 0 22px;
        padding: 11px 14px;
        border: 1px solid rgba(220, 177, 88, 0.26);
        border-radius: 10px;
        color: var(--muted, rgba(239, 228, 204, 0.66));
        background: linear-gradient(90deg, rgba(73, 43, 19, 0.52), rgba(13, 8, 5, 0.88));
        font-size: 0.84rem;
    }

    .profile-note[hidden],
    .profile-summary-notice[hidden],
    .profile-content[hidden],
    .profile-empty[hidden],
    .profile-body[hidden],
    [data-profile-combos-section][hidden],
    [data-profile-public-standing][hidden],
    [data-profile-self][hidden] {
        display: none;
    }

    .profile-panel {
        display: grid;
        gap: 10px;
        justify-items: start;
        max-width: 560px;
        margin-top: 16px;
        padding: 24px 26px;
        border: 1px solid rgba(255, 143, 0, 0.27);
        border-radius: 16px;
        background: rgba(12, 8, 5, 0.91);
        box-shadow: 0 14px 38px rgba(0, 0, 0, 0.42);
        backdrop-filter: blur(14px);
    }

    .profile-panel h2 {
        margin: 0;
        color: var(--hoc-bronze, #cda078);
        font-size: 1.3rem;
    }

    .profile-panel p {
        margin: 0;
        color: rgba(251, 244, 232, 0.72);
    }

    .profile-btn {
        margin-top: 6px;
        padding: 9px 18px;
        border: 0;
        border-radius: 0;
        background-color: transparent;
        background-image:
            linear-gradient(rgba(105, 48, 18, 0.48), rgba(105, 48, 18, 0.48)),
            url("/assets/images/ui/ui_start_button_plate_trimmed.webp");
        background-position: center;
        background-repeat: no-repeat;
        background-size: 100% 100%;
        color: var(--hoc-bronze, #cda078);
        font-weight: 400;
        font-size: 0.9rem;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        cursor: pointer;
        transition:
            border-color 0.18s ease,
            background 0.18s ease;
    }

    .profile-btn:hover {
        background-color: transparent;
        filter: brightness(1.1) contrast(1.04) drop-shadow(0 0 7px rgba(224, 83, 34, 0.3));
        transform: translateY(-1px);
    }

    .profile-body {
        display: grid;
        gap: 16px;
    }

    .profile-section {
        position: relative;
        min-width: 0;
        padding: clamp(16px, 2vw, 22px);
        border: 1px solid rgba(255, 143, 0, 0.27);
        border-radius: 16px;
        background: rgba(12, 8, 5, 0.91);
        box-shadow: 0 14px 38px rgba(0, 0, 0, 0.42);
        backdrop-filter: blur(14px);
    }

    .profile-section::before {
        display: none;
    }

    .profile-section h2 {
        margin: 0 0 15px;
        color: var(--gold, #dcb158);
        font-size: 1rem;
        font-weight: 400;
        letter-spacing: 0.025em;
        text-transform: none;
    }

    .profile-columns {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 12px;
        margin: 0;
    }

    .stat-card {
        display: grid;
        gap: 4px;
        padding: 16px 18px;
        border: 1px solid rgba(239, 228, 204, 0.08);
        border-radius: 12px;
        background: rgba(0, 0, 0, 0.3);
        text-align: center;
    }

    .stat-card dt {
        color: rgba(251, 244, 232, 0.58);
        font-size: 0.74rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .stat-card dd {
        margin: 0;
        color: var(--gold, #dcb158);
        font-size: 1.5rem;
        font-weight: 820;
    }

    /* Profile rows are client-rendered, so they do not receive Astro's scope attribute. */
    .profile-page :global(.stat-card) {
        display: grid;
        gap: 4px;
        padding: 16px 18px;
        border: 1px solid rgba(239, 228, 204, 0.08);
        border-radius: 12px;
        background: rgba(0, 0, 0, 0.3);
        text-align: center;
    }

    .profile-page :global(.stat-card dt) {
        color: rgba(251, 244, 232, 0.58);
        font-size: 0.74rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .profile-page :global(.stat-card dd) {
        margin: 0;
        color: var(--gold, #dcb158);
        font-size: 1.5rem;
        font-weight: 400;
        letter-spacing: 0.045em;
    }

    .profile-page :global(.stat-card--form) {
        grid-column: span 2;
        text-align: left;
    }

    .profile-page :global(.stat-card--form dd) {
        display: flex;
        align-items: center;
        min-height: 32px;
    }

    .ranked-standing {
        display: grid;
        grid-template-columns: minmax(220px, 0.72fr) minmax(0, 1.55fr);
        gap: 14px;
    }

    .ranked-standing :global(.ranked-standing__banner) {
        position: relative;
        display: grid;
        grid-template-columns: 118px minmax(0, 1fr);
        gap: 14px;
        align-items: center;
        align-content: center;
        min-height: 150px;
        padding: 18px 20px;
        overflow: hidden;
        border: 1px solid rgba(255, 143, 0, 0.3);
        border-radius: 12px;
        background:
            radial-gradient(circle at 88% 12%, rgba(255, 143, 0, 0.2), transparent 40%),
            linear-gradient(145deg, rgba(70, 41, 17, 0.72), rgba(15, 10, 7, 0.94));
        box-shadow: inset 0 0 28px rgba(255, 143, 0, 0.05);
    }

    .ranked-standing :global(.ranked-standing__emblem) {
        display: block;
        width: 118px;
        height: 118px;
        object-fit: contain;
        filter: drop-shadow(0 9px 12px rgba(0, 0, 0, 0.58)) drop-shadow(0 0 10px rgba(220, 177, 88, 0.24));
    }

    .ranked-standing :global(.ranked-standing__copy) {
        display: grid;
        min-width: 0;
    }

    .ranked-standing :global(.ranked-standing__state) {
        width: fit-content;
        margin-bottom: 12px;
        padding: 4px 9px;
        border: 1px solid rgba(242, 199, 93, 0.38);
        border-radius: 8px;
        background: rgba(76, 45, 22, 0.6);
        color: var(--gold, #dcb158);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .ranked-standing :global(.ranked-standing__banner strong) {
        color: #fff5df;
        font-size: clamp(1.35rem, 2vw, 1.85rem);
        line-height: 1.05;
    }

    .ranked-standing :global(.ranked-standing__banner small) {
        margin-top: 7px;
        color: rgba(251, 244, 232, 0.62);
        font-size: 0.84rem;
    }

    .ranked-standing :global(.ranked-standing__facts) {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 9px;
        margin: 0;
    }

    .ranked-standing :global(.ranked-standing__facts > div) {
        display: grid;
        align-content: center;
        min-height: 68px;
        padding: 11px 14px;
        border: 1px solid rgba(239, 228, 204, 0.08);
        border-radius: 10px;
        background: rgba(0, 0, 0, 0.28);
    }

    .ranked-standing :global(.ranked-standing__facts dt) {
        color: rgba(251, 244, 232, 0.48);
        font-size: 0.68rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .ranked-standing :global(.ranked-standing__facts dd) {
        margin: 4px 0 0;
        color: rgba(251, 244, 232, 0.92);
        font-size: 0.94rem;
        font-weight: 400;
        letter-spacing: 0.035em;
    }

    .ranked-standing :global(.ranked-standing__form) {
        grid-column: 1 / -1;
    }

    .profile-page :global(.result-form) {
        display: flex;
        gap: clamp(5px, 0.8vw, 9px);
        align-items: center;
        min-height: 22px;
    }

    .profile-page :global(.result-form__dot) {
        display: block;
        width: 12px;
        height: 12px;
        border: 1px solid rgba(239, 228, 204, 0.2);
        border-radius: 50%;
        background: rgba(239, 228, 204, 0.08);
        box-shadow: inset 0 0 0 2px rgba(0, 0, 0, 0.18);
    }

    .profile-page :global(.result-form__dot.win) {
        border-color: rgba(70, 209, 96, 0.78);
        background: #46d160;
        box-shadow: 0 0 7px rgba(70, 209, 96, 0.28);
    }

    .profile-page :global(.result-form__dot.draw) {
        border-color: rgba(174, 181, 190, 0.72);
        background: #8f99a4;
    }

    .profile-page :global(.result-form__dot.loss) {
        border-color: rgba(255, 90, 90, 0.78);
        background: #ff5a5a;
        box-shadow: 0 0 7px rgba(255, 90, 90, 0.22);
    }

    .ranked-standing :global(.ranked-standing__previous) {
        grid-column: 1 / -1;
    }

    .bar-list,
    .combo-list,
    .match-list {
        display: grid;
        gap: 8px;
    }

    .matches-more {
        display: block;
        min-width: 170px;
        margin: 14px auto 0;
        padding: 9px 18px;
        border: 1px solid rgba(205, 160, 120, 0.48);
        border-radius: 7px;
        background: linear-gradient(180deg, rgba(82, 43, 22, 0.9), rgba(31, 17, 10, 0.94));
        color: var(--hoc-bronze, #cda078);
        font: inherit;
        font-size: 0.86rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
        transition:
            border-color 0.18s ease,
            color 0.18s ease,
            filter 0.18s ease;
    }

    .matches-more:hover {
        border-color: rgba(224, 177, 113, 0.76);
        color: #f0c982;
        filter: brightness(1.12);
    }

    .matches-more:focus-visible {
        outline: 2px solid #f0c982;
        outline-offset: 3px;
    }

    .matches-more[hidden] {
        display: none;
    }

    .profile-page :global(.bar-row) {
        display: grid;
        grid-template-columns: 34px minmax(0, 1fr) minmax(80px, 160px) 42px auto;
        gap: 10px;
        align-items: center;
        padding: 8px 12px;
        border: 1px solid rgba(112, 75, 42, 0.42);
        border-radius: 2px;
        background: linear-gradient(90deg, rgba(42, 25, 13, 0.8), rgba(9, 6, 4, 0.88));
    }

    .profile-page :global(.bar-icon),
    .profile-page :global(.combo-icon),
    .profile-page :global(.match-icon) {
        border-radius: 2px;
        background: rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(220, 177, 88, 0.32);
        object-fit: cover;
    }

    .profile-page :global(.bar-name) {
        overflow: hidden;
        color: var(--ink, #efe4cc);
        font-weight: 400;
        letter-spacing: 0.035em;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .profile-page :global(.bar-track) {
        position: relative;
        height: 8px;
        overflow: hidden;
        border: 1px solid rgba(112, 75, 42, 0.42);
        border-radius: 1px;
        background: rgba(0, 0, 0, 0.36);
    }

    .profile-page :global(.bar-fill) {
        position: absolute;
        inset: 0;
        border-radius: 0;
        box-shadow: 0 0 7px currentColor;
    }

    .profile-page :global(.bar-pct) {
        font-size: 0.84rem;
        font-weight: 400;
        text-align: right;
    }

    .profile-page :global(.bar-games) {
        color: rgba(251, 244, 232, 0.5);
        font-size: 0.8rem;
        white-space: nowrap;
    }

    .profile-page :global(.combo-row) {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto minmax(80px, 160px) 42px;
        gap: 12px;
        align-items: center;
        padding: 8px 12px;
        border: 1px solid rgba(112, 75, 42, 0.42);
        border-radius: 2px;
        background: linear-gradient(90deg, rgba(42, 25, 13, 0.8), rgba(9, 6, 4, 0.88));
    }

    .profile-page :global(.combo-icons),
    .profile-page :global(.match-icons) {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
    }

    .profile-page :global(.combo-games) {
        color: rgba(251, 244, 232, 0.5);
        font-size: 0.8rem;
        white-space: nowrap;
    }

    .profile-page :global(.match-replay) {
        margin-left: auto;
        padding: 5px 8px;
        border: 1px solid rgba(220, 177, 88, 0.36);
        border-radius: 2px;
        background: rgba(76, 45, 22, 0.44);
        color: var(--gold, #dcb158);
        font-size: 0.72rem;
        font-weight: 400;
        letter-spacing: 0.055em;
        text-decoration: none;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .profile-page :global(.match-replay:hover) {
        border-color: rgba(220, 177, 88, 0.68);
        color: var(--gold-soft, #efd49a);
    }

    .profile-page :global(.match-row) {
        display: grid;
        grid-template-columns: 74px minmax(0, auto) minmax(0, 1fr) auto;
        gap: 12px;
        align-items: center;
        padding: 8px 12px;
        border: 1px solid rgba(112, 75, 42, 0.42);
        border-radius: 2px;
        background: linear-gradient(90deg, rgba(42, 25, 13, 0.8), rgba(9, 6, 4, 0.88));
    }

    .profile-page :global(.match-result) {
        padding: 4px 8px;
        border-radius: 1px;
        font-size: 0.76rem;
        font-weight: 400;
        text-align: center;
        text-transform: uppercase;
        letter-spacing: 0.065em;
    }

    .profile-page :global(.match-result.win) {
        border: 1px solid rgba(70, 209, 96, 0.36);
        background: rgba(70, 209, 96, 0.16);
        color: #46d160;
    }

    .profile-page :global(.match-result.loss) {
        border: 1px solid rgba(255, 90, 63, 0.36);
        background: rgba(255, 90, 90, 0.16);
        color: #ff5a3f;
    }

    .profile-page :global(.match-result.draw) {
        background: rgba(242, 199, 93, 0.13);
        color: #f2c75d;
    }

    .profile-page :global(.match-row--ranked) {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto auto;
        gap: 14px;
        align-items: center;
        min-height: 70px;
        padding: 11px 12px 11px 17px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        background: rgba(0, 0, 0, 0.27);
        transition:
            border-color 0.15s ease,
            background-color 0.15s ease;
    }

    .profile-page :global(.match-row--ranked:hover) {
        border-color: rgba(220, 177, 88, 0.28);
        background: rgba(25, 15, 8, 0.72);
    }

    .profile-page :global(.match-card-link) {
        position: absolute;
        z-index: 1;
        inset: 0;
        border-radius: inherit;
    }

    .profile-page :global(.match-card-link:focus-visible) {
        outline: 2px solid var(--gold, #dcb158);
        outline-offset: -3px;
    }

    .profile-page :global(.match-row--ranked .match-opponent),
    .profile-page :global(.match-row--ranked .match-replay) {
        position: relative;
        z-index: 2;
    }

    .profile-page :global(.match-details-hint) {
        position: absolute;
        z-index: 2;
        right: 7px;
        bottom: 1px;
        color: rgba(220, 177, 88, 0.5);
        font-size: 1.15rem;
        line-height: 1;
        pointer-events: none;
    }

    .profile-page :global(.match-row--ranked::before) {
        position: absolute;
        inset: 0 auto 0 0;
        width: 3px;
        background: #8f99a4;
        content: "";
    }

    .profile-page :global(.match-row--ranked.win::before) {
        background: #46d160;
    }

    .profile-page :global(.match-row--ranked.loss::before) {
        background: #ff5a5a;
    }

    .profile-page :global(.match-main) {
        min-width: 0;
    }

    .profile-page :global(.match-title) {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        align-items: baseline;
        min-width: 0;
        color: rgba(251, 244, 232, 0.64);
        font-size: 0.92rem;
    }

    .profile-page :global(.match-row--ranked .match-result) {
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        font-size: 0.92rem;
        font-weight: 800;
        letter-spacing: 0.025em;
        text-transform: none;
    }

    .profile-page :global(.match-row--ranked .match-result.win) {
        color: #46d160;
        background: transparent;
    }

    .profile-page :global(.match-row--ranked .match-result.loss) {
        color: #ff5a5a;
        background: transparent;
    }

    .profile-page :global(.match-row--ranked .match-result.draw) {
        color: #b2bac4;
        background: transparent;
    }

    .profile-page :global(.match-opponent) {
        color: var(--ink, #efe4cc);
        font-weight: 400;
        letter-spacing: 0.035em;
        text-decoration: none;
    }

    .profile-page :global(.match-opponent:hover) {
        color: var(--gold, #dcb158);
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .profile-page :global(.match-meta) {
        display: flex;
        flex-wrap: wrap;
        gap: 5px 10px;
        align-items: center;
        margin-top: 5px;
    }

    .profile-page :global(.match-reason) {
        color: rgba(251, 244, 232, 0.5);
        font-size: 0.8rem;
    }

    .profile-page :global(.match-rewards) {
        display: grid;
        gap: 3px;
        justify-items: end;
        min-width: 86px;
    }

    .profile-page :global(.match-delta) {
        color: rgba(251, 244, 232, 0.68);
        font-size: 0.82rem;
        font-weight: 400;
        white-space: nowrap;
    }

    .profile-page :global(.match-delta.positive) {
        color: #46d160;
    }

    .profile-page :global(.match-delta.negative) {
        color: #ff6969;
    }

    .profile-page :global(.match-row--ranked .match-when) {
        color: rgba(251, 244, 232, 0.46);
        font-size: 0.82rem;
        white-space: nowrap;
    }

    .profile-page :global(.profile-empty-message) {
        margin: 0;
        padding: 18px;
        border: 1px solid rgba(112, 75, 42, 0.42);
        border-radius: 2px;
        color: var(--muted, rgba(239, 228, 204, 0.66));
        background: rgba(31, 18, 9, 0.5);
    }

    .profile-page :global(.match-vs) {
        overflow: hidden;
        color: rgba(251, 244, 232, 0.66);
        font-size: 0.9rem;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .profile-page :global(.match-vs strong) {
        color: rgba(251, 244, 232, 0.92);
    }

    .profile-page :global(.match-when) {
        color: rgba(251, 244, 232, 0.46);
        font-size: 0.82rem;
        white-space: nowrap;
    }

    @media (max-width: 820px) {
        .profile-head {
            grid-template-columns: auto minmax(0, 1fr);
        }

        .profile-arena-link {
            grid-column: 1 / -1;
            justify-self: start;
        }

        .ranked-standing {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 560px) {
        .profile-shell {
            padding: 22px 0 54px;
        }

        .profile-head {
            gap: 10px;
            padding: 12px;
        }

        .profile-head-emblem {
            width: 54px;
            height: 54px;
        }

        .profile-head-emblem img {
            width: 44px;
            height: 44px;
        }

        .profile-name {
            min-width: 0;
            margin-block: 3px 6px;
            overflow-wrap: anywhere;
            font-size: clamp(1.42rem, 8vw, 2rem);
        }

        .profile-sub {
            font-size: 0.9rem;
            line-height: 1.45;
        }

        .profile-arena-link {
            width: 100%;
        }

        .profile-section {
            padding: 13px;
        }

        .stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 7px;
        }

        .profile-page :global(.stat-card) {
            min-width: 0;
            padding: 12px;
        }

        .profile-page :global(.stat-card dd) {
            overflow-wrap: anywhere;
            font-size: 1.16rem;
        }

        .profile-page :global(.stat-card--form) {
            grid-column: 1 / -1;
        }

        .ranked-standing :global(.ranked-standing__facts) {
            grid-template-columns: 1fr;
        }

        .ranked-standing :global(.ranked-standing__banner) {
            grid-template-columns: 88px minmax(0, 1fr);
            gap: 10px;
            padding: 14px;
        }

        .ranked-standing :global(.ranked-standing__emblem) {
            width: 88px;
            height: 88px;
        }

        .ranked-standing :global(.ranked-standing__previous) {
            grid-column: auto;
        }

        .profile-page :global(.bar-row) {
            grid-template-columns: 30px minmax(0, 1fr) 40px;
            row-gap: 6px;
        }

        .profile-page :global(.bar-track) {
            grid-column: 1 / -1;
            order: 3;
        }

        .profile-page :global(.bar-games) {
            display: none;
        }

        .profile-page :global(.combo-row) {
            grid-template-columns: minmax(0, 1fr) auto 42px;
            gap: 7px;
        }

