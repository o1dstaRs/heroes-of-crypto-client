---
import { content, links, type Language } from "../lib/site-data";

interface Props {
    lang: Language;
}

const { lang } = Astro.props;
const copy = content[lang].profile;
const isRu = lang === "ru";
const profilePath = isRu ? "/ru/profile/" : "/profile/";
const loginHref = `${isRu ? "/ru" : ""}/auth/login/?redirect=${encodeURIComponent(profilePath)}`;
const arenaHref = isRu ? "/ru/#arena" : "/#arena";
const arenaLabel = isRu ? "Арена командиров" : "Commander Arena";
// The ranked redirect page (/play/ranked) forwards into the game app; reuse it for the "play" CTAs.
const rankedApp = links.rankedApp;
---

<section class="profile-page">
    <div class="page-shell profile-shell">
        <header class="profile-head">
            <span class="profile-head-emblem" aria-hidden="true">
                <img src="/assets/images/home/logo/hocai_logo_96.png" alt="" width="64" height="64" />
            </span>
            <div class="profile-head-copy">
                <p class="eyebrow" data-profile-eyebrow>{copy.title}</p>
                <div class="profile-name-row">
                    <h1 class="profile-name" data-profile-name>{copy.title}</h1>
                    <span class="profile-gold" data-profile-gold hidden></span>
                </div>
                <p class="profile-sub" data-profile-subtitle>{copy.subtitle}</p>
                <div class="profile-meta" data-profile-meta hidden>
                    <span class="profile-streak" data-profile-streak></span>
                    <span class="profile-presence" data-profile-presence hidden></span>
                    <span class="profile-lastseen" data-profile-lastseen></span>
                </div>
            </div>
            <a class="profile-arena-link" href={arenaHref}>← {arenaLabel}</a>
        </header>

        <p class="profile-note" data-profile-loading>{copy.loading}</p>

        <div class="profile-note profile-panel" data-profile-guest hidden>
            <h2>{copy.guestTitle}</h2>
            <p>{copy.guestBody}</p>
            <a class="profile-btn" href={loginHref}>{copy.guestCta}</a>
        </div>

        <div class="profile-note profile-panel" data-profile-error hidden>
            <h2 data-profile-error-title>{copy.errorTitle}</h2>
            <p data-profile-error-body>{copy.errorBody}</p>
            <button type="button" class="profile-btn" data-profile-retry>{copy.retry}</button>
        </div>

        <div class="profile-content" data-profile-content hidden>
            <p class="profile-summary-notice" data-profile-summary-notice hidden>{copy.publicSummaryNotice}</p>

            <div class="profile-panel profile-empty" data-profile-empty hidden>
                <h2>{copy.emptyTitle}</h2>
                <p>{copy.emptyBody}</p>
                <a class="profile-btn" href={rankedApp}>{copy.playCta}</a>
            </div>

            <div class="profile-body" data-profile-sections>
                <section class="profile-section">
                    <h2>{copy.sectionOverview}</h2>
                    <div class="stat-grid" data-profile-stats></div>
                </section>

                <section class="profile-section" data-profile-public-standing hidden>
                    <h2>{copy.sectionRankedStanding}</h2>
                    <div class="ranked-standing" data-profile-standing></div>
                </section>

                <section class="profile-section" data-profile-seasons-section hidden>
                    <h2>{copy.publicSeasonsTitle}</h2>
                    <div class="season-history" data-profile-seasons></div>
                </section>

                <div class="profile-columns" data-profile-self>
                    <section class="profile-section">
                        <h2>{copy.sectionFactions}</h2>
                        <div class="bar-list" data-profile-factions></div>
                    </section>
                    <section class="profile-section">
                        <h2>{copy.sectionCreatures}</h2>
                        <div class="bar-list" data-profile-creatures></div>
                    </section>
                </div>

                <section class="profile-section" data-profile-combos-section data-profile-self>
                    <h2>{copy.sectionCombos}</h2>
                    <div class="combo-list" data-profile-combos></div>
                </section>

                <section class="profile-section" data-profile-playstyle-section hidden>
                    <h2>{copy.publicPlaystyle}</h2>
                    <div class="playstyle" data-profile-playstyle></div>
                </section>

                <section class="profile-section">
                    <h2>{copy.sectionMatches}</h2>
                    <div class="match-list" data-profile-matches></div>
                </section>
            </div>
        </div>
    </div>

    <script type="application/json" data-profile-copy set:html={JSON.stringify(copy)}></script>
</section>

<script>
    import { isLoggedIn, onAuthStateChange } from "../lib/auth-state";
    import { fetchPlayerPortal, PortalAuthError } from "../lib/portal-client";
    import { gameClientRoot } from "../lib/ranked-arena-client";
    import {
        fetchPublicRankedProfile,
        publicRankedProfileFallbackFromSearchParams,
        type PublicRankedProfile,
        type RankedMatchReason,
        type RankedProfileMatch,
    } from "../lib/ranked-profile-client";
    import {
        creatureById,
        factionById,
        streakLabel,
        timeAgo,
        winRateColor,
        winRatePct,
    } from "../lib/portal-data";

    type Copy = Record<string, string>;
    const copyEl = document.querySelector<HTMLElement>("[data-profile-copy]");
    const copy: Copy = copyEl ? JSON.parse(copyEl.textContent || "{}") : {};

    const $ = <T extends HTMLElement = HTMLElement>(name: string): T | null =>
        document.querySelector<T>(`[data-profile-${name}]`);

    const loadingEl = $("loading");
    const guestEl = $("guest");
    const errorEl = $("error");
    const contentEl = $("content");
    const emptyEl = $("empty");
    const sectionsEl = $("sections");
    const nameEl = $("name");
    const goldEl = $("gold");
    const metaEl = $("meta");
    const streakEl = $("streak");
    const presenceEl = $("presence");
    const lastSeenEl = $("lastseen");
    const eyebrowEl = $("eyebrow");
    const subtitleEl = $("subtitle");
    const errorTitleEl = $("error-title");
    const errorBodyEl = $("error-body");
    const publicStandingEl = $("public-standing");
    const standingEl = $("standing");
    const summaryNoticeEl = $("summary-notice");
    const selfSections = [...document.querySelectorAll<HTMLElement>("[data-profile-self]")];
    const profileSearchParams = new URL(window.location.href).searchParams;
    const requestedPlayerId = profileSearchParams.get("playerId")?.trim() ?? "";
    const publicMode = profileSearchParams.has("playerId");
    const language = document.documentElement.lang.toLowerCase().startsWith("ru") ? "ru" : "en";

    const escapeHtml = (value: string): string =>
        value.replace(
            /[&<>"']/g,
            (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!,
        );

    const UNKNOWN_IMG = "/assets/images/units/units/unknown_creature_512.webp";
    const imgFallback = `onerror="this.onerror=null;this.src='${UNKNOWN_IMG}'"`;

    type State = "loading" | "guest" | "error" | "content";
    function showState(state: State): void {
        if (loadingEl) loadingEl.hidden = state !== "loading";
        if (guestEl) guestEl.hidden = state !== "guest";
        if (errorEl) errorEl.hidden = state !== "error";
        if (contentEl) contentEl.hidden = state !== "content";
    }

    const agoLabels = {
        now: copy.agoNow,
        m: copy.agoMinute,
        h: copy.agoHour,
        d: copy.agoDay,
        mo: copy.agoMonth,
        y: copy.agoYear,
    };
    const streakLabels = { win: copy.streakWin, loss: copy.streakLoss, none: copy.streakNone };

    const num = (value: unknown): number => {
        const n = typeof value === "string" ? Number(value) : (value as number);
        return Number.isFinite(n) ? n : 0;
    };
    const numberFormatter = new Intl.NumberFormat(language);

    function statCard(label: string, value: string, accent?: string): string {
        const style = accent ? ` style="color:${accent}"` : "";
        return `<div class="stat-card"><dt>${escapeHtml(label)}</dt><dd${style}>${escapeHtml(value)}</dd></div>`;
    }

    // Public playtime: "42m" under an hour, "7.5h" under ten, whole hours beyond.
    function hoursInGameLabel(secondsInGame: number): string {
        if (!secondsInGame) return "—";
        const hours = secondsInGame / 3600;
        if (hours < 1) return `${Math.max(1, Math.round(secondsInGame / 60))}m`;
        if (hours < 10) return `${hours.toFixed(1).replace(/\.0$/, "")}h`;
        return `${Math.round(hours)}h`;
    }

    // One "icon · name · win-rate bar · games" row, used for both creatures and factions.
    function barRow(image: string, name: string, wins: number, games: number): string {
        const pct = winRatePct(wins, games);
        const color = winRateColor(pct);
        return `
            <div class="bar-row">
                <img class="bar-icon" src="${image}" alt="" width="34" height="34" loading="lazy" ${imgFallback} />
                <span class="bar-name">${escapeHtml(name)}</span>
                <span class="bar-track"><span class="bar-fill" style="width:${pct}%;background:${color}"></span></span>
                <span class="bar-pct" style="color:${color}">${pct}%</span>
                <span class="bar-games">${games} ${escapeHtml(copy.gamesLabel)}</span>
            </div>`;
    }

    function creatureRow(id: number, wins: number, games: number): string {
        const c = creatureById(id);
        return barRow(c.image, c.name, wins, games);
    }

    function comboRow(creatureIds: number[], wins: number, games: number): string {
        const pct = winRatePct(wins, games);
        const color = winRateColor(pct);
        const icons = creatureIds
            .map((id) => {
                const c = creatureById(id);
                return `<img class="combo-icon" src="${c.image}" alt="${escapeHtml(c.name)}" title="${escapeHtml(
                    c.name,
                )}" width="30" height="30" loading="lazy" ${imgFallback} />`;
            })
            .join("");
        return `
            <div class="combo-row">
                <span class="combo-icons">${icons}</span>
                <span class="combo-games">${games} ${escapeHtml(copy.gamesLabel)}</span>
                <span class="bar-track"><span class="bar-fill" style="width:${pct}%;background:${color}"></span></span>
                <span class="bar-pct" style="color:${color}">${pct}%</span>
            </div>`;
    }

    function matchRow(match: any): string {
        const won = !!match.won;
        const abandoned = !!match.abandoned;
        const resultLabel = abandoned ? copy.resultAbandoned : won ? copy.resultWin : copy.resultLoss;
        const resultClass = won ? "win" : "loss";
        const icons = (match.creature_ids ?? [])
            .map((id: number) => {
                const c = creatureById(id);
                return `<img class="match-icon" src="${c.image}" alt="${escapeHtml(c.name)}" title="${escapeHtml(
                    c.name,
                )}" width="26" height="26" loading="lazy" ${imgFallback} />`;
            })
            .join("");
        const opponent = escapeHtml(match.opponent_username || "—");
        const when = timeAgo(num(match.finished_time), agoLabels);
        const replay = match.game_id
            ? `<a class="match-replay" href="${escapeHtml(`${gameClientRoot}/game/${encodeURIComponent(String(match.game_id))}/replay`)}">▶ ${escapeHtml(copy.matchReplay)}</a>`
            : "";
        return `
            <div class="match-row">
                <span class="match-result ${resultClass}">${escapeHtml(resultLabel)}</span>
                <span class="match-icons">${icons}</span>
                <span class="match-vs">${escapeHtml(copy.versus)} <strong>${opponent}</strong></span>
                <span class="match-when">${escapeHtml(when)}</span>
                ${replay}
            </div>`;
    }

    function leagueLabel(league: number): string {
        if (!league) return copy.publicUnranked;
        if (language === "ru") return `${league}-я ${copy.publicLeague.toLowerCase()}`;
        const mod100 = league % 100;
        const suffix = mod100 >= 11 && mod100 <= 13 ? "th" : league % 10 === 1 ? "st" : league % 10 === 2 ? "nd" : league % 10 === 3 ? "rd" : "th";
        return `${league}${suffix} ${copy.publicLeague}`;
    }

    function publicStateLabel(state: PublicRankedProfile["state"]): string {
        if (state === "placed") return copy.publicStatePlaced;
        if (state === "recalibration") return copy.publicStateRecalibration;
        return copy.publicStateCalibration;
    }

    function publicReasonLabel(reason: RankedMatchReason): string {
        if (reason === "concede") return copy.publicReasonConcede;
        if (reason === "disconnect") return copy.publicReasonDisconnect;
        if (reason === "double_disconnect") return copy.publicReasonDoubleDisconnect;
        if (reason === "cancel") return copy.publicReasonCancel;
        return copy.publicReasonNormal;
    }

    function opponentProfileHref(playerId: string, username: string): string {
        const params = new URLSearchParams({ playerId, username });
        return `${window.location.pathname}?${params.toString()}`;
    }

    function publicMatchRow(match: RankedProfileMatch): string {
        const resultLabel =
            match.result === "win" ? copy.resultWin : match.result === "loss" ? copy.resultLoss : copy.resultDraw;
        const opponent = match.opponent
            ? `<a class="match-opponent" href="${escapeHtml(opponentProfileHref(match.opponent.playerId, match.opponent.username))}">${escapeHtml(match.opponent.username)}</a>`
            : "<strong>—</strong>";
        const when = timeAgo(match.finishedTime, agoLabels);
        const delta = match.calibration
            ? copy.publicCalibrationGame
            : `${match.mmrDelta > 0 ? "+" : ""}${numberFormatter.format(match.mmrDelta)} MMR`;
        const deltaClass = match.calibration ? "" : match.mmrDelta > 0 ? "positive" : match.mmrDelta < 0 ? "negative" : "";
        const replay = match.gameId
            ? `<a class="match-replay" href="${escapeHtml(`${gameClientRoot}/game/${encodeURIComponent(match.gameId)}/replay`)}">▶ ${escapeHtml(copy.matchReplay)}</a>`
            : "";
        return `
            <div class="match-row match-row--ranked">
                <span class="match-result ${match.result}">${escapeHtml(resultLabel)}</span>
                <span class="match-vs">${escapeHtml(copy.versus)} ${opponent}</span>
                <span class="match-reason">${escapeHtml(publicReasonLabel(match.reason))}</span>
                <span class="match-delta ${deltaClass}">${escapeHtml(delta)}</span>
                <span class="match-gold">${match.goldEarned > 0 ? `+${match.goldEarned} 🪙` : ""}</span>
                <span class="match-when">${escapeHtml(when)}</span>
                ${replay}
            </div>`;
    }

    function configureSelfMode(): void {
        if (eyebrowEl) eyebrowEl.textContent = copy.title;
        if (subtitleEl) subtitleEl.textContent = copy.subtitle;
        if (loadingEl) loadingEl.textContent = copy.loading;
        if (errorTitleEl) errorTitleEl.textContent = copy.errorTitle;
        if (errorBodyEl) errorBodyEl.textContent = copy.errorBody;
        if (publicStandingEl) publicStandingEl.hidden = true;
        if (summaryNoticeEl) summaryNoticeEl.hidden = true;
        for (const section of selfSections) section.hidden = false;
    }

    function configurePublicMode(): void {
        if (eyebrowEl) eyebrowEl.textContent = copy.publicEyebrow;
        if (subtitleEl) subtitleEl.textContent = copy.publicSubtitle;
        if (loadingEl) loadingEl.textContent = copy.publicLoading;
        if (errorTitleEl) errorTitleEl.textContent = copy.publicErrorTitle;
        if (errorBodyEl) errorBodyEl.textContent = copy.publicErrorBody;
        if (publicStandingEl) publicStandingEl.hidden = false;
        for (const section of selfSections) section.hidden = true;
    }

    function renderPublicProfile(profile: PublicRankedProfile, summaryOnly = false): void {
        configurePublicMode();
        const placed = profile.state === "placed";
        const currentStreak = profile.winStreak > 0 ? profile.winStreak : profile.lossStreak > 0 ? -profile.lossStreak : 0;
        const rating = placed ? numberFormatter.format(profile.mmr) : copy.publicRatingHidden;
        const rank = placed && profile.leaderboardRank ? `#${numberFormatter.format(profile.leaderboardRank)}` : copy.publicUnranked;

        if (nameEl) nameEl.textContent = profile.username;
        if (goldEl) {
            goldEl.textContent = `${numberFormatter.format(profile.gold)} 🪙`;
            goldEl.hidden = false;
        }
        document.title = `${profile.username} · Heroes of Crypto`;
        if (metaEl) metaEl.hidden = false;
        if (streakEl) streakEl.textContent = streakLabel(currentStreak, streakLabels);
        if (presenceEl) {
            // Live presence: green "Online" while the player has an active session; otherwise how
            // long ago they were last seen (independent of when their last ranked battle was).
            if (profile.online) {
                presenceEl.hidden = false;
                presenceEl.dataset.online = "true";
                presenceEl.textContent = copy.publicOnlineNow;
            } else {
                const seen = timeAgo(profile.lastOnlineAt, agoLabels);
                presenceEl.hidden = !seen;
                delete presenceEl.dataset.online;
                presenceEl.textContent = seen ? `${copy.publicLastSeen} ${seen}` : "";
            }
        }
        if (lastSeenEl) {
            const ago = timeAgo(profile.lastRankedGameAt, agoLabels);
            lastSeenEl.textContent = ago ? `${copy.publicLastBattle} ${ago}` : "";
        }
        if (emptyEl) emptyEl.hidden = true;
        if (sectionsEl) sectionsEl.hidden = false;
        if (summaryNoticeEl) summaryNoticeEl.hidden = !summaryOnly;

        const statsEl = $("stats");
        if (statsEl) {
            statsEl.innerHTML = [
                statCard(copy.statRating, rating, placed ? "#f2c75d" : undefined),
                statCard(copy.statLeaderboardRank, rank),
                statCard(copy.statRecord, `${profile.wins}–${profile.losses}–${profile.draws}`),
                statCard(copy.statWinRate, profile.totalGames ? `${profile.winRatePct.toFixed(1).replace(/\.0$/, "")}%` : "—", winRateColor(profile.winRatePct)),
                statCard(copy.statPeakRating, profile.peakMmr ? numberFormatter.format(profile.peakMmr) : "—"),
                statCard(copy.statGames, numberFormatter.format(profile.totalGames)),
                statCard(copy.statHoursInGame, hoursInGameLabel(profile.secondsInGame)),
                // Gold moved to the header (large, right after the nickname); no duplicate stat card here.
            ].join("");
        }

        if (standingEl) {
            const progress = `${Math.min(profile.calibration.gamesPlayed, profile.calibration.required)} / ${profile.calibration.required}`;
            const previous = profile.previous
                ? `${leagueLabel(profile.previous.league)} · ${numberFormatter.format(profile.previous.mmr)} MMR`
                : copy.publicUnranked;
            const seasonLine = profile.season
                ? `<small class="ranked-standing__season">${escapeHtml(profile.season.name)}</small>`
                : "";
            standingEl.innerHTML = `
                <div class="ranked-standing__banner" data-state="${escapeHtml(profile.state)}">
                    <span class="ranked-standing__state">${escapeHtml(publicStateLabel(profile.state))}</span>
                    <strong>${escapeHtml(placed ? leagueLabel(profile.league) : `${publicStateLabel(profile.state)} ${progress}`)}</strong>
                    <small>${escapeHtml(placed ? `${numberFormatter.format(profile.mmr)} MMR` : copy.publicRatingHidden)}</small>
                    ${seasonLine}
                </div>
                <dl class="ranked-standing__facts">
                    <div><dt>${escapeHtml(copy.publicLeague)}</dt><dd>${escapeHtml(placed ? leagueLabel(profile.league) : `${publicStateLabel(profile.state)} ${progress}`)}</dd></div>
                    <div><dt>${escapeHtml(copy.statCurrentStreak)}</dt><dd>${escapeHtml(streakLabel(currentStreak, streakLabels))}</dd></div>
                    <div><dt>${escapeHtml(copy.publicDisconnectRecord)}</dt><dd>${profile.dcWins}–${profile.dcLosses}</dd></div>
                    ${profile.state === "recalibration" ? `<div class="ranked-standing__previous"><dt>${escapeHtml(copy.publicPreviousStanding)}</dt><dd>${escapeHtml(previous)}</dd></div>` : ""}
                </dl>`;
        }

        // Previous seasons: the archived final standings (MMR resets each season; this is where the
        // old numbers live on). Hidden until the player has at least one finished season behind them.
        const seasonsSection = document.querySelector<HTMLElement>("[data-profile-seasons-section]");
        const seasonsEl = $("seasons");
        if (seasonsSection && seasonsEl) {
            const history = summaryOnly ? [] : profile.seasonHistory;
            seasonsSection.hidden = history.length === 0;
            seasonsEl.innerHTML = history
                .map((entry) => {
                    const rank = entry.leaderboardRank ? ` · #${entry.leaderboardRank}` : "";
                    const standing = entry.league > 0 ? `${leagueLabel(entry.league)}${rank}` : copy.publicUnranked;
                    const mmr = entry.mmr ? `${numberFormatter.format(entry.mmr)} MMR` : "—";
                    const rate = entry.totalGames
                        ? `${entry.winRatePct.toFixed(1).replace(/\.0$/, "")}%`
                        : "—";
                    return `
                        <div class="season-row">
                            <span class="season-name">${escapeHtml(entry.seasonName)}</span>
                            <span class="season-standing">${escapeHtml(standing)}</span>
                            <span class="season-mmr">${escapeHtml(mmr)}</span>
                            <span class="season-gold">${numberFormatter.format(entry.gold)} 🪙</span>
                            <span class="season-record">${entry.wins}–${entry.losses}–${entry.draws}</span>
                            <span class="season-rate">${escapeHtml(rate)}</span>
                            <span class="season-games">${entry.totalGames} ${escapeHtml(copy.gamesLabel)}</span>
                        </div>`;
                })
                .join("");
        }

        const matchesEl = $("matches");
        if (matchesEl) {
            matchesEl.innerHTML = summaryOnly
                ? `<p class="profile-empty-message">${escapeHtml(copy.publicDetailsUnavailable)}</p>`
                : profile.recentGames.length
                ? profile.recentGames.map(publicMatchRow).join("")
                : `<p class="profile-empty-message">${escapeHtml(copy.publicNoMatches)}</p>`;
        }

        // Winning strategies: what this player fields and what wins for them (from recorded games).
        const playstyleSection = document.querySelector<HTMLElement>("[data-profile-playstyle-section]");
        const playstyleEl = $("playstyle");
        const style = profile.playstyle;
        if (playstyleSection && playstyleEl) {
            const chip = (label: string, winRate: number, games: number): string => {
                const trend = winRate >= 55 ? "strong" : winRate <= 45 ? "weak" : "even";
                return `<span class="playstyle-chip" data-trend="${trend}"><b>${escapeHtml(label)}</b> ${winRate
                    .toFixed(1)
                    .replace(/\.0$/, "")}% · ${games} ${escapeHtml(copy.publicPlaystyleGames)}</span>`;
            };
            const group = (title: string, chips: string[]): string =>
                chips.length
                    ? `<div class="playstyle-group"><h3>${escapeHtml(title)}</h3><div class="playstyle-chips">${chips.join("")}</div></div>`
                    : "";
            const hasData = !summaryOnly && style && style.games > 0;
            playstyleSection.hidden = !hasData && !style;
            playstyleEl.innerHTML = hasData
                ? [
                      group(copy.publicPlaystyleCreatures, style.topCreatures.map((c) => chip(c.name, c.winRatePct, c.games))),
                      group(copy.publicPlaystylePairs, style.topPairs.map((c) => chip(c.names.join(" + "), c.winRatePct, c.games))),
                      group(copy.publicPlaystyleTriples, style.topTriples.map((c) => chip(c.names.join(" + "), c.winRatePct, c.games))),
                      group(
                          copy.publicPlaystyleArtifacts,
                          [...style.artifactsTier1, ...style.artifactsTier2].map((a) =>
                              chip(`T${a.tier} ${a.name}`, a.winRatePct, a.games),
                          ),
                      ),
                  ].join("") || `<p class="profile-empty-message">${escapeHtml(copy.publicPlaystyleEmpty)}</p>`
                : `<p class="profile-empty-message">${escapeHtml(copy.publicPlaystyleEmpty)}</p>`;
        }
        showState("content");
    }

    function render(portal: any): void {
        configureSelfMode();
        const wins = num(portal.wins);
        const losses = num(portal.losses);
        const games = num(portal.total_games_played);
        const winRate = winRatePct(wins, games);

        if (nameEl) nameEl.textContent = portal.username || copy.title;
        // The portal payload has no gold field; keep the header badge hidden for this render path.
        if (goldEl) goldEl.hidden = true;

        const currentStreak = num(portal.current_streak);
        if (metaEl) metaEl.hidden = false;
        if (streakEl) streakEl.textContent = streakLabel(currentStreak, streakLabels);
        const lastLogin = num(portal.last_login);
        if (lastSeenEl) {
            const ago = timeAgo(lastLogin, agoLabels);
            lastSeenEl.textContent = ago ? `${copy.lastLoginPrefix} ${ago}` : "";
        }

        const matches = (portal.recent_matches ?? []) as any[];
        const creatures = (portal.creature_stats ?? []) as any[];
        const factions = (portal.faction_stats ?? []) as any[];
        const combos = (portal.combos ?? []) as any[];

        const noData = games <= 0 && matches.length === 0 && creatures.length === 0;
        if (emptyEl) emptyEl.hidden = !noData;
        if (sectionsEl) sectionsEl.hidden = noData;

        const statsEl = $("stats");
        if (statsEl) {
            statsEl.innerHTML = [
                statCard(copy.statWins, String(wins), "#46d160"),
                statCard(copy.statLosses, String(losses), "#ff5a5a"),
                statCard(copy.statWinRate, `${winRate}%`, winRateColor(winRate)),
                statCard(copy.statGames, String(games)),
                statCard(copy.statCurrentStreak, streakLabel(currentStreak, streakLabels)),
                statCard(copy.statBestStreak, streakLabel(num(portal.best_win_streak), streakLabels)),
            ].join("");
        }

        const factionsEl = $("factions");
        if (factionsEl) {
            factionsEl.innerHTML = factions
                .slice()
                .sort((a, b) => num(b.games) - num(a.games))
                .map((f) => {
                    const info = factionById(num(f.faction));
                    return barRow(info.image, info.name, num(f.wins), num(f.games));
                })
                .join("");
        }

        const creaturesEl = $("creatures");
        if (creaturesEl) {
            creaturesEl.innerHTML = creatures
                .slice()
                .sort((a, b) => num(b.games) - num(a.games))
                .slice(0, 14)
                .map((c) => creatureRow(num(c.creature_id), num(c.wins), num(c.games)))
                .join("");
        }

        const combosEl = $("combos");
        const combosSection = $("combos-section");
        if (combosEl) {
            combosEl.innerHTML = combos
                .map((c) => comboRow((c.creature_ids ?? []).map(num), num(c.wins), num(c.games)))
                .join("");
            if (combosSection) combosSection.hidden = combos.length === 0;
        }

        const matchesEl = $("matches");
        if (matchesEl) {
            matchesEl.innerHTML = matches.map((m) => matchRow(m)).join("");
        }

        showState("content");
    }

    async function load(): Promise<void> {
        if (publicMode) {
            configurePublicMode();
            showState("loading");
            try {
                renderPublicProfile(await fetchPublicRankedProfile(requestedPlayerId));
            } catch {
                const fallback = publicRankedProfileFallbackFromSearchParams(profileSearchParams);
                if (fallback) renderPublicProfile(fallback, true);
                else showState("error");
            }
            return;
        }
        configureSelfMode();
        if (!isLoggedIn()) {
            showState("guest");
            return;
        }
        showState("loading");
        try {
            render(await fetchPlayerPortal());
        } catch (error) {
            showState(error instanceof PortalAuthError ? "guest" : "error");
        }
    }

    $("retry")?.addEventListener("click", () => void load());
    // React to login/logout happening in another tab or via the header while this page is open.
    if (publicMode) void load();
    else onAuthStateChange(() => void load());
</script>

