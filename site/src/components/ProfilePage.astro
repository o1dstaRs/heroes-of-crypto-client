---
import { content, links, type Language } from "../lib/site-data";

interface Props {
    lang: Language;
}

const { lang } = Astro.props;
const copy = content[lang].profile;
const isRu = lang === "ru";
const profilePath = isRu ? "/ru/profile/" : "/profile/";
const loginHref = `${isRu ? "/ru" : ""}/auth/login/?redirect=${encodeURIComponent(profilePath)}`;
const arenaHref = isRu ? "/ru/#arena" : "/#arena";
const arenaLabel = isRu ? "Арена командиров" : "Commander Arena";
// The ranked redirect page (/play/ranked) forwards into the game app; reuse it for the "play" CTAs.
const rankedApp = links.rankedApp;
---

<section class="profile-page">
    <div class="page-shell profile-shell">
        <header class="profile-head">
            <span class="profile-head-emblem" aria-hidden="true">
                <img src="/assets/images/home/logo/hocai_logo_96.png" alt="" width="64" height="64" />
            </span>
            <div class="profile-head-copy">
                <p class="eyebrow" data-profile-eyebrow>{copy.title}</p>
                <div class="profile-name-row">
                    <h1 class="profile-name" data-profile-name>{copy.title}</h1>
                    <span class="profile-gold" data-profile-gold hidden></span>
                </div>
                <p class="profile-sub" data-profile-subtitle>{copy.subtitle}</p>
                <div class="profile-meta" data-profile-meta hidden>
                    <span class="profile-presence" data-profile-presence hidden></span>
                    <span class="profile-lastseen" data-profile-lastseen></span>
                </div>
            </div>
            <a class="profile-arena-link" href={arenaHref}>← {arenaLabel}</a>
        </header>

        <p class="profile-note" data-profile-loading>{copy.loading}</p>

        <div class="profile-note profile-panel" data-profile-guest hidden>
            <h2>{copy.guestTitle}</h2>
            <p>{copy.guestBody}</p>
            <a class="profile-btn" href={loginHref}>{copy.guestCta}</a>
        </div>

        <div class="profile-note profile-panel" data-profile-error hidden>
            <h2 data-profile-error-title>{copy.errorTitle}</h2>
            <p data-profile-error-body>{copy.errorBody}</p>
            <button type="button" class="profile-btn" data-profile-retry>{copy.retry}</button>
        </div>

        <div class="profile-content" data-profile-content hidden>
            <p class="profile-summary-notice" data-profile-summary-notice hidden>{copy.publicSummaryNotice}</p>

            <div class="profile-panel profile-empty" data-profile-empty hidden>
                <h2>{copy.emptyTitle}</h2>
                <p>{copy.emptyBody}</p>
                <a class="profile-btn" href={rankedApp}>{copy.playCta}</a>
            </div>

            <div class="profile-body" data-profile-sections>
                <section class="profile-section">
                    <h2>{copy.sectionOverview}</h2>
                    <dl class="stat-grid" data-profile-stats></dl>
                </section>

                <section class="profile-section" data-profile-public-standing hidden>
                    <h2>{copy.sectionRankedStanding}</h2>
                    <div class="ranked-standing" data-profile-standing></div>
                </section>

                <section class="profile-section" data-profile-seasons-section hidden>
                    <h2>{copy.publicSeasonsTitle}</h2>
                    <div class="season-history" data-profile-seasons></div>
                </section>

                <section class="profile-section profile-section--predictions" data-profile-predictions-section hidden>
                    <details class="prediction-panel" data-profile-predictions-panel>
                        <summary class="prediction-panel__summary">
                            <span class="prediction-panel__heading" role="heading" aria-level="2">{copy.publicPredictionsTitle}</span>
                            <span class="prediction-panel__metrics" data-profile-prediction-summary></span>
                            <span class="prediction-panel__chevron" aria-hidden="true"></span>
                        </summary>
                        <div class="prediction-panel__body">
                            <div
                                class="prediction-history"
                                id="profile-prediction-history"
                                data-profile-predictions></div>
                            <button
                                type="button"
                                class="matches-more prediction-panel__more"
                                data-profile-predictions-more
                                aria-controls="profile-prediction-history"
                                hidden>{copy.predictionsShowMore}</button
                            >
                        </div>
                    </details>
                </section>

                <section class="profile-section profile-section--predictions" data-profile-wagers-section hidden>
                    <details class="prediction-panel" data-profile-wagers-panel>
                        <summary class="prediction-panel__summary">
                            <span class="prediction-panel__heading" role="heading" aria-level="2">{copy.publicWagersTitle}</span>
                            <span class="prediction-panel__metrics" data-profile-wager-summary></span>
                            <span class="prediction-panel__chevron" aria-hidden="true"></span>
                        </summary>
                        <div class="prediction-panel__body">
                            <div
                                class="prediction-history"
                                id="profile-wager-history"
                                data-profile-wagers></div>
                            <button
                                type="button"
                                class="matches-more prediction-panel__more"
                                data-profile-wagers-more
                                aria-controls="profile-wager-history"
                                hidden>{copy.predictionsShowMore}</button
                            >
                        </div>
                    </details>
                </section>

                <section class="profile-section profile-section--predictions" data-profile-gold-section hidden>
                    <details class="prediction-panel" data-profile-gold-panel>
                        <summary class="prediction-panel__summary">
                            <span class="prediction-panel__heading" role="heading" aria-level="2">{copy.goldHistoryTitle}</span>
                            <span class="prediction-panel__metrics" data-profile-gold-summary></span>
                            <span class="prediction-panel__chevron" aria-hidden="true"></span>
                        </summary>
                        <div class="prediction-panel__body">
                            <div class="prediction-history" data-profile-gold-history></div>
                        </div>
                    </details>
                </section>

                <section class="profile-section" data-profile-self>
                    <h2>{copy.sectionCreatures}</h2>
                    <div class="bar-list" data-profile-creatures></div>
                </section>

                <section class="profile-section" data-profile-combos-section data-profile-self>
                    <h2>{copy.sectionCombos}</h2>
                    <div class="combo-list" data-profile-combos></div>
                </section>

                <section class="profile-section" data-profile-playstyle-section hidden>
                    <h2>{copy.publicPlaystyle}</h2>
                    <div class="playstyle" data-profile-playstyle></div>
                </section>

                <section class="profile-section">
                    <h2>{copy.sectionMatches}</h2>
                    <div class="match-list" id="profile-match-list" data-profile-matches></div>
                    <button
                        type="button"
                        class="matches-more"
                        data-profile-matches-more
                        aria-controls="profile-match-list"
                        hidden>{copy.matchesShowMore}</button
                    >
                </section>
            </div>
        </div>
    </div>

    <script type="application/json" data-profile-copy set:html={JSON.stringify(copy)}></script>
</section>

<script>
    import {
        TIER1_ARTIFACTS,
        TIER2_ARTIFACTS,
        type ArtifactProperties,
        type Tier1Artifact,
        type Tier2Artifact,
    } from "@heroesofcrypto/common/src/artifacts/artifact_properties";
    import { getPerkProperties, type Perk } from "@heroesofcrypto/common/src/perks/perk_properties";

    import { isLoggedIn, onAuthStateChange } from "../lib/auth-state";
    import { artifacts } from "../lib/artifacts-data";
    import { fetchPlayerPortal, PortalAuthError } from "../lib/portal-client";
    import { gameClientRoot } from "../lib/ranked-arena-client";
    import { rankedArenaCopy } from "../lib/ranked-arena-copy";
    import { TOP_WEALTH } from "../lib/ranked-arena-data";
    import { leagueEmblemPath } from "../lib/league-emblems";
    import {
        buildRankedMatchPagePath,
        fetchPublicRankedMatch,
        type PublicRankedMatch,
        type RankedMatchSide,
        type RankedMatchTeamSetup,
        type RankedMatchUnitPerformance,
    } from "../lib/ranked-match-client";
    import {
        fetchPublicRankedProfile,
        publicRankedProfileFallbackFromSearchParams,
        rankedExitRatePct,
        type PlaystyleArtifact,
        type PlaystyleAugment,
        type PublicRankedProfile,
        type RankedMatchReason,
        type RankedMatchResult,
        type RankedProfileMatch,
    } from "../lib/ranked-profile-client";
    import { creatureById, timeAgo, winRateColor, winRatePct } from "../lib/portal-data";
    import {
        fetchSeasonCurrencyCatalog,
        LEGACY_SEASON_CURRENCY,
        seasonCurrencyForTimestamp,
        seasonCurrencyIconUrl,
        type SeasonCurrency,
        type SeasonCurrencyCatalog,
    } from "../lib/season-currency";

    type Copy = Record<string, string>;
    const copyEl = document.querySelector<HTMLElement>("[data-profile-copy]");
    const copy: Copy = copyEl ? JSON.parse(copyEl.textContent || "{}") : {};

    const $ = <T extends HTMLElement = HTMLElement>(name: string): T | null =>
        document.querySelector<T>(`[data-profile-${name}]`);

    const loadingEl = $("loading");
    const guestEl = $("guest");
    const errorEl = $("error");
    const contentEl = $("content");
    const emptyEl = $("empty");
    const sectionsEl = $("sections");
    const nameEl = $("name");
    const goldEl = $("gold");
    const metaEl = $("meta");
    const presenceEl = $("presence");
    const lastSeenEl = $("lastseen");
    const eyebrowEl = $("eyebrow");
    const subtitleEl = $("subtitle");
    const errorTitleEl = $("error-title");
    const errorBodyEl = $("error-body");
    const publicStandingEl = $("public-standing");
    const standingEl = $("standing");
    const summaryNoticeEl = $("summary-notice");
    const matchesEl = $("matches");
    const matchesMoreEl = $<HTMLButtonElement>("matches-more");
    const predictionsPanelEl = $<HTMLDetailsElement>("predictions-panel");
    const predictionsEl = $("predictions");
    const predictionsMoreEl = $<HTMLButtonElement>("predictions-more");
    const wagersEl = $("wagers");
    const wagersMoreEl = $<HTMLButtonElement>("wagers-more");
    const selfSections = [...document.querySelectorAll<HTMLElement>("[data-profile-self]")];
    const profileSearchParams = new URL(window.location.href).searchParams;
    const requestedPlayerId = profileSearchParams.get("playerId")?.trim() ?? "";
    const publicMode = profileSearchParams.has("playerId");
    const language = document.documentElement.lang.toLowerCase().startsWith("ru") ? "ru" : "en";
    // League + wealth names live with the arena copy so every surface names a standing identically.
    const standingCopy = rankedArenaCopy[language];

    const escapeHtml = (value: string): string =>
        value.replace(
            /[&<>"']/g,
            (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!,
        );

    const UNKNOWN_IMG = "/assets/images/units/units/unknown_creature_512.webp";
    const imgFallback = `onerror="this.onerror=null;this.src='${UNKNOWN_IMG}'"`;

    type State = "loading" | "guest" | "error" | "content";
    function showState(state: State): void {
        if (loadingEl) loadingEl.hidden = state !== "loading";
        if (guestEl) guestEl.hidden = state !== "guest";
        if (errorEl) errorEl.hidden = state !== "error";
        if (contentEl) contentEl.hidden = state !== "content";
    }

    const agoLabels = {
        now: copy.agoNow,
        m: copy.agoMinute,
        h: copy.agoHour,
        d: copy.agoDay,
        mo: copy.agoMonth,
        y: copy.agoYear,
    };
    const num = (value: unknown): number => {
        const n = typeof value === "string" ? Number(value) : (value as number);
        return Number.isFinite(n) ? n : 0;
    };
    const numberFormatter = new Intl.NumberFormat(language);
    const exitRateLabel = language === "ru" ? "Отключения / выходы" : "Disconnect / exit rate";
    const exitRateTitle =
        language === "ru"
            ? "Доля рейтинговых боёв, завершённых игроком через выход из боя или длительное отключение."
            : "Ranked battles this player ended by exiting the fight or remaining disconnected.";
    const MATCH_PAGE_SIZE = 10;
    const PREDICTION_PAGE_SIZE = 5;
    let matchHistoryRows: unknown[] = [];
    let matchHistoryRenderer: (match: unknown) => string = () => "";
    let visibleMatchCount = 0;
    const matchHistoryById = new Map<string, unknown>();
    const publicMatchDetails = new Map<string, PublicRankedMatch>();
    let expandedMatchId = "";
    let predictionHistoryRows: string[] = [];
    let visiblePredictionCount = 0;
    let currentCurrency: SeasonCurrency = LEGACY_SEASON_CURRENCY;
    let selfSeasonCatalog: SeasonCurrencyCatalog | null = null;

    const matchGameId = (match: unknown): string => {
        if (!match || typeof match !== "object") return "";
        const row = match as Record<string, unknown>;
        const value = row.gameId ?? row.game_id;
        return typeof value === "string" ? value : "";
    };

    function updateMatchesMoreButton(): void {
        if (matchesMoreEl) matchesMoreEl.hidden = visibleMatchCount >= matchHistoryRows.length;
    }

    function renderMatchHistory<T>(matches: T[], renderRow: (match: T) => string, emptyMarkup: string): void {
        matchHistoryRows = matches;
        matchHistoryRenderer = (match) => renderRow(match as T);
        matchHistoryById.clear();
        for (const match of matches) {
            const gameId = matchGameId(match);
            if (gameId) matchHistoryById.set(gameId, match);
        }
        expandedMatchId = "";
        visibleMatchCount = Math.min(MATCH_PAGE_SIZE, matches.length);
        if (matchesEl) {
            matchesEl.innerHTML = matches.length
                ? matches.slice(0, visibleMatchCount).map(renderRow).join("")
                : emptyMarkup;
        }
        updateMatchesMoreButton();
    }

    matchesMoreEl?.addEventListener("click", () => {
        if (!matchesEl) return;
        const nextCount = Math.min(visibleMatchCount + MATCH_PAGE_SIZE, matchHistoryRows.length);
        const nextRows = matchHistoryRows.slice(visibleMatchCount, nextCount).map(matchHistoryRenderer).join("");
        matchesEl.insertAdjacentHTML("beforeend", nextRows);
        visibleMatchCount = nextCount;
        updateMatchesMoreButton();
    });

    function updatePredictionsMoreButton(): void {
        if (predictionsMoreEl) predictionsMoreEl.hidden = visiblePredictionCount >= predictionHistoryRows.length;
    }

    function renderPredictionHistory(rows: string[], emptyMarkup: string): void {
        predictionHistoryRows = rows;
        visiblePredictionCount = Math.min(PREDICTION_PAGE_SIZE, rows.length);
        if (predictionsEl) {
            predictionsEl.innerHTML = rows.length ? rows.slice(0, visiblePredictionCount).join("") : emptyMarkup;
        }
        updatePredictionsMoreButton();
    }

    predictionsMoreEl?.addEventListener("click", () => {
        if (!predictionsEl) return;
        const nextCount = Math.min(visiblePredictionCount + PREDICTION_PAGE_SIZE, predictionHistoryRows.length);
        predictionsEl.insertAdjacentHTML(
            "beforeend",
            predictionHistoryRows.slice(visiblePredictionCount, nextCount).join(""),
        );
        visiblePredictionCount = nextCount;
        updatePredictionsMoreButton();
    });

    let wagerHistoryRows: string[] = [];
    let visibleWagerCount = 0;

    function updateWagersMoreButton(): void {
        if (wagersMoreEl) wagersMoreEl.hidden = visibleWagerCount >= wagerHistoryRows.length;
    }

    function renderWagerHistory(rows: string[], emptyMarkup: string): void {
        wagerHistoryRows = rows;
        visibleWagerCount = Math.min(PREDICTION_PAGE_SIZE, rows.length);
        if (wagersEl) {
            wagersEl.innerHTML = rows.length ? rows.slice(0, visibleWagerCount).join("") : emptyMarkup;
        }
        updateWagersMoreButton();
    }

    wagersMoreEl?.addEventListener("click", () => {
        if (!wagersEl) return;
        const nextCount = Math.min(visibleWagerCount + PREDICTION_PAGE_SIZE, wagerHistoryRows.length);
        wagersEl.insertAdjacentHTML("beforeend", wagerHistoryRows.slice(visibleWagerCount, nextCount).join(""));
        visibleWagerCount = nextCount;
        updateWagersMoreButton();
    });

    function currencyMarkup(
        value: number,
        prefix = "",
        currency: SeasonCurrency = currentCurrency,
        allowNegative = false,
    ): string {
        const normalizedValue = allowNegative ? Math.trunc(value) : Math.max(0, Math.trunc(value));
        const amount = `${prefix}${numberFormatter.format(normalizedValue)}`;
        const iconUrl = seasonCurrencyIconUrl(currency);
        return `<span class="currency-amount" aria-label="${escapeHtml(`${currency.name}: ${amount}`)}"><img class="currency-icon" src="${escapeHtml(iconUrl)}" alt="" aria-hidden="true" width="20" height="20" /><span>${escapeHtml(amount)}</span></span>`;
    }

    function portalMatchCurrency(match: Record<string, unknown>): SeasonCurrency {
        const finishedTime = num(match.finished_time ?? match.finishedTime);
        return finishedTime
            ? seasonCurrencyForTimestamp(selfSeasonCatalog, finishedTime)
            : currentCurrency;
    }

    function statCard(label: string, value: string, accent?: string): string {
        const style = accent ? ` style="color:${accent}"` : "";
        return `<div class="stat-card"><dt>${escapeHtml(label)}</dt><dd${style}>${escapeHtml(value)}</dd></div>`;
    }

    // Public playtime: "42m" under an hour, "7.5h" under ten, whole hours beyond.
    function hoursInGameLabel(secondsInGame: number): string {
        if (!secondsInGame) return "—";
        const hours = secondsInGame / 3600;
        if (hours < 1) return `${Math.max(1, Math.round(secondsInGame / 60))}m`;
        if (hours < 10) return `${hours.toFixed(1).replace(/\.0$/, "")}h`;
        return `${Math.round(hours)}h`;
    }

    // One "icon · name · win-rate bar · games" row, used for both creatures and factions.
    function barRow(image: string, name: string, wins: number, games: number): string {
        const pct = winRatePct(wins, games);
        const color = winRateColor(pct);
        return `
            <div class="bar-row">
                <img class="bar-icon" src="${image}" alt="" width="34" height="34" loading="lazy" ${imgFallback} />
                <span class="bar-name">${escapeHtml(name)}</span>
                <span class="bar-track"><span class="bar-fill" style="width:${pct}%;background:${color}"></span></span>
                <span class="bar-pct" style="color:${color}">${pct}%</span>
                <span class="bar-games">${games} ${escapeHtml(copy.gamesLabel)}</span>
            </div>`;
    }

    function creatureRow(id: number, wins: number, games: number): string {
        const c = creatureById(id);
        return barRow(c.image, c.name, wins, games);
    }

    function comboRow(creatureIds: number[], wins: number, games: number): string {
        const pct = winRatePct(wins, games);
        const color = winRateColor(pct);
        const icons = creatureIds
            .map((id) => {
                const c = creatureById(id);
                return `<img class="combo-icon" src="${c.image}" alt="${escapeHtml(c.name)}" title="${escapeHtml(
                    c.name,
                )}" width="30" height="30" loading="lazy" ${imgFallback} />`;
            })
            .join("");
        return `
            <div class="combo-row">
                <span class="combo-icons">${icons}</span>
                <span class="combo-games">${games} ${escapeHtml(copy.gamesLabel)}</span>
                <span class="bar-track"><span class="bar-fill" style="width:${pct}%;background:${color}"></span></span>
                <span class="bar-pct" style="color:${color}">${pct}%</span>
            </div>`;
    }

    type MatchMode = "calibration" | "lobby" | "ranked" | "unknown";

    interface MatchSetupView {
        artifactTier1: number;
        artifactTier2: number;
        perk: number;
        augments: Array<{ kind: string; level: number; slug: string }>;
        synergies: string[];
        available: boolean;
        complete: boolean;
    }

    interface RichPublicMatchStats {
        durationMs?: number;
        duration_ms?: number;
        lowerCreatureIds?: number[];
        lower_creature_ids?: number[];
        upperCreatureIds?: number[];
        upper_creature_ids?: number[];
    }

    interface RichPublicMatch {
        durationMs?: number;
        duration_ms?: number;
        lowerCreatureIds?: number[];
        lower_creature_ids?: number[];
        upperCreatureIds?: number[];
        upper_creature_ids?: number[];
    }

    const dateFormatter = new Intl.DateTimeFormat(language, { dateStyle: "medium", timeStyle: "short" });

    function formatDuration(durationMs: unknown): string {
        const totalSeconds = Math.floor(Math.max(0, num(durationMs)) / 1000);
        if (!totalSeconds) return "—";
        if (totalSeconds < 60) return `${totalSeconds}s`;
        const minutes = Math.floor(totalSeconds / 60);
        const seconds = totalSeconds % 60;
        if (minutes < 60) return seconds ? `${minutes}m ${seconds}s` : `${minutes}m`;
        const hours = Math.floor(minutes / 60);
        const remainingMinutes = minutes % 60;
        return remainingMinutes ? `${hours}h ${remainingMinutes}m` : `${hours}h`;
    }

    function formatDamage(value: unknown): string {
        const damage = Math.max(0, Math.round(num(value)));
        return damage ? numberFormatter.format(damage) : "—";
    }

    function matchModeLabel(mode: MatchMode): string {
        if (mode === "ranked") return copy.matchModeRanked;
        if (mode === "calibration") return copy.matchModeCalibration;
        if (mode === "lobby") return copy.matchModeLobby;
        return copy.matchModeUnknown;
    }

    function portalMatchMode(match: Record<string, unknown>): MatchMode {
        const raw =
            match.match_kind ??
            match.matchKind ??
            match.match_type ??
            match.matchType ??
            match.match_mode ??
            match.matchMode ??
            match.mode;
        if (typeof raw === "number") {
            if (raw === 1) return "ranked";
            if (raw === 2) return "calibration";
            if (raw === 3) return "lobby";
        }
        if (typeof raw === "string") {
            const normalized = raw.trim().toLowerCase();
            if (normalized.includes("calibrat")) return "calibration";
            if (normalized.includes("lobby") || normalized.includes("casual")) return "lobby";
            if (normalized.includes("rank")) return "ranked";
        }
        if (match.calibration === true || match.is_calibration === true) return "calibration";
        if (match.casual === true || match.lobby === true) return "lobby";
        if (match.ranked === true || match.is_ranked === true) return "ranked";
        return "unknown";
    }

    function matchIds(gameId: string, source: "portal" | "public"): { button: string; panel: string } {
        const safeId = gameId.replace(/[^a-zA-Z0-9_-]/g, "-");
        return {
            button: `profile-match-toggle-${source}-${safeId}`,
            panel: `profile-match-details-${source}-${safeId}`,
        };
    }

    function modeBadge(mode: MatchMode): string {
        return `<span class="match-mode" data-mode="${mode}">${escapeHtml(matchModeLabel(mode))}</span>`;
    }

    function matchToggle(gameId: string, source: "portal" | "public", context: string): string {
        const ids = matchIds(gameId, source);
        return `<button class="match-card-hit-target" type="button" id="${ids.button}" data-match-toggle data-match-source="${source}" data-match-context="${escapeHtml(context)}" data-game-id="${escapeHtml(gameId)}" aria-label="${escapeHtml(`${copy.matchDetails}: ${context}`)}" aria-expanded="false" aria-controls="${ids.panel}"></button>`;
    }

    function matchDetailsRegion(gameId: string, source: "portal" | "public"): string {
        const ids = matchIds(gameId, source);
        return `<div class="match-details-panel" id="${ids.panel}" role="region" aria-labelledby="${ids.button}" hidden></div>`;
    }

    function rosterMarkup(creatureIds: unknown, label: string): string {
        const ids = Array.isArray(creatureIds)
            ? creatureIds.map(num).filter((id) => id > 0)
            : [];
        const icons = ids
            .map((id) => {
                const creature = creatureById(id);
                return `<img class="match-roster-icon" src="${escapeHtml(creature.image)}" alt="${escapeHtml(creature.name)}" title="${escapeHtml(creature.name)}" width="32" height="32" loading="lazy" ${imgFallback} />`;
            })
            .join("");
        return `<section class="match-roster"><h4>${escapeHtml(label)}</h4><div>${icons || `<span class="match-unavailable">${escapeHtml(copy.matchNotRecorded)}</span>`}</div></section>`;
    }

    function matchMetric(label: string, value: string, tone = ""): string {
        return `<div class="match-detail-metric"><dt>${escapeHtml(label)}</dt><dd${tone ? ` class="${tone}"` : ""}>${value}</dd></div>`;
    }

    function performanceMarkup(
        performances: Array<{ creatureId: number; damageDealt: number }>,
        label: string,
    ): string {
        const rows = performances
            .slice()
            .sort((a, b) => b.damageDealt - a.damageDealt)
            .map((performance) => {
                const creature = creatureById(performance.creatureId);
                return `<div class="match-performance-row"><img src="${escapeHtml(creature.image)}" alt="" width="32" height="32" loading="lazy" ${imgFallback} /><span>${escapeHtml(creature.name)}</span><strong>${escapeHtml(formatDamage(performance.damageDealt))}</strong></div>`;
            })
            .join("");
        return `<section class="match-performance"><h4>${escapeHtml(label)}</h4>${rows || `<p>${escapeHtml(copy.matchNoDamage)}</p>`}</section>`;
    }

    function artifactProperties(tier: 1 | 2, artifactId: number): ArtifactProperties | undefined {
        return tier === 1
            ? TIER1_ARTIFACTS[artifactId as Tier1Artifact]
            : TIER2_ARTIFACTS[artifactId as Tier2Artifact];
    }

    function artifactChoice(tier: 1 | 2, artifactId: number): string {
        const artifact = artifactId > 0 ? artifactProperties(tier, artifactId) : undefined;
        if (!artifact) return "";
        const image = `/assets/images/artifacts/artifact_t${tier}_${artifact.slug}_256.webp`;
        return `<span class="match-choice" title="${escapeHtml(artifact.description)}"><img src="${escapeHtml(image)}" alt="" width="30" height="30" loading="lazy" /><span>${escapeHtml(artifact.name)}</span><b>T${tier}</b></span>`;
    }

    function synergyChoice(key: string): string {
        const [faction = "", variant = "", level = "0"] = key.split(":");
        const names: Record<string, [string, string]> =
            language === "ru"
                ? {
                      Life: ["Глубокие резервы", "Боевой дух"],
                      Nature: ["Расширенные ряды", "Броня крылатых"],
                      Chaos: ["Стремительный натиск", "Сокрушающие удары"],
                      Might: ["Мастерство аур", "Мастерство способностей"],
                  }
                : {
                      Life: ["Deep reserves", "High spirits"],
                      Nature: ["Expanded ranks", "Winged armor"],
                      Chaos: ["Rapid advance", "Disrupting strikes"],
                      Might: ["Aura mastery", "Ability mastery"],
                  };
        const name = names[faction]?.[Math.max(0, Number(variant) - 1)] ?? (faction || copy.matchSynergies);
        return `<span class="match-choice"><span>${escapeHtml(name)}</span><b>L${Math.max(0, num(level))}</b></span>`;
    }

    function portalSetup(setup: unknown): MatchSetupView {
        const row = setup && typeof setup === "object" ? (setup as Record<string, unknown>) : null;
        const complete = row?.complete === true;
        const augments = [
            { kind: language === "ru" ? "Расстановка" : "Placement", level: Math.min(2, num(row?.augment_placement)) + 1, slug: "board" },
            { kind: language === "ru" ? "Броня" : "Armor", level: num(row?.augment_armor), slug: "armor" },
            { kind: language === "ru" ? "Сила" : "Might", level: num(row?.augment_might), slug: "might" },
            { kind: language === "ru" ? "Магия" : "Empower", level: num(row?.augment_empower), slug: "empower" },
            { kind: language === "ru" ? "Снайпер" : "Sniper", level: num(row?.augment_sniper), slug: "sniper" },
            { kind: language === "ru" ? "Движение" : "Movement", level: num(row?.augment_movement), slug: "movement" },
        ];
        return {
            artifactTier1: num(row?.artifact_tier_1),
            artifactTier2: num(row?.artifact_tier_2),
            perk: num(row?.perk),
            augments: complete ? augments.filter((augment, index) => index === 0 || augment.level > 0) : [],
            synergies: complete && Array.isArray(row?.synergies) ? row.synergies.filter((entry): entry is string => typeof entry === "string") : [],
            available: !!row,
            complete,
        };
    }

    function publicSetup(setup: RankedMatchTeamSetup, available: boolean): MatchSetupView {
        const augments = [
            { kind: language === "ru" ? "Расстановка" : "Placement", level: setup.augmentPlacement + 1, slug: "board" },
            { kind: language === "ru" ? "Броня" : "Armor", level: setup.augmentArmor, slug: "armor" },
            { kind: language === "ru" ? "Сила" : "Might", level: setup.augmentMight, slug: "might" },
            { kind: language === "ru" ? "Магия" : "Empower", level: setup.augmentEmpower, slug: "empower" },
            { kind: language === "ru" ? "Снайпер" : "Sniper", level: setup.augmentSniper, slug: "sniper" },
            { kind: language === "ru" ? "Движение" : "Movement", level: setup.augmentMovement, slug: "movement" },
        ];
        return {
            artifactTier1: setup.artifactTier1,
            artifactTier2: setup.artifactTier2,
            perk: setup.perk,
            augments: available ? augments.filter((augment, index) => index === 0 || augment.level > 0) : [],
            synergies: available ? setup.synergies : [],
            available,
            complete: available,
        };
    }

    function buildMarkup(setup: MatchSetupView, label: string): string {
        if (!setup.available) {
            return `<section class="match-build"><h4>${escapeHtml(label)}</h4><p class="match-unavailable">${escapeHtml(copy.matchNotRecorded)}</p></section>`;
        }
        const artifactsMarkup = `${artifactChoice(1, setup.artifactTier1)}${artifactChoice(2, setup.artifactTier2)}`;
        let perkMarkup = "";
        try {
            const perk = getPerkProperties(setup.perk as Perk);
            if (perk?.name) perkMarkup = `<span class="match-choice"><span>${escapeHtml(perk.name)}</span></span>`;
        } catch {
            perkMarkup = "";
        }
        const augmentsMarkup = setup.augments
            .map(
                (augment) =>
                    `<span class="match-choice"><img src="/assets/images/units/abilities/${augment.slug}_augment_256.webp" alt="" width="30" height="30" loading="lazy" /><span>${escapeHtml(augment.kind)}</span><b>L${augment.level}</b></span>`,
            )
            .join("");
        const synergiesMarkup = setup.synergies.map(synergyChoice).join("");
        const choiceRow = (title: string, value: string): string =>
            `<div><dt>${escapeHtml(title)}</dt><dd>${value || `<span class="match-unavailable">${escapeHtml(copy.matchNotRecorded)}</span>`}</dd></div>`;
        return `<section class="match-build"><h4>${escapeHtml(label)}</h4><dl>${choiceRow(copy.matchPerk, perkMarkup)}${choiceRow(copy.matchArtifacts, artifactsMarkup)}${choiceRow(copy.matchAugments, setup.complete ? augmentsMarkup : "")}${choiceRow(copy.matchSynergies, setup.complete ? synergiesMarkup : "")}</dl></section>`;
    }

    function portalPerformances(value: unknown): Array<{ creatureId: number; damageDealt: number }> {
        return Array.isArray(value)
            ? value
                  .map((entry) => (entry && typeof entry === "object" ? (entry as Record<string, unknown>) : {}))
                  .map((entry) => ({ creatureId: num(entry.creature_id), damageDealt: num(entry.damage_dealt) }))
                  .filter((entry) => entry.creatureId > 0)
            : [];
    }

    function matchRow(match: Record<string, unknown>): string {
        const won = match.won === true;
        const draw = match.draw === true;
        const abandoned = match.abandoned === true;
        const resultLabel = draw ? copy.resultDraw : won ? copy.resultWin : copy.resultLoss;
        const resultClass = draw ? "draw" : won ? "win" : "loss";
        const opponentName = typeof match.opponent_username === "string" ? match.opponent_username : "—";
        const opponent = escapeHtml(opponentName);
        const matchContext = `${resultLabel} ${copy.versus} ${opponentName}`;
        const abandonmentDetail = abandoned
            ? match.player_abandoned === true
                ? copy.matchYouLeft
                : copy.matchOpponentLeft
            : "";
        const when = timeAgo(num(match.finished_time), agoLabels);
        const currency = portalMatchCurrency(match);
        const gameId = typeof match.game_id === "string" ? match.game_id : "";
        const mode = portalMatchMode(match);
        const ratedMode = mode === "ranked" || mode === "calibration";
        const duration = formatDuration(match.duration_ms);
        const laps = Math.max(0, num(match.total_laps));
        const delta = num(match.mmr_delta ?? match.mmrDelta ?? match.delta);
        const hasDelta = match.mmr_delta !== undefined || match.mmrDelta !== undefined || match.delta !== undefined;
        const gold = Math.max(0, num(match.gold_earned ?? match.goldEarned));
        const hasGold = match.gold_earned !== undefined || match.goldEarned !== undefined;
        const replay = gameId && match.replay_available === true
            ? `<a class="match-replay" href="${escapeHtml(`${gameClientRoot}/game/${encodeURIComponent(gameId)}/replay`)}">↻ ${escapeHtml(copy.matchReplay)}</a>`
            : "";
        const rewards = ratedMode && (hasDelta || hasGold)
            ? `<div class="match-rewards">${hasDelta ? `<span class="match-delta ${delta > 0 ? "positive" : delta < 0 ? "negative" : ""}">${delta > 0 ? "+" : ""}${numberFormatter.format(delta)} MMR</span>` : ""}${hasGold ? `<span class="match-gold">${currencyMarkup(gold, "+", currency)}</span>` : ""}</div>`
            : "";
        return `
            <article class="match-row match-card--expandable ${resultClass}" aria-label="${escapeHtml(matchContext)}">
                <div class="match-card-overview">
                    <div class="match-card-toggle-surface${gameId ? "" : " is-static"}">
                        ${gameId ? matchToggle(gameId, "portal", matchContext) : ""}
                        <div class="match-card-summary">
                            <div class="match-main">
                                <div class="match-title"><strong class="match-result ${resultClass}">${escapeHtml(resultLabel)}</strong><span>${escapeHtml(copy.versus)}</span><strong>${opponent}</strong></div>
                                <div class="match-meta">${modeBadge(mode)}<span class="match-when">${escapeHtml(when)}</span>${abandonmentDetail ? `<span class="match-abandonment">${escapeHtml(abandonmentDetail)}</span>` : ""}${duration !== "—" ? `<span>${escapeHtml(duration)}</span>` : ""}${laps ? `<span>${laps} ${escapeHtml(copy.matchLaps.toLowerCase())}</span>` : ""}</div>
                            </div>
                            ${rewards}
                            ${gameId ? `<span class="match-details-chevron" aria-hidden="true">⌄</span>` : ""}
                        </div>
                        <div class="match-rosters">${rosterMarkup(match.creature_ids, copy.matchYourArmy)}${rosterMarkup(match.opponent_creature_ids, copy.matchOpponentArmy)}</div>
                    </div>
                    ${replay ? `<div class="match-card-actions">${replay}</div>` : ""}
                </div>
                ${gameId ? matchDetailsRegion(gameId, "portal") : ""}
            </article>`;
    }

    function leagueLabel(league: number): string {
        if (!league) return copy.publicUnranked;
        // Leagues are named, not numbered — the same table the arena and the game client render.
        return standingCopy.leagueNames[league - 1] ?? copy.publicUnranked;
    }

    /** Their gold third joined to the league: "Ragged Aspirant", "Demigod Whale" (top tier trails). */
    function standingLabel(league: number, wealth: number): string {
        if (!league) return copy.publicUnranked;
        const name = leagueLabel(league);
        const tier = standingCopy.wealthNames[wealth - 1] ?? "";
        if (!tier) return name;
        return wealth === TOP_WEALTH ? `${name} ${tier}` : `${tier} ${name}`;
    }

    function publicStateLabel(state: PublicRankedProfile["state"]): string {
        if (state === "placed") return copy.publicStatePlaced;
        if (state === "recalibration") return copy.publicStateRecalibration;
        return copy.publicStateCalibration;
    }

    function publicReasonLabel(reason: RankedMatchReason): string {
        if (reason === "concede") return copy.publicReasonConcede;
        if (reason === "disconnect") return copy.publicReasonDisconnect;
        if (reason === "double_disconnect") return copy.publicReasonDoubleDisconnect;
        if (reason === "cancel") return copy.publicReasonCancel;
        return copy.publicReasonNormal;
    }

    function recentForm(outcomes: RankedMatchResult[]): string {
        // Both profile APIs are newest-first. Show the form chronologically, with the latest result on
        // the right, and keep the strip at exactly ten positions even for a new commander.
        const results = outcomes.slice(0, 10).reverse();
        const padded: Array<RankedMatchResult | "empty"> = [
            ...Array<"empty">(Math.max(0, 10 - results.length)).fill("empty"),
            ...results,
        ];
        const counts = results.reduce(
            (total, result) => ({ ...total, [result]: total[result] + 1 }),
            { win: 0, draw: 0, loss: 0 },
        );
        const ariaLabel = `${copy.publicRecentForm}: ${counts.win} ${copy.resultWin}, ${counts.draw} ${copy.resultDraw}, ${counts.loss} ${copy.resultLoss}`;
        const labels: Record<RankedMatchResult | "empty", string> = {
            win: copy.resultWin,
            draw: copy.resultDraw,
            loss: copy.resultLoss,
            empty: copy.publicNoResult,
        };
        return `<span class="result-form" role="img" aria-label="${escapeHtml(ariaLabel)}">${padded
            .map(
                (result) =>
                    `<i class="result-form__dot ${result}" title="${escapeHtml(labels[result])}" aria-hidden="true"></i>`,
            )
            .join("")}</span>`;
    }

    function recentFormCard(outcomes: RankedMatchResult[]): string {
        return `<div class="stat-card stat-card--form"><dt>${escapeHtml(copy.publicRecentForm)}</dt><dd>${recentForm(outcomes)}</dd></div>`;
    }

    interface StrategyArtwork {
        alt: string;
        src: string;
    }

    function strategyCard(
        label: string,
        winRate: number,
        games: number,
        artwork: StrategyArtwork[],
        badge?: string,
    ): string {
        const trend = winRate >= 55 ? "strong" : winRate <= 45 ? "weak" : "even";
        const color = winRateColor(winRate);
        const images = artwork.length
            ? artwork
                  .map(
                      (item) =>
                          `<img src="${escapeHtml(item.src)}" alt="${escapeHtml(item.alt)}" width="54" height="54" loading="lazy" ${imgFallback} />`,
                  )
                  .join("")
            : `<span class="strategy-artwork__fallback" aria-hidden="true">${escapeHtml(badge ?? "?")}</span>`;
        return `
            <article class="strategy-card" data-trend="${trend}">
                <div class="strategy-artwork">${images}</div>
                <div class="strategy-card__copy">
                    ${badge ? `<small>${escapeHtml(badge)}</small>` : ""}
                    <strong>${escapeHtml(label)}</strong>
                    <span>${games} ${escapeHtml(copy.publicPlaystyleGames)}</span>
                </div>
                <b class="strategy-rate" style="color:${color}">${winRate.toFixed(1).replace(/\.0$/, "")}%</b>
            </article>`;
    }

    function creatureArtwork(creatureIds: number[]): StrategyArtwork[] {
        return creatureIds.map((id) => {
            const creature = creatureById(id);
            return { src: creature.image, alt: creature.name };
        });
    }

    function opponentProfileHref(playerId: string, username: string): string {
        const params = new URLSearchParams({ playerId, username });
        return `${window.location.pathname}?${params.toString()}`;
    }

    function publicMatchRow(match: RankedProfileMatch): string {
        const currency = match.season?.currency ?? LEGACY_SEASON_CURRENCY;
        const resultLabel =
            match.result === "win" ? copy.resultWin : match.result === "loss" ? copy.resultLoss : copy.resultDraw;
        const opponentName = match.opponent?.username ?? "—";
        const matchContext = `${resultLabel} ${copy.versus} ${opponentName}`;
        const opponent = match.opponent
            ? `<a class="match-opponent" href="${escapeHtml(opponentProfileHref(match.opponent.playerId, match.opponent.username))}">${escapeHtml(match.opponent.username)}</a>`
            : "<strong>—</strong>";
        const when = timeAgo(match.finishedTime, agoLabels);
        const delta = `${match.mmrDelta > 0 ? "+" : ""}${numberFormatter.format(match.mmrDelta)} MMR`;
        const deltaClass = match.mmrDelta > 0 ? "positive" : match.mmrDelta < 0 ? "negative" : "";
        const mode: MatchMode = match.calibration ? "calibration" : "ranked";
        return `
            <article class="match-row match-row--ranked match-card--expandable ${match.result}" aria-label="${escapeHtml(matchContext)}">
                <div class="match-card-overview">
                    <div class="match-card-toggle-surface">
                        ${matchToggle(match.gameId, "public", matchContext)}
                        <div class="match-card-summary">
                            <div class="match-main">
                                <div class="match-title">
                                    <strong class="match-result ${match.result}">${escapeHtml(resultLabel)}</strong>
                                    <span>${escapeHtml(copy.versus)}</span>
                                    ${opponent}
                                </div>
                                <div class="match-meta">
                                    ${modeBadge(mode)}
                                    <span class="match-when">${escapeHtml(when)}</span>
                                    <span class="match-reason">${escapeHtml(publicReasonLabel(match.reason))}</span>
                                </div>
                            </div>
                            <div class="match-rewards">
                                <span class="match-delta ${deltaClass}">${escapeHtml(delta)}</span>
                                <span class="match-gold">${currencyMarkup(match.goldEarned, "+", currency)}</span>
                            </div>
                            <span class="match-details-chevron" aria-hidden="true">⌄</span>
                        </div>
                    </div>
                </div>
                ${matchDetailsRegion(match.gameId, "public")}
            </article>`;
    }

    function publicDurationMs(match: PublicRankedMatch): number {
        const richMatch = match as PublicRankedMatch & RichPublicMatch;
        const richStats = match.stats as (PublicRankedMatch["stats"] & RichPublicMatchStats) | null;
        return num(richStats?.durationMs ?? richStats?.duration_ms ?? richMatch.durationMs ?? richMatch.duration_ms);
    }

    function publicRoster(match: PublicRankedMatch, side: RankedMatchSide): number[] {
        const richMatch = match as PublicRankedMatch & RichPublicMatch;
        const richStats = match.stats as (PublicRankedMatch["stats"] & RichPublicMatchStats) | null;
        const value =
            side === "lower"
                ? richStats?.lowerCreatureIds ??
                  richStats?.lower_creature_ids ??
                  richMatch.lowerCreatureIds ??
                  richMatch.lower_creature_ids
                : richStats?.upperCreatureIds ??
                  richStats?.upper_creature_ids ??
                  richMatch.upperCreatureIds ??
                  richMatch.upper_creature_ids;
        return Array.isArray(value) ? value.map(num).filter((id) => id > 0) : [];
    }

    function publicPerformances(
        performances: RankedMatchUnitPerformance[],
    ): Array<{ creatureId: number; damageDealt: number }> {
        return performances.map((entry) => ({ creatureId: entry.creatureId, damageDealt: entry.damageDealt }));
    }

    function detailFooter(gameId: string, finishedTime: number, fullReport: boolean, replayAvailable: boolean): string {
        const finished = finishedTime ? dateFormatter.format(new Date(finishedTime)) : "—";
        const reportHref = buildRankedMatchPagePath(gameId, requestedPlayerId, language);
        const replayHref = `${gameClientRoot}/game/${encodeURIComponent(gameId)}/replay`;
        return `<footer class="match-detail-footer"><span>${escapeHtml(copy.matchFinished)} ${escapeHtml(finished)}</span><div>${fullReport ? `<a class="match-detail-link" href="${escapeHtml(reportHref)}">${escapeHtml(copy.matchFullReport)}</a>` : ""}${replayAvailable ? `<a class="match-detail-link" href="${escapeHtml(replayHref)}">↻ ${escapeHtml(copy.matchReplay)}</a>` : ""}</div></footer>`;
    }

    function publicDetailsMarkup(match: PublicRankedMatch): string {
        const currency = match.season?.currency ?? LEGACY_SEASON_CURRENCY;
        const viewer = match.players.find((player) => player.playerId === requestedPlayerId) ?? match.players[0];
        const opponent = match.players.find((player) => player.playerId !== viewer.playerId) ?? match.players[1];
        const stats = match.stats;
        const side = viewer.side;
        const opponentSide: RankedMatchSide = side === "lower" ? "upper" : "lower";
        const duration = formatDuration(publicDurationMs(match));
        const laps = stats?.totalLaps ?? 0;
        const playerDamage = side === "lower" ? (stats?.lowerDamage ?? 0) : (stats?.upperDamage ?? 0);
        const opponentDamage = side === "lower" ? (stats?.upperDamage ?? 0) : (stats?.lowerDamage ?? 0);
        const playerPerformances = publicPerformances(
            side === "lower" ? (stats?.lowerPerformers ?? []) : (stats?.upperPerformers ?? []),
        );
        const opponentPerformances = publicPerformances(
            side === "lower" ? (stats?.upperPerformers ?? []) : (stats?.lowerPerformers ?? []),
        );
        const signedDelta = `${viewer.delta > 0 ? "+" : ""}${numberFormatter.format(viewer.delta)}`;
        const mmr = viewer.calibration
            ? `<span class="${viewer.delta > 0 ? "positive" : viewer.delta < 0 ? "negative" : ""}">${signedDelta} MMR</span>`
            : `${numberFormatter.format(viewer.mmrBefore)} → ${numberFormatter.format(viewer.mmrAfter)} <span class="${viewer.delta > 0 ? "positive" : viewer.delta < 0 ? "negative" : ""}">(${signedDelta})</span>`;
        const playerSetup = stats
            ? publicSetup(side === "lower" ? stats.lowerSetup : stats.upperSetup, stats.setupRecorded)
            : null;
        const opponentSetup = stats
            ? publicSetup(opponentSide === "lower" ? stats.lowerSetup : stats.upperSetup, stats.setupRecorded)
            : null;
        return `
            <dl class="match-detail-metrics">
                ${matchMetric(copy.matchDuration, duration)}
                ${matchMetric(copy.matchLaps, laps > 0 ? numberFormatter.format(laps) : "—")}
                ${matchMetric(copy.matchMmr, mmr)}
                ${matchMetric(currency.name, currencyMarkup(viewer.goldEarned, "+", currency))}
                ${matchMetric(copy.matchYourDamage, formatDamage(playerDamage))}
                ${matchMetric(copy.matchOpponentDamage, formatDamage(opponentDamage))}
            </dl>
            <div class="match-rosters">${rosterMarkup(publicRoster(match, side), copy.matchYourArmy)}${rosterMarkup(publicRoster(match, opponentSide), copy.matchOpponentArmy)}</div>
            <div class="match-performance-grid">${performanceMarkup(playerPerformances, copy.matchYourDamage)}${performanceMarkup(opponentPerformances, `${opponent.username} · ${copy.matchOpponentDamage}`)}</div>
            <div class="match-build-grid">${playerSetup ? buildMarkup(playerSetup, copy.matchYourBuild) : buildMarkup(portalSetup(null), copy.matchYourBuild)}${opponentSetup ? buildMarkup(opponentSetup, copy.matchOpponentBuild) : buildMarkup(portalSetup(null), copy.matchOpponentBuild)}</div>
            ${detailFooter(match.gameId, match.finishedTime, true, stats?.replayAvailable === true)}
        `;
    }

    function portalDetailsMarkup(match: Record<string, unknown>): string {
        const gameId = typeof match.game_id === "string" ? match.game_id : "";
        const opponent = typeof match.opponent_username === "string" && match.opponent_username
            ? match.opponent_username
            : "—";
        const mode = portalMatchMode(match);
        const ratedMode = mode === "ranked" || mode === "calibration";
        const currency = portalMatchCurrency(match);
        const duration = formatDuration(match.duration_ms);
        const laps = Math.max(0, num(match.total_laps));
        const playerDamage = num(match.player_damage);
        const opponentDamage = num(match.opponent_damage);
        const delta = num(match.mmr_delta ?? match.mmrDelta ?? match.delta);
        const before = num(match.mmr_before ?? match.mmrBefore);
        const after = num(match.mmr_after ?? match.mmrAfter);
        const hasRating =
            ratedMode &&
            (match.mmr_delta !== undefined ||
                match.mmrDelta !== undefined ||
                match.delta !== undefined ||
                match.mmr_before !== undefined ||
                match.mmrBefore !== undefined);
        const mmr = hasRating
            ? `${numberFormatter.format(before)} → ${numberFormatter.format(after)} <span class="${delta > 0 ? "positive" : delta < 0 ? "negative" : ""}">(${delta > 0 ? "+" : ""}${numberFormatter.format(delta)})</span>`
            : "—";
        const goldValue = match.gold_earned ?? match.goldEarned;
        const gold = !ratedMode || goldValue === undefined
            ? "—"
            : currencyMarkup(Math.max(0, num(goldValue)), "+", currency);
        const playerPerformances = portalPerformances(match.player_top_units);
        const opponentPerformances = portalPerformances(match.opponent_top_units);
        return `
            <dl class="match-detail-metrics">
                ${matchMetric(copy.matchDuration, duration)}
                ${matchMetric(copy.matchLaps, laps > 0 ? numberFormatter.format(laps) : "—")}
                ${matchMetric(copy.matchMmr, mmr)}
                ${matchMetric(currency.name, gold)}
                ${matchMetric(copy.matchYourDamage, formatDamage(playerDamage))}
                ${matchMetric(copy.matchOpponentDamage, formatDamage(opponentDamage))}
            </dl>
            <div class="match-performance-grid">${performanceMarkup(playerPerformances, copy.matchYourDamage)}${performanceMarkup(opponentPerformances, `${opponent} · ${copy.matchOpponentDamage}`)}</div>
            <div class="match-build-grid">${buildMarkup(portalSetup(match.player_setup), copy.matchYourBuild)}${buildMarkup(portalSetup(match.opponent_setup), copy.matchOpponentBuild)}</div>
            ${detailFooter(gameId, num(match.finished_time), ratedMode, match.replay_available === true)}
        `;
    }

    function collapseExpandedMatch(): void {
        if (!expandedMatchId) return;
        const panel = document.getElementById(expandedMatchId);
        const buttonId = panel?.getAttribute("aria-labelledby") ?? "";
        const button = buttonId ? document.getElementById(buttonId) : null;
        if (panel) panel.hidden = true;
        if (button instanceof HTMLButtonElement) {
            button.setAttribute("aria-expanded", "false");
            const context = button.dataset.matchContext;
            button.setAttribute("aria-label", context ? `${copy.matchDetails}: ${context}` : copy.matchDetails);
        }
        expandedMatchId = "";
    }

    async function loadPublicMatchDetails(gameId: string, panel: HTMLElement): Promise<void> {
        const cached = publicMatchDetails.get(gameId);
        if (cached) {
            panel.innerHTML = publicDetailsMarkup(cached);
            panel.removeAttribute("aria-busy");
            return;
        }
        panel.setAttribute("aria-busy", "true");
        panel.innerHTML = `<p class="match-details-status" role="status">${escapeHtml(copy.matchLoadingDetails)}</p>`;
        try {
            const details = await fetchPublicRankedMatch(gameId);
            publicMatchDetails.set(gameId, details);
            panel.innerHTML = publicDetailsMarkup(details);
            panel.removeAttribute("aria-busy");
        } catch {
            panel.innerHTML = `<div class="match-details-error" role="alert"><p>${escapeHtml(copy.matchDetailsError)}</p><button type="button" data-match-details-retry data-game-id="${escapeHtml(gameId)}">${escapeHtml(copy.matchRetryDetails)}</button></div>`;
            panel.removeAttribute("aria-busy");
        }
    }

    async function toggleMatchDetails(button: HTMLButtonElement): Promise<void> {
        const panelId = button.getAttribute("aria-controls") ?? "";
        const panel = panelId ? document.getElementById(panelId) : null;
        const gameId = button.dataset.gameId ?? "";
        if (!panel || !gameId) return;
        if (button.getAttribute("aria-expanded") === "true") {
            collapseExpandedMatch();
            return;
        }
        collapseExpandedMatch();
        expandedMatchId = panelId;
        button.setAttribute("aria-expanded", "true");
        const context = button.dataset.matchContext;
        button.setAttribute("aria-label", context ? `${copy.matchCollapse}: ${context}` : copy.matchCollapse);
        panel.hidden = false;
        if (button.dataset.matchSource === "public") {
            await loadPublicMatchDetails(gameId, panel);
        } else {
            const match = matchHistoryById.get(gameId);
            panel.innerHTML = match && typeof match === "object"
                ? portalDetailsMarkup(match as Record<string, unknown>)
                : `<p class="match-details-status">${escapeHtml(copy.matchDetailsError)}</p>`;
        }
    }

    matchesEl?.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const retry = target.closest<HTMLButtonElement>("[data-match-details-retry]");
        if (retry) {
            const gameId = retry.dataset.gameId ?? "";
            const panel = retry.closest<HTMLElement>(".match-details-panel");
            if (gameId && panel) void loadPublicMatchDetails(gameId, panel);
            return;
        }
        const button = target.closest<HTMLButtonElement>("[data-match-toggle]");
        if (button) void toggleMatchDetails(button);
    });

    function configureSelfMode(): void {
        if (eyebrowEl) eyebrowEl.textContent = copy.title;
        if (subtitleEl) subtitleEl.textContent = copy.subtitle;
        if (loadingEl) loadingEl.textContent = copy.loading;
        if (errorTitleEl) errorTitleEl.textContent = copy.errorTitle;
        if (errorBodyEl) errorBodyEl.textContent = copy.errorBody;
        if (publicStandingEl) publicStandingEl.hidden = true;
        if (summaryNoticeEl) summaryNoticeEl.hidden = true;
        for (const section of selfSections) section.hidden = false;
    }

    function configurePublicMode(): void {
        if (eyebrowEl) eyebrowEl.textContent = copy.publicEyebrow;
        if (subtitleEl) subtitleEl.textContent = copy.publicSubtitle;
        if (loadingEl) loadingEl.textContent = copy.publicLoading;
        if (errorTitleEl) errorTitleEl.textContent = copy.publicErrorTitle;
        if (errorBodyEl) errorBodyEl.textContent = copy.publicErrorBody;
        if (publicStandingEl) publicStandingEl.hidden = false;
        for (const section of selfSections) section.hidden = true;
    }

    function renderPublicProfile(profile: PublicRankedProfile, summaryOnly = false): void {
        configurePublicMode();
        currentCurrency = profile.season?.currency ?? LEGACY_SEASON_CURRENCY;
        if (predictionsPanelEl) predictionsPanelEl.open = false;
        const placed = profile.state === "placed";
        const rating = placed ? numberFormatter.format(profile.mmr) : copy.publicRatingHidden;
        const rank = placed && profile.leaderboardRank ? `#${numberFormatter.format(profile.leaderboardRank)}` : copy.publicUnranked;

        if (nameEl) nameEl.textContent = profile.username;
        if (goldEl) {
            const gold = numberFormatter.format(profile.gold);
            goldEl.innerHTML = currencyMarkup(profile.gold);
            goldEl.setAttribute("aria-label", `${currentCurrency.name}: ${gold}`);
            goldEl.title = currentCurrency.name;
            goldEl.hidden = false;
        }
        document.title = `${profile.username} · Heroes of Crypto`;
        if (metaEl) metaEl.hidden = false;
        if (presenceEl) {
            // Live presence: green "Online" while the player has an active session; otherwise how
            // long ago they were last seen (independent of when their last ranked battle was).
            if (profile.online) {
                presenceEl.hidden = false;
                presenceEl.dataset.online = "true";
                presenceEl.textContent = copy.publicOnlineNow;
            } else {
                const seen = timeAgo(profile.lastOnlineAt, agoLabels);
                presenceEl.hidden = !seen;
                delete presenceEl.dataset.online;
                presenceEl.textContent = seen ? `${copy.publicLastSeen} ${seen}` : "";
            }
        }
        if (lastSeenEl) {
            const ago = timeAgo(profile.lastRankedGameAt, agoLabels);
            lastSeenEl.textContent = ago ? `${copy.publicLastBattle} ${ago}` : "";
        }
        if (emptyEl) emptyEl.hidden = true;
        if (sectionsEl) sectionsEl.hidden = false;
        if (summaryNoticeEl) summaryNoticeEl.hidden = !summaryOnly;

        // While calibrating, the season record and the placement counter sit on DIFFERENT scopes, and
        // showing both as-is makes the profile contradict itself. resetProfileForSeason() zeroes
        // wins/losses/draws/totalGames but deliberately preserves the calibration counters —
        // "calibration is a once-per-account rite, never re-asked on season rollover". So a player who
        // crosses a season boundary mid-placement reads "Calibrating 2 / 5" beside a record of "1–0–0",
        // with the pre-rollover game missing from one number and counted by the other. Report the
        // CALIBRATION record while calibrating so every tile here describes the same set of games.
        // (Entering recalibration zeroes these counters too, so the scope is right in that state as well.)
        const record = placed ? profile : profile.calibration;
        const recordGames = placed ? profile.totalGames : record.wins + record.losses + record.draws;
        const recordWinRatePct = placed ? profile.winRatePct : recordGames ? (record.wins / recordGames) * 100 : 0;

        const statsEl = $("stats");
        if (statsEl) {
            statsEl.innerHTML = [
                statCard(copy.statRating, rating, placed ? "#f2c75d" : undefined),
                statCard(copy.statLeaderboardRank, rank),
                statCard(copy.statRecord, `${record.wins}–${record.losses}–${record.draws}`),
                statCard(copy.statWinRate, recordGames ? `${recordWinRatePct.toFixed(1).replace(/\.0$/, "")}%` : "—", winRateColor(recordWinRatePct)),
                statCard(copy.statPeakRating, profile.peakMmr ? numberFormatter.format(profile.peakMmr) : "—"),
                statCard(copy.statGames, numberFormatter.format(recordGames)),
                statCard(copy.statHoursInGame, hoursInGameLabel(profile.secondsInGame)),
                // Gold moved to the header (large, right after the nickname); no duplicate stat card here.
            ].join("");
        }

        if (standingEl) {
            const progress = `${Math.min(profile.calibration.gamesPlayed, profile.calibration.required)} / ${profile.calibration.required}`;
            const exitRate = rankedExitRatePct(profile.dcLosses, profile.totalGames);
            const exitRateValue = profile.totalGames
                ? `${exitRate.toFixed(1).replace(/\.0$/, "")}% · ${profile.dcLosses}/${profile.totalGames}`
                : "— · 0/0";
            const previous = profile.previous
                ? `${leagueLabel(profile.previous.league)} · ${numberFormatter.format(profile.previous.mmr)} MMR`
                : copy.publicUnranked;
            const seasonLine = profile.season
                ? `<small class="ranked-standing__season">${escapeHtml(`${profile.season.name} · ${currentCurrency.name}`)}</small>`
                : "";
            const emblemLabel = placed ? leagueLabel(profile.league) : publicStateLabel(profile.state);
            standingEl.innerHTML = `
                <div class="ranked-standing__banner" data-state="${escapeHtml(profile.state)}">
                    <img class="ranked-standing__emblem" src="${leagueEmblemPath(placed ? profile.league : 0)}" alt="${escapeHtml(emblemLabel)}" width="128" height="128" />
                    <div class="ranked-standing__copy">
                        <span class="ranked-standing__state">${escapeHtml(publicStateLabel(profile.state))}</span>
                        <strong>${escapeHtml(placed ? standingLabel(profile.league, profile.wealth) : `${publicStateLabel(profile.state)} ${progress}`)}</strong>
                        <small>${escapeHtml(placed ? `${numberFormatter.format(profile.mmr)} MMR` : copy.publicRatingHidden)}</small>
                        ${seasonLine}
                    </div>
                </div>
                <dl class="ranked-standing__facts">
                    <div><dt>${escapeHtml(copy.publicLeague)}</dt><dd>${escapeHtml(placed ? standingLabel(profile.league, profile.wealth) : `${publicStateLabel(profile.state)} ${progress}`)}</dd></div>
                    <div class="ranked-standing__form"><dt>${escapeHtml(copy.publicRecentForm)}</dt><dd>${recentForm(profile.recentGames.map((match) => match.result))}</dd></div>
                    <div><dt>${escapeHtml(exitRateLabel)}</dt><dd title="${escapeHtml(exitRateTitle)}">${exitRateValue}</dd></div>
                    <div><dt>${escapeHtml(copy.publicBannedUnit)}</dt><dd>${escapeHtml(profile.rankedBan ? profile.rankedBan.name : copy.publicBanNotPicked)}</dd></div>
                    ${profile.state === "recalibration" ? `<div class="ranked-standing__previous"><dt>${escapeHtml(copy.publicPreviousStanding)}</dt><dd>${escapeHtml(previous)}</dd></div>` : ""}
                </dl>`;
        }

        // Prediction record: how this player bets on OTHER people's games. Public for every profile —
        // a market is only readable if you can see who backs what and how it turns out. Hidden until
        // they have actually placed one.
        const predictionsSection = document.querySelector<HTMLElement>("[data-profile-predictions-section]");
        const predictionSummaryEl = document.querySelector<HTMLElement>("[data-profile-prediction-summary]");
        if (predictionsSection && predictionsEl) {
            const predictions = summaryOnly
                ? { bets: 0, staked: 0, returned: 0, settled: 0, won: 0, net: 0, winRatePct: 0, recent: [] }
                : profile.predictions;
            predictionsSection.hidden = predictions.bets === 0;

            if (predictionSummaryEl) {
                const netClass = predictions.net > 0 ? "positive" : predictions.net < 0 ? "negative" : "";
                const netSign = predictions.net > 0 ? "+" : "";
                predictionSummaryEl.innerHTML = `
                    <span class="prediction-panel__metric"><b>${numberFormatter.format(predictions.bets)}</b><span>${escapeHtml(copy.predictionsPlaced)}</span></span>
                    <span class="prediction-panel__metric"><b>${currencyMarkup(predictions.staked)}</b><span>${escapeHtml(copy.predictionsStaked)}</span></span>
                    <span class="prediction-panel__metric"><b>${
                        predictions.settled > 0
                            ? `${predictions.winRatePct.toFixed(1).replace(/\.0$/, "")}%`
                            : "—"
                    }</b><span>${escapeHtml(copy.predictionsHitRate)}</span></span>
                    <span class="prediction-panel__metric ${netClass}"><b>${currencyMarkup(predictions.net, netSign, currentCurrency, true)}</b><span>${escapeHtml(`${copy.predictionsNet} · ${currentCurrency.name}`)}</span></span>`;
            }

            const predictionRows = predictions.recent
                .map((bet) => {
                    const label = {
                        open: copy.predictionOpen,
                        won: copy.predictionWon,
                        lost: copy.predictionLost,
                        burned: copy.predictionBurned,
                        refunded: copy.predictionRefunded,
                    }[bet.status];
                    // Only a settled bet has a result worth colouring; an open one is still in play.
                    const tone =
                        bet.status === "won"
                            ? "positive"
                            : bet.status === "lost" || bet.status === "burned"
                              ? "negative"
                              : bet.status === "refunded"
                                ? "muted"
                                : "";
                    const profit = bet.payout - bet.amount;
                    const outcomeMarkup =
                        bet.status === "open"
                            ? "—"
                            : currencyMarkup(profit, profit > 0 ? "+" : "", currentCurrency, true);
                    const backedUsername = bet.backedUsername || copy.predictionUnknownSide;
                    const placedDate = bet.placedAt ? new Date(bet.placedAt) : null;
                    const placedAt = placedDate && Number.isFinite(placedDate.getTime()) ? dateFormatter.format(placedDate) : "—";
                    const placedTime =
                        placedDate && Number.isFinite(placedDate.getTime())
                            ? `<time datetime="${escapeHtml(placedDate.toISOString())}">${escapeHtml(placedAt)}</time>`
                            : escapeHtml(placedAt);
                    const compactGameId =
                        bet.gameId.length > 16 ? `${bet.gameId.slice(0, 8)}…${bet.gameId.slice(-6)}` : bet.gameId;
                    let matchHref = "";
                    try {
                        matchHref = buildRankedMatchPagePath(bet.gameId, bet.predictedPlayerId, language);
                    } catch {
                        matchHref = "";
                    }
                    // The match's OWN result, which the bet status cannot convey: a lost bet never names
                    // the winner. Empty for an unfinished match; "drawn" when it ended level.
                    const matchResult = !bet.matchDecided
                        ? bet.status === "open"
                            ? escapeHtml(copy.predictionUndecided)
                            : escapeHtml(copy.predictionDrawn)
                        : bet.winnerUsername
                          ? `${escapeHtml(copy.predictionWonBy)} <strong>${escapeHtml(bet.winnerUsername)}</strong>`
                          : "";
                    const matchResultMarkup = matchResult
                        ? `<span class="prediction-row__result">${matchResult}</span>`
                        : "";
                    const match = matchHref
                        ? `<a class="prediction-row__match" href="${escapeHtml(matchHref)}" aria-label="${escapeHtml(`${copy.predictionOpenMatch}: ${bet.gameId}`)}"><span>${escapeHtml(copy.predictionMatch)}</span><code title="${escapeHtml(bet.gameId)}">${escapeHtml(compactGameId)}</code><i aria-hidden="true">↗</i></a>`
                        : `<span class="prediction-row__match"><span>${escapeHtml(copy.predictionMatch)}</span><code title="${escapeHtml(bet.gameId)}">${escapeHtml(compactGameId)}</code></span>`;
                    return `
                        <article class="prediction-row" aria-label="${escapeHtml(`${label}: ${copy.predictionBacked} ${backedUsername}`)}">
                            <div class="prediction-row__outcome">
                                <span class="prediction-status ${tone}">${escapeHtml(label)}</span>
                                <strong class="prediction-outcome ${tone}">${outcomeMarkup}</strong>
                            </div>
                            <div class="prediction-row__bet">
                                <strong>${escapeHtml(copy.predictionBacked)} ${escapeHtml(backedUsername)}</strong>
                                <span>${escapeHtml(copy.predictionStake)} ${currencyMarkup(bet.amount)}</span>
                            </div>
                            <div class="prediction-row__context">
                                <span class="prediction-row__matchcell">${match}${matchResultMarkup}</span>
                                <span class="prediction-row__placed"><span>${escapeHtml(copy.predictionPlaced)}</span>${placedTime}</span>
                            </div>
                        </article>`;
                });
            renderPredictionHistory(
                predictionRows,
                `<p class="prediction-history__empty">${escapeHtml(copy.predictionHistoryEmpty)}</p>`,
            );
        }

        // Head-to-head wager record: gold made (or lost) betting on their OWN games. Public like the
        // prediction book, hidden until they have wagered at least once.
        const wagersSection = document.querySelector<HTMLElement>("[data-profile-wagers-section]");
        const wagerSummaryEl = document.querySelector<HTMLElement>("[data-profile-wager-summary]");
        if (wagersSection && wagersEl) {
            const wagers = summaryOnly
                ? { wagers: 0, staked: 0, won: 0, lost: 0, draws: 0, net: 0, winRatePct: 0, recent: [] }
                : profile.wagers;
            wagersSection.hidden = wagers.wagers === 0;

            if (wagerSummaryEl) {
                const netClass = wagers.net > 0 ? "positive" : wagers.net < 0 ? "negative" : "";
                const netSign = wagers.net > 0 ? "+" : "";
                wagerSummaryEl.innerHTML = `
                    <span class="prediction-panel__metric"><b>${numberFormatter.format(wagers.wagers)}</b><span>${escapeHtml(copy.wagersPlayed)}</span></span>
                    <span class="prediction-panel__metric"><b>${currencyMarkup(wagers.staked)}</b><span>${escapeHtml(copy.predictionsStaked)}</span></span>
                    <span class="prediction-panel__metric"><b>${
                        wagers.won + wagers.lost > 0
                            ? `${wagers.winRatePct.toFixed(1).replace(/\.0$/, "")}%`
                            : "—"
                    }</b><span>${escapeHtml(copy.wagersWinRate)}</span></span>
                    <span class="prediction-panel__metric ${netClass}"><b>${currencyMarkup(wagers.net, netSign, currentCurrency, true)}</b><span>${escapeHtml(`${copy.predictionsNet} · ${currentCurrency.name}`)}</span></span>`;
            }

            const wagerRows = wagers.recent.map((wager) => {
                const label = {
                    open: copy.wagerOpen,
                    won: copy.wagerWon,
                    lost: copy.wagerLost,
                    draw: copy.wagerDraw,
                    refunded: copy.wagerRefunded,
                }[wager.outcome];
                const tone =
                    wager.outcome === "won"
                        ? "positive"
                        : wager.outcome === "lost" || wager.outcome === "draw"
                          ? "negative"
                          : wager.outcome === "refunded"
                            ? "muted"
                            : "";
                // Each side risks exactly `amount`: a win banks the opponent's stake, a loss or a
                // drawn (burned) pot costs your own; refunds and live tables move nothing yet.
                const profit =
                    wager.outcome === "won" ? wager.amount : wager.outcome === "lost" || wager.outcome === "draw" ? -wager.amount : 0;
                const outcomeMarkup =
                    wager.outcome === "open" || wager.outcome === "refunded"
                        ? "—"
                        : currencyMarkup(profit, profit > 0 ? "+" : "", currentCurrency, true);
                const opponent = wager.opponentUsername || copy.predictionUnknownSide;
                const whenMs = wager.settledAt || wager.createdAt;
                const whenDate = whenMs ? new Date(whenMs) : null;
                const whenLabel = whenDate && Number.isFinite(whenDate.getTime()) ? dateFormatter.format(whenDate) : "—";
                const whenTime =
                    whenDate && Number.isFinite(whenDate.getTime())
                        ? `<time datetime="${escapeHtml(whenDate.toISOString())}">${escapeHtml(whenLabel)}</time>`
                        : escapeHtml(whenLabel);
                const compactGameId =
                    wager.gameId.length > 16 ? `${wager.gameId.slice(0, 8)}…${wager.gameId.slice(-6)}` : wager.gameId;
                let matchHref = "";
                try {
                    matchHref = buildRankedMatchPagePath(wager.gameId, profile.playerId, language);
                } catch {
                    matchHref = "";
                }
                const match = matchHref
                    ? `<a class="prediction-row__match" href="${escapeHtml(matchHref)}" aria-label="${escapeHtml(`${copy.predictionOpenMatch}: ${wager.gameId}`)}"><span>${escapeHtml(copy.predictionMatch)}</span><code title="${escapeHtml(wager.gameId)}">${escapeHtml(compactGameId)}</code><i aria-hidden="true">↗</i></a>`
                    : `<span class="prediction-row__match"><span>${escapeHtml(copy.predictionMatch)}</span><code title="${escapeHtml(wager.gameId)}">${escapeHtml(compactGameId)}</code></span>`;
                return `
                    <article class="prediction-row" aria-label="${escapeHtml(`${label}: ${copy.wagerVersus} ${opponent}`)}">
                        <div class="prediction-row__outcome">
                            <span class="prediction-status ${tone}">${escapeHtml(label)}</span>
                            <strong class="prediction-outcome ${tone}">${outcomeMarkup}</strong>
                        </div>
                        <div class="prediction-row__bet">
                            <strong>${escapeHtml(copy.wagerVersus)} ${escapeHtml(opponent)}</strong>
                            <span>${escapeHtml(copy.predictionStake)} ${currencyMarkup(wager.amount)}</span>
                        </div>
                        <div class="prediction-row__context">
                            <span class="prediction-row__matchcell">${match}</span>
                            <span class="prediction-row__placed"><span>${escapeHtml(copy.predictionPlaced)}</span>${whenTime}</span>
                        </div>
                    </article>`;
            });
            renderWagerHistory(
                wagerRows,
                `<p class="prediction-history__empty">${escapeHtml(copy.wagerHistoryEmpty)}</p>`,
            );
        }

        // The purse timeline: every movement in one list, newest first. The prediction and wager
        // panels above each show one KIND of gold; this is where a balance is actually explained —
        // match winnings, the daily league reward, stakes going out and payouts coming back.
        // Flat keys rather than a nested map so the copy object stays one level deep, like every
        // other label on this page (it is serialized into the DOM and re-parsed by this script).
        const goldKindLabel = (kind: string): string =>
            ({
                match: copy.goldKindMatch,
                daily_league: copy.goldKindDailyLeague,
                bet_placed: copy.goldKindBetPlaced,
                bet_payout: copy.goldKindBetPayout,
                bet_refund: copy.goldKindBetRefund,
                wager_escrow: copy.goldKindWagerEscrow,
                wager_payout: copy.goldKindWagerPayout,
                wager_refund: copy.goldKindWagerRefund,
                admin_adjust: copy.goldKindAdminAdjust,
                season_reset: copy.goldKindSeasonReset,
            })[kind] ?? kind;

        const goldSection = document.querySelector<HTMLElement>("[data-profile-gold-section]");
        const goldHistoryEl = document.querySelector<HTMLElement>("[data-profile-gold-history]");
        const goldSummaryEl = document.querySelector<HTMLElement>("[data-profile-gold-summary]");
        if (goldSection && goldHistoryEl) {
            const movements = summaryOnly ? [] : profile.goldHistory;
            goldSection.hidden = movements.length === 0;

            if (goldSummaryEl) {
                const earned = movements.filter((m) => m.delta > 0).reduce((sum, m) => sum + m.delta, 0);
                const spent = movements.filter((m) => m.delta < 0).reduce((sum, m) => sum - m.delta, 0);
                goldSummaryEl.innerHTML = `
                    <span class="prediction-panel__metric positive"><b>${currencyMarkup(earned, "+", currentCurrency, true)}</b><span>${escapeHtml(copy.goldHistoryEarned)}</span></span>
                    <span class="prediction-panel__metric negative"><b>${currencyMarkup(-spent, "", currentCurrency, true)}</b><span>${escapeHtml(copy.goldHistorySpent)}</span></span>`;
            }

            goldHistoryEl.innerHTML = movements.length
                ? movements
                      .map((movement) => {
                          const label = goldKindLabel(movement.kind);
                          const tone = movement.delta > 0 ? "positive" : "negative";
                          const sign = movement.delta > 0 ? "+" : "";
                          // A daily reward is the one movement with no match behind it, so it names
                          // the league that earned it instead of a game id.
                          const leagueName =
                              typeof movement.detail?.leagueName === "string" ? movement.detail.leagueName : "";
                          const context = leagueName
                              ? escapeHtml(leagueName)
                              : typeof movement.detail?.gameId === "string"
                                ? `<code title="${escapeHtml(movement.detail.gameId)}">${escapeHtml(
                                      movement.detail.gameId.slice(0, 8),
                                  )}</code>`
                                : "";
                          const when = new Date(movement.at);
                          const whenValid = Number.isFinite(when.getTime());
                          const whenTime = whenValid
                              ? `<time datetime="${escapeHtml(when.toISOString())}">${escapeHtml(
                                    dateFormatter.format(when),
                                )}</time>`
                              : "—";
                          const balance =
                              movement.balanceAfter === null
                                  ? ""
                                  : `<span>${escapeHtml(copy.goldHistoryBalance)} ${currencyMarkup(movement.balanceAfter)}</span>`;
                          return `
                    <article class="prediction-row" aria-label="${escapeHtml(`${label}: ${movement.delta}`)}">
                        <div class="prediction-row__outcome">
                            <span class="prediction-status ${tone}">${escapeHtml(label)}</span>
                            <strong class="prediction-outcome ${tone}">${currencyMarkup(movement.delta, sign, currentCurrency, true)}</strong>
                        </div>
                        <div class="prediction-row__bet">
                            <strong>${context || escapeHtml(label)}</strong>
                            ${balance}
                        </div>
                        <div class="prediction-row__context">
                            <span class="prediction-row__placed">${whenTime}</span>
                        </div>
                    </article>`;
                      })
                      .join("")
                : `<p class="prediction-history__empty">${escapeHtml(copy.goldHistoryEmpty)}</p>`;
        }

        // Previous seasons: the archived final standings (MMR resets each season; this is where the
        // old numbers live on). Hidden until the player has at least one finished season behind them.
        const seasonsSection = document.querySelector<HTMLElement>("[data-profile-seasons-section]");
        const seasonsEl = $("seasons");
        if (seasonsSection && seasonsEl) {
            const history = summaryOnly ? [] : profile.seasonHistory;
            seasonsSection.hidden = history.length === 0;
            seasonsEl.innerHTML = history
                .map((entry) => {
                    const rank = entry.leaderboardRank ? ` · #${entry.leaderboardRank}` : "";
                    const standing = entry.league > 0 ? `${leagueLabel(entry.league)}${rank}` : copy.publicUnranked;
                    const mmr = entry.mmr ? `${numberFormatter.format(entry.mmr)} MMR` : "—";
                    const rate = entry.totalGames
                        ? `${entry.winRatePct.toFixed(1).replace(/\.0$/, "")}%`
                        : "—";
                    return `
                        <div class="season-row">
                            <span class="season-name">${escapeHtml(entry.seasonName)}</span>
                            <span class="season-standing">${escapeHtml(standing)}</span>
                            <span class="season-mmr">${escapeHtml(mmr)}</span>
                            <span class="season-gold">${currencyMarkup(entry.gold, "", entry.currency)}</span>
                            <span class="season-record">${entry.wins}–${entry.losses}–${entry.draws}</span>
                            <span class="season-rate">${escapeHtml(rate)}</span>
                            <span class="season-games">${entry.totalGames} ${escapeHtml(copy.gamesLabel)}</span>
                        </div>`;
                })
                .join("");
        }

        renderMatchHistory(
            summaryOnly ? [] : profile.recentGames,
            publicMatchRow,
            `<p class="profile-empty-message">${escapeHtml(summaryOnly ? copy.publicDetailsUnavailable : copy.publicNoMatches)}</p>`,
        );

        // Winning strategies: what this player fields and what wins for them (from recorded games).
        const playstyleSection = document.querySelector<HTMLElement>("[data-profile-playstyle-section]");
        const playstyleEl = $("playstyle");
        const style = profile.playstyle;
        if (playstyleSection && playstyleEl) {
            const group = (title: string, cards: string[]): string =>
                cards.length
                    ? `<section class="playstyle-group"><h3>${escapeHtml(title)}</h3><div class="strategy-list">${cards.join("")}</div></section>`
                    : "";
            // Tier 1 and Tier 2 artifacts are separate habits (a player picks one of each per game), so they
            // read as two lists rather than one merged "Artifact habits" pile.
            const artifactCards = (list: PlaystyleArtifact[]): string[] =>
                list
                    .slice()
                    .sort((a, b) => b.games - a.games)
                    .slice(0, 6)
                    .map((artifact) => {
                        const catalogEntry = artifacts.find(
                            (entry) => entry.tier === artifact.tier && entry.name === artifact.name,
                        );
                        return strategyCard(
                            artifact.name,
                            artifact.winRatePct,
                            artifact.games,
                            catalogEntry ? [{ src: catalogEntry.icon, alt: catalogEntry.name }] : [],
                            `Tier ${artifact.tier}`,
                        );
                    });
            // Combat augments: six kinds, each shown at its display level. Localized names + icons live here,
            // parallel to the match page's augment chips.
            const augmentMeta: Record<number, { slug: string; en: string; ru: string }> = {
                1: { slug: "board", en: "Placement", ru: "Расстановка" },
                2: { slug: "armor", en: "Armor", ru: "Броня" },
                3: { slug: "might", en: "Might", ru: "Сила" },
                4: { slug: "sniper", en: "Sniper", ru: "Снайпер" },
                5: { slug: "movement", en: "Movement", ru: "Движение" },
                6: { slug: "empower", en: "Empower", ru: "Магия" },
            };
            const augmentCards = (list: PlaystyleAugment[]): string[] =>
                list
                    .slice()
                    .sort((a, b) => b.games - a.games)
                    .slice(0, 6)
                    .map((augment) => {
                        const meta = augmentMeta[augment.kind];
                        const name = meta ? (language === "ru" ? meta.ru : meta.en) : augment.name;
                        const artwork = meta
                            ? [{ src: `/assets/images/units/abilities/${meta.slug}_augment_256.webp`, alt: name }]
                            : [];
                        const levelWord = language === "ru" ? "Ур." : "Lv";
                        return strategyCard(
                            name,
                            augment.winRatePct,
                            augment.games,
                            artwork,
                            `${levelWord} ${augment.level}`,
                        );
                    });
            const hasData = !summaryOnly && style && style.games > 0;
            playstyleSection.hidden = !hasData && !style;
            playstyleEl.innerHTML = hasData
                ? [
                      group(
                          copy.publicPlaystyleCreatures,
                          style.topCreatures.slice(0, 6).map((creature) =>
                              strategyCard(
                                  creature.name,
                                  creature.winRatePct,
                                  creature.games,
                                  creatureArtwork([creature.creatureId]),
                              ),
                          ),
                      ),
                      group(
                          copy.publicPlaystylePairs,
                          style.topPairs.map((pair) =>
                              strategyCard(
                                  pair.names.join(" + "),
                                  pair.winRatePct,
                                  pair.games,
                                  creatureArtwork(pair.creatureIds),
                              ),
                          ),
                      ),
                      group(
                          copy.publicPlaystyleTriples,
                          style.topTriples.map((triple) =>
                              strategyCard(
                                  triple.names.join(" + "),
                                  triple.winRatePct,
                                  triple.games,
                                  creatureArtwork(triple.creatureIds),
                              ),
                          ),
                      ),
                      group(copy.publicPlaystyleArtifactsTier1, artifactCards(style.artifactsTier1)),
                      group(copy.publicPlaystyleArtifactsTier2, artifactCards(style.artifactsTier2)),
                      group(copy.publicPlaystyleAugments, augmentCards(style.augments)),
                  ].join("") || `<p class="profile-empty-message">${escapeHtml(copy.publicPlaystyleEmpty)}</p>`
                : `<p class="profile-empty-message">${escapeHtml(copy.publicPlaystyleEmpty)}</p>`;
        }
        showState("content");
    }

    function render(portal: any, catalog: SeasonCurrencyCatalog | null): void {
        configureSelfMode();
        selfSeasonCatalog = catalog;
        currentCurrency = catalog?.current?.currency ?? LEGACY_SEASON_CURRENCY;
        const wins = num(portal.wins);
        const losses = num(portal.losses);
        const games = num(portal.total_games_played);
        const winRate = winRatePct(wins, games);

        if (nameEl) nameEl.textContent = portal.username || copy.title;
        if (goldEl) {
            const gold = Math.max(0, num(portal.gold));
            goldEl.innerHTML = currencyMarkup(gold);
            goldEl.setAttribute("aria-label", `${currentCurrency.name}: ${numberFormatter.format(gold)}`);
            goldEl.title = currentCurrency.name;
            goldEl.hidden = false;
        }

        if (metaEl) metaEl.hidden = false;
        const lastLogin = num(portal.last_login);
        if (lastSeenEl) {
            const ago = timeAgo(lastLogin, agoLabels);
            lastSeenEl.textContent = ago ? `${copy.lastLoginPrefix} ${ago}` : "";
        }

        const matches = (portal.recent_matches ?? []) as any[];
        const creatures = (portal.creature_stats ?? []) as any[];
        const combos = (portal.combos ?? []) as any[];
        const recentOutcomes: RankedMatchResult[] = matches.map((match) =>
            match.draw === true ? "draw" : match.won === true ? "win" : "loss",
        );

        const noData = games <= 0 && matches.length === 0 && creatures.length === 0;
        if (emptyEl) emptyEl.hidden = !noData;
        if (sectionsEl) sectionsEl.hidden = noData;

        const statsEl = $("stats");
        if (statsEl) {
            statsEl.innerHTML = [
                statCard(copy.statWins, String(wins), "#46d160"),
                statCard(copy.statLosses, String(losses), "#ff5a5a"),
                statCard(copy.statWinRate, `${winRate}%`, winRateColor(winRate)),
                statCard(copy.statGames, String(games)),
                recentFormCard(recentOutcomes),
            ].join("");
        }

        const creaturesEl = $("creatures");
        if (creaturesEl) {
            creaturesEl.innerHTML = creatures
                .slice()
                .sort((a, b) => num(b.games) - num(a.games))
                .slice(0, 14)
                .map((c) => creatureRow(num(c.creature_id), num(c.wins), num(c.games)))
                .join("");
        }

        const combosEl = $("combos");
        const combosSection = $("combos-section");
        if (combosEl) {
            combosEl.innerHTML = combos
                .map((c) => comboRow((c.creature_ids ?? []).map(num), num(c.wins), num(c.games)))
                .join("");
            if (combosSection) combosSection.hidden = combos.length === 0;
        }

        renderMatchHistory(matches, matchRow, "");

        showState("content");
    }

    async function load(): Promise<void> {
        if (publicMode) {
            configurePublicMode();
            showState("loading");
            try {
                renderPublicProfile(await fetchPublicRankedProfile(requestedPlayerId));
            } catch {
                const fallback = publicRankedProfileFallbackFromSearchParams(profileSearchParams);
                if (fallback) renderPublicProfile(fallback, true);
                else showState("error");
            }
            return;
        }
        configureSelfMode();
        if (!isLoggedIn()) {
            showState("guest");
            return;
        }
        showState("loading");
        try {
            const [portal, catalog] = await Promise.all([
                fetchPlayerPortal(),
                fetchSeasonCurrencyCatalog().catch(() => null),
            ]);
            render(portal, catalog);
        } catch (error) {
            showState(error instanceof PortalAuthError ? "guest" : "error");
        }
    }

    $("retry")?.addEventListener("click", () => void load());
    // React to login/logout happening in another tab or via the header while this page is open.
    if (publicMode) void load();
    else onAuthStateChange(() => void load());
</script>

