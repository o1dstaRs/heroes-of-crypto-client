        align-items: center;
        min-height: clamp(650px, calc(100svh - 68px), 780px);
        padding: 64px 0 58px;
    }

    .rules-hero-copy p {
        max-width: 720px;
        color: rgba(251, 244, 232, 0.82);
        font-size: 1.08rem;
    }

    .rules-hero-actions,
