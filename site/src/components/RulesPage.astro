---

{!embedded && <section class="rules-hero">
    <img class="rules-hero-bg" src="/assets/images/preview_game.webp" alt="" width="1200" height="630" />
    <div class="rules-hero-shade"></div>
    <div class="page-shell rules-hero-shell">
        <div class="rules-hero-copy">
            <p class="eyebrow">{copy.eyebrow}</p>
            <h1>{copy.title}</h1>
            <p>{copy.description}</p>
            <div class="rules-hero-actions">
                <a class="button primary" href={playHref}>
                    <img src="/assets/icons/navbar/joystick.svg" alt="" width="22" height="22" />
                    {copy.primaryCta}
                </a>
                <a class="button secondary" href={unitsHref}>{copy.secondaryCta}</a>
            </div>
        </div>

        <div class="rules-showcase" aria-label={copy.heroLabel}>
            <div class="rules-board-shot rules-hero-board" aria-hidden="true">
                <div class="rules-hero-board-grid">
                    {
                        Array.from({ length: 64 }).map((_, i) => (
                            <span
                                class:list={[
                                    {
                                        "is-deploy-left": i % 8 < 2,
                                        "is-deploy-right": i % 8 > 5,
                                        "is-center": i === 27 || i === 28 || i === 35 || i === 36,
                                        "is-hole": i < 8 || i > 55,
                                    },
                                ]}
                            />
                        ))
                    }
                </div>
                <img class="rules-hero-piece dragon" src="/assets/images/units/units/black_dragon_512.webp" alt="" width="512" height="512" loading="eager" />
                <img class="rules-hero-piece angel" src="/assets/images/units/units/angel_512.webp" alt="" width="512" height="512" loading="eager" />
                <img class="rules-hero-piece arbalester" src="/assets/images/units/units/arbalester_512.webp" alt="" width="512" height="512" loading="eager" />
                <img class="rules-hero-piece pegasus" src="/assets/images/units/units/pegasus_512.webp" alt="" width="512" height="512" loading="eager" />
                <img class="rules-hero-piece medusa" src="/assets/images/units/units/medusa_512.webp" alt="" width="512" height="512" loading="eager" />
            </div>
            <div class="rules-unit-line">
                {
                    heroUnits.map((unit) => (
                        <a
                            href={unitsHref}
                            class="rules-hero-unit"
                            style={`--faction: ${factionColors[unit.faction]}`}
                            aria-label={`${unit.name}, ${factionLabel(unit.faction)}`}
                        >
                            <img src={unit.icon} alt="" width="512" height="512" loading="eager" />
                            <span>{unit.name}</span>
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
</section>}

<div class:list={["rules-guide", { "is-embedded": embedded }]}>
    {!embedded && <section class="rules-stat-strip" aria-label={copy.eyebrow}>
        <div class="page-shell rules-stats">
            {copy.stats.map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}
        </div>
    </section>}

    <nav class="rules-guide-nav" aria-labelledby="rules-guide-nav-title">
        <div class="page-shell rules-guide-nav-layout">
            <div class="rules-guide-nav-intro">
                <p class="eyebrow">{isRu ? "Навигация" : "Guide navigation"}</p>
                <strong id="rules-guide-nav-title">{isRu ? "Правила по порядку" : "Read the rules in order"}</strong>
                <p>{isRu ? "Начните с основ или сразу откройте нужную механику." : "Start with the essentials or jump straight to the mechanic you need."}</p>
            </div>
            <div class="rules-guide-nav-groups">
                {guideNavigation.map((group) => (
                    <div>
                        <strong>{group.label}</strong>
                        <ol>
                            {group.items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
                        </ol>
                    </div>
                ))}
            </div>
        </div>
    </nav>

    <section class="section rules-section" id="rule-loop" tabindex="-1">
        <div class="page-shell">
            <div class="section-heading rules-reading-width">
                <p class="eyebrow">{isRu ? "Цикл боя" : "Fight loop"}</p>
                <SectionTitle class="rules-section-title">{copy.loopTitle}</SectionTitle>
                <p>{copy.loopIntro}</p>
            </div>
            <ol class="rules-phase-grid">
                {copy.phases.map((phase, index) => (
                    <li class="rules-card rules-step">
                        <span class="rules-step-number" aria-hidden="true">{index + 1}</span>
                        <ItemTitle>{phase.title.replace(/^\d+\.\s*/, "")}</ItemTitle>
                        <p>{phase.text}</p>
                    </li>
                ))}
            </ol>

            <section class="rules-reference" aria-labelledby="rules-reference-title">
                <div class="rules-reference-heading">
                    <p class="eyebrow">{isRu ? "Краткий справочник" : "Quick reference"}</p>
                    <ItemTitle id="rules-reference-title">{isRu ? "Ключевые числа и их смысл" : "Key numbers and why they matter"}</ItemTitle>
                </div>
                <dl class="rules-facts">
                    {quickFacts.map((fact) => (
                        <div class="rules-fact">
                            <dt><strong>{fact.value}</strong><span>{fact.label}</span></dt>
                            <dd>{fact.tip}</dd>
                        </div>
                    ))}
                </dl>
            </section>
        </div>
    </section>

    <section class="section rules-band" id="rule-victory" tabindex="-1">
        <div class="page-shell rules-two-col">
            <div class="rules-copy-block">
                <p class="eyebrow">{isRu ? "Победа" : "Victory"}</p>
                <SectionTitle class="rules-section-title">{copy.winTitle}</SectionTitle>
                {copy.winParagraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            <ul class="rules-note-list" aria-label={isRu ? "На что смотреть" : "What to watch"}>
                {copy.readBoard.map((item) => <li>{item}</li>)}
            </ul>
        </div>
    </section>

    <section class="section rules-section" id="rule-draft" tabindex="-1">
        <div class="page-shell">
            <div class="section-heading rules-reading-width">
                <p class="eyebrow">{isRu ? "Драфт" : "Draft"}</p>
                <SectionTitle class="rules-section-title">{copy.draftTitle}</SectionTitle>
                {copy.draftParagraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            <ol class="rules-action-grid rules-draft-steps">
                {copy.draftSteps.map((step) => (
                    <li class="rules-card compact">
                        <ItemTitle>{step.title}</ItemTitle>
                        <p>{step.text}</p>
                    </li>
                ))}
            </ol>
            <div class="rules-draft-reference">
                <div>
                    <ItemTitle>{isRu ? "Что важно помнить" : "What to remember"}</ItemTitle>
                    <ul class="rules-clean-list">
                        {copy.draftNotes.map((note) => <li>{note}</li>)}
                    </ul>
                </div>
                <div class="rules-table-scroll">
                    <table class="rules-level-table">
                        <caption>{isRu ? "Состав армии по уровням" : "Army composition by level"}</caption>
                        <thead>
                            <tr>
                                <th scope="col">{isRu ? "Уровень" : "Level"}</th>
                                <th scope="col">{isRu ? "Берёте" : "You draft"}</th>
                                <th scope="col">{isRu ? "В пуле" : "In pool"}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {levelRows.map((row) => (
                                <tr>
                                    <th scope="row">{isRu ? "Ур." : "Lv"} {row.level}</th>
                                    <td>×{row.draft}</td>
                                    <td>{row.available}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="rules-faction-grid" aria-label={isRu ? "Фракции" : "Factions"}>
                {factionUnits.map((faction) => (
                    <a
                        href={knowledgePath(lang, { section: "units", faction: faction.faction })}
                        class="rules-faction"
                        style={`--faction: ${faction.color}`}
                    >
                        <span class="rules-faction-head">
                            <img src={faction.icon} alt="" width="34" height="34" loading="lazy" />
                            <strong>{factionLabel(faction.faction)}</strong>
                            <em>{faction.units.length}</em>
                        </span>
                        <span>{factionDescriptions[lang][faction.faction]}</span>
                    </a>
                ))}
            </div>
        </div>
    </section>

    <section class="section rules-band" id="rule-unit-stats" tabindex="-1">
        <div class="page-shell">
            <div class="section-heading rules-reading-width">
                <p class="eyebrow">{isRu ? "Карточка юнита" : "Unit card"}</p>
                <SectionTitle class="rules-section-title">{copy.unitsTitle}</SectionTitle>
            </div>
            <div class="rules-unit-reader">
                <div class="rules-example-units">
                    {exampleUnits.map((unit) => (
                        <a
                            href={knowledgePath(lang, { section: "units", entry: unit.name, faction: unit.faction })}
                            class="rules-example-unit"
                            style={`--faction: ${factionColors[unit.faction]}`}
                        >
                            <img src={unit.icon} alt="" width="512" height="512" loading="lazy" />
                            <span>
                                <strong>{unit.name}</strong>
                                <em>
                                    {attackLabels[unit.attackType as keyof typeof attackLabels] ?? unit.attackType} ·{" "}
                                    {movementLabels[unit.movementType as keyof typeof movementLabels] ?? unit.movementType}
                                </em>
                            </span>
                        </a>
                    ))}
                </div>
                <dl class="rules-stat-reader">
                    {copy.unitStats.map((stat) => <div><dt>{stat.label}</dt><dd>{stat.text}</dd></div>)}
                    <div class="rules-role-row">
                        <dt class="sr-only">{isRu ? "Типы атак" : "Attack types"}</dt>
                        <dd>
                            {Object.entries(roleCounts).map(([role, count]) => (
                                <span><strong>{count}</strong>{attackLabels[role as keyof typeof attackLabels] ?? role}</span>
                            ))}
                        </dd>
                    </div>
