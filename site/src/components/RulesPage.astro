    }

    .rules-stat-strip {
        border-block: 1px solid var(--line);
        background: #10161b;
    }

    .rules-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1px;
    }

    .rules-stats div {
        min-height: 96px;
        padding: 20px 24px;
        background: rgba(255, 255, 255, 0.035);
    }

    .rules-stats strong {
        display: block;
        color: var(--gold);
        font-size: 2rem;
        line-height: 1;
    }

    .rules-stats span {
        display: block;
        margin-top: 8px;
        color: rgba(251, 244, 232, 0.72);
        font-size: 0.9rem;
    }

    .rules-guide-nav {
        padding-block: clamp(26px, 4cqi, 40px);
        border-bottom: 1px solid rgba(220, 177, 88, 0.24);
        background:
            linear-gradient(90deg, rgba(220, 177, 88, 0.055), transparent 46%),
            #0d1216;
    }

    .rules-guide-nav-layout {
        display: grid;
        grid-template-columns: minmax(190px, 0.62fr) minmax(0, 1.5fr);
        gap: clamp(28px, 5cqi, 56px);
        align-items: start;
    }

    .rules-guide-nav-intro > strong {
        display: block;
        color: var(--ink-strong);
        font-family: var(--hoc-font-display);
        font-size: 1.22rem;
        letter-spacing: 0.045em;
    }

    .rules-guide-nav-intro > p:last-child {
        max-width: 32ch;
        margin: 8px 0 0;
        font-size: 0.9rem;
    }

    .rules-guide-nav-groups {
        display: grid;
        grid-template-columns: 0.72fr 1.25fr 1fr;
        gap: clamp(18px, 4cqi, 38px);
    }

    .rules-guide-nav-groups > div > strong {
        display: block;
        margin-bottom: 8px;
        color: var(--gold);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .rules-guide-nav-groups ol {
        display: grid;
        gap: 4px;
        margin: 0;
        padding: 0;
        list-style: none;
        counter-reset: rule-link;
    }

    .rules-guide-nav-groups li {
        counter-increment: rule-link;
    }

    .rules-guide-nav-groups a {
        display: grid;
        grid-template-columns: 1.8em minmax(0, 1fr);
        gap: 7px;
        align-items: baseline;
        min-height: 30px;
        padding: 3px 0;
        color: rgba(251, 244, 232, 0.78);
        font-size: 0.88rem;
        line-height: 1.35;
        text-decoration: none;
    }

    .rules-guide-nav-groups a::before {
        color: rgba(220, 177, 88, 0.58);
        font-variant-numeric: tabular-nums;
        content: counter(rule-link, decimal-leading-zero);
    }

    .rules-guide-nav-groups a:hover {
        color: var(--gold-soft);
    }

    .rules-section,
    .rules-band {
        padding-block: clamp(44px, 6cqi, 68px);
        border-top: 1px solid rgba(255, 255, 255, 0.045);
    }

    .rules-section {
        background: #090d10;
    }

    .rules-band {
        background: #0e1419;
    }

    .rules-reading-width,
    .rules-copy-block {
        max-width: 72ch;
    }

    .rules-section-title {
        margin-bottom: 18px;
        font-size: clamp(1.7rem, 5cqi, 2.55rem);
        line-height: 1.08;
    }

    .rules-guide .section-heading {
        margin-bottom: 30px;
    }

    .rules-guide .section-heading > p:last-child,
    .rules-copy-block p {
        color: rgba(251, 244, 232, 0.78);
        font-size: 1rem;
    }

    .rules-game-capture {
        position: relative;
        min-width: 0;
        margin: 0;
        overflow: hidden;
        border: 1px solid rgba(220, 177, 88, 0.44);
        border-radius: 6px;
        background: #050708;
        box-shadow: 0 24px 54px rgba(0, 0, 0, 0.34);
    }

    .rules-game-capture::before,
    .rules-game-capture::after {
        position: absolute;
        z-index: 1;
        width: 54px;
        height: 54px;
        content: "";
        pointer-events: none;
    }

    .rules-game-capture::before {
        top: 9px;
        left: 9px;
        border-top: 1px solid rgba(242, 199, 93, 0.8);
        border-left: 1px solid rgba(242, 199, 93, 0.8);
    }

    .rules-game-capture::after {
        right: 9px;
        bottom: 68px;
        border-right: 1px solid rgba(242, 199, 93, 0.8);
        border-bottom: 1px solid rgba(242, 199, 93, 0.8);
    }

    .rules-game-capture > img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 1920 / 947;
        object-fit: cover;
        object-position: center;
    }

    .rules-game-capture-wide {
        margin: -4px 0 24px;
    }

    .rules-capture-caption {
        display: grid;
        grid-template-columns: max-content minmax(0, 1fr);
        gap: 15px;
        align-items: center;
        margin: 0;
        padding: 12px 16px;
        color: rgba(251, 244, 232, 0.72);
        border-top: 1px solid rgba(220, 177, 88, 0.24);
        background:
            linear-gradient(90deg, rgba(220, 177, 88, 0.12), transparent 42%),
            #090d10;
        font-size: 0.78rem;
        line-height: 1.45;
    }

    .rules-capture-kicker {
        display: inline-flex;
        gap: 7px;
        align-items: center;
        color: var(--gold-soft);
        font-family: var(--font-display);
        font-size: 0.7rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .rules-capture-kicker i {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #6fd186;
        box-shadow: 0 0 12px rgba(111, 209, 134, 0.75);
    }

    .rules-placement-compare {
        margin: -2px 0 26px;
        padding: clamp(18px, 3cqi, 28px);
        border: 1px solid rgba(220, 177, 88, 0.25);
        border-radius: 7px;
        background:
            radial-gradient(circle at 14% 0%, rgba(62, 170, 101, 0.1), transparent 34%),
            #070b0e;
        box-shadow: 0 22px 42px rgba(0, 0, 0, 0.22);
    }

    .rules-placement-compare-head {
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(250px, 0.92fr);
        gap: clamp(18px, 4cqi, 38px);
        align-items: end;
        margin-bottom: 20px;
    }

    .rules-placement-compare-head h3,
    .rules-placement-compare-head h4 {
        margin: 4px 0 0;
        color: var(--gold-soft);
        font-size: clamp(1.2rem, 3.2cqi, 1.65rem);
        line-height: 1.16;
    }

    .rules-placement-compare-head > p {
        margin: 0;
        color: rgba(251, 244, 232, 0.68);
        font-size: 0.86rem;
        line-height: 1.55;
    }

    .rules-placement-compare-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .rules-placement-variant {
        min-width: 0;
        margin: 0;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.085);
        border-radius: 5px;
        background: #0c1216;
    }

    .rules-placement-board {
        position: relative;
        overflow: hidden;
        border-bottom: 1px solid rgba(220, 177, 88, 0.2);
        background: #030506;
    }

    .rules-placement-board::after {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 62%, rgba(0, 0, 0, 0.48));
        content: "";
        pointer-events: none;
    }

    .rules-placement-board svg {
        display: block;
        width: 100%;
        height: auto;
    }

    .rules-placement-zone-wash {
        fill: rgba(41, 176, 91, 0.34);
        filter: drop-shadow(0 0 18px rgba(61, 211, 117, 0.34));
    }

    .rules-placement-zone-edge {
        fill: none;
        stroke: rgba(102, 225, 145, 0.96);
        stroke-linejoin: round;
        stroke-width: 6;
        vector-effect: non-scaling-stroke;
    }

    .rules-placement-side,
    .rules-placement-tier-number {
        position: absolute;
        z-index: 1;
        font-family: var(--font-display);
        letter-spacing: 0.11em;
    }

    .rules-placement-side {
        bottom: 10px;
        left: 11px;
        color: #a6efbd;
        font-size: 0.62rem;
        text-shadow: 0 1px 5px #000;
    }

    .rules-placement-tier-number {
        top: 9px;
        right: 10px;
        color: rgba(251, 244, 232, 0.66);
        font-size: 0.68rem;
    }

    .rules-placement-variant figcaption {
        display: grid;
        gap: 8px;
        padding: 13px 14px 15px;
    }

    .rules-placement-variant figcaption > span {
        display: flex;
        gap: 8px;
        align-items: baseline;
        justify-content: space-between;
    }

    .rules-placement-variant figcaption strong {
        color: var(--gold-soft);
        font-family: var(--font-display);
        font-size: 0.88rem;
        font-weight: 500;
    }

    .rules-placement-variant figcaption em {
        color: rgba(166, 239, 189, 0.68);
        font-size: 0.62rem;
        font-style: normal;
        letter-spacing: 0.04em;
        text-align: right;
        text-transform: uppercase;
    }

    .rules-placement-variant figcaption b {
        color: rgba(251, 244, 232, 0.9);
        font-size: 0.78rem;
        font-weight: 650;
        line-height: 1.35;
    }

    .rules-placement-variant figcaption p {
        margin: 0;
        color: rgba(251, 244, 232, 0.61);
        font-size: 0.72rem;
        line-height: 1.45;
    }

    .rules-phase-grid,
    .rules-action-grid,
    .rules-synergy-grid {
        display: grid;
        gap: 12px;
        margin: 0;
        padding: 0;
    }

    .rules-phase-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        list-style: none;
    }

    .rules-action-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .rules-draft-steps {
        list-style: none;
    }

    .rules-draft-steps .is-map-reveal {
        border-left-color: rgba(104, 177, 224, 0.9);
        background:
            radial-gradient(circle at 100% 0%, rgba(104, 177, 224, 0.12), transparent 42%),
            linear-gradient(90deg, rgba(104, 177, 224, 0.09), rgba(255, 255, 255, 0.02));
    }

    .rules-map-reveal-badge {
        display: inline-flex;
        margin-bottom: 9px;
        color: rgba(154, 210, 246, 0.88);
        font-size: 0.63rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .rules-synergy-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .rules-card {
        min-width: 0;
        padding: 19px 20px;
        border-left: 2px solid rgba(220, 177, 88, 0.56);
        background: linear-gradient(90deg, rgba(220, 177, 88, 0.075), rgba(255, 255, 255, 0.02));
    }

    .rules-card :is(h3, h4),
    .rules-synergy :is(h3, h4),
    .rules-mechanics-block > :is(h3, h4),
    .rules-reference-heading :is(h3, h4),
    .rules-morale-breakdown > :is(h3, h4),
    .rules-final-list > :is(h3, h4) {
        margin-bottom: 9px;
        color: var(--gold);
        font-size: 1.06rem;
    }

    .rules-card p,
    .rules-synergy li,
    .rules-final-list li {
        margin-bottom: 0;
    }

    .rules-step {
        position: relative;
        padding-left: 58px;
    }

    .rules-step-number {
        position: absolute;
        top: 18px;
        left: 17px;
        display: grid;
        width: 27px;
        height: 27px;
        place-items: center;
        color: #161006;
        border-radius: 50%;
        background: var(--gold);
        font-size: 0.8rem;
        font-variant-numeric: tabular-nums;
    }

    .rules-reference {
        margin-top: 38px;
        padding-top: 28px;
        border-top: 1px solid rgba(220, 177, 88, 0.25);
    }

    .rules-reference-heading {
        max-width: 72ch;
        margin-bottom: 12px;
    }

    .rules-facts {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin: 0;
    }

    .rules-fact {
        display: grid;
        grid-template-columns: minmax(105px, 0.65fr) minmax(0, 1.35fr);
        gap: 16px;
        min-width: 0;
        padding: 18px 18px 18px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.075);
    }

    .rules-fact:nth-child(odd) {
        padding-right: 24px;
        border-right: 1px solid rgba(255, 255, 255, 0.075);
    }

    .rules-fact:nth-child(even) {
        padding-left: 24px;
    }

    .rules-fact dt,
    .rules-fact dd {
        min-width: 0;
        margin: 0;
    }

    .rules-fact dt strong,
    .rules-fact dt span {
        display: block;
    }

    .rules-fact dt strong {
        color: var(--gold);
        font-size: 1.18rem;
        line-height: 1.05;
    }

    .rules-fact dt span {
        margin-top: 5px;
        color: rgba(251, 244, 232, 0.66);
        font-size: 0.78rem;
        line-height: 1.35;
    }

    .rules-fact dd {
        color: rgba(251, 244, 232, 0.76);
        font-size: 0.88rem;
    }

    .rules-two-col {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(340px, 1fr);
        gap: clamp(30px, 5cqi, 50px);
        align-items: center;
    }

    .rules-note-list {
        display: grid;
        gap: 0;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .rules-note-list li,
    .rules-note-list p {
        position: relative;
        margin: 0;
        padding: 14px 12px 14px 29px;
        color: rgba(251, 244, 232, 0.82);
        border-top: 1px solid rgba(255, 255, 255, 0.075);
    }

    .rules-note-list li::before,
    .rules-note-list p::before {
        position: absolute;
        top: 15px;
        left: 4px;
        color: var(--gold);
        content: "◆";
