        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
    }

    .rules-showcase {
        display: grid;
        gap: 14px;
        min-width: 0;
    }

    .rules-board-shot {
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.22);
        border-radius: 8px;
        background: #070808;
        box-shadow: var(--shadow);
    }

    .rules-board-shot > img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 1920 / 947;
        object-fit: cover;
    }

    .rules-hero-board {
        margin: 0;
    }

    .rules-unit-line {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
    }

    .rules-hero-unit,
    .rules-example-unit {
        display: grid;
        min-width: 0;
        overflow: hidden;
        border: 1px solid color-mix(in srgb, var(--faction) 44%, rgba(255, 255, 255, 0.14));
        border-radius: 8px;
        background:
            linear-gradient(180deg, color-mix(in srgb, var(--faction) 18%, transparent), rgba(6, 7, 8, 0.42)),
            #090b0d;
    }

    .rules-hero-unit img {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        object-position: center 18%;
    }

    .rules-hero-unit span {
        overflow: hidden;
        padding: 8px;
        color: var(--ink);
        font-size: 0.76rem;
        font-weight: 820;
        line-height: 1.08;
        text-align: center;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .rules-guide {
        container: rules-guide / inline-size;
        background: #090d10;
        color: var(--ink);
    }

    .rules-guide :is(p, li, dd, td) {
