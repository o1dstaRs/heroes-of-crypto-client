    .rules-role-row dd {
        display: flex;
        flex-wrap: wrap;
        gap: 7px 14px;
        margin: 0;
    }

    .rules-role-row span {
        color: rgba(251, 244, 232, 0.74);
        font-size: 0.84rem;
    }

    .rules-role-row span strong {
        margin-right: 5px;
        color: var(--gold);
    }

    .rules-synergy {
        min-width: 0;
        padding: 18px 20px;
        border-left: 2px solid var(--faction);
