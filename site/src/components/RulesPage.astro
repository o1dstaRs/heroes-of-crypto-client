    .rules-note-list.large p {
        padding-block: 17px;
        font-size: 0.95rem;
    }

    .rules-draft-reference {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) minmax(250px, 0.75fr);
        gap: 30px;
        align-items: start;
        margin-top: 32px;
    }

    .rules-draft-reference > div > :is(h3, h4) {
        color: var(--gold);
        font-size: 1.05rem;
    }

    .rules-clean-list {
        display: grid;
        gap: 9px;
        margin: 14px 0 0;
        padding-left: 20px;
        color: var(--muted);
    }

    .rules-table-scroll {
        max-width: 100%;
        overflow-x: auto;
        scrollbar-color: rgba(220, 177, 88, 0.42) rgba(255, 255, 255, 0.035);
        scrollbar-width: thin;
