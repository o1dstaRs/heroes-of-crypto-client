<style>
    .rules-hero {
        position: relative;
        overflow: hidden;
        background: #060708;
    }

    .rules-hero-bg,
    .rules-hero-shade {
        position: absolute;
        inset: 0;
    }

    .rules-hero-bg {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.45;
        transform: scale(1.04);
    }

    .rules-hero-shade {
        background:
            linear-gradient(90deg, rgba(6, 7, 8, 0.96), rgba(6, 7, 8, 0.7) 52%, rgba(6, 7, 8, 0.42)),
            linear-gradient(180deg, rgba(6, 7, 8, 0.12), #070808 100%);
