    .rules-table-scroll::-webkit-scrollbar {
        height: 7px;
    }

    .rules-table-scroll::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.035);
    }

    .rules-table-scroll::-webkit-scrollbar-thumb {
        border: 2px solid #0b1014;
        border-radius: 999px;
        background: rgba(220, 177, 88, 0.52);
    }

    .rules-level-table,
    .rules-aug-table,
    .rules-morale-table {
        width: 100%;
        border-collapse: collapse;
        background: rgba(255, 255, 255, 0.018);
    }

    :is(.rules-level-table, .rules-aug-table, .rules-morale-table) caption {
        padding: 12px 14px;
        color: var(--ink-strong);
        border-block: 1px solid rgba(220, 177, 88, 0.22);
        background: rgba(220, 177, 88, 0.065);
        font-size: 0.9rem;
        text-align: left;
    }

    :is(.rules-level-table, .rules-aug-table) thead th {
        padding: 10px 14px;
        color: rgba(251, 244, 232, 0.72);
        border-bottom: 1px solid var(--line);
        font-size: 0.74rem;
        text-align: left;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    :is(.rules-level-table, .rules-aug-table) tbody :is(th, td),
    .rules-morale-table :is(th, td) {
        padding: 11px 14px;
        color: rgba(251, 244, 232, 0.82);
        border-bottom: 1px solid rgba(255, 255, 255, 0.075);
        font-size: 0.9rem;
        text-align: left;
        vertical-align: top;
    }

    .rules-level-table :is(th, td):not(:first-child),
    .rules-aug-table :is(th, td):not(:first-child) {
        text-align: center;
    }

    .rules-level-table tbody td,
    .rules-aug-tier {
        color: var(--gold-soft);
        font-variant-numeric: tabular-nums;
    }

    .rules-aug-table {
        min-width: 680px;
    }

    .rules-aug-table thead th:first-child {
        width: 55%;
    }

    .rules-aug-name {
        display: flex;
        gap: 13px;
        align-items: flex-start;
        min-width: 0;
    }

    .rules-aug-name img {
        flex: 0 0 auto;
        width: 44px;
        height: 44px;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: #090b0d;
    }

    .rules-aug-name > div {
        display: grid;
        min-width: 0;
    }

    .rules-aug-name strong {
        color: var(--ink-strong);
    }

    .rules-aug-name em {
        color: var(--gold);
        font-size: 0.76rem;
        font-style: normal;
    }

    .rules-aug-name p {
        max-width: 65ch;
        margin: 5px 0 0;
        color: var(--muted);
        font-size: 0.84rem;
        font-weight: 400;
    }

    .rules-faction-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        margin-top: 30px;
    }

    .rules-faction {
        display: grid;
        gap: 9px;
        min-width: 0;
        padding: 15px 16px;
        border-left: 2px solid var(--faction);
        background:
            linear-gradient(90deg, color-mix(in srgb, var(--faction) 13%, transparent), transparent),
            rgba(255, 255, 255, 0.02);
        text-decoration: none;
    }

    .rules-faction:hover {
        background: color-mix(in srgb, var(--faction) 10%, rgba(255, 255, 255, 0.025));
    }

    .rules-faction-head {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        gap: 10px;
        align-items: center;
    }

    .rules-faction-head img {
        width: 30px;
        height: 30px;
    }

    .rules-faction-head strong {
        overflow: hidden;
        color: var(--ink);
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .rules-faction-head em {
        color: var(--gold);
        font-style: normal;
    }

    .rules-faction > span:last-child {
        color: rgba(251, 244, 232, 0.7);
        font-size: 0.88rem;
    }

    .rules-unit-reader {
        display: grid;
        grid-template-columns: minmax(360px, 0.9fr) minmax(0, 1fr);
        gap: 24px;
        align-items: start;
    }

    .rules-example-units {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
