    .rules-synergy-head img {
        width: 40px;
        height: 40px;
    }

    .rules-synergy-head :is(h3, h4) {
        margin: 0;
    }

    .rules-synergy-head span {
        color: rgba(251, 244, 232, 0.64);
        font-size: 0.8rem;
    }

    .rules-synergy ul {
        display: grid;
        gap: 8px;
        margin: 0;
        padding-left: 18px;
