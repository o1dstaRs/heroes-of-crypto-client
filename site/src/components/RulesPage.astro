    .rules-example-unit > span {
        align-self: end;
        display: grid;
        gap: 3px;
        min-width: 0;
        padding: 13px;
    }

    .rules-example-unit strong {
        color: #fff;
    }

    .rules-example-unit em {
        overflow: hidden;
        color: color-mix(in srgb, var(--faction) 80%, #fff);
        font-size: 0.76rem;
        font-style: normal;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .rules-stat-reader {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 18px;
        margin: 0;
    }

    .rules-stat-reader > div {
