---
import CreaturePortrait from "./CreaturePortrait.astro";
import {
    ArmorAugment,
    DefaultPlacementLevel1,
    EmpowerAugment,
    getArmorPower,
    getEmpowerPower,
    getMightPower,
    getMovementPower,
    getPlacementSizes,
    getSniperPower,
    MightAugment,
    MovementAugment,
    PlacementAugment,
    SniperAugment,
} from "@heroesofcrypto/common/src/augments/augment_properties";
import { PlacementType } from "@heroesofcrypto/common/src/grid/placement_properties";
import { NatureSynergy, SynergyKeysToPower } from "@heroesofcrypto/common/src/synergies/synergy_properties";

import { knowledgePath } from "../lib/knowledge-base";
import { links, type Language } from "../lib/site-data";
import { localizedFactionName } from "../lib/localization";
import { abilityCount, factionColors, factionUnits, unitCount, type FactionName, type Unit } from "../lib/units-data";

interface Props {
    lang: Language;
    embedded?: boolean;
}

const { lang, embedded = false } = Astro.props;
const isRu = lang === "ru";
const allUnits = factionUnits.flatMap((faction) => faction.units);
const byName = new Map(allUnits.map((unit) => [unit.name, unit]));
const pickUnits = (names: string[]) => names.map((name) => byName.get(name)).filter(Boolean) as Unit[];
const heroUnits = pickUnits(["Black Dragon", "Angel", "Behemoth", "Pegasus"]);
const exampleUnits = pickUnits(["Medusa", "Arbalester", "Hydra", "Thunderbird", "Satyr", "Gargantuan"]);
const unitsHref = knowledgePath(lang, { section: "units" });
const playHref = isRu ? "/ru/play/" : links.play;
const factionLabel = (faction: string) => localizedFactionName(lang, faction);
const rulesCombatImage = "/assets/images/knowledge-base/rules-live-combat.webp";
const rulesPlacementImage = "/assets/images/knowledge-base/rules-live-placement.webp";
const rulesEmptyBoardImage = "/assets/images/knowledge-base/rules-board-empty.webp";
const rulesPlacementZonesImage = "/assets/images/knowledge-base/rules-placement-zones-base.webp";
// The map illustration is a perspective-projected 16x16 board, not a flat rectangle. These guides follow
// the painted seams after 1, 3, and 5 narrowing layers instead of using percentage CSS insets that cut
// diagonally across the tiles. Coordinates are in the source artwork's 1470x940 space.
const mapNarrowingGuides = [
    { layer: 1, className: "one", color: "#ef4a3f", points: "277,2 1178,2 1253,833 198,833" },
    { layer: 3, className: "two", color: "#f2c75d", points: "399,100 1055,100 1092,679 360,679" },
    { layer: 5, className: "three", color: "#63d28a", points: "526,197 928,197 941,543 512,543" },
] as const;
const rulesVisuals = isRu
    ? {
          liveBadge: "Снято в игре",
          combatAlt:
              "Настоящий бой Heroes of Crypto: армии на каменном поле, карточка активного юнита, очередь ходов и журнал боя.",
          combatCaption:
              "Живой бой в песочнице: поле, стеки, очередь, способности и журнал — интерфейс самой игры.",
          placementAlt:
              "Настоящая расстановка Heroes of Crypto: по шесть стеков в зеленой и красной зонах поля.",
          placementCaption:
              "Фактическая расстановка 6 на 6. Цветные зоны и размер каждой фигуры совпадают с полем, на котором вы играете.",
      }
    : {
          liveBadge: "Captured in game",
          combatAlt:
              "A real Heroes of Crypto fight with both armies on the stone board, the active unit card, turn queue, and battle log.",
          combatCaption:
              "Live sandbox combat: the board, stacks, turn queue, abilities, and battle log are all the game's own interface.",
          placementAlt:
              "A real Heroes of Crypto placement screen with six stacks deployed in each green and red board zone.",
          placementCaption:
              "An actual 6-versus-6 deployment. The colored zones and every unit footprint match the board you play on.",
      };

const attackLabels = isRu
    ? {
          MELEE: "Ближний бой",
          RANGE: "Стрельба",
          MAGIC: "Магия",
          MELEE_MAGIC: "Ближний бой / магия",
      }
    : {
          MELEE: "Melee",
          RANGE: "Ranged",
          MAGIC: "Magic",
          MELEE_MAGIC: "Melee / magic",
      };

const movementLabels = isRu
    ? { WALK: "Пеший", FLY: "Летающий", TELEPORT: "Телепорт" }
    : { WALK: "Walk", FLY: "Fly", TELEPORT: "Teleport" };

// The draft never offers a summon-only creature (Arachna Spider), so the roster tallies leave it out.
const draftableUnits = allUnits.filter((unit) => !unit.summonedOnly);
const roleCounts = draftableUnits.reduce<Record<string, number>>((counts, unit) => {
    counts[unit.attackType] = (counts[unit.attackType] ?? 0) + 1;
    return counts;
}, {});

const levelCounts = draftableUnits.reduce<Record<number, number>>((counts, unit) => {
    counts[unit.level] = (counts[unit.level] ?? 0) + 1;
    return counts;
}, {});
const levelRows = [1, 2, 3, 4].map((level) => ({
    level,
    draft: [2, 2, 1, 1][level - 1],
    available: levelCounts[level] ?? 0,
}));

// Quick-reference numbers, all taken from the shared engine constants (constants.ts / grid).
// Each carries a short "what it means / how it affects the fight" tip shown on hover/focus.
const quickFacts = [
    {
        value: "16 × 16",
        label: isRu ? "клеток на поле" : "battlefield cells",
        tip: isRu
            ? "Поле боя — сетка 16×16. В этих клетках измеряются ходы, дальность атак и радиусы аур."
            : "The battlefield is a 16×16 grid. Every move, attack range and aura radius is measured in these cells.",
    },
    {
        value: "6–8",
        label: isRu ? "лимит стеков по расстановке" : "stack cap by Placement tier",
        tip: isRu
            ? "Апгрейд расстановки поднимает базовый предел с 6 до 7 или 8 стеков. Синергия Природы «Юниты на поле» добавляет ещё 2/3/4, поэтому абсолютный максимум — 12."
            : "The Placement augment raises the baseline cap from 6 to 7 or 8 stacks. Nature's Board Units synergy adds another 2/3/4, so the absolute cap is 12.",
    },
    {
        value: "2 / 2 / 1 / 1",
        label: isRu ? "драфт по уровням 1–4" : "draft by level 1–4",
        tip: isRu
            ? "За матч вы берёте 2 юнита 1 уровня, 2 — 2-го, 1 — 3-го и 1 — 4-го. Старшие существа сильнее поштучно, но размер каждого стека компенсирует ценность существа."
            : "Each match you draft two level-1 units, two level-2, one level-3 and one level-4. Senior creatures are stronger individually, but each stack's amount compensates for creature value.",
    },
    {
        value: "5–7",
        label: isRu ? "очков апгрейдов" : "augment points",
        tip: isRu
            ? "Доктрина даёт 5, 6 или 7 очков на командные апгрейды (броня, ближний бой, магия, стрельба, движение, зона расстановки) — чем меньше разведки, тем больше бюджет."
            : "Your doctrine grants 5, 6, or 7 points for team augments (armor, melee, magic, ranged, movement, deployment)—less scouting buys a larger budget.",
    },
    {
        value: "−20 … +20",
        label: isRu ? "диапазон морали" : "morale range",
        tip: isRu
            ? "В начале круга стек бросает шанс, равный его морали в процентах. Положительное срабатывание (Morale) ходит раньше обычной очереди и бьёт на 1,25× сильнее в этом круге; отрицательное (Dismorale) ходит после всех обычных стеков с 0,8× урона. Ход в обоих случаях один — мораль его не добавляет и не отнимает."
            : "At lap start a stack rolls its morale as a percentage chance. A positive roll (Morale) acts before the regular turn order with 1.25× damage for that lap; a negative roll (Dismorale) acts after every regular stack with 0.8× damage. Either way the stack keeps exactly one turn.",
    },
    {
        value: "−10 … +10",
        label: isRu ? "диапазон удачи" : "luck range",
        tip: isRu
            ? "Удача — в основном защита: удачливый стек получает примерно на 1% меньше урона от атак за очко, неудачливый — больше (заклинания её не учитывают). Каждое очко ещё добавляет 1 процентный пункт к шансам способностей стека. Удача перебрасывается каждый круг: база фракции (Природа +4, Жизнь и Сила +1, Хаос −1) плюс свежие −3…+3 и бонусы."
            : "Luck is mostly defensive: a lucky stack takes about 1% less attack damage per point, an unlucky one more (spells ignore it). Each point also adds 1 percentage point to the stack's own ability chances. It is re-rolled every lap: the faction base (Nature +4, Life and Might +1, Chaos −1) plus a fresh −3…+3 and bonuses.",
    },
    {
        value: "1 – 5",
        label: isRu ? "сила стека" : "stack power",
        tip: isRu
            ? "Оценка 1–5: опыт × живые существа стека как доля от сильнейшего стека на поле (до 20% → 1, до 40% → 2, до 60% → 3, до 80% → 4, выше → 5). Усиливает способности и ауры, помеченные как зависящие от силы стека, и открывает часть заклинаний; пересчитывается после каждого действия."
            : "A 1–5 rating: a stack's experience × living bodies as a share of the strongest stack on the board (up to 20% → 1, 40% → 2, 60% → 3, 80% → 4, above → 5). It scales stack-powered abilities and auras and gates some spells; it is recalculated after every action.",
    },
    {
        value: isRu ? "круги 4 · 7 · 10" : "laps 4 · 7 · 10",
        label: isRu ? "сужение карты" : "map narrowing",
        tip: isRu
            ? "Внешнее кольцо клеток становится провалами на 4-м, 7-м и 10-м кругах (на Barrels — на 5-м и 9-м). Если ни один стек не приблизился к врагу, кольцо приходит на круг раньше, а если за круг не было и урона — добавляется лишнее кольцо до конца боя. Юнитов толкает внутрь, а без места — убивает."
            : "The outer ring of cells turns into holes at laps 4, 7 and 10 (5 and 9 on Barrels). If no stack got closer to an enemy, the ring comes a lap early, and a lap with no damage either adds an extra ring for the rest of the fight. Units are pushed inward — or die if there's no room.",
    },
    {
        value: isRu ? "круги 12–15" : "laps 12–15",
        label: isRu ? "Армагеддон, волн" : "Armageddon, waves",
        tip: isRu
            ? "Круги 12–15 начинаются с волны Армагеддона, которая игнорирует броню и удачу: 25%, 50%, 75% и 100% исходного здоровья каждого стека (первая — не меньше 75). Первые три вместе — это 150%, так что третья волна добивает почти всех, а четвёртая уничтожает всех оставшихся: бой, доживший до 15-го круга, — ничья."
            : "Laps 12–15 each open with an Armageddon wave that ignores armor and luck: 25%, 50%, 75% and 100% of each stack's original health (the first at least 75). The first three add up to 150%, so wave 3 finishes almost every stack and wave 4 destroys whatever is left: a fight that reaches lap 15 is a draw.",
    },
    {
        value: isRu ? "12–60 сек" : "12–60 s",
        label: isRu ? "время на ход" : "per-turn timer",
        tip: isRu
            ? "Ход длится до 60 секунд из 4-минутного бюджета армии на круг, и каждому стеку, который ещё не ходил, всегда остаётся минимум 12 секунд. Раз за круг можно попросить дополнительное время. В рейтинге первый пропуск таймера за бой играет Hourglass (или Luck Shield), следующие пропуски играет ИИ, а после двух пропусков подряд ИИ ведёт ваши стеки, пока вы снова не сделаете ход."
            : "A turn gets up to 60 seconds from the army's 4-minute budget for the lap, always leaving at least 12 seconds for each stack still to act. Once per lap you can ask for extra time. In ranked, your first missed deadline of the fight plays Hourglass (or Luck Shield), later misses are played by the AI, and after two misses in a row the AI plays your seat until you act again.",
    },
    {
        value: "×8",
        label: isRu ? "макс. штраф дальности" : "max range divisor",
        tip: isRu
            ? "Урон выстрела делится на 2 во второй полосе дальности, на 4 в третьей и на 8 дальше; ширина полосы — дистанция выстрела юнита. Держите стрелков в радиусе: апгрейд «Стрельба» расширяет каждую полосу, но не отменяет штраф."
            : "A shot's damage is halved in the second band of its shot distance, quartered in the third and divided by 8 beyond; a band is the unit's shot distance wide. Keep shooters in range: the Sniper augment widens every band but does not remove falloff.",
    },
    {
        value: "×0.5",
        label: isRu ? "стрелок в упор" : "ranged-in-melee",
        tip: isRu
            ? "Удары стрелка в ближнем бою — и атаки, и ответы — наносят половину урона, если у него нет Handyman. Не подпускайте врага вплотную: враг в любой соседней клетке, включая диагональ, ещё и не даёт стрелять."
            : "A shooter's melee hits — attacks and retaliations alike — deal half damage unless it has Handyman. Keep shooters out of contact: an enemy in any touching cell, diagonals included, also stops them shooting.",
    },
];

// Augment tiers are derived from the same functions the game UI and engine use.
const armorPowers = [ArmorAugment.LEVEL_1, ArmorAugment.LEVEL_2, ArmorAugment.LEVEL_3].map(getArmorPower);
const mightPowers = [MightAugment.LEVEL_1, MightAugment.LEVEL_2, MightAugment.LEVEL_3].map(getMightPower);
const empowerPowers = [EmpowerAugment.LEVEL_1, EmpowerAugment.LEVEL_2, EmpowerAugment.LEVEL_3].map(getEmpowerPower);
const sniperPowers = [SniperAugment.LEVEL_1, SniperAugment.LEVEL_2, SniperAugment.LEVEL_3].map(getSniperPower);
const movementPowers = [MovementAugment.LEVEL_1, MovementAugment.LEVEL_2].map(getMovementPower);
const placementDepths = [PlacementAugment.LEVEL_1, PlacementAugment.LEVEL_2, PlacementAugment.LEVEL_3].map(
    (level) =>
        getPlacementSizes(PlacementType.RECTANGLE, level, DefaultPlacementLevel1.THREE_BY_THREE)[0],
);
const flyingArmorTiers = [1, 2, 3]
    .map((level) => SynergyKeysToPower[`Nature:${NatureSynergy.PLUS_FLY_ARMOR}:${level}`]?.[0] ?? 0)
    .map((power) => `+${power}%`)
    .join(" / ");
const placementZoneVisuals = [
    {
        tier: isRu ? "Бесплатно" : "Free",
        cost: isRu ? "уровень 1 · до 6 стеков" : "tier 1 · up to 6 stacks",
        title: isRu ? `${placementDepths[0]} клетки вглубь · частично` : `${placementDepths[0]} cells deep · partial`,
        detail: isRu
            ? "Крайняя боковая колонка и верхний/нижний торцы закрыты."
            : "The outer side column and the top/bottom ends stay closed.",
        points: "295,349 495,349 434,1244 171,1244",
    },
    {
        tier: isRu ? "1 очко" : "1 point",
        cost: isRu ? "уровень 2 · до 7 стеков" : "tier 2 · up to 7 stacks",
        title: isRu ? `${placementDepths[1]} клетки вглубь · полная высота` : `${placementDepths[1]} cells deep · full height`,
        detail: isRu
            ? "Зона доходит до верхнего и нижнего края, но боковая кромка ещё закрыта."
            : "The zone reaches both ends of the board, but the side-edge column stays closed.",
        points: "301,310 563,310 518,1342 157,1342",
    },
    {
        tier: isRu ? "2 очка" : "2 points",
        cost: isRu ? "уровень 3 · до 8 стеков" : "tier 3 · up to 8 stacks",
        title: isRu ? `${placementDepths[2]} клеток вглубь · с краем` : `${placementDepths[2]} cells deep · edge open`,
        detail: isRu
            ? "Самая глубокая зона: вся высота поля и крайняя боковая колонка открыты."
            : "The deepest zone opens the full board height and the outermost side column.",
        points: "235,310 628,310 608,1342 67,1342",
    },
];
const augmentTable = [
    {
        icon: "/assets/images/units/abilities/armor_augment_256.webp",
        name: isRu ? "Броня" : "Armor",
        tiers: armorPowers.map((power) => `+${power}% / +${power}`),
        // One purchase, both defences, but they land differently: physical armor gains a PERCENTAGE of the
        // unit's own stat, magic armor gains the points outright (base magic armor is 0/5/10/15 by creature
        // level, so a percentage would give a level 1 creature nothing at all).
        note: isRu ? "% брони, очки магической брони" : "% armor, flat magic armor",
    },
    {
        icon: "/assets/images/units/abilities/might_augment_256.webp",
        name: isRu ? "Сила" : "Might",
        tiers: mightPowers.map((power) => `+${power}%`),
        note: isRu ? "ближняя атака" : "melee attack",
    },
    {
        icon: "/assets/images/units/abilities/empower_augment_256.webp",
        name: isRu ? "Магия" : "Empower",
        tiers: empowerPowers.map((power) => `+${power}%`),
        note: isRu ? "магический урон" : "magic damage",
    },
    {
        icon: "/assets/images/units/abilities/sniper_augment_256.webp",
        name: isRu ? "Стрельба" : "Sniper",
        tiers: sniperPowers.map(([attack, range]) => `+${attack}% / +${range}%`),
        note: isRu ? "атака / дистанция выстрела" : "attack / shot range",
    },
    {
        icon: "/assets/images/units/abilities/movement_augment_256.webp",
        name: isRu ? "Движение" : "Movement",
        tiers: [`+${movementPowers[0]}`, `+${movementPowers[1]}`, "—"],
        note: isRu ? "шага к ходу" : "steps to move",
    },
    {
        icon: "/assets/images/units/abilities/board_augment_256.webp",
        name: isRu ? "Расстановка" : "Placement",
        tiers: isRu
            ? [
                  `бесплатно · ${placementDepths[0]} клетки вглубь, частично`,
                  `1 очко · ${placementDepths[1]} клетки, полная высота`,
                  `2 очка · ${placementDepths[2]} клеток + боковой край`,
              ]
            : [
                  `free · ${placementDepths[0]} cells deep, partial`,
                  `1 point · ${placementDepths[1]} cells, full height`,
                  `2 points · ${placementDepths[2]} cells + side edge`,
              ],
        note: isRu ? "стоимость · глубина от своей стороны" : "cost · depth from your side",
    },
];

const copy = isRu
    ? {
          eyebrow: "Правила игры",
          title: "Как играть в Heroes of Crypto",
          description:
              "Соберите небольшой отряд, расставьте его на поле 16x16 и выиграйте бой через позиционирование, синергии, мораль, магию и сужающуюся карту. Этот раздел описывает реальные правила из общего TypeScript-движка игры.",
          primaryCta: "Играть",
          secondaryCta: "Открыть юнитов",
          heroLabel: "Примеры боевых юнитов",
          stats: [
              { value: String(unitCount), label: "юнитов в справочнике" },
              { value: String(factionUnits.length), label: "игровые фракции" },
              { value: String(abilityCount), label: "способностей" },
          ],
          loopTitle: "Партия в одну минуту",
          loopIntro:
              "Думайте о матче как о цепочке понятных решений. Вы не смотрите симуляцию в черном ящике: выборы игрока проходят через общий движок, а клиент показывает события на доске.",
          phases: [
              {
                  title: "1. Драфт",
                  text: "Вы берете компактный состав по уровням: два юнита 1 уровня, два 2 уровня, один 3 уровня и один 4 уровня. Баны и инструменты раскрытия помогают контролировать скрытую информацию.",
              },
              {
                  title: "2. Апгрейды и синергии",
                  text: "После драфта вы тратите бюджет доктрины на апгрейды. Бонус каждой фракции уже определён идентификатором матча и автоматически достигает уровня 1/2/3 при 2/4/6 юнитах этой фракции — выбирать синергию отдельно не нужно.",
              },
              {
                  title: "3. Расстановка",
                  text: "Вы выставляете стеки в своей зоне. След крупного существа может быть 2x1 или 2x2, дальники хотят линии огня, а ауры работают только там, где их зона реально достаёт.",
              },
              {
                  title: "4. Бой",
                  text: "За ход активный стек делает одно действие: перемещение, ближнюю атаку (подойдя к цели, если нужно), выстрел, заклинание, ожидание через Hourglass, защиту Luck Shield или пропуск. Перемещение завершает ход, поэтому стрелок или маг действует с того места, где уже стоит.",
              },
          ],
          winTitle: "Цель простая: оставить на доске свою армию",
          winParagraphs: [
              "Каждый юнит на поле - это стек, а не один солдат. Урон снимает здоровье текущей фигуры внутри стека, затем убивает следующую. Когда живых существ в стеке не остается, стек исчезает с доски.",
              "Вы выигрываете, когда у соперника не осталось живых стеков. Если обе армии уничтожены одним событием — например, одной волной Армагеддона, — бой заканчивается ничьей. При затягивании карта сужается, а первая волна Армагеддона приходит в начале 12-го круга; четвёртая, в начале 15-го круга, уничтожает все оставшиеся стеки, поэтому бой, доживший до 15-го круга, заканчивается ничьей.",
              "Выход из рейтингового боя или отключение дольше 5 минут отдаёт победу сопернику; если отсутствуют оба игрока, бой заканчивается ничьей.",
          ],
          readBoard: [
