---
import { rankedArenaCopy, type RankedArenaLanguage } from "../lib/ranked-arena-copy";

interface Props {
    lang: RankedArenaLanguage;
}

const { lang } = Astro.props;
const copy = rankedArenaCopy[lang];
const playHref = lang === "ru" ? "/ru/play/" : "/play/ranked/";
const pendingUpdatedLabel = copy.updated.replace("{time}", "—");
---

<section
    class="ranked-arena section"
    id="arena"
    data-ranked-arena
    data-state="connecting"
    data-language={lang}
    data-play-href={playHref}
    aria-labelledby="ranked-arena-title"
>
    <div class="ranked-arena__glow" aria-hidden="true"></div>
    <div class="page-shell ranked-arena__shell">
        <header class="ranked-arena__heading">
            <div class="ranked-arena__intro">
                <span class="ranked-arena__sigil" aria-hidden="true">
                    <img src="/assets/images/home/logo/hocai_logo_96.png" alt="" width="52" height="52" />
                </span>
                <div class="ranked-arena__intro-copy">
                    <p class="eyebrow">{copy.eyebrow}</p>
                    <h2 id="ranked-arena-title">{copy.title}</h2>
                    <p>{copy.body}</p>
                </div>
            </div>

            <div class="ranked-arena__connection">
                <div class="ranked-arena__connection-copy">
                    <span class="ranked-arena__status" role="status" aria-live="polite" aria-atomic="true">
                        <span class="ranked-arena__status-dot" aria-hidden="true"></span>
                        <span data-arena-status>{copy.connecting}</span>
                    </span>
                    <span class="ranked-arena__updated" data-arena-updated>{pendingUpdatedLabel}</span>
                </div>
                <button
                    class="ranked-arena__refresh"
                    type="button"
                    data-arena-refresh
                    aria-label={copy.refresh}
                    title={copy.refresh}
                >
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                        <path d="M20 11a8 8 0 1 0-2.34 5.66M20 5v6h-6"></path>
                    </svg>
                    <span>{copy.refresh}</span>
                </button>
            </div>
        </header>

        <div class="ranked-arena__frame">
            <div class="ranked-arena__navigation">
                <div class="ranked-arena__tabs" role="tablist" aria-label={copy.eyebrow}>
                    <button
                        class="ranked-arena__tab"
                        id="ranked-arena-tab-players"
                        type="button"
                        role="tab"
                        aria-controls="ranked-arena-panel"
                        aria-selected="false"
                        tabindex="-1"
                        data-arena-tab="players"
                    >
                        <span>{copy.playersTab}</span>
                        <span class="ranked-arena__tab-count" data-arena-count aria-hidden="true">—</span>
                    </button>
                    <button
                        class="ranked-arena__tab"
                        id="ranked-arena-tab-games"
                        type="button"
                        role="tab"
                        aria-controls="ranked-arena-panel"
                        aria-selected="true"
                        tabindex="0"
                        data-arena-tab="games"
                    >
                        <span>{copy.gamesTab}</span>
                        <span class="ranked-arena__tab-count" data-arena-count aria-hidden="true">—</span>
                    </button>
                    <button
                        class="ranked-arena__tab"
                        id="ranked-arena-tab-leagues"
                        type="button"
                        role="tab"
                        aria-controls="ranked-arena-panel"
                        aria-selected="false"
                        tabindex="-1"
                        data-arena-tab="leagues"
                    >
                        <span>{copy.leaguesTab}</span>
                        <span class="ranked-arena__tab-count" data-arena-count aria-hidden="true">—</span>
                    </button>
                </div>

                <a class="button primary ranked-arena__play" href={playHref}>{copy.playRanked}</a>
            </div>

            <div class="ranked-arena__controls" aria-label={copy.searchLabel}>
                <label class="ranked-arena__control ranked-arena__control--search" for="ranked-arena-search">
                    <span class="ranked-arena__control-label">{copy.searchLabel}</span>
                    <span class="ranked-arena__field ranked-arena__search-field">
                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                            <circle cx="11" cy="11" r="6.5"></circle>
                            <path d="m16 16 4 4"></path>
                        </svg>
                        <input
                            id="ranked-arena-search"
                            type="search"
                            inputmode="search"
                            autocomplete="off"
                            spellcheck="false"
                            placeholder={copy.searchPlaceholder}
                            data-arena-search
                        />
                        <button
                            class="ranked-arena__clear"
                            type="button"
                            data-arena-clear
                            aria-label={copy.clearSearch}
                            title={copy.clearSearch}
                            hidden
                        >
                            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
                                <path d="m7 7 10 10M17 7 7 17"></path>
                            </svg>
                        </button>
                    </span>
                </label>

                <label class="ranked-arena__control" for="ranked-arena-filter" data-arena-filter-field>
                    <span class="ranked-arena__control-label">{copy.filterLabel}</span>
                    <span class="ranked-arena__field ranked-arena__select-field">
                        <select id="ranked-arena-filter" data-arena-filter>
                            <option value="all">{copy.allLeagues}</option>
                        </select>
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                            <path d="m7 10 5 5 5-5"></path>
                        </svg>
                    </span>
                </label>

                <label class="ranked-arena__control" for="ranked-arena-sort" data-arena-sort-field>
                    <span class="ranked-arena__control-label">{copy.sortLabel}</span>
                    <span class="ranked-arena__field ranked-arena__select-field">
                        <select id="ranked-arena-sort" data-arena-sort>
                            <option value="rank">{copy.sortRank}</option>
                            <option value="rating">{copy.sortRating}</option>
                            <option value="winRate">{copy.sortWinRate}</option>
                            <option value="wins">{copy.sortWins}</option>
                            <option value="streak">{copy.sortStreak}</option>
                        </select>
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                            <path d="m7 10 5 5 5-5"></path>
                        </svg>
                    </span>
                </label>
            </div>

            <div
                class="ranked-arena__panel"
                id="ranked-arena-panel"
                role="tabpanel"
                aria-labelledby="ranked-arena-tab-games"
                tabindex="0"
                data-arena-panel
            >
                <div class="ranked-arena__loading">
                    <div class="ranked-arena__loading-copy">
                        <span class="ranked-arena__loading-mark" aria-hidden="true">
                            <span></span>
                        </span>
                        <div>
                            <strong>{copy.connecting}</strong>
                            <p>{copy.body}</p>
                        </div>
                    </div>
                    <div class="ranked-arena__skeleton" aria-hidden="true">
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                </div>

                <noscript>
                    <div class="ranked-arena__no-js">
                        <p>{copy.noJs}</p>
                        <a class="button secondary" href={playHref}>{copy.playRanked}</a>
                    </div>
                </noscript>
            </div>

            <p class="ranked-arena__announcer" data-arena-announcer aria-live="polite" aria-atomic="true"></p>
        </div>
    </div>
</section>

<style is:global>
    .ranked-arena {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        scroll-margin-top: 92px;
        border-block: 1px solid rgba(151, 104, 50, 0.42);
        background:
            linear-gradient(180deg, rgba(7, 5, 4, 0.28), rgba(7, 5, 4, 0.94)),
            radial-gradient(circle at 10% 10%, rgba(255, 90, 63, 0.1), transparent 34%),
            radial-gradient(circle at 88% 22%, rgba(220, 177, 88, 0.1), transparent 31%), #0b0704;
        font-family: var(--hoc-font-ui, var(--hoc-font-display, inherit));
        font-synthesis: none;
    }

    .ranked-arena::before {
        position: absolute;
        z-index: -2;
        inset: 0;
        background-image:
            linear-gradient(rgba(220, 177, 88, 0.018) 1px, transparent 1px),
            linear-gradient(90deg, rgba(220, 177, 88, 0.018) 1px, transparent 1px);
        background-size: 48px 48px;
        mask-image: linear-gradient(180deg, #000, transparent 86%);
        content: "";
    }

    .ranked-arena .ranked-arena__glow {
        position: absolute;
        z-index: -1;
        top: -170px;
        left: 50%;
        width: min(900px, 90vw);
        height: 340px;
        border-radius: 50%;
        background: rgba(220, 177, 88, 0.08);
        filter: blur(90px);
        transform: translateX(-50%);
        pointer-events: none;
    }

    .ranked-arena .ranked-arena__shell {
        position: relative;
        z-index: 1;
    }

    .ranked-arena .ranked-arena__heading {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 24px;
        align-items: center;
        margin-bottom: 22px;
        padding: 16px 18px;
        border: 1px solid rgba(151, 104, 50, 0.46);
        border-radius: 2px;
        clip-path: polygon(
            10px 0,
            calc(100% - 10px) 0,
            100% 10px,
            100% calc(100% - 10px),
            calc(100% - 10px) 100%,
            10px 100%,
            0 calc(100% - 10px),
            0 10px
        );
        background:
            linear-gradient(90deg, rgba(70, 40, 18, 0.72), rgba(13, 8, 5, 0.9) 54%),
            rgba(14, 9, 5, 0.94);
        box-shadow:
            inset 0 1px rgba(239, 228, 204, 0.045),
            inset 0 0 24px rgba(0, 0, 0, 0.36);
    }

    .ranked-arena .ranked-arena__intro {
        display: flex;
        gap: 15px;
        align-items: center;
        max-width: 760px;
        min-width: 0;
    }

    .ranked-arena .ranked-arena__sigil {
        display: grid;
        flex: 0 0 auto;
        place-items: center;
        width: 62px;
        height: 62px;
        border: 1px solid rgba(220, 177, 88, 0.46);
        border-radius: 50%;
        background: radial-gradient(circle, rgba(111, 53, 18, 0.82), rgba(11, 7, 4, 0.98) 70%);
        box-shadow:
            inset 0 0 0 3px rgba(0, 0, 0, 0.42),
            0 0 16px rgba(255, 143, 0, 0.1);
    }

    .ranked-arena .ranked-arena__sigil img {
        width: 50px;
        height: 50px;
    }

    .ranked-arena .ranked-arena__intro-copy {
        min-width: 0;
    }

    .ranked-arena .ranked-arena__intro h2 {
        margin-bottom: 14px;
    }

    .ranked-arena .ranked-arena__intro-copy > p:last-child {
        max-width: 690px;
        margin-bottom: 0;
        font-size: 1.02rem;
    }

    .ranked-arena .ranked-arena__connection {
        display: flex;
        gap: 12px;
        align-items: center;
        justify-content: flex-end;
        min-width: 0;
    }

    .ranked-arena .ranked-arena__connection-copy {
        display: grid;
        justify-items: end;
        min-width: 0;
    }

    .ranked-arena .ranked-arena__status {
        display: inline-flex;
        gap: 8px;
        align-items: center;
        color: var(--ink);
        font-size: 0.86rem;
        font-weight: 790;
        white-space: nowrap;
    }

    .ranked-arena .ranked-arena__status-dot {
        width: 9px;
        height: 9px;
        border: 2px solid rgba(242, 199, 93, 0.35);
        border-radius: 50%;
        background: var(--gold);
        box-shadow: 0 0 0 0 rgba(242, 199, 93, 0.35);
        animation: ranked-arena-pulse 1.8s ease-out infinite;
    }

    .ranked-arena[data-state="live"] .ranked-arena__status-dot,
    .ranked-arena[data-connection="live"] .ranked-arena__status-dot {
        border-color: rgba(99, 210, 138, 0.38);
        background: var(--green);
        box-shadow: 0 0 18px rgba(99, 210, 138, 0.42);
        animation: none;
    }

    .ranked-arena[data-state="partial"] .ranked-arena__status-dot,
    .ranked-arena[data-connection="partial"] .ranked-arena__status-dot {
        background: var(--gold);
        animation: none;
    }

    .ranked-arena[data-state="unavailable"] .ranked-arena__status-dot,
    .ranked-arena[data-connection="error"] .ranked-arena__status-dot {
        border-color: rgba(239, 74, 63, 0.4);
        background: var(--red);
        animation: none;
    }

    .ranked-arena .ranked-arena__updated {
        overflow: hidden;
        max-width: 210px;
        color: var(--muted-2);
        font-size: 0.76rem;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ranked-arena .ranked-arena__refresh {
        display: inline-flex;
        gap: 8px;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 9px 12px;
        border: 1px solid rgba(151, 104, 50, 0.56);
        border-radius: 2px;
        background: linear-gradient(180deg, rgba(57, 36, 19, 0.92), rgba(24, 14, 8, 0.96));
        color: var(--ink);
        font: inherit;
        font-size: 0.82rem;
        font-weight: 400;
        letter-spacing: 0.065em;
        text-transform: uppercase;
        cursor: pointer;
        transition:
            border-color 0.16s ease,
            background 0.16s ease,
            color 0.16s ease;
    }

    .ranked-arena .ranked-arena__refresh:hover {
        border-color: rgba(220, 177, 88, 0.72);
        background: linear-gradient(180deg, rgba(76, 47, 23, 0.96), rgba(31, 18, 9, 0.98));
        color: var(--gold-soft);
        box-shadow: 0 0 16px rgba(255, 143, 0, 0.12);
    }

    .ranked-arena .ranked-arena__refresh:disabled {
        cursor: wait;
        opacity: 0.66;
    }

    .ranked-arena .ranked-arena__refresh svg,
    .ranked-arena .ranked-arena__field svg {
        flex: 0 0 auto;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.8;
    }

    .ranked-arena[data-refreshing="true"] .ranked-arena__refresh svg,
    .ranked-arena[aria-busy="true"] .ranked-arena__refresh svg {
        animation: ranked-arena-spin 0.75s linear infinite;
    }

    .ranked-arena .ranked-arena__frame {
        overflow: hidden;
        border: 15px solid transparent;
        border-radius: 0;
        border-image-source: url("/assets/images/ui/pick_phase_ember_panel_frame_9slice.webp");
        border-image-slice: 140 160 fill;
        border-image-width: 16px;
        border-image-repeat: stretch;
        background: rgba(13, 8, 5, 0.97);
        box-shadow:
            0 24px 60px rgba(0, 0, 0, 0.55),
            0 0 32px rgba(255, 119, 0, 0.08);
    }

    .ranked-arena .ranked-arena__navigation {
        display: flex;
        gap: 20px;
        align-items: center;
        justify-content: space-between;
        min-width: 0;
        padding: 14px 16px;
        border-bottom: 1px solid rgba(151, 104, 50, 0.44);
        background: linear-gradient(180deg, rgba(42, 25, 13, 0.92), rgba(18, 11, 7, 0.94));
    }

    .ranked-arena .ranked-arena__tabs {
        display: flex;
        gap: 5px;
        min-width: 0;
        padding: 4px;
        border: 1px solid rgba(151, 104, 50, 0.46);
        border-radius: 2px;
        background: rgba(6, 4, 3, 0.58);
    }

    .ranked-arena .ranked-arena__tab {
        display: inline-flex;
        gap: 8px;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 9px 14px;
        border: 1px solid transparent;
        border-radius: 1px;
        background: transparent;
        color: var(--muted);
        font: inherit;
        font-size: 0.9rem;
        font-weight: 400;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        white-space: nowrap;
        cursor: pointer;
        transition:
            border-color 0.16s ease,
            background 0.16s ease,
            color 0.16s ease;
    }

    .ranked-arena .ranked-arena__tab:hover {
        color: var(--ink);
    }

    .ranked-arena .ranked-arena__tab[aria-selected="true"] {
        border-color: rgba(220, 177, 88, 0.64);
        background: linear-gradient(180deg, rgba(101, 65, 25, 0.72), rgba(38, 22, 10, 0.8));
        color: var(--gold-soft);
        box-shadow:
            inset 0 1px rgba(255, 231, 168, 0.1),
            0 0 14px rgba(255, 143, 0, 0.09);
    }

    .ranked-arena .ranked-arena__tab-count {
        min-width: 24px;
        padding: 2px 6px;
        border: 1px solid rgba(151, 104, 50, 0.38);
        border-radius: 1px;
        background: rgba(7, 5, 4, 0.58);
        color: var(--muted);
        font-size: 0.7rem;
        line-height: 1.45;
        text-align: center;
    }

    .ranked-arena .ranked-arena__tab[aria-selected="true"] .ranked-arena__tab-count {
        border-color: rgba(220, 177, 88, 0.48);
        background: rgba(220, 177, 88, 0.13);
        color: var(--gold-soft);
    }

    .ranked-arena .ranked-arena__play {
        flex: 0 0 auto;
        min-height: 44px;
        padding-block: 10px;
        font-size: 0.9rem;
    }

    .ranked-arena .ranked-arena__controls {
        display: grid;
        grid-template-columns: minmax(260px, 1fr) minmax(150px, 0.34fr) minmax(150px, 0.34fr);
        gap: 12px;
        padding: 16px;
        border-bottom: 1px solid rgba(151, 104, 50, 0.38);
        background: rgba(8, 5, 3, 0.72);
    }

    .ranked-arena .ranked-arena__control {
        display: grid;
        gap: 6px;
        min-width: 0;
    }

    .ranked-arena .ranked-arena__control-label {
        color: var(--muted-2);
        font-size: 0.7rem;
        font-weight: 400;
        letter-spacing: 0.1em;
        line-height: 1.2;
        text-transform: uppercase;
    }

    .ranked-arena .ranked-arena__field {
        display: flex;
        align-items: center;
        min-width: 0;
        min-height: 44px;
        border: 1px solid rgba(151, 104, 50, 0.46);
        border-radius: 2px;
        background:
            linear-gradient(180deg, rgba(29, 17, 9, 0.94), rgba(12, 8, 5, 0.98)),
            rgba(7, 5, 4, 0.94);
        color: var(--muted);
        transition:
            border-color 0.16s ease,
            background 0.16s ease,
            box-shadow 0.16s ease;
    }

    .ranked-arena .ranked-arena__field:focus-within {
        border-color: rgba(220, 177, 88, 0.72);
        background: linear-gradient(180deg, rgba(37, 23, 12, 0.98), rgba(15, 9, 5, 0.98));
        box-shadow:
            inset 0 0 12px rgba(255, 143, 0, 0.04),
            0 0 0 2px rgba(220, 177, 88, 0.08);
    }

    .ranked-arena .ranked-arena__search-field {
        gap: 9px;
        padding-left: 13px;
    }

    .ranked-arena .ranked-arena__field input,
    .ranked-arena .ranked-arena__field select {
        width: 100%;
        min-width: 0;
        min-height: 42px;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--ink);
        font: inherit;
        font-size: 0.9rem;
        font-family: var(--hoc-font-ui, var(--hoc-font-display, inherit));
        font-synthesis: none;
        letter-spacing: 0.025em;
    }

    .ranked-arena .ranked-arena__field input::placeholder {
        color: var(--muted-2);
    }

    .ranked-arena .ranked-arena__field input::-webkit-search-cancel-button {
        display: none;
    }

    .ranked-arena .ranked-arena__select-field {
        position: relative;
    }

    .ranked-arena .ranked-arena__select-field select {
        appearance: none;
        padding: 0 38px 0 12px;
        cursor: pointer;
    }

    .ranked-arena .ranked-arena__select-field > svg {
        position: absolute;
        right: 12px;
        pointer-events: none;
    }

    .ranked-arena .ranked-arena__clear {
        display: inline-grid;
        place-items: center;
        flex: 0 0 auto;
        width: 34px;
        height: 34px;
        margin-right: 4px;
        padding: 0;
        border: 0;
        border-radius: 1px;
        background: transparent;
        color: var(--muted);
        cursor: pointer;
    }

    .ranked-arena .ranked-arena__clear:hover {
        background: rgba(255, 255, 255, 0.08);
        color: var(--ink);
    }

    .ranked-arena .ranked-arena__clear[hidden],
    .ranked-arena [hidden] {
        display: none !important;
    }

    .ranked-arena .ranked-arena__panel {
        min-height: 390px;
        padding: 18px;
        outline-offset: -3px;
    }

    .ranked-arena .ranked-arena__loading {
        display: grid;
        gap: 22px;
        align-content: center;
        min-height: 350px;
        padding: 22px;
    }

    .ranked-arena .ranked-arena__loading-copy {
        display: flex;
        gap: 16px;
        align-items: center;
        justify-content: center;
        text-align: left;
    }

    .ranked-arena .ranked-arena__loading-copy strong {
        display: block;
        margin-bottom: 3px;
        color: var(--ink);
        font-size: 1rem;
    }

    .ranked-arena .ranked-arena__loading-copy p {
        max-width: 520px;
        margin: 0;
        font-size: 0.84rem;
    }

    .ranked-arena .ranked-arena__loading-mark {
        position: relative;
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        width: 48px;
        height: 48px;
        border: 1px solid rgba(242, 199, 93, 0.34);
        border-radius: 50%;
        background: rgba(242, 199, 93, 0.07);
    }

    .ranked-arena .ranked-arena__loading-mark::before,
    .ranked-arena .ranked-arena__loading-mark span {
        width: 18px;
        height: 18px;
        border: 2px solid transparent;
        border-top-color: var(--gold);
        border-radius: 50%;
        content: "";
        animation: ranked-arena-spin 0.9s linear infinite;
    }

    .ranked-arena .ranked-arena__loading-mark span {
        position: absolute;
        width: 30px;
        height: 30px;
        border-top-color: transparent;
        border-right-color: rgba(242, 199, 93, 0.38);
        animation-direction: reverse;
        animation-duration: 1.4s;
    }

    .ranked-arena .ranked-arena__skeleton {
        display: grid;
        gap: 9px;
        width: min(760px, 100%);
        margin-inline: auto;
    }

    .ranked-arena .ranked-arena__skeleton span {
        position: relative;
        overflow: hidden;
        height: 44px;
        border: 1px solid rgba(255, 255, 255, 0.045);
        border-radius: 2px;
        background: rgba(72, 43, 21, 0.2);
    }

