---
import CreaturePortrait from "./CreaturePortrait.astro";
import AbilitiesPage from "./AbilitiesPage.astro";
import ArtifactsPage from "./ArtifactsPage.astro";
import KnowledgeIcon from "./KnowledgeIcon.astro";
import RulesPage from "./RulesPage.astro";
import SpellsPage from "./SpellsPage.astro";
import UnitsPage from "./UnitsPage.astro";
import { artifactsCount } from "../lib/artifacts-data";
import { KNOWLEDGE_AI_PANEL_COPY } from "../lib/knowledge-ai-copy";
import {
    buildKnowledgeEntries,
    knowledgeEntryId,
    knowledgePath,
    type KnowledgeCatalogSection,
    type KnowledgeSection,
} from "../lib/knowledge-base";
import { spellsCount } from "../lib/spells-data";
import type { Language } from "../lib/site-data";
import { abilitiesCount, unitCount } from "../lib/units-data";

interface Props {
    lang: Language;
}

const { lang } = Astro.props;
const isRu = lang === "ru";
const entries = buildKnowledgeEntries(lang);
const rulesCount = entries.filter((entry) => entry.section === "rules").length;
const totalCount = entries.length;

const copy = isRu
    ? {
          eyebrow: "Единый справочник игрока",
          title: "База знаний",
          searchLabel: "Поиск по базе знаний",
          searchPlaceholder: "Например: мораль, огонь, дракон, воскрешение...",
          searchHint: "Нажмите /, чтобы начать поиск. Можно вводить несколько слов в любом порядке.",
          aiSearch: "AI-поиск",
          aiSearchDescription: "Понимает смысл запроса и близкие игровые термины",
          aiAsk: "Спросить ИИ",
          aiPromptLead: "Спросить ИИ:",
          aiHintOn: "Нажмите Enter, чтобы задать вопрос ИИ. Обычные результаты остаются ниже.",
          clear: "Очистить поиск",
          overview: "Обзор",
          rules: "Правила",
          units: "Юниты",
          abilities: "Способности",
          spells: "Заклинания",
          artifacts: "Артефакты",
          browseTitle: "Выберите раздел",
          browseBody:
              "Начните с полного руководства или откройте каталог. Внутри каждого каталога есть дополнительные фильтры и подробные карточки.",
          searchResults: "Результаты поиска",
          searchResultsBody: "Найдите точное правило или объект, затем перейдите прямо к его описанию.",
          noResults: "Ничего не найдено. Попробуйте другое название, эффект, фракцию или механику.",
          result: "результат",
          results: "результатов",
          type: "Раздел",
          name: "Название",
          summary: "Описание",
          details: "Метки",
          action: "Открыть",
          open: "Перейти",
          sectionNav: "Разделы базы знаний",
          returnToOverview: "Вернуться к обзору",
          categoryDescriptions: {
              rules: "Полный цикл матча: драфт, расстановка, бой, мораль, удача, карты и Армагеддон.",
              units: "Характеристики, роли, движение, способности и заклинания всего боевого ростера.",
              abilities: "Пассивные эффекты, ауры и активные умения с указанием всех носителей.",
              spells: "Школы, источники, цели, длительность, урон, баффы и дебаффы.",
              artifacts: "Артефакты 1-го и 2-го уровней, проклятые варианты и точные эффекты армии.",
          },
          sectionEyebrows: {
              rules: "Руководство",
              units: "Боевой ростер",
              abilities: "Справочник умений",
              spells: "Справочник магии",
              artifacts: "Арсенал армии",
          },
      }
    : {
          eyebrow: "Unified player reference",
          title: "Knowledge Base",
          searchLabel: "Search the Knowledge Base",
          searchPlaceholder: "Try morale, fire, dragon, resurrection...",
          searchHint: "Press / to search. Use several words in any order to narrow the results.",
          aiSearch: "AI Search",
          aiSearchDescription: "Understands intent and related game terms",
          aiAsk: "Ask AI",
          aiPromptLead: "Ask the AI:",
          aiHintOn: "Press Enter to ask the AI a question. The regular results stay below.",
          clear: "Clear search",
          overview: "Overview",
          rules: "Rules",
          units: "Units",
          abilities: "Abilities",
          spells: "Spells",
          artifacts: "Artifacts",
          browseTitle: "Choose a section",
          browseBody:
              "Start with the complete guide or open a catalog. Each catalog adds focused filters and descriptive detail cards.",
          searchResults: "Search results",
          searchResultsBody: "Find a rule or game object, then jump directly to its full description.",
          noResults: "No matches. Try another name, effect, faction, or game mechanic.",
          result: "result",
          results: "results",
          type: "Section",
          name: "Name",
          summary: "Summary",
          details: "Tags",
          action: "Open",
          open: "View",
          sectionNav: "Knowledge Base sections",
          returnToOverview: "Return to overview",
          categoryDescriptions: {
              rules: "The complete match loop: draft, placement, combat, morale, luck, maps, and Armageddon.",
              units: "Stats, roles, movement, abilities, and spells for the entire combat roster.",
              abilities: "Passive effects, auras, and active skills with every carrier clearly identified.",
              spells: "Schools, sources, targets, duration, damage, buffs, and debuffs.",
              artifacts: "Tier 1 and Tier 2 artifacts, cursed options, and exact army-wide effects.",
          },
          sectionEyebrows: {
              rules: "Game guide",
              units: "Combat roster",
              abilities: "Skill reference",
              spells: "Magic reference",
              artifacts: "Army arsenal",
          },
      };

const categoryCounts: Record<KnowledgeCatalogSection, number> = {
    rules: rulesCount,
    units: unitCount,
    abilities: abilitiesCount,
    spells: spellsCount,
    artifacts: artifactsCount,
};

const categorySections: KnowledgeCatalogSection[] = ["rules", "units", "abilities", "spells", "artifacts"];
const navigationSections: KnowledgeSection[] = ["overview", ...categorySections];
const sectionLabels: Record<KnowledgeSection, string> = {
    overview: copy.overview,
    rules: copy.rules,
    units: copy.units,
    abilities: copy.abilities,
    spells: copy.spells,
    artifacts: copy.artifacts,
};
// Strings the streaming script needs at runtime; passed through a data attribute because the client bundle
// cannot read frontmatter values.
const aiCopy = {
    ask: copy.aiAsk,
    promptLead: copy.aiPromptLead,
    hintOn: copy.aiHintOn,
    hintOff: copy.searchHint,
};
// The answer panel starts in the page's language and follows the answer's (knowledge-ai-copy.ts).
const panelCopy = KNOWLEDGE_AI_PANEL_COPY[lang];
---

<div
    class="knowledge-base"
    data-knowledge-base
    data-result-singular={copy.result}
    data-result-plural={copy.results}
>
    <a class="kb-skip-link" href="#kb-search">{copy.searchLabel}</a>

    <div class="page-shell kb-search-shell" data-kb-search-shell>
        <section class="kb-search-card" id="kb-search" aria-labelledby="kb-search-label">
            <div class="kb-search-main">
                <div class="kb-search-heading">
                    <h1 id="kb-search-label" class="kb-title">{copy.title}</h1>
                    <p id="kb-search-hint" class="kb-search-hint">{copy.searchHint}</p>
                </div>
                <div class="kb-search-controls">
                    <div class="kb-search-field">
                        <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
                            <circle cx="10.8" cy="10.8" r="6.8"></circle>
                            <path d="m16 16 4.3 4.3"></path>
                        </svg>
                        <input
                            id="kb-search-input"
                            data-kb-search
                            type="search"
                            autocomplete="off"
                            placeholder={copy.searchPlaceholder}
                            aria-label={copy.searchLabel}
                            aria-describedby="kb-search-hint kb-search-status"
                        />
                        <button class="kb-search-clear" data-kb-clear type="button" aria-label={copy.clear} hidden>×</button>
                        <kbd aria-hidden="true">/</kbd>
                    </div>
                    <button
                        class="kb-ai-toggle"
                        data-kb-ai-toggle
                        type="button"
                        role="switch"
                        aria-checked="false"
                        aria-label={copy.aiSearch}
                        title={copy.aiSearchDescription}
                    >
                        <span class="kb-ai-spark" aria-hidden="true">✦</span>
                        <span>{copy.aiSearch}</span>
                        <span class="kb-ai-track" aria-hidden="true"><span></span></span>
                    </button>
                    <button class="kb-ai-ask" data-kb-ai-ask type="button" hidden>
                        <span class="kb-ai-spark" aria-hidden="true">✦</span>
                        <span>{copy.aiAsk}</span>
                    </button>
                </div>
            </div>

            <p id="kb-search-status" class="sr-only" data-kb-status role="status" aria-live="polite"></p>
        </section>
    </div>

    <div class="page-shell kb-ai-shell">
        <section
            class="kb-ai-panel"
            data-kb-ai-panel
            data-kb-ai-copy={JSON.stringify(aiCopy)}
            lang={lang}
            aria-labelledby="kb-ai-title"
            hidden
        >
            <header class="kb-ai-panel-head">
                <h2 class="kb-ai-panel-title" id="kb-ai-title">
                    <span class="kb-ai-spark" aria-hidden="true">✦</span>
                    <span data-kb-ai-title>{panelCopy.title}</span>
                </h2>
                <p class="kb-ai-panel-status" data-kb-ai-status role="status" aria-live="polite"></p>
                <button class="kb-ai-stop" data-kb-ai-stop type="button" hidden>{panelCopy.stop}</button>
            </header>
            <p class="kb-ai-question" data-kb-ai-question></p>
            <div class="kb-ai-answer" data-kb-ai-answer aria-live="polite" aria-busy="false"></div>
            <p class="kb-ai-error" data-kb-ai-error role="alert" hidden></p>
            <div class="kb-ai-sources" data-kb-ai-sources hidden>
                <span class="kb-ai-sources-label" data-kb-ai-sources-label>{panelCopy.sources}</span>
                <ul class="kb-ai-source-list" data-kb-ai-source-list></ul>
            </div>
            <p class="kb-ai-disclaimer" data-kb-ai-disclaimer>{panelCopy.disclaimer}</p>
        </section>
    </div>

    <div class="page-shell kb-layout">
        <nav class="kb-section-nav" data-kb-tablist aria-label={copy.sectionNav}>
            {
                navigationSections.map((section) => (
                    <a
                        class:list={["kb-section-tab", section, { active: section === "overview" }]}
                        id={`kb-tab-${section}`}
                        href={section === "overview" ? knowledgePath(lang) : knowledgePath(lang, { section })}
                        data-kb-tab={section}
                        aria-current={section === "overview" ? "page" : undefined}
                    >
                        <span class="kb-tab-icon" aria-hidden="true">
                            <KnowledgeIcon section={section} size={25} />
                        </span>
                        <span>{sectionLabels[section]}</span>
                        <em>{section === "overview" ? totalCount : categoryCounts[section]}</em>
                    </a>
                ))
            }
        </nav>

        <div class="kb-content" id="kb-content">
            <section class="kb-search-results" data-kb-search-results aria-labelledby="kb-results-title" hidden>
                <button class="kb-ai-prompt" data-kb-ai-prompt type="button" hidden>
                    <span class="kb-ai-spark" aria-hidden="true">✦</span>
                    <span class="kb-ai-prompt-lead">{copy.aiPromptLead}</span>
                    <span class="kb-ai-prompt-question" data-kb-ai-prompt-question></span>
                    <span class="kb-ai-prompt-cta">{copy.aiAsk} ↵</span>
                </button>
                <header class="kb-panel-header compact">
                    <div class="kb-heading-group">
                        <span class="kb-heading-icon overview" aria-hidden="true"><KnowledgeIcon section="overview" size={36} /></span>
                        <div>
                            <p class="eyebrow">{copy.eyebrow}</p>
                            <h2 id="kb-results-title">{copy.searchResults}</h2>
                            <p>{copy.searchResultsBody}</p>
                        </div>
                    </div>
                    <strong data-kb-visible-count>0</strong>
                </header>

                <div class="kb-results-table-wrap">
                    <table class="kb-results-table">
                        <thead>
                            <tr>
                                <th scope="col">{copy.name}</th>
                                <th scope="col">{copy.type}</th>
                                <th scope="col">{copy.summary}</th>
                                <th scope="col">{copy.details}</th>
                                <th scope="col"><span class="sr-only">{copy.action}</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            {
                                entries.map((entry) => (
                                    <tr
                                        data-kb-result
                                        data-section={entry.section}
                                        data-name={entry.name}
                                        data-search={`${entry.name} ${entry.description} ${entry.meta} ${entry.searchText}`}
                                    >
                                        <td data-label={copy.name}>
                                            <span class="kb-result-name">
                                                {
                                                    entry.creatureSlug ? (
                                                        <CreaturePortrait slug={entry.creatureSlug} name="" />
                                                    ) : (
                                                        <img src={entry.image} alt="" width="46" height="46" loading="lazy" />
                                                    )
                                                }
                                                <strong>{entry.name}</strong>
                                            </span>
                                        </td>
                                        <td data-label={copy.type}>
                                            <span class={`kb-type-badge ${entry.section}`}>{sectionLabels[entry.section]}</span>
                                        </td>
                                        <td data-label={copy.summary}><span class="kb-result-summary">{entry.description}</span></td>
                                        <td data-label={copy.details}><span class="kb-result-meta">{entry.meta}</span></td>
                                        <td class="kb-result-action">
                                            <a
                                                href={knowledgePath(lang, { section: entry.section, entry: entry.target })}
                                                data-kb-result-link
                                                data-section={entry.section}
                                                data-target={knowledgeEntryId(entry.section, entry.target)}
                                                aria-label={`${copy.open}: ${entry.name}`}
                                            >
                                                {copy.open}<span aria-hidden="true"> →</span>
                                            </a>
                                        </td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                </div>
                <p class="kb-empty" data-kb-empty hidden>{copy.noResults}</p>
            </section>

            <section class="kb-panel kb-overview" id="overview" data-kb-panel="overview" aria-labelledby="kb-tab-overview">
                <header class="kb-panel-header">
                    <div class="kb-heading-group">
                        <span class="kb-heading-icon overview" aria-hidden="true"><KnowledgeIcon section="overview" size={36} /></span>
                        <div>
                            <p class="eyebrow">{copy.eyebrow}</p>
                            <h2>{copy.browseTitle}</h2>
                            <p>{copy.browseBody}</p>
                        </div>
                    </div>
                    <strong>{totalCount}</strong>
                </header>
                <div class="kb-category-grid">
                    {
                        categorySections.map((section) => (
                            <a
                                class={`kb-category-card ${section}`}
                                href={knowledgePath(lang, { section })}
                                data-kb-section-link={section}
                            >
                                <span class="kb-category-art">
                                    <span class="kb-category-sigil" aria-hidden="true">
                                        <KnowledgeIcon section={section} size={82} />
                                    </span>
                                </span>
                                <span class="kb-category-copy">
                                    <span class="eyebrow">{copy.sectionEyebrows[section]}</span>
                                    <strong>{sectionLabels[section]}</strong>
                                    <span>{copy.categoryDescriptions[section]}</span>
                                </span>
                                <em>{categoryCounts[section]}</em>
                                <span class="kb-category-arrow" aria-hidden="true">↗</span>
                            </a>
                        ))
                    }
                </div>
            </section>

            <section class="kb-panel" id="rules" data-kb-panel="rules" aria-labelledby="kb-tab-rules">
                <header class="kb-panel-header">
                    <div class="kb-heading-group">
                        <span class="kb-heading-icon rules" aria-hidden="true"><KnowledgeIcon section="rules" size={36} /></span>
                        <div>
                            <p class="eyebrow">{copy.sectionEyebrows.rules}</p>
                            <h2>{copy.rules}</h2>
                            <p>{copy.categoryDescriptions.rules}</p>
                        </div>
                    </div>
                    <strong>{categoryCounts.rules}</strong>
                </header>
                <RulesPage lang={lang} embedded />
            </section>

            <section class="kb-panel" id="units" data-kb-panel="units" aria-labelledby="kb-tab-units">
                <header class="kb-panel-header">
                    <div class="kb-heading-group">
                        <span class="kb-heading-icon units" aria-hidden="true"><KnowledgeIcon section="units" size={36} /></span>
                        <div>
                            <p class="eyebrow">{copy.sectionEyebrows.units}</p>
                            <h2>{copy.units}</h2>
                            <p>{copy.categoryDescriptions.units}</p>
                        </div>
                    </div>
                    <strong>{categoryCounts.units}</strong>
                </header>
                <UnitsPage lang={lang} embedded />
            </section>

            <section class="kb-panel" id="abilities" data-kb-panel="abilities" aria-labelledby="kb-tab-abilities">
                <header class="kb-panel-header">
                    <div class="kb-heading-group">
                        <span class="kb-heading-icon abilities" aria-hidden="true"><KnowledgeIcon section="abilities" size={36} /></span>
                        <div>
                            <p class="eyebrow">{copy.sectionEyebrows.abilities}</p>
                            <h2>{copy.abilities}</h2>
                            <p>{copy.categoryDescriptions.abilities}</p>
                        </div>
                    </div>
                    <strong>{categoryCounts.abilities}</strong>
                </header>
                <AbilitiesPage lang={lang} embedded />
            </section>

            <section class="kb-panel" id="spells" data-kb-panel="spells" aria-labelledby="kb-tab-spells">
                <header class="kb-panel-header">
                    <div class="kb-heading-group">
                        <span class="kb-heading-icon spells" aria-hidden="true"><KnowledgeIcon section="spells" size={36} /></span>
                        <div>
                            <p class="eyebrow">{copy.sectionEyebrows.spells}</p>
                            <h2>{copy.spells}</h2>
                            <p>{copy.categoryDescriptions.spells}</p>
                        </div>
                    </div>
                    <strong>{categoryCounts.spells}</strong>
                </header>
                <SpellsPage lang={lang} embedded />
            </section>

            <section class="kb-panel" id="artifacts" data-kb-panel="artifacts" aria-labelledby="kb-tab-artifacts">
                <header class="kb-panel-header">
                    <div class="kb-heading-group">
                        <span class="kb-heading-icon artifacts" aria-hidden="true"><KnowledgeIcon section="artifacts" size={36} /></span>
                        <div>
                            <p class="eyebrow">{copy.sectionEyebrows.artifacts}</p>
                            <h2>{copy.artifacts}</h2>
                            <p>{copy.categoryDescriptions.artifacts}</p>
                        </div>
                    </div>
                    <strong>{categoryCounts.artifacts}</strong>
                </header>
                <ArtifactsPage lang={lang} embedded />
            </section>

            <a class="kb-back-overview" href={knowledgePath(lang)} data-kb-section-link="overview">← {copy.returnToOverview}</a>
        </div>
    </div>
</div>

<script>
    import {
        answerLanguageFor,
        askKnowledgeAi,
        KnowledgeAiRequestError,
        type KnowledgeAiHistoryMessage,
        type KnowledgeAiLanguage,
        type KnowledgeAiSource,
    } from "../lib/knowledge-ai-client";
    import { KNOWLEDGE_AI_PANEL_COPY } from "../lib/knowledge-ai-copy";
    import {
        isKnowledgeSection,
        knowledgeAiSearchRank,
        knowledgeEntryMatches,
        knowledgeSearchRank,
        type KnowledgeSection,
    } from "../lib/knowledge-base";
    import { renderMarkdown } from "../lib/markdown-lite";

    const roots = document.querySelectorAll<HTMLElement>("[data-knowledge-base]");

    roots.forEach((root) => {
        const tabs = Array.from(root.querySelectorAll<HTMLAnchorElement>("[data-kb-tab]"));
        const tablist = root.querySelector<HTMLElement>("[data-kb-tablist]");
        const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-kb-panel]"));
        const searchInput = root.querySelector<HTMLInputElement>("[data-kb-search]");
        const clearButton = root.querySelector<HTMLButtonElement>("[data-kb-clear]");
        const aiToggle = root.querySelector<HTMLButtonElement>("[data-kb-ai-toggle]");
        const searchResults = root.querySelector<HTMLElement>("[data-kb-search-results]");
        const resultRows = Array.from(root.querySelectorAll<HTMLTableRowElement>("[data-kb-result]"));
        const status = root.querySelector<HTMLElement>("[data-kb-status]");
        const count = root.querySelector<HTMLElement>("[data-kb-visible-count]");
        const empty = root.querySelector<HTMLElement>("[data-kb-empty]");
        const searchHint = root.querySelector<HTMLElement>("#kb-search-hint");
        const askButton = root.querySelector<HTMLButtonElement>("[data-kb-ai-ask]");
        const aiPrompt = root.querySelector<HTMLButtonElement>("[data-kb-ai-prompt]");
        const aiPromptQuestion = root.querySelector<HTMLElement>("[data-kb-ai-prompt-question]");
        const aiPanel = root.querySelector<HTMLElement>("[data-kb-ai-panel]");
        const aiStatus = root.querySelector<HTMLElement>("[data-kb-ai-status]");
        const aiStop = root.querySelector<HTMLButtonElement>("[data-kb-ai-stop]");
        const aiQuestion = root.querySelector<HTMLElement>("[data-kb-ai-question]");
        const aiAnswer = root.querySelector<HTMLElement>("[data-kb-ai-answer]");
        const aiError = root.querySelector<HTMLElement>("[data-kb-ai-error]");
        const aiSources = root.querySelector<HTMLElement>("[data-kb-ai-sources]");
        const aiSourceList = root.querySelector<HTMLElement>("[data-kb-ai-source-list]");
        const aiTitle = root.querySelector<HTMLElement>("[data-kb-ai-title]");
        const aiSourcesLabel = root.querySelector<HTMLElement>("[data-kb-ai-sources-label]");
        const aiDisclaimer = root.querySelector<HTMLElement>("[data-kb-ai-disclaimer]");
        const backToOverview = root.querySelector<HTMLElement>(".kb-back-overview");
        const searchShell = root.querySelector<HTMLElement>("[data-kb-search-shell]");
        let activeSection: KnowledgeSection = "overview";

        // The section nav sticks directly under the search card, so its offset has to be the card's real
        // height — which changes with the viewport and grows a whole row when AI search switches on. A
        // fixed number was right for exactly one layout and wrong for every other.
        if (searchShell && "ResizeObserver" in window) {
            const syncStickyOffset = () =>
                root.style.setProperty("--kb-search-sticky-offset", `${Math.ceil(searchShell.getBoundingClientRect().height)}px`);
            new ResizeObserver(syncStickyOffset).observe(searchShell);
            syncStickyOffset();
        }
        let aiSearchEnabled = false;

        type AiCopy = Record<"ask" | "promptLead" | "hintOn" | "hintOff", string>;
        let aiCopy: Partial<AiCopy> = {};
        try {
            aiCopy = JSON.parse(aiPanel?.dataset.kbAiCopy ?? "{}") as Partial<AiCopy>;
        } catch {
            // The panel still works with empty labels.
        }
        const aiLang: KnowledgeAiLanguage = document.documentElement.lang.toLowerCase().startsWith("ru") ? "ru" : "en";
        // The panel speaks the language of the answer, which follows the question: a Russian question on the
        // English page gets a Russian answer, and a Russian status line, source list and errors with it.
        let panelLang: KnowledgeAiLanguage = aiLang;
        const panelCopy = () => KNOWLEDGE_AI_PANEL_COPY[panelLang];
        const setPanelLanguage = (language: KnowledgeAiLanguage) => {
            panelLang = language;
            const labels = KNOWLEDGE_AI_PANEL_COPY[language];
            if (aiPanel) aiPanel.lang = language;
            if (aiTitle) aiTitle.textContent = labels.title;
            if (aiSourcesLabel) aiSourcesLabel.textContent = labels.sources;
            if (aiDisclaimer) aiDisclaimer.textContent = labels.disclaimer;
            if (aiStop) aiStop.textContent = labels.stop;
        };
        const aiHistory: KnowledgeAiHistoryMessage[] = [];
        let aiController: AbortController | null = null;
        let aiMarkdown = "";
        let aiRenderQueued = false;
        let aiLastQuestion = "";

        // The "Ask the AI: <question>" row above the filtered results: shown whenever AI search is on and the
        // typed question has not been asked yet, so the answer is one click (or Enter) away and never a mystery.
        const syncAiPrompt = () => {
            if (!aiPrompt) return;
            const question = searchInput?.value.trim() ?? "";
            const show = aiSearchEnabled && Boolean(question) && question !== aiLastQuestion;
            aiPrompt.hidden = !show;
            if (aiPromptQuestion) aiPromptQuestion.textContent = question;
        };

        // An opening math delimiter, which is all it takes to start fetching KaTeX — the closing one, and
        // with it the finished formula, is usually still streaming.
        const MATH_STARTED = /\$|\\\(|\\\[/;
        let mathModule: Promise<typeof import("../lib/math-typeset")> | undefined;

        // KaTeX (script + stylesheet + fonts) is pulled in only for an answer that actually contains a
        // formula, and never for the many questions that have none. Until it lands, every mark shows the
        // TeX the assistant wrote, so nothing is blank or missing while it loads.
        const typesetAnswerMath = () => {
            if (!aiAnswer || !MATH_STARTED.test(aiMarkdown)) return;
            void (mathModule ??= import("../lib/math-typeset"))
                .then(({ typesetMath }) => {
                    if (aiAnswer) typesetMath(aiAnswer);
                })
                .catch(() => {
                    // The answer stays readable as plain TeX.
                });
        };

        const renderAiAnswer = () => {
            aiRenderQueued = false;
            if (aiAnswer) aiAnswer.innerHTML = renderMarkdown(aiMarkdown);
            typesetAnswerMath();
        };

        const scheduleAiRender = () => {
            if (aiRenderQueued) return;
            aiRenderQueued = true;
            window.requestAnimationFrame(renderAiAnswer);
        };

        const setAiStatus = (text: string, busy: boolean) => {
            if (aiStatus) aiStatus.textContent = text;
            aiPanel?.classList.toggle("busy", busy);
            aiAnswer?.setAttribute("aria-busy", busy ? "true" : "false");
            if (aiStop) aiStop.hidden = !busy;
        };

        const renderAiSources = (items: KnowledgeAiSource[]) => {
            if (!aiSources || !aiSourceList) return;
            aiSourceList.replaceChildren();
            for (const item of items.slice(0, 10)) {
                const li = document.createElement("li");
                const link = document.createElement("a");
                link.href = item.href;
                link.textContent = item.name;
                link.dataset.kbAiSource = item.type;
                li.append(link);
                aiSourceList.append(li);
            }
            aiSources.hidden = items.length === 0;
        };

        const showAiError = (message: string) => {
            if (aiError) {
                aiError.textContent = message;
                aiError.hidden = false;
            }
        };

        const aiErrorMessage = (error: unknown): string => {
            if (error instanceof KnowledgeAiRequestError) {
                if (error.code === "rate_limited") {
                    return panelCopy().errorRate.replace("{seconds}", String(error.retryAfterSeconds ?? 60));
                }
                if (error.code === "busy") return panelCopy().errorBusy;
                if (error.code === "budget_exhausted") return panelCopy().errorBudget;
                if (error.code === "question_too_long") return panelCopy().errorLong;
            }
            return panelCopy().errorGeneric;
        };

        const stopAi = () => {
            aiController?.abort();
            aiController = null;
        };

        const askAi = (question: string) => {
            const trimmed = question.trim();
            if (!trimmed || !aiPanel) return;
            aiLastQuestion = trimmed;
            syncAiPrompt();
            stopAi();
            const controller = new AbortController();
            aiController = controller;
            aiMarkdown = "";
            aiPanel.hidden = false;
            if (aiQuestion) aiQuestion.textContent = trimmed;
            if (aiAnswer) aiAnswer.replaceChildren();
            if (aiError) aiError.hidden = true;
            renderAiSources([]);
            const history = aiHistory.slice(-6);
            setPanelLanguage(answerLanguageFor(trimmed, aiLang, history));
            setAiStatus(panelCopy().thinking, true);
            // The model can take 10–30 s to say its first word when it is busy, and a silent wait read as a
            // hang: players re-asked, cancelling the answer they were waiting for. After a quiet spell the
            // status says it is still working, and later that the assistant is busy but the answer is coming.
            let lastProgressAt = Date.now();
            let slowStage = 0;
            const slowWatch = window.setInterval(() => {
                if (controller.signal.aborted || aiController !== controller || aiMarkdown) return;
                const quietFor = Date.now() - lastProgressAt;
                if (slowStage < 2 && quietFor > 18_000) {
                    slowStage = 2;
                    setAiStatus(panelCopy().verySlow, true);
                } else if (slowStage < 1 && quietFor > 7_000) {
                    slowStage = 1;
                    setAiStatus(panelCopy().slow, true);
                }
            }, 1_000);
            askKnowledgeAi(
                { question: trimmed, lang: aiLang, history },
                (event) => {
                    if (controller.signal.aborted) return;
                    if (event.type === "status" || event.type === "delta") {
                        lastProgressAt = Date.now();
                        slowStage = 0;
                    }
                    if (event.type === "meta") {
                        // The service decides the answer's language; follow it if it disagrees with our guess.
                        if (event.language !== panelLang) {
                            setPanelLanguage(event.language);
                            setAiStatus(panelCopy().thinking, true);
                        }
                    } else if (event.type === "status") {
                        const labels = panelCopy();
                        const label =
                            event.phase === "searching"
                                ? labels.searching
                                : event.phase === "reading"
                                  ? labels.reading
                                  : event.phase === "listing"
                                    ? labels.listing
                                    : event.phase === "answering"
                                      ? labels.answering
                                      : labels.thinking;
                        const detail = event.detail && event.phase !== "answering" && event.phase !== "thinking" ? `: ${event.detail}` : "";
                        setAiStatus(`${label}${detail}`, true);
                    } else if (event.type === "sources") {
                        renderAiSources(event.items);
                    } else if (event.type === "delta") {
                        aiMarkdown += event.text;
                        scheduleAiRender();
                    } else if (event.type === "reset") {
                        aiMarkdown = "";
                        scheduleAiRender();
                    } else if (event.type === "done") {
                        aiMarkdown = event.answer || aiMarkdown;
                        renderAiAnswer();
                        renderAiSources(event.sources);
                        setAiStatus(event.cached ? panelCopy().cached : panelCopy().done, false);
                        aiHistory.push({ role: "user", content: trimmed }, { role: "assistant", content: aiMarkdown });
                        while (aiHistory.length > 6) aiHistory.shift();
                    } else if (event.type === "error") {
                        setAiStatus("", false);
                        showAiError(panelCopy().errorGeneric);
                    }
                },
                { signal: controller.signal },
            )
                .catch((error: unknown) => {
                    if (controller.signal.aborted) {
                        setAiStatus(panelCopy().stopped, false);
                        return;
                    }
                    setAiStatus("", false);
                    showAiError(aiErrorMessage(error));
                })
                .finally(() => {
                    window.clearInterval(slowWatch);
                    if (aiController === controller) aiController = null;
                    if (aiStop) aiStop.hidden = true;
                    aiPanel.classList.remove("busy");
                });
        };

        const setAiSearchEnabled = (enabled: boolean, syncUrl = true) => {
            aiSearchEnabled = enabled;
            root.dataset.aiSearch = enabled ? "true" : "false";
            aiToggle?.setAttribute("aria-checked", enabled ? "true" : "false");
            if (askButton) askButton.hidden = !enabled;
            if (searchHint && (aiCopy.hintOn || aiCopy.hintOff)) searchHint.textContent = (enabled ? aiCopy.hintOn : aiCopy.hintOff) ?? "";
            if (!enabled) {
                stopAi();
                if (aiPanel) aiPanel.hidden = true;
                aiHistory.length = 0;
                aiLastQuestion = "";
            }
            syncAiPrompt();
            try {
                window.localStorage.setItem("hoc.kb.aiSearch", enabled ? "1" : "0");
            } catch {
                // Search remains usable when storage is unavailable or blocked.
            }
            if (!syncUrl) return;
            const url = new URL(window.location.href);
            if (enabled) url.searchParams.set("ai", "1");
            else url.searchParams.delete("ai");
            window.history.replaceState(null, "", `${url.pathname}${url.search}${url.hash}`);
        };

        tablist?.setAttribute("role", "tablist");
        tabs.forEach((tab) => {
            const section = tab.dataset.kbTab;
            if (!isKnowledgeSection(section)) return;
            tab.id = `kb-tab-${section}`;
            tab.setAttribute("role", "tab");
            tab.setAttribute("aria-controls", section);
        });
        panels.forEach((panel) => panel.setAttribute("role", "tabpanel"));
        root.dataset.enhanced = "true";

        const sectionFromFragment = (fragment: string): KnowledgeSection => {
            let clean = fragment.replace(/^#/, "");
            try {
                clean = decodeURIComponent(clean);
            } catch {
                // A malformed external fragment should fall back to the overview, not stop page setup.
                return "overview";
            }
            if (isKnowledgeSection(clean)) return clean;
            if (clean.startsWith("rule-")) return "rules";
            if (clean.startsWith("unit-")) return "units";
            if (clean.startsWith("ability-")) return "abilities";
            if (clean.startsWith("spell-")) return "spells";
            if (clean.startsWith("artifact-")) return "artifacts";
            return "overview";
        };

        const activateSection = (section: KnowledgeSection, focusTab = false) => {
            root.querySelectorAll<HTMLDialogElement>("dialog[open]").forEach((dialog) => dialog.close());
            activeSection = section;
            searchResults?.setAttribute("hidden", "");
            // "Return to overview" sits below every panel; on the overview itself it was a stray link
            // floating above the footer with nowhere to go.
            if (backToOverview) backToOverview.hidden = section === "overview";
            panels.forEach((panel) => {
                const selected = panel.dataset.kbPanel === section;
                panel.hidden = !selected;
            });
            tabs.forEach((tab) => {
                const selected = tab.dataset.kbTab === section;
                tab.classList.toggle("active", selected);
                tab.setAttribute("aria-selected", selected ? "true" : "false");
                tab.tabIndex = selected ? 0 : -1;
                if (selected) tab.setAttribute("aria-current", "page");
                else tab.removeAttribute("aria-current");
                if (selected && focusTab) tab.focus();
            });
        };

        const updateSectionUrl = (section: KnowledgeSection) => {
            const url = new URL(window.location.href);
            url.searchParams.delete("q");
            url.searchParams.delete("entry");
            url.hash = section === "overview" ? "" : section;
            window.history.pushState(null, "", `${url.pathname}${url.search}${url.hash}`);
        };

        const applySearch = (syncUrl = true) => {
            const query = searchInput?.value.trim() ?? "";
            const searching = Boolean(query);
            let visible = 0;

            resultRows.forEach((row) => {
                const queryMatch =
                    searching &&
                    (aiSearchEnabled
                        ? Number.isFinite(
                              knowledgeAiSearchRank(row.dataset.name ?? "", row.dataset.search ?? "", query),
                          )
                        : knowledgeEntryMatches(row.dataset.search ?? "", query));
                const shown = queryMatch;
                row.hidden = !shown;
                if (shown) visible += 1;
            });

            const resultBody = resultRows[0]?.parentElement;
            if (searching && resultBody) {
                resultRows
                    .sort(
                        (a, b) =>
                            (aiSearchEnabled ? knowledgeAiSearchRank : knowledgeSearchRank)(
                                a.dataset.name ?? "",
                                a.dataset.search ?? "",
                                query,
                            ) -
                                (aiSearchEnabled ? knowledgeAiSearchRank : knowledgeSearchRank)(
                                    b.dataset.name ?? "",
                                    b.dataset.search ?? "",
                                    query,
                                ) ||
                            (a.dataset.name ?? "").localeCompare(b.dataset.name ?? ""),
                    )
                    .forEach((row) => resultBody.append(row));
            }

            if (searching) {
                panels.forEach((panel) => (panel.hidden = true));
                if (searchResults) searchResults.hidden = false;
            } else {
                if (searchResults) searchResults.hidden = true;
                activateSection(activeSection);
            }

            if (clearButton) clearButton.hidden = !searching;
            if (count) count.textContent = String(visible);
            if (empty) empty.hidden = !searching || visible > 0;
            if (status) {
                const resultWord = visible === 1 ? root.dataset.resultSingular : root.dataset.resultPlural;
                status.textContent = searching ? `${visible} ${resultWord ?? "results"}` : "";
            }

            if (syncUrl) {
                const url = new URL(window.location.href);
                if (query) url.searchParams.set("q", query);
                else url.searchParams.delete("q");
                window.history.replaceState(null, "", `${url.pathname}${url.search}${url.hash}`);
            }
        };

        const focusTarget = (targetId: string) => {
            const target = document.getElementById(targetId);
            if (!target) return;
            const details = target.matches("details") ? target : target.closest("details");
            if (details instanceof HTMLDetailsElement) details.open = true;
            target.classList.add("kb-target-highlight");
            const isRuleTarget = targetId.startsWith("rule-");
            target.scrollIntoView({
                behavior: isRuleTarget ? "instant" : "smooth",
                block: isRuleTarget ? "start" : "center",
            });
            const isNaturallyFocusable = target.matches(
                'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]',
            );
            if (!isNaturallyFocusable) target.tabIndex = -1;
            target.focus({ preventScroll: true });
            if (target instanceof HTMLButtonElement && target.matches("[data-unit]")) target.click();
            window.setTimeout(() => {
                target.classList.remove("kb-target-highlight");
                if (!isNaturallyFocusable) target.removeAttribute("tabindex");
            }, 2200);
        };

        const resetSearchUi = () => {
            if (searchInput) searchInput.value = "";
            applySearch(false);
        };

        tabs.forEach((tab, index) => {
            tab.addEventListener("click", (event) => {
                const section = tab.dataset.kbTab;
                if (!isKnowledgeSection(section)) return;
                event.preventDefault();
                resetSearchUi();
                activateSection(section);
                updateSectionUrl(section);
                root.querySelector<HTMLElement>(`[data-kb-panel="${section}"]`)?.scrollIntoView({
                    behavior: "smooth",
                    block: "start",
                });
            });

            tab.addEventListener("keydown", (event) => {
                let next = index;
                if (event.key === "ArrowRight" || event.key === "ArrowDown") next = (index + 1) % tabs.length;
                else if (event.key === "ArrowLeft" || event.key === "ArrowUp") next = (index - 1 + tabs.length) % tabs.length;
                else if (event.key === "Home") next = 0;
                else if (event.key === "End") next = tabs.length - 1;
                else return;
                event.preventDefault();
                tabs[next]?.click();
                tabs[next]?.focus({ preventScroll: true });
            });
        });

        root.querySelectorAll<HTMLAnchorElement>("[data-kb-section-link]").forEach((link) => {
            link.addEventListener("click", (event) => {
                const section = link.dataset.kbSectionLink;
                if (!isKnowledgeSection(section)) return;
                event.preventDefault();
                resetSearchUi();
                activateSection(section);
                updateSectionUrl(section);
                root.querySelector<HTMLElement>(`[data-kb-panel="${section}"]`)?.scrollIntoView({
                    behavior: "smooth",
                    block: "start",
                });
            });
        });

        searchInput?.addEventListener("input", () => {
            applySearch();
            syncAiPrompt();
        });
        aiPrompt?.addEventListener("click", () => askAi(searchInput?.value ?? ""));
        aiToggle?.addEventListener("click", () => {
            setAiSearchEnabled(!aiSearchEnabled);
            applySearch(false);
            searchInput?.focus();
        });
        askButton?.addEventListener("click", () => askAi(searchInput?.value ?? ""));
        aiStop?.addEventListener("click", () => {
            stopAi();
            setAiStatus(panelCopy().stopped, false);
        });
        searchInput?.addEventListener("keydown", (event) => {
            if (event.key === "Enter" && aiSearchEnabled && !event.isComposing) {
                event.preventDefault();
                askAi(searchInput.value);
            }
        });
        // Links inside the answer and the source chips point at this page's own anchors: open them in place,
        // the same way a result row does, instead of reloading the page.
        aiPanel?.addEventListener("click", (event) => {
            const link = (event.target as HTMLElement | null)?.closest<HTMLAnchorElement>("a[href]");
            if (!link || event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
            const destination = new URL(link.href, window.location.href);
            if (destination.origin !== window.location.origin || !/\/knowledge-base\/?$/.test(destination.pathname)) return;
            if (destination.pathname !== window.location.pathname) return;
            const target = destination.hash.replace(/^#/, "");
            const section = sectionFromFragment(destination.hash);
            if (!target) return;
            event.preventDefault();
            if (searchInput) searchInput.value = "";
            applySearch(false);
            activateSection(section);
            window.history.pushState(null, "", `${destination.pathname}${destination.search}${destination.hash}`);
            window.requestAnimationFrame(() => focusTarget(section === target ? "" : target));
        });
        clearButton?.addEventListener("click", () => {
            if (searchInput) {
                searchInput.value = "";
                searchInput.focus();
            }
            applySearch();
        });

        root.querySelectorAll<HTMLAnchorElement>("[data-kb-result-link]").forEach((link) => {
            link.addEventListener("click", (event) => {
                const section = link.dataset.section;
                const target = link.dataset.target;
                if (!isKnowledgeSection(section) || section === "overview" || !target) return;
                event.preventDefault();
                resetSearchUi();
                activateSection(section);
                const destination = new URL(link.href);
                window.history.pushState(null, "", `${destination.pathname}${destination.search}${destination.hash}`);
                window.requestAnimationFrame(() => focusTarget(target));
            });
        });

        document.addEventListener("keydown", (event) => {
            const target = event.target as HTMLElement | null;
            const isTyping =
                target?.matches("input, textarea, select") || target?.isContentEditable || target?.closest("[contenteditable]");
            if (event.key === "/" && !isTyping) {
                event.preventDefault();
                searchInput?.focus();
            } else if (event.key === "Escape" && document.activeElement === searchInput && searchInput?.value) {
                searchInput.value = "";
                applySearch();
            }
        });

        const syncFromLocation = () => {
            const params = new URLSearchParams(window.location.search);
            const query = params.get("q") ?? "";
            let storedAiSearch = false;
            try {
                storedAiSearch = window.localStorage.getItem("hoc.kb.aiSearch") === "1";
            } catch {
                // Use the URL/default state if storage is unavailable or blocked.
            }
            setAiSearchEnabled(params.get("ai") === "1" || (!params.has("ai") && storedAiSearch), false);
            const section = sectionFromFragment(window.location.hash);
            activateSection(section);
            if (searchInput) searchInput.value = query;
            applySearch(false);
            syncAiPrompt();
            // A shared link that carries both the switch and a question asks it straight away.
            if (params.get("ai") === "1" && query.trim() && query.trim() !== aiLastQuestion) askAi(query);
            const target = window.location.hash.replace(/^#/, "");
            if (target && target !== section && !query) window.requestAnimationFrame(() => focusTarget(target));
        };

        window.addEventListener("popstate", syncFromLocation);
        window.addEventListener("hashchange", syncFromLocation);
        syncFromLocation();
    });
</script>

<style>
    .knowledge-base {
        --kb-surface: #0d0a08;
        --kb-surface-raised: #15100c;
        --kb-line: rgba(220, 177, 88, 0.2);
        --kb-muted: rgba(246, 241, 230, 0.64);
        --kb-search-sticky-offset: 118px;
        --kb-search-sticky-top: 68px;
        min-height: 100vh;
        background: linear-gradient(180deg, #080605, #100b08 46%, #080605);
    }

    :is(.kb-section-tab, .kb-category-card, .kb-heading-icon).overview {
        --kb-accent: #e0b85f;
        --kb-accent-rgb: 224, 184, 95;
    }

    :is(.kb-section-tab, .kb-category-card, .kb-heading-icon).rules {
        --kb-accent: #dcae52;
        --kb-accent-rgb: 220, 174, 82;
    }

    :is(.kb-section-tab, .kb-category-card, .kb-heading-icon).units {
        --kb-accent: #d66d52;
        --kb-accent-rgb: 214, 109, 82;
    }

    :is(.kb-section-tab, .kb-category-card, .kb-heading-icon).abilities {
        --kb-accent: #64b39e;
        --kb-accent-rgb: 100, 179, 158;
    }

    :is(.kb-section-tab, .kb-category-card, .kb-heading-icon).spells {
        --kb-accent: #77a8dc;
        --kb-accent-rgb: 119, 168, 220;
    }

    :is(.kb-section-tab, .kb-category-card, .kb-heading-icon).artifacts {
        --kb-accent: #d7c48b;
        --kb-accent-rgb: 215, 196, 139;
    }

    .kb-skip-link {
        position: fixed;
        z-index: 1000;
        top: 8px;
        left: 8px;
        padding: 10px 15px;
        color: #111;
        background: #f2c75d;
        border-radius: 6px;
        transform: translateY(-140%);
    }

    .kb-skip-link:focus {
        transform: none;
    }

    .kb-panel-header .eyebrow,
    .kb-category-copy .eyebrow {
        margin: 0 0 9px;
        color: #e4b951;
        letter-spacing: 0.13em;
        text-transform: uppercase;
    }

    /* The search is the first thing on the page now. A margin, not padding, keeps the spacing at rest
       and lets the card sit flush under the header once it sticks. */
    .kb-search-shell {
        position: sticky;
        z-index: 24;
        top: var(--kb-search-sticky-top);
        margin-top: 26px;
    }

    .kb-search-card {
        padding: 12px;
        border: 1px solid rgba(241, 200, 97, 0.2);
        border-radius: 12px;
        background:
            linear-gradient(110deg, rgba(20, 14, 9, 0.98), rgba(9, 7, 6, 0.97)),
            radial-gradient(circle at 82% 0, rgba(224, 184, 95, 0.12), transparent 38%);
        box-shadow: 0 14px 36px rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(18px);
    }

    .kb-search-heading {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        align-items: baseline;
        margin-bottom: 8px;
    }

    .kb-title {
        flex: 0 0 auto;
        margin: 0;
        color: rgba(249, 246, 237, 0.88);
        font-family: var(--font-display);
        font-size: 1.05rem;
        font-weight: 760;
        line-height: 1.2;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .kb-search-controls {
        display: flex;
        gap: 9px;
        align-items: stretch;
    }

    .kb-search-field {
        display: flex;
        flex: 1 1 auto;
        align-items: center;
        min-width: 0;
        min-height: 56px;
        padding: 0 13px 0 16px;
        border: 1px solid rgba(241, 200, 97, 0.19);
        border-radius: 10px;
        background: #090705;
        transition: border-color 160ms ease, box-shadow 160ms ease;
    }

    .kb-search-field:focus-within {
        border-color: rgba(242, 199, 93, 0.76);
        box-shadow: 0 0 0 3px rgba(242, 199, 93, 0.13);
    }

    .kb-search-field svg {
        flex: 0 0 auto;
        margin-right: 12px;
        fill: none;
        stroke: #d9b45a;
        stroke-width: 1.8;
    }

    .kb-search-field input {
        width: 100%;
        min-width: 0;
        padding: 15px 0;
        color: #faf7ed;
        border: 0;
        outline: 0;
        background: transparent;
        font: inherit;
        font-size: 1.04rem;
    }

    .kb-search-field input::placeholder {
        color: rgba(247, 243, 233, 0.4);
    }

    .kb-search-field input::-webkit-search-cancel-button {
        display: none;
    }

    .kb-search-clear {
        flex: 0 0 auto;
        width: 36px;
        height: 36px;
        margin-left: 8px;
        color: rgba(255, 255, 255, 0.76);
        border: 0;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        font-size: 1.45rem;
        line-height: 1;
        cursor: pointer;
    }

    .kb-search-field kbd {
        flex: 0 0 auto;
        min-width: 28px;
        margin-left: 9px;
        padding: 4px 8px;
        color: rgba(255, 255, 255, 0.55);
        border: 1px solid rgba(255, 255, 255, 0.13);
        border-bottom-color: rgba(255, 255, 255, 0.24);
        border-radius: 5px;
        background: rgba(255, 255, 255, 0.04);
        text-align: center;
    }

    .kb-search-hint {
        margin: 0;
        color: var(--kb-muted);
        font-size: 0.82rem;
        text-align: right;
    }

    .kb-ai-toggle {
        display: inline-flex;
        flex: 0 0 auto;
        gap: 9px;
        align-items: center;
        justify-content: center;
        min-width: 156px;
        min-height: 56px;
        padding: 0 13px;
        color: rgba(247, 242, 230, 0.7);
        border: 1px solid rgba(241, 200, 97, 0.17);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.025);
        font: inherit;
        font-size: 0.83rem;
        font-weight: 720;
        letter-spacing: 0.025em;
        cursor: pointer;
        transition: color 160ms ease, border-color 160ms ease, background 160ms ease, box-shadow 160ms ease;
    }

    .kb-ai-toggle:hover {
        color: #fff8e8;
        border-color: rgba(241, 200, 97, 0.38);
        background: rgba(241, 200, 97, 0.07);
    }

    .kb-ai-toggle:focus-visible {
        outline: 3px solid rgba(242, 199, 93, 0.28);
        outline-offset: 2px;
    }

    .kb-ai-toggle[aria-checked="true"] {
        color: #fff4cc;
        border-color: rgba(242, 199, 93, 0.55);
        background: linear-gradient(110deg, rgba(242, 199, 93, 0.17), rgba(100, 179, 158, 0.1));
        box-shadow: inset 0 0 20px rgba(242, 199, 93, 0.06);
    }

    .kb-ai-spark {
        color: rgba(224, 184, 95, 0.62);
        font-size: 0.9rem;
        transition: color 160ms ease, text-shadow 160ms ease;
    }

    .kb-ai-toggle[aria-checked="true"] .kb-ai-spark {
        color: #f2c75d;
        text-shadow: 0 0 10px rgba(242, 199, 93, 0.55);
    }

    .kb-ai-track {
        position: relative;
        width: 32px;
        height: 18px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        transition: border-color 160ms ease, background 160ms ease;
    }

    .kb-ai-track > span {
        position: absolute;
        top: 3px;
        left: 3px;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.58);
        transition: transform 160ms ease, background 160ms ease, box-shadow 160ms ease;
    }

    .kb-ai-toggle[aria-checked="true"] .kb-ai-track {
        border-color: rgba(242, 199, 93, 0.62);
        background: rgba(242, 199, 93, 0.2);
    }

    .kb-ai-toggle[aria-checked="true"] .kb-ai-track > span {
        background: #f2c75d;
        box-shadow: 0 0 8px rgba(242, 199, 93, 0.5);
        transform: translateX(14px);
    }

    .kb-section-nav::-webkit-scrollbar {
        display: none;
    }

    .kb-layout {
        display: grid;
        grid-template-columns: 210px minmax(0, 1fr);
        gap: 24px;
        align-items: start;
        padding-top: 34px;
        padding-bottom: 56px;
    }

    .kb-section-nav {
        position: sticky;
        top: calc(var(--kb-search-sticky-top) + var(--kb-search-sticky-offset));
        display: grid;
        gap: 7px;
    }

    .kb-section-tab {
        display: grid;
        grid-template-columns: 34px minmax(0, 1fr) auto;
        gap: 10px;
        align-items: center;
        min-height: 51px;
        padding: 8px 10px;
        color: rgba(246, 241, 230, 0.66);
        border: 1px solid transparent;
        border-radius: 6px;
        text-decoration: none;
        transition: 150ms ease;
    }

    .kb-section-tab:hover {
        color: #fff8e8;
        background: rgba(255, 255, 255, 0.045);
    }

    .kb-section-tab.active {
        color: #fff9e9;
        border-color: rgba(242, 199, 93, 0.24);
        background: linear-gradient(90deg, rgba(242, 199, 93, 0.16), rgba(242, 199, 93, 0.04));
    }

    .kb-section-tab:focus-visible,
    .kb-category-card:focus-visible,
    .kb-result-action a:focus-visible {
        outline: 2px solid #f2c75d;
        outline-offset: 3px;
    }

    .kb-tab-icon {
        display: grid;
        width: 34px;
        height: 34px;
        place-items: center;
        color: var(--kb-accent);
        border: 1px solid rgba(var(--kb-accent-rgb), 0.2);
        border-radius: 5px;
        background: rgba(var(--kb-accent-rgb), 0.07);
    }

    .kb-section-tab.active .kb-tab-icon {
        border-color: rgba(var(--kb-accent-rgb), 0.46);
        background: rgba(var(--kb-accent-rgb), 0.14);
        box-shadow: inset 0 0 12px rgba(var(--kb-accent-rgb), 0.08);
    }

    .kb-section-tab > span:nth-child(2) {
        min-width: 0;
        overflow: hidden;
        font-size: 0.9rem;
        font-weight: 720;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .kb-section-tab em {
        color: rgba(242, 199, 93, 0.66);
        font-size: 0.72rem;
        font-style: normal;
        font-variant-numeric: tabular-nums;
    }

    .kb-content {
        min-width: 0;
    }

    .kb-panel,
    .kb-search-results {
        scroll-margin-top: calc(var(--kb-search-sticky-top) + var(--kb-search-sticky-offset));
        overflow: hidden;
        border: 1px solid var(--kb-line);
        border-radius: 16px;
        background: var(--kb-surface);
        box-shadow: 0 24px 64px rgba(0, 0, 0, 0.2);
    }

    .kb-panel.kb-overview {
        overflow: visible;
        border: 0;
        border-radius: 0;
        background: transparent;
        box-shadow: none;
    }

    .kb-overview .kb-panel-header {
        padding: 22px 0 24px;
        border-bottom: 0;
        background: transparent;
    }

    .kb-overview .kb-category-grid {
        padding: 0;
    }

    .knowledge-base[data-enhanced="true"] .kb-panel[hidden],
    .kb-search-results[hidden],
    [data-kb-result][hidden],
    .kb-search-clear[hidden],
    .kb-empty[hidden] {
        display: none !important;
    }

    .knowledge-base:not([data-enhanced="true"]) .kb-panel + .kb-panel {
        margin-top: 28px;
    }

    .kb-panel-header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 24px;
        align-items: center;
        padding: 30px clamp(22px, 4vw, 42px);
        border-bottom: 1px solid var(--kb-line);
        background: linear-gradient(145deg, rgba(220, 177, 88, 0.065), rgba(255, 255, 255, 0.018) 52%, transparent);
    }

    .kb-heading-group {
        display: flex;
        gap: 17px;
        align-items: center;
        min-width: 0;
    }

    .kb-heading-group > div {
        min-width: 0;
    }

    .kb-heading-icon {
        display: grid;
        width: 60px;
        height: 60px;
        flex: 0 0 auto;
        place-items: center;
        color: var(--kb-accent);
        border: 1px solid rgba(var(--kb-accent-rgb), 0.34);
        border-radius: 7px;
        background: linear-gradient(145deg, rgba(var(--kb-accent-rgb), 0.16), rgba(var(--kb-accent-rgb), 0.035));
        box-shadow: inset 0 0 22px rgba(var(--kb-accent-rgb), 0.07);
    }

    .kb-panel-header.compact {
        padding-block: 24px;
    }

    .kb-panel-header h2 {
        margin: 0 0 8px;
        font-size: clamp(2rem, 4vw, 3.25rem);
        line-height: 1;
    }

    .kb-panel-header p:last-child {
        max-width: 730px;
        margin: 0;
        color: var(--kb-muted);
        line-height: 1.58;
    }

    .kb-panel-header > strong {
        display: grid;
        min-width: 68px;
        height: 68px;
        place-items: center;
        color: #f2c75d;
        border: 1px solid rgba(242, 199, 93, 0.24);
        border-radius: 50%;
        background: rgba(242, 199, 93, 0.06);
        font-family: var(--font-display);
        font-size: 1.5rem;
    }

    .kb-category-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 13px;
        padding: clamp(18px, 4vw, 38px);
    }

    .kb-category-card {
        position: relative;
        display: grid;
        grid-template-columns: 116px minmax(0, 1fr);
        gap: 18px;
        min-height: 178px;
        overflow: hidden;
        color: #f8f4e8;
        border: 1px solid rgba(var(--kb-accent-rgb), 0.2);
        border-radius: 8px;
        background: linear-gradient(135deg, rgba(var(--kb-accent-rgb), 0.09), rgba(255, 255, 255, 0.018) 58%);
        text-decoration: none;
        transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
    }

    .kb-category-card:first-child {
        grid-column: 1 / -1;
    }

    .kb-category-card:hover {
        border-color: rgba(var(--kb-accent-rgb), 0.52);
        background: linear-gradient(135deg, rgba(var(--kb-accent-rgb), 0.15), rgba(255, 255, 255, 0.028) 58%);
        transform: translateY(-2px);
    }

    .kb-category-art {
        position: relative;
        display: grid;
        overflow: hidden;
        place-items: center;
        color: var(--kb-accent);
        border-right: 1px solid rgba(var(--kb-accent-rgb), 0.16);
        background:
            linear-gradient(90deg, transparent 49%, rgba(var(--kb-accent-rgb), 0.1) 50%, transparent 51%),
            linear-gradient(0deg, transparent 49%, rgba(var(--kb-accent-rgb), 0.1) 50%, transparent 51%),
            linear-gradient(145deg, rgba(var(--kb-accent-rgb), 0.16), rgba(5, 4, 3, 0.55));
    }

    .kb-category-sigil {
        position: absolute;
        display: grid;
        width: 88px;
        height: 88px;
        place-items: center;
        filter: drop-shadow(0 8px 13px rgba(0, 0, 0, 0.48));
    }

    .kb-category-sigil::before {
        position: absolute;
        inset: 9px;
        border: 1px solid rgba(var(--kb-accent-rgb), 0.22);
        content: "";
        transform: rotate(45deg);
    }

    .kb-category-sigil :global(svg) {
        position: relative;
        z-index: 1;
    }

    .kb-category-copy {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 22px 46px 22px 0;
    }

    .kb-category-copy > strong {
        margin-bottom: 9px;
        font-family: var(--font-display);
        font-size: 1.55rem;
    }

    .kb-category-copy > span:last-child {
        color: var(--kb-muted);
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .kb-category-card > em {
        position: absolute;
        top: 14px;
        right: 14px;
        color: rgba(242, 199, 93, 0.76);
        font-size: 0.75rem;
        font-style: normal;
    }

    .kb-category-arrow {
        position: absolute;
        right: 17px;
        bottom: 15px;
        color: #e4b951;
        font-size: 1.2rem;
    }

    .kb-results-table-wrap {
        overflow-x: auto;
    }

    .kb-results-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

    .kb-results-table th {
        padding: 13px 14px;
        color: rgba(246, 241, 230, 0.48);
        border-bottom: 1px solid var(--kb-line);
        background: rgba(0, 0, 0, 0.17);
        font-size: 0.69rem;
        text-align: left;
        text-transform: uppercase;
        letter-spacing: 0.09em;
    }

    .kb-results-table th:nth-child(1) { width: 22%; }
    .kb-results-table th:nth-child(2) { width: 12%; }
    .kb-results-table th:nth-child(3) { width: 36%; }
    .kb-results-table th:nth-child(4) { width: 20%; }
    .kb-results-table th:nth-child(5) { width: 10%; }

    .kb-results-table td {
        padding: 13px 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.055);
        color: rgba(249, 246, 238, 0.76);
        font-size: 0.82rem;
        line-height: 1.45;
        vertical-align: middle;
    }

    .kb-results-table tbody tr:hover {
        background: rgba(242, 199, 93, 0.035);
    }

    .kb-result-name {
        display: flex;
        gap: 10px;
        align-items: center;
        color: #fcf7e9;
    }

    /* Ability, spell and artifact rows still show a bare icon, letterboxed; a creature row shows the
       composed portrait, which owns its own fit and must not be given one here. */
    .kb-result-name img {
        flex: 0 0 auto;
        width: 46px;
        height: 46px;
        object-fit: contain;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.035);
    }

    .kb-result-name :global(.portrait) {
        flex: 0 0 auto;
        width: 46px;
        height: 46px;
        border-radius: 8px;
    }

    .kb-type-badge {
        display: inline-flex;
        padding: 5px 8px;
        color: #dfbd65;
        border: 1px solid rgba(223, 189, 101, 0.2);
        border-radius: 999px;
        background: rgba(223, 189, 101, 0.06);
        font-size: 0.69rem;
        font-weight: 700;
    }

    .kb-result-summary {
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
    }

    .kb-result-meta {
        color: rgba(246, 241, 230, 0.52);
    }

    .kb-result-action a {
        color: #e8c261;
        font-weight: 730;
        text-decoration: none;
        white-space: nowrap;
    }

    .kb-empty {
        margin: 0;
        padding: 52px 24px;
        color: var(--kb-muted);
        text-align: center;
    }

    .kb-back-overview {
        display: inline-flex;
        margin-top: 22px;
        padding: 10px 14px;
        color: rgba(242, 199, 93, 0.82);
        border: 1px solid var(--kb-line);
        border-radius: 10px;
        text-decoration: none;
    }

    .kb-back-overview[hidden] {
        display: none;
    }

    .kb-target-highlight {
        animation: kb-highlight 2.2s ease-out;
    }

    @keyframes kb-highlight {
        0%, 25% { box-shadow: 0 0 0 4px rgba(242, 199, 93, 0.55), 0 0 42px rgba(242, 199, 93, 0.22); }
        100% { box-shadow: none; }
    }

    .kb-panel :global(.page-shell) {
        width: 100%;
        max-width: none;
        padding-inline: clamp(18px, 4vw, 38px);
    }

    .kb-panel :global(.units-section),
    .kb-panel :global(.abilities-section),
    .kb-panel :global(.spells-section),
    .kb-panel :global(.artifacts-section) {
        padding-top: clamp(18px, 4vw, 36px);
        padding-bottom: clamp(30px, 5vw, 52px);
        background: transparent;
    }

    .kb-panel :global(.rules-stat-strip) {
        border-top: 0;
    }

    :global(html.reveal-on) .knowledge-base :global(.section),
    :global(html.reveal-on) .knowledge-base :global(.rules-stat-strip) {
        opacity: 1 !important;
        transform: none !important;
    }

    @media (max-width: 1060px) {
        .knowledge-base {
            --kb-search-sticky-top: 0px;
        }

        .kb-layout {
            grid-template-columns: 1fr;
        }

        .kb-section-nav {
            z-index: 4;
            top: var(--kb-search-sticky-offset);
            display: flex;
            overflow-x: auto;
            scrollbar-width: none;
            -webkit-overflow-scrolling: touch;
        }

        .kb-section-tab {
            flex: 0 0 auto;
            min-width: 145px;
        }
    }

    @media (max-width: 760px) {
        .knowledge-base {
            --kb-search-sticky-offset: 110px;
        }

        .kb-search-shell {
            margin-top: 14px;
        }

        /* On a phone the card is the search field and nothing else: the title and hint go to screen
           readers only, and the controls sit centred in the card rather than hanging off a heading row. */
        .kb-search-card {
            display: grid;
            align-content: center;
            padding: 12px;
        }

        .kb-search-heading {
            position: absolute;
            overflow: hidden;
            width: 1px;
            height: 1px;
            margin: 0;
            clip: rect(0 0 0 0);
            clip-path: inset(50%);
            white-space: nowrap;
        }

        .kb-search-controls {
            gap: 10px;
        }

        .kb-search-field {
            flex: 1 0 100%;
            min-height: 52px;
        }

        .kb-search-field kbd {
            display: none;
        }

        .kb-layout {
            gap: 15px;
            padding-top: 22px;
            padding-bottom: 36px;
        }

        .kb-section-nav {
            margin-inline: -4px;
            padding: 0;
        }

        .kb-section-tab {
            grid-template-columns: 30px minmax(0, 1fr) auto;
            min-width: 132px;
            min-height: 47px;
            padding: 6px 8px;
        }

        .kb-tab-icon {
            width: 30px;
            height: 30px;
        }

        .kb-tab-icon :global(svg) {
            width: 27px;
            height: 27px;
        }

        .kb-heading-icon {
            width: 48px;
            height: 48px;
        }

        .kb-heading-icon :global(svg) {
            width: 30px;
            height: 30px;
        }

        .kb-panel,
        .kb-search-results {
            border-radius: 12px;
        }

        .kb-panel.kb-overview {
            border-radius: 0;
        }

        .kb-panel-header {
            grid-template-columns: 1fr auto;
            padding: 23px 18px;
        }

        .kb-panel-header > strong {
            min-width: 52px;
            height: 52px;
            font-size: 1.08rem;
        }

        .kb-category-grid {
            grid-template-columns: 1fr;
            padding: 14px;
        }

        .kb-category-card:first-child {
            grid-column: auto;
        }

        .kb-category-card {
            grid-template-columns: 92px minmax(0, 1fr);
            min-height: 154px;
        }

        .kb-category-copy {
            padding: 17px 38px 17px 0;
        }

        .kb-category-copy > strong {
            font-size: 1.25rem;
        }

        .kb-category-copy > span:last-child {
            font-size: 0.82rem;
        }

        .kb-results-table,
        .kb-results-table tbody {
            display: block;
        }

        .kb-results-table thead {
            display: none;
        }

        .kb-results-table tr {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            padding: 16px;
            border-bottom: 1px solid var(--kb-line);
        }

        .kb-results-table td {
            display: block;
            grid-column: 1 / -1;
            padding: 5px 0;
            border: 0;
        }

        .kb-results-table td:nth-child(1) {
            grid-column: 1;
        }

        .kb-results-table td:nth-child(2) {
            grid-column: 2;
            grid-row: 1;
            align-self: center;
            padding-left: 10px;
        }

        .kb-results-table td:nth-child(3) {
            padding-top: 11px;
        }

        .kb-results-table td:nth-child(4)::before {
            content: attr(data-label) ": ";
            color: rgba(246, 241, 230, 0.38);
            font-size: 0.7rem;
            text-transform: uppercase;
        }

        .kb-result-action {
            padding-top: 9px !important;
        }
    }

    @media (max-width: 440px) {
        .kb-category-card {
            grid-template-columns: 76px minmax(0, 1fr);
        }

        .kb-category-copy > span:last-child {
            display: -webkit-box;
            overflow: hidden;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 3;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .kb-category-card,
        .kb-section-tab,
        .kb-ai-toggle,
        .kb-ai-spark,
        .kb-ai-track,
        .kb-ai-track > span {
            transition: none;
        }

        .kb-target-highlight {
            animation: none;
            outline: 3px solid #f2c75d;
            outline-offset: 3px;
        }
    }

    /* ---- AI answer panel ------------------------------------------------------------------- */

    .kb-ai-ask {
        display: inline-flex;
        flex: 0 0 auto;
        gap: 8px;
        align-items: center;
        justify-content: center;
        min-height: 56px;
        padding: 0 16px;
        color: #14100b;
        border: 1px solid rgba(242, 199, 93, 0.7);
        border-radius: 10px;
        background: linear-gradient(120deg, #f2c75d, #dcae52);
        font: inherit;
        font-size: 0.84rem;
        font-weight: 760;
        letter-spacing: 0.03em;
        cursor: pointer;
        transition: filter 160ms ease, box-shadow 160ms ease, transform 160ms ease;
    }

    .kb-ai-ask .kb-ai-spark {
        color: rgba(20, 16, 11, 0.7);
    }

    .kb-ai-ask:hover {
        box-shadow: 0 8px 22px rgba(242, 199, 93, 0.25);
        filter: brightness(1.05);
    }

    .kb-ai-ask:focus-visible {
        outline: 3px solid rgba(242, 199, 93, 0.35);
        outline-offset: 2px;
    }

    .kb-ai-shell {
        margin-top: 18px;
    }

    .kb-ai-prompt {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 10px;
        align-items: center;
        width: 100%;
        margin: 0 0 14px;
        padding: 12px 16px;
        color: #fff4cc;
        border: 1px solid rgba(242, 199, 93, 0.45);
        border-radius: 10px;
        background: linear-gradient(110deg, rgba(242, 199, 93, 0.16), rgba(100, 179, 158, 0.08));
        font: inherit;
        font-size: 0.92rem;
        text-align: left;
        cursor: pointer;
        transition: border-color 160ms ease, background 160ms ease, box-shadow 160ms ease;
    }

    .kb-ai-prompt:hover {
        border-color: rgba(242, 199, 93, 0.8);
        box-shadow: 0 8px 22px rgba(242, 199, 93, 0.16);
    }

    .kb-ai-prompt:focus-visible {
        outline: 3px solid rgba(242, 199, 93, 0.35);
        outline-offset: 2px;
    }

    .kb-ai-prompt .kb-ai-spark {
        color: #f2c75d;
        text-shadow: 0 0 10px rgba(242, 199, 93, 0.55);
    }

    .kb-ai-prompt-lead {
        color: rgba(246, 241, 230, 0.7);
        font-size: 0.78rem;
        font-weight: 760;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .kb-ai-prompt-question {
        flex: 1 1 200px;
        min-width: 0;
        overflow: hidden;
        font-style: italic;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .kb-ai-prompt-cta {
        margin-left: auto;
        padding: 5px 12px;
        color: #14100b;
        border-radius: 999px;
        background: linear-gradient(120deg, #f2c75d, #dcae52);
        font-size: 0.78rem;
        font-weight: 760;
        white-space: nowrap;
    }

    .kb-ai-panel {
        position: relative;
        padding: 18px 20px 14px;
        border: 1px solid rgba(242, 199, 93, 0.24);
        border-radius: 14px;
        background:
            linear-gradient(140deg, rgba(22, 15, 9, 0.98), rgba(10, 8, 6, 0.98)),
            radial-gradient(circle at 0 0, rgba(242, 199, 93, 0.14), transparent 45%);
        box-shadow: 0 18px 44px rgba(0, 0, 0, 0.38);
    }

    .kb-ai-panel-head {
        display: flex;
