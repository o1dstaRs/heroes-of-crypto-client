---
import AbilitiesPage from "./AbilitiesPage.astro";
import ArtifactsPage from "./ArtifactsPage.astro";
import RulesPage from "./RulesPage.astro";
import SpellsPage from "./SpellsPage.astro";
import UnitsPage from "./UnitsPage.astro";
import { artifacts, artifactsCount } from "../lib/artifacts-data";
import {
    buildKnowledgeEntries,
    knowledgeEntryId,
    knowledgePath,
    type KnowledgeCatalogSection,
    type KnowledgeSection,
} from "../lib/knowledge-base";
import { spells, spellsCount } from "../lib/spells-data";
import type { Language } from "../lib/site-data";
import { abilities, abilitiesCount, allUnits, unitCount } from "../lib/units-data";

interface Props {
    lang: Language;
}

const { lang } = Astro.props;
const isRu = lang === "ru";
const entries = buildKnowledgeEntries(lang);
const rulesCount = entries.filter((entry) => entry.section === "rules").length;
const totalCount = entries.length;

const copy = isRu
    ? {
          eyebrow: "Единый справочник игрока",
          title: "База знаний",
          description:
              "Правила, юниты, способности, заклинания и артефакты — в одном месте с быстрым поиском и прямыми ссылками.",
          searchLabel: "Поиск по базе знаний",
          searchPlaceholder: "Например: мораль, огонь, дракон, воскрешение...",
          searchHint: "Нажмите /, чтобы начать поиск. Можно вводить несколько слов в любом порядке.",
          clear: "Очистить поиск",
          all: "Всё",
          overview: "Обзор",
          rules: "Правила",
          units: "Юниты",
          abilities: "Способности",
          spells: "Заклинания",
          artifacts: "Артефакты",
          indexed: "материалов в поиске",
          sections: "разделов",
          liveData: "единый справочник",
          browseTitle: "Выберите раздел",
          browseBody:
              "Начните с полного руководства или откройте каталог. Внутри каждого каталога есть дополнительные фильтры и подробные карточки.",
          searchResults: "Результаты поиска",
          searchResultsBody: "Найдите точное правило или объект, затем перейдите прямо к его описанию.",
          noResults: "Ничего не найдено. Попробуйте другое название, эффект, фракцию или механику.",
          result: "результат",
          results: "результатов",
          type: "Раздел",
          name: "Название",
          summary: "Описание",
          details: "Метки",
          action: "Открыть",
          open: "Перейти",
          filterLabel: "Фильтр результатов по разделу",
          sectionNav: "Разделы базы знаний",
          returnToOverview: "Вернуться к обзору",
          categoryDescriptions: {
              rules: "Полный цикл матча: драфт, расстановка, бой, мораль, удача, карты и Армагеддон.",
              units: "Характеристики, роли, движение, способности и заклинания всего боевого ростера.",
              abilities: "Пассивные эффекты, ауры и активные умения с указанием всех носителей.",
              spells: "Школы, источники, цели, длительность, урон, баффы и дебаффы.",
              artifacts: "Артефакты 1-го и 2-го уровней, проклятые варианты и точные эффекты армии.",
          },
          sectionEyebrows: {
              rules: "Руководство",
              units: "Боевой ростер",
              abilities: "Справочник умений",
              spells: "Справочник магии",
              artifacts: "Арсенал армии",
          },
      }
    : {
          eyebrow: "Unified player reference",
          title: "Knowledge Base",
          description:
              "Rules, units, abilities, spells, and artifacts in one searchable home with direct links to every detail.",
          searchLabel: "Search the Knowledge Base",
          searchPlaceholder: "Try morale, fire, dragon, resurrection...",
          searchHint: "Press / to search. Use several words in any order to narrow the results.",
          clear: "Clear search",
          all: "All",
          overview: "Overview",
          rules: "Rules",
          units: "Units",
          abilities: "Abilities",
          spells: "Spells",
          artifacts: "Artifacts",
          indexed: "searchable references",
          sections: "sections",
          liveData: "one source of truth",
          browseTitle: "Choose a section",
          browseBody:
              "Start with the complete guide or open a catalog. Each catalog adds focused filters and descriptive detail cards.",
          searchResults: "Search results",
          searchResultsBody: "Find a rule or game object, then jump directly to its full description.",
          noResults: "No matches. Try another name, effect, faction, or game mechanic.",
          result: "result",
          results: "results",
          type: "Section",
          name: "Name",
          summary: "Summary",
          details: "Tags",
          action: "Open",
          open: "View",
          filterLabel: "Filter search results by section",
          sectionNav: "Knowledge Base sections",
          returnToOverview: "Return to overview",
          categoryDescriptions: {
              rules: "The complete match loop: draft, placement, combat, morale, luck, maps, and Armageddon.",
              units: "Stats, roles, movement, abilities, and spells for the entire combat roster.",
              abilities: "Passive effects, auras, and active skills with every carrier clearly identified.",
              spells: "Schools, sources, targets, duration, damage, buffs, and debuffs.",
              artifacts: "Tier 1 and Tier 2 artifacts, cursed options, and exact army-wide effects.",
          },
          sectionEyebrows: {
              rules: "Game guide",
              units: "Combat roster",
              abilities: "Skill reference",
              spells: "Magic reference",
              artifacts: "Army arsenal",
          },
      };

const categoryCounts: Record<KnowledgeCatalogSection, number> = {
    rules: rulesCount,
    units: unitCount,
    abilities: abilitiesCount,
    spells: spellsCount,
    artifacts: artifactsCount,
};

const categoryImages: Record<KnowledgeCatalogSection, string> = {
    rules: "/assets/images/preview_game.webp",
    units: allUnits.find((unit) => unit.name === "Black Dragon")?.icon ?? allUnits[0]?.icon ?? "",
    abilities: abilities.find((ability) => ability.name === "Lucky Strike")?.icon ?? abilities[0]?.icon ?? "",
    spells: spells.find((spell) => spell.name === "Meteor Shower")?.icon ?? spells[0]?.icon ?? "",
    artifacts: artifacts[0]?.icon ?? "",
};

const categorySections: KnowledgeCatalogSection[] = ["rules", "units", "abilities", "spells", "artifacts"];
const navigationSections: KnowledgeSection[] = ["overview", ...categorySections];
const sectionLabels: Record<KnowledgeSection, string> = {
    overview: copy.overview,
    rules: copy.rules,
    units: copy.units,
    abilities: copy.abilities,
    spells: copy.spells,
    artifacts: copy.artifacts,
};
---

<div
    class="knowledge-base"
    data-knowledge-base
    data-result-singular={copy.result}
    data-result-plural={copy.results}
>
    <a class="kb-skip-link" href="#kb-search">{copy.searchLabel}</a>

    <header class="kb-hero">
        <div class="kb-hero-image" aria-hidden="true"></div>
        <div class="page-shell kb-hero-shell">
            <div class="kb-hero-copy">
                <p class="eyebrow">{copy.eyebrow}</p>
                <h1>{copy.title}</h1>
                <p>{copy.description}</p>
            </div>
            <dl class="kb-hero-stats" aria-label={isRu ? "Содержание базы знаний" : "Knowledge Base contents"}>
                <div><dt>{copy.indexed}</dt><dd>{totalCount}</dd></div>
                <div><dt>{copy.sections}</dt><dd>5</dd></div>
                <div><dt>{copy.liveData}</dt><dd><span aria-hidden="true">✓</span><span class="sr-only">{isRu ? "Да" : "Yes"}</span></dd></div>
            </dl>
        </div>
    </header>

    <div class="page-shell kb-search-shell">
        <section class="kb-search-card" id="kb-search" aria-labelledby="kb-search-label">
            <div class="kb-search-main">
                <label id="kb-search-label" for="kb-search-input">{copy.searchLabel}</label>
                <div class="kb-search-field">
                    <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
                        <circle cx="10.8" cy="10.8" r="6.8"></circle>
                        <path d="m16 16 4.3 4.3"></path>
                    </svg>
                    <input
                        id="kb-search-input"
                        data-kb-search
                        type="search"
                        autocomplete="off"
                        placeholder={copy.searchPlaceholder}
                        aria-describedby="kb-search-hint kb-search-status"
                    />
                    <button class="kb-search-clear" data-kb-clear type="button" aria-label={copy.clear} hidden>×</button>
                    <kbd aria-hidden="true">/</kbd>
                </div>
                <p id="kb-search-hint" class="kb-search-hint">{copy.searchHint}</p>
            </div>

            <div class="kb-search-filters" role="group" aria-label={copy.filterLabel}>
                <button type="button" class="active" data-kb-search-filter="all" aria-pressed="true">
                    {copy.all}<span>{totalCount}</span>
                </button>
                {
                    categorySections.map((section) => (
                        <button type="button" data-kb-search-filter={section} aria-pressed="false">
                            {sectionLabels[section]}<span>{categoryCounts[section]}</span>
                        </button>
                    ))
                }
            </div>
            <p id="kb-search-status" class="sr-only" data-kb-status role="status" aria-live="polite"></p>
        </section>
    </div>

    <div class="page-shell kb-layout">
        <nav class="kb-section-nav" data-kb-tablist aria-label={copy.sectionNav}>
            {
                navigationSections.map((section, index) => (
                    <a
                        class:list={["kb-section-tab", { active: section === "overview" }]}
                        id={`kb-tab-${section}`}
                        href={section === "overview" ? knowledgePath(lang) : knowledgePath(lang, { section })}
                        data-kb-tab={section}
                        aria-current={section === "overview" ? "page" : undefined}
                    >
                        <span class="kb-tab-icon" aria-hidden="true">
                            {section === "overview" ? (
                                <img src="/assets/images/home/logo/hocai_logo_96.png" alt="" width="30" height="30" />
                            ) : (
                                <img src={categoryImages[section]} alt="" width="30" height="30" loading="lazy" />
                            )}
                        </span>
                        <span>{sectionLabels[section]}</span>
                        <em>{section === "overview" ? totalCount : categoryCounts[section]}</em>
                    </a>
                ))
            }
        </nav>

        <div class="kb-content" id="kb-content">
            <section class="kb-search-results" data-kb-search-results aria-labelledby="kb-results-title" hidden>
                <header class="kb-panel-header compact">
                    <div>
                        <p class="eyebrow">{copy.eyebrow}</p>
                        <h2 id="kb-results-title">{copy.searchResults}</h2>
                        <p>{copy.searchResultsBody}</p>
                    </div>
                    <strong data-kb-visible-count>0</strong>
                </header>

                <div class="kb-results-table-wrap">
                    <table class="kb-results-table">
                        <thead>
                            <tr>
                                <th scope="col">{copy.name}</th>
                                <th scope="col">{copy.type}</th>
                                <th scope="col">{copy.summary}</th>
                                <th scope="col">{copy.details}</th>
                                <th scope="col"><span class="sr-only">{copy.action}</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            {
                                entries.map((entry) => (
                                    <tr
                                        data-kb-result
                                        data-section={entry.section}
                                        data-name={entry.name}
                                        data-search={`${entry.name} ${entry.description} ${entry.meta} ${entry.searchText}`}
                                    >
                                        <td data-label={copy.name}>
                                            <span class="kb-result-name">
                                                <img src={entry.image} alt="" width="46" height="46" loading="lazy" />
                                                <strong>{entry.name}</strong>
                                            </span>
                                        </td>
                                        <td data-label={copy.type}>
                                            <span class={`kb-type-badge ${entry.section}`}>{sectionLabels[entry.section]}</span>
                                        </td>
                                        <td data-label={copy.summary}><span class="kb-result-summary">{entry.description}</span></td>
                                        <td data-label={copy.details}><span class="kb-result-meta">{entry.meta}</span></td>
                                        <td class="kb-result-action">
                                            <a
                                                href={knowledgePath(lang, { section: entry.section, entry: entry.target })}
                                                data-kb-result-link
                                                data-section={entry.section}
                                                data-target={knowledgeEntryId(entry.section, entry.target)}
                                                aria-label={`${copy.open}: ${entry.name}`}
                                            >
                                                {copy.open}<span aria-hidden="true"> →</span>
                                            </a>
                                        </td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                </div>
                <p class="kb-empty" data-kb-empty hidden>{copy.noResults}</p>
            </section>

            <section class="kb-panel kb-overview" id="overview" data-kb-panel="overview" aria-labelledby="kb-tab-overview">
                <header class="kb-panel-header">
                    <div>
                        <p class="eyebrow">{copy.eyebrow}</p>
                        <h2>{copy.browseTitle}</h2>
                        <p>{copy.browseBody}</p>
                    </div>
                    <strong>{totalCount}</strong>
                </header>
                <div class="kb-category-grid">
                    {
                        categorySections.map((section) => (
                            <a
                                class={`kb-category-card ${section}`}
                                href={knowledgePath(lang, { section })}
                                data-kb-section-link={section}
                            >
                                <span class="kb-category-art">
                                    <img src={categoryImages[section]} alt="" width="180" height="180" loading="lazy" />
                                </span>
                                <span class="kb-category-copy">
                                    <span class="eyebrow">{copy.sectionEyebrows[section]}</span>
                                    <strong>{sectionLabels[section]}</strong>
                                    <span>{copy.categoryDescriptions[section]}</span>
                                </span>
                                <em>{categoryCounts[section]}</em>
                                <span class="kb-category-arrow" aria-hidden="true">↗</span>
                            </a>
                        ))
                    }
                </div>
            </section>

            <section class="kb-panel" id="rules" data-kb-panel="rules" aria-labelledby="kb-tab-rules">
                <header class="kb-panel-header">
                    <div>
                        <p class="eyebrow">{copy.sectionEyebrows.rules}</p>
                        <h2>{copy.rules}</h2>
                        <p>{copy.categoryDescriptions.rules}</p>
                    </div>
                    <strong>{categoryCounts.rules}</strong>
                </header>
                <RulesPage lang={lang} embedded />
            </section>

            <section class="kb-panel" id="units" data-kb-panel="units" aria-labelledby="kb-tab-units">
                <header class="kb-panel-header">
                    <div>
                        <p class="eyebrow">{copy.sectionEyebrows.units}</p>
                        <h2>{copy.units}</h2>
                        <p>{copy.categoryDescriptions.units}</p>
                    </div>
                    <strong>{categoryCounts.units}</strong>
                </header>
                <UnitsPage lang={lang} embedded />
            </section>

            <section class="kb-panel" id="abilities" data-kb-panel="abilities" aria-labelledby="kb-tab-abilities">
                <header class="kb-panel-header">
                    <div>
                        <p class="eyebrow">{copy.sectionEyebrows.abilities}</p>
                        <h2>{copy.abilities}</h2>
                        <p>{copy.categoryDescriptions.abilities}</p>
                    </div>
                    <strong>{categoryCounts.abilities}</strong>
                </header>
                <AbilitiesPage lang={lang} embedded />
            </section>

            <section class="kb-panel" id="spells" data-kb-panel="spells" aria-labelledby="kb-tab-spells">
                <header class="kb-panel-header">
                    <div>
                        <p class="eyebrow">{copy.sectionEyebrows.spells}</p>
                        <h2>{copy.spells}</h2>
                        <p>{copy.categoryDescriptions.spells}</p>
                    </div>
                    <strong>{categoryCounts.spells}</strong>
                </header>
                <SpellsPage lang={lang} embedded />
            </section>

            <section class="kb-panel" id="artifacts" data-kb-panel="artifacts" aria-labelledby="kb-tab-artifacts">
                <header class="kb-panel-header">
                    <div>
                        <p class="eyebrow">{copy.sectionEyebrows.artifacts}</p>
                        <h2>{copy.artifacts}</h2>
                        <p>{copy.categoryDescriptions.artifacts}</p>
                    </div>
                    <strong>{categoryCounts.artifacts}</strong>
                </header>
                <ArtifactsPage lang={lang} embedded />
            </section>

            <a class="kb-back-overview" href={knowledgePath(lang)} data-kb-section-link="overview">← {copy.returnToOverview}</a>
        </div>
    </div>
</div>

<script>
    import {
        isKnowledgeSection,
        knowledgeEntryMatches,
        knowledgeSearchRank,
        type KnowledgeCatalogSection,
        type KnowledgeSection,
    } from "../lib/knowledge-base";

    const roots = document.querySelectorAll<HTMLElement>("[data-knowledge-base]");

    roots.forEach((root) => {
        const tabs = Array.from(root.querySelectorAll<HTMLAnchorElement>("[data-kb-tab]"));
        const tablist = root.querySelector<HTMLElement>("[data-kb-tablist]");
        const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-kb-panel]"));
        const searchInput = root.querySelector<HTMLInputElement>("[data-kb-search]");
        const clearButton = root.querySelector<HTMLButtonElement>("[data-kb-clear]");
        const searchResults = root.querySelector<HTMLElement>("[data-kb-search-results]");
        const resultRows = Array.from(root.querySelectorAll<HTMLTableRowElement>("[data-kb-result]"));
        const filterButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-kb-search-filter]"));
        const status = root.querySelector<HTMLElement>("[data-kb-status]");
        const count = root.querySelector<HTMLElement>("[data-kb-visible-count]");
        const empty = root.querySelector<HTMLElement>("[data-kb-empty]");
        let activeSection: KnowledgeSection = "overview";
        let searchSection: KnowledgeCatalogSection | "all" = "all";

        tablist?.setAttribute("role", "tablist");
        tabs.forEach((tab) => {
            const section = tab.dataset.kbTab;
            if (!isKnowledgeSection(section)) return;
            tab.id = `kb-tab-${section}`;
            tab.setAttribute("role", "tab");
            tab.setAttribute("aria-controls", section);
        });
        panels.forEach((panel) => panel.setAttribute("role", "tabpanel"));
        root.dataset.enhanced = "true";

        const sectionFromFragment = (fragment: string): KnowledgeSection => {
            let clean = fragment.replace(/^#/, "");
            try {
                clean = decodeURIComponent(clean);
            } catch {
                // A malformed external fragment should fall back to the overview, not stop page setup.
                return "overview";
            }
            if (isKnowledgeSection(clean)) return clean;
            if (clean.startsWith("rule-")) return "rules";
            if (clean.startsWith("unit-")) return "units";
            if (clean.startsWith("ability-")) return "abilities";
            if (clean.startsWith("spell-")) return "spells";
            if (clean.startsWith("artifact-")) return "artifacts";
            return "overview";
        };

        const activateSection = (section: KnowledgeSection, focusTab = false) => {
            root.querySelectorAll<HTMLDialogElement>("dialog[open]").forEach((dialog) => dialog.close());
            activeSection = section;
            searchResults?.setAttribute("hidden", "");
            panels.forEach((panel) => {
                const selected = panel.dataset.kbPanel === section;
                panel.hidden = !selected;
            });
            tabs.forEach((tab) => {
                const selected = tab.dataset.kbTab === section;
                tab.classList.toggle("active", selected);
                tab.setAttribute("aria-selected", selected ? "true" : "false");
                tab.tabIndex = selected ? 0 : -1;
                if (selected) tab.setAttribute("aria-current", "page");
                else tab.removeAttribute("aria-current");
                if (selected && focusTab) tab.focus();
            });
        };

        const updateSectionUrl = (section: KnowledgeSection) => {
            const url = new URL(window.location.href);
            url.searchParams.delete("q");
            url.searchParams.delete("entry");
            url.hash = section === "overview" ? "" : section;
            window.history.pushState(null, "", `${url.pathname}${url.search}${url.hash}`);
        };

        const setSearchFilter = (section: KnowledgeCatalogSection | "all") => {
            searchSection = section;
            filterButtons.forEach((button) => {
                const selected = (button.dataset.kbSearchFilter ?? "all") === section;
                button.classList.toggle("active", selected);
                button.setAttribute("aria-pressed", selected ? "true" : "false");
            });
        };

        const applySearch = (syncUrl = true) => {
            const query = searchInput?.value.trim() ?? "";
            const searching = Boolean(query);
            let visible = 0;

            resultRows.forEach((row) => {
                const sectionMatch = searchSection === "all" || row.dataset.section === searchSection;
                const queryMatch = searching && knowledgeEntryMatches(row.dataset.search ?? "", query);
                const shown = sectionMatch && queryMatch;
                row.hidden = !shown;
                if (shown) visible += 1;
            });

            const resultBody = resultRows[0]?.parentElement;
            if (searching && resultBody) {
                resultRows
                    .sort(
                        (a, b) =>
                            knowledgeSearchRank(a.dataset.name ?? "", a.dataset.search ?? "", query) -
                                knowledgeSearchRank(b.dataset.name ?? "", b.dataset.search ?? "", query) ||
                            (a.dataset.name ?? "").localeCompare(b.dataset.name ?? ""),
                    )
                    .forEach((row) => resultBody.append(row));
            }

            if (searching) {
                panels.forEach((panel) => (panel.hidden = true));
                if (searchResults) searchResults.hidden = false;
            } else {
                if (searchResults) searchResults.hidden = true;
                activateSection(activeSection);
            }

            if (clearButton) clearButton.hidden = !searching;
            if (count) count.textContent = String(visible);
            if (empty) empty.hidden = !searching || visible > 0;
            if (status) {
                const resultWord = visible === 1 ? root.dataset.resultSingular : root.dataset.resultPlural;
                status.textContent = searching ? `${visible} ${resultWord ?? "results"}` : "";
            }

            if (syncUrl) {
                const url = new URL(window.location.href);
                if (query) url.searchParams.set("q", query);
                else url.searchParams.delete("q");
                window.history.replaceState(null, "", `${url.pathname}${url.search}${url.hash}`);
            }
        };

        const focusTarget = (targetId: string) => {
            const target = document.getElementById(targetId);
            if (!target) return;
            const details = target.matches("details") ? target : target.closest("details");
            if (details instanceof HTMLDetailsElement) details.open = true;
            target.classList.add("kb-target-highlight");
            target.scrollIntoView({ behavior: "smooth", block: "center" });
            const isNaturallyFocusable = target.matches(
                'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]',
            );
            if (!isNaturallyFocusable) target.tabIndex = -1;
            target.focus({ preventScroll: true });
            if (target instanceof HTMLButtonElement && target.matches("[data-unit]")) target.click();
            window.setTimeout(() => {
                target.classList.remove("kb-target-highlight");
                if (!isNaturallyFocusable) target.removeAttribute("tabindex");
            }, 2200);
        };

        const resetSearchUi = () => {
            if (searchInput) searchInput.value = "";
            setSearchFilter("all");
            applySearch(false);
        };

        tabs.forEach((tab, index) => {
            tab.addEventListener("click", (event) => {
                const section = tab.dataset.kbTab;
                if (!isKnowledgeSection(section)) return;
                event.preventDefault();
                resetSearchUi();
                activateSection(section);
                updateSectionUrl(section);
                root.querySelector<HTMLElement>(`[data-kb-panel="${section}"]`)?.scrollIntoView({
                    behavior: "smooth",
                    block: "start",
                });
            });

            tab.addEventListener("keydown", (event) => {
                let next = index;
                if (event.key === "ArrowRight" || event.key === "ArrowDown") next = (index + 1) % tabs.length;
                else if (event.key === "ArrowLeft" || event.key === "ArrowUp") next = (index - 1 + tabs.length) % tabs.length;
                else if (event.key === "Home") next = 0;
                else if (event.key === "End") next = tabs.length - 1;
                else return;
                event.preventDefault();
                tabs[next]?.click();
                tabs[next]?.focus({ preventScroll: true });
            });
        });

        root.querySelectorAll<HTMLAnchorElement>("[data-kb-section-link]").forEach((link) => {
            link.addEventListener("click", (event) => {
                const section = link.dataset.kbSectionLink;
                if (!isKnowledgeSection(section)) return;
                event.preventDefault();
                resetSearchUi();
                activateSection(section);
                updateSectionUrl(section);
                root.querySelector<HTMLElement>(`[data-kb-panel="${section}"]`)?.scrollIntoView({
                    behavior: "smooth",
                    block: "start",
                });
            });
        });

        filterButtons.forEach((button) => {
            button.addEventListener("click", () => {
                const value = button.dataset.kbSearchFilter;
                const section = value === "all" ? "all" : isKnowledgeSection(value) && value !== "overview" ? value : "all";
                setSearchFilter(section);
                applySearch();
            });
        });

        searchInput?.addEventListener("input", () => applySearch());
        clearButton?.addEventListener("click", () => {
            if (searchInput) {
                searchInput.value = "";
                searchInput.focus();
            }
            setSearchFilter("all");
            applySearch();
        });

        root.querySelectorAll<HTMLAnchorElement>("[data-kb-result-link]").forEach((link) => {
            link.addEventListener("click", (event) => {
                const section = link.dataset.section;
                const target = link.dataset.target;
                if (!isKnowledgeSection(section) || section === "overview" || !target) return;
                event.preventDefault();
                resetSearchUi();
                activateSection(section);
                const destination = new URL(link.href);
                window.history.pushState(null, "", `${destination.pathname}${destination.search}${destination.hash}`);
                window.requestAnimationFrame(() => focusTarget(target));
            });
        });

        document.addEventListener("keydown", (event) => {
            const target = event.target as HTMLElement | null;
            const isTyping =
                target?.matches("input, textarea, select") || target?.isContentEditable || target?.closest("[contenteditable]");
            if (event.key === "/" && !isTyping) {
                event.preventDefault();
                searchInput?.focus();
            } else if (event.key === "Escape" && document.activeElement === searchInput && searchInput?.value) {
                searchInput.value = "";
                setSearchFilter("all");
                applySearch();
            }
        });

        const syncFromLocation = () => {
            const params = new URLSearchParams(window.location.search);
            const query = params.get("q") ?? "";
            const section = sectionFromFragment(window.location.hash);
            setSearchFilter("all");
            activateSection(section);
            if (searchInput) searchInput.value = query;
            applySearch(false);
            const target = window.location.hash.replace(/^#/, "");
            if (target && target !== section && !query) window.requestAnimationFrame(() => focusTarget(target));
        };

        window.addEventListener("popstate", syncFromLocation);
        window.addEventListener("hashchange", syncFromLocation);
        syncFromLocation();
    });
</script>

