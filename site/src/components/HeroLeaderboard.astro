---
import { rankedArenaCopy, type RankedArenaLanguage } from "../lib/ranked-arena-copy";

interface Props {
    lang: RankedArenaLanguage;
    topN?: number;
}

const { lang, topN: requestedTopN = 10 } = Astro.props;
const copy = rankedArenaCopy[lang];
const topN = Math.max(1, Math.min(100, Math.trunc(requestedTopN)));
---

<aside
    class="hero-ranked"
    data-hero-leaderboard
    data-language={lang}
    data-top-n={topN}
    aria-labelledby="hero-ranked-title"
>
    <div class="hero-ranked__frame" data-hero-ranked-frame data-state="loading">
        <header class="hero-ranked__header">
            <div>
                <p class="hero-ranked__eyebrow">
                    <span aria-hidden="true"></span>
                    {copy.heroLadderEyebrow}
                </p>
                <h2 id="hero-ranked-title">{copy.heroLadderTitle}</h2>
                <p>{copy.heroLadderBody}</p>
            </div>
            <span class="hero-ranked__top-mark">{copy.topPlayers.replace("{n}", String(topN))}</span>
        </header>

        <div
            class="hero-ranked__viewport"
            data-hero-ranked-viewport
            tabindex="0"
            role="region"
            aria-label={copy.heroLadderTitle}
            aria-busy="true"
        >
            <div class="hero-ranked__loading" data-hero-ranked-loading>
                <span class="hero-ranked__loading-title">{copy.loadingTopPlayers}</span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>

        <footer class="hero-ranked__footer">
            <div class="hero-ranked__slider-controls" data-hero-ranked-controls hidden>
                <button type="button" data-hero-ranked-previous aria-label={copy.previousPlayers} title={copy.previousPlayers}>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 6-6 6 6 6"></path></svg>
                </button>
                <div class="hero-ranked__pages" data-hero-ranked-pages></div>
                <button type="button" data-hero-ranked-next aria-label={copy.nextPlayers} title={copy.nextPlayers}>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 6 6 6-6 6"></path></svg>
                </button>
            </div>
            <span class="hero-ranked__range" data-hero-ranked-range aria-live="polite"></span>
            <a class="hero-ranked__ladder-link" href="#arena">
                {copy.viewFullLadder}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-5 5 5-5 5"></path></svg>
            </a>
        </footer>

        <p class="sr-only" data-hero-ranked-announcer aria-live="polite" aria-atomic="true"></p>
    </div>

    <noscript>
        <p class="hero-ranked__noscript">{copy.noJs}</p>
    </noscript>
</aside>

<style is:global>
    .hero-ranked {
        position: relative;
        width: min(100%, 520px);
        min-width: 0;
        justify-self: end;
        color: #efe4cc;
        font-family: var(--hoc-font-display);
        font-synthesis: none;
        animation: hocRise 0.72s cubic-bezier(0.22, 1, 0.36, 1) 0.14s both;
    }

    .hero-ranked::before {
        position: absolute;
        z-index: -1;
        inset: 10% 4% 0;
        border-radius: 50%;
        background: linear-gradient(135deg, rgba(255, 90, 63, 0.18), rgba(220, 177, 88, 0.12));
        filter: blur(68px);
        content: "";
        pointer-events: none;
    }

    .hero-ranked__frame {
        position: relative;
        display: grid;
        grid-template-rows: auto minmax(280px, 1fr) auto;
        min-height: 484px;
        overflow: hidden;
        padding: 28px 30px 24px;
        border: 1px solid rgba(220, 177, 88, 0.16);
        border-radius: 18px;
        background:
            radial-gradient(circle at 8% 0, rgba(255, 90, 63, 0.14), transparent 38%),
            radial-gradient(circle at 100% 0, rgba(220, 177, 88, 0.1), transparent 34%),
            linear-gradient(155deg, rgba(28, 18, 12, 0.92), rgba(7, 7, 7, 0.94) 48%, rgba(5, 5, 5, 0.98));
        backdrop-filter: blur(14px);
        box-shadow:
            0 28px 70px rgba(0, 0, 0, 0.5),
            inset 0 1px rgba(255, 238, 203, 0.04);
    }

    .hero-ranked__frame::before {
        position: absolute;
        top: 0;
        left: 30px;
        width: 88px;
        height: 2px;
        border-radius: 0 0 999px 999px;
        background: linear-gradient(90deg, #ff5a3f, #e8bd62);
        box-shadow: 0 0 18px rgba(255, 90, 63, 0.34);
        content: "";
        pointer-events: none;
    }

    .hero-ranked__header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 14px;
        align-items: start;
        padding: 0 0 20px;
        border-bottom: 1px solid rgba(239, 228, 204, 0.1);
    }

    .hero-ranked__header h2 {
        margin: 0 0 5px;
        color: #fff1d8;
        font-family: var(--hoc-font-display);
        font-size: clamp(1.46rem, 2vw, 1.8rem);
        font-weight: 400;
        font-synthesis: none;
        letter-spacing: 0.055em;
        line-height: 1.05;
        text-transform: uppercase;
        text-shadow: 0 8px 24px rgba(0, 0, 0, 0.44);
    }

    .hero-ranked__header > div > p:last-child {
        max-width: 330px;
        margin: 0;
        color: rgba(239, 228, 204, 0.58);
        font-size: 0.78rem;
        letter-spacing: 0.025em;
        line-height: 1.45;
    }

    .hero-ranked__eyebrow {
        display: flex;
        gap: 8px;
        align-items: center;
        margin: 0 0 7px;
        color: #dcb158;
        font-size: 0.68rem;
        font-weight: 400;
        letter-spacing: 0.14em;
        line-height: 1.2;
        text-transform: uppercase;
    }

    .hero-ranked__eyebrow span {
        width: 7px;
        height: 7px;
        border: 1px solid rgba(255, 145, 77, 0.7);
        border-radius: 50%;
        background: #ff5a3f;
        box-shadow: 0 0 9px rgba(255, 90, 63, 0.8);
        animation: hero-ranked-live 2.1s ease-in-out infinite;
    }

    .hero-ranked__top-mark {
        display: inline-flex;
        align-items: center;
        min-height: 30px;
        padding: 6px 10px 5px;
        border: 0;
        border-radius: 999px;
        background: rgba(220, 177, 88, 0.11);
        color: #efc96e;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        line-height: 1;
        text-transform: uppercase;
        white-space: nowrap;
        box-shadow: inset 0 0 0 1px rgba(220, 177, 88, 0.14);
    }

    .hero-ranked__viewport {
        min-width: 0;
        overflow: hidden;
        padding: 10px 0 8px;
        outline-offset: -3px;
        touch-action: pan-y;
    }

    .hero-ranked__track {
        display: flex;
        width: 100%;
        transition: transform 0.46s cubic-bezier(0.22, 1, 0.36, 1);
        will-change: transform;
    }

    .hero-ranked__page {
        flex: 0 0 100%;
        min-width: 0;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .hero-ranked__player-item {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .hero-ranked__player {
        position: relative;
        display: grid;
        grid-template-columns: 34px 40px minmax(0, 1fr) auto;
        gap: 9px;
        align-items: center;
        min-height: 64px;
        width: 100%;
        padding: 7px 9px;
        border: 0;
        border-bottom: 1px solid rgba(239, 228, 204, 0.07);
        background: transparent;
        color: #efe4cc;
        font: inherit;
        text-align: left;
        cursor: pointer;
    }

    .hero-ranked__player-item:last-child .hero-ranked__player {
        border-bottom-color: transparent;
    }

    .hero-ranked__player::before {
        position: absolute;
        inset: 4px 0;
        border: 0;
        border-radius: 10px;
        background: transparent;
        content: "";
        pointer-events: none;
        transition:
            background 0.16s ease;
    }

    .hero-ranked__player:hover::before {
        background: rgba(220, 177, 88, 0.07);
    }

    .hero-ranked__player[data-rank="1"]::before {
        background: linear-gradient(90deg, rgba(220, 177, 88, 0.12), rgba(220, 177, 88, 0.025) 68%, transparent);
    }

    .hero-ranked__rank {
        position: relative;
        z-index: 1;
        color: rgba(239, 228, 204, 0.62);
        font-size: 1rem;
        letter-spacing: 0.04em;
        text-align: center;
    }

    .hero-ranked__player[data-rank="1"] .hero-ranked__rank {
        color: #ffd875;
        font-size: 1.28rem;
        text-shadow: 0 0 12px rgba(220, 177, 88, 0.52);
    }

    .hero-ranked__player[data-rank="2"] .hero-ranked__rank {
        color: #ddd7c8;
    }

    .hero-ranked__player[data-rank="3"] .hero-ranked__rank {
        color: #c48652;
    }

    .hero-ranked__avatar {
        position: relative;
        z-index: 1;
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border: 1px solid rgba(220, 177, 88, 0.25);
        border-radius: 50%;
        background:
            radial-gradient(circle at 34% 28%, rgba(255, 201, 118, 0.17), transparent 32%),
            linear-gradient(145deg, #2a2119, #080706);
        color: #d8c29c;
        font-size: 0.7rem;
        letter-spacing: 0.06em;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.38);
    }

    .hero-ranked__league-emblem {
        position: absolute;
        right: -7px;
        bottom: -7px;
        width: 22px;
        height: 22px;
        object-fit: contain;
        filter: drop-shadow(0 3px 4px rgba(0, 0, 0, 0.8));
        pointer-events: none;
    }

    .hero-ranked__player[data-rank="1"] .hero-ranked__avatar {
        border-color: #dcb158;
        box-shadow:
            0 0 13px rgba(220, 177, 88, 0.3),
            inset 0 0 0 2px rgba(0, 0, 0, 0.42);
    }

    .hero-ranked__identity {
        position: relative;
        z-index: 1;
        display: grid;
        min-width: 0;
    }

    .hero-ranked__identity strong {
        overflow: hidden;
        color: #f5ead7;
        font-size: 0.9rem;
        font-weight: 400;
        letter-spacing: 0.055em;
        line-height: 1.15;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .hero-ranked__identity small {
        overflow: hidden;
        color: rgba(239, 228, 204, 0.52);
        font-size: 0.64rem;
        letter-spacing: 0.04em;
        line-height: 1.28;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .hero-ranked__rating {
        position: relative;
        z-index: 1;
        display: grid;
        justify-items: end;
        min-width: 62px;
    }

    .hero-ranked__rating strong {
        color: #dcb158;
        font-size: 0.98rem;
        font-weight: 400;
        letter-spacing: 0.06em;
        line-height: 1.1;
    }

    .hero-ranked__rating small {
        color: rgba(239, 228, 204, 0.44);
        font-size: 0.58rem;
        letter-spacing: 0.11em;
        line-height: 1.3;
        text-transform: uppercase;
    }

    .hero-ranked__dossier {
        position: absolute;
        z-index: 5;
        inset: 3px 0 3px 28%;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 6px;
        align-items: center;
        padding: 7px 10px;
        border: 1px solid rgba(220, 177, 88, 0.22);
        border-radius: 10px;
        background:
            linear-gradient(90deg, rgba(35, 23, 13, 0.98), rgba(9, 8, 7, 0.98)), rgba(14, 9, 5, 0.98);
        box-shadow:
            0 12px 26px rgba(0, 0, 0, 0.52),
            inset 0 1px rgba(255, 255, 255, 0.035);
        opacity: 0;
        transform: translateY(3px);
        transition:
            opacity 0.16s ease,
            transform 0.16s ease;
        pointer-events: none;
    }

    .hero-ranked__player:hover .hero-ranked__dossier,
    .hero-ranked__player:focus-visible .hero-ranked__dossier {
        opacity: 1;
        transform: none;
    }

    .hero-ranked__dossier-stat {
        display: grid;
        min-width: 0;
        text-align: center;
    }

    .hero-ranked__dossier-stat + .hero-ranked__dossier-stat {
        border-left: 1px solid rgba(112, 75, 42, 0.5);
    }

    .hero-ranked__dossier-stat small,
    .hero-ranked__dossier-stat strong {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .hero-ranked__dossier-stat small {
        color: rgba(239, 228, 204, 0.5);
        font-size: 0.53rem;
        letter-spacing: 0.08em;
        line-height: 1.2;
        text-transform: uppercase;
    }

    .hero-ranked__dossier-stat strong {
        color: #efe4cc;
        font-size: 0.83rem;
        font-weight: 400;
        letter-spacing: 0.045em;
        line-height: 1.25;
    }

    .hero-ranked__dossier-stat .currency-amount {
        justify-content: center;
        gap: 0.25em;
    }

    .hero-ranked__dossier-stat .currency-icon {
        width: 1.1em;
        height: 1.1em;
    }

    .hero-ranked__footer {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 7px 14px;
        align-items: center;
        padding: 16px 0 0;
        border-top: 1px solid rgba(239, 228, 204, 0.1);
    }

    .hero-ranked__slider-controls {
        display: inline-flex;
        grid-row: 1 / span 2;
        gap: 7px;
        align-items: center;
    }

    .hero-ranked__slider-controls[hidden] {
        display: none;
    }

    .hero-ranked__slider-controls button,
    .hero-ranked__page-dot {
        display: grid;
        place-items: center;
        border: 1px solid rgba(220, 177, 88, 0.18);
        border-radius: 50%;
        background: rgba(220, 177, 88, 0.06);
        color: #d8c29c;
        font: inherit;
        cursor: pointer;
        transition:
            border-color 0.16s ease,
            color 0.16s ease,
            filter 0.16s ease,
            transform 0.08s ease;
    }

    .hero-ranked__slider-controls > button {
        width: 36px;
        height: 36px;
    }

    .hero-ranked__slider-controls button:hover,
    .hero-ranked__page-dot:hover,
    .hero-ranked__page-dot[aria-current="true"] {
        border-color: #dcb158;
        color: #ffbf56;
        filter: brightness(1.16);
    }

    .hero-ranked__slider-controls button:active {
        transform: translateY(1px);
    }

    .hero-ranked__slider-controls svg,
    .hero-ranked__ladder-link svg {
        width: 17px;
        height: 17px;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.8;
    }

    .hero-ranked__pages {
        display: flex;
        gap: 5px;
        align-items: center;
    }

    .hero-ranked__page-dot {
        width: 9px;
        height: 9px;
        padding: 0;
        border-radius: 50%;
    }

    .hero-ranked__page-dot[aria-current="true"] {
        background: #dcb158;
        box-shadow: 0 0 8px rgba(220, 177, 88, 0.5);
    }

    .hero-ranked__range {
        align-self: end;
        color: rgba(239, 228, 204, 0.48);
        font-size: 0.62rem;
        letter-spacing: 0.08em;
        line-height: 1.1;
        text-transform: uppercase;
    }

    .hero-ranked__ladder-link {
        display: inline-flex;
        gap: 7px;
        align-items: center;
        justify-self: start;
        color: #dcb158;
        font-size: 0.74rem;
        letter-spacing: 0.075em;
        line-height: 1.2;
        text-transform: uppercase;
        transition:
            color 0.16s ease,
            text-shadow 0.16s ease;
    }

    .hero-ranked__ladder-link:hover {
        color: #ffbf56;
        text-shadow: 0 0 10px rgba(255, 143, 0, 0.36);
    }

    .hero-ranked__loading {
        display: grid;
        gap: 8px;
        align-content: center;
        min-height: 270px;
        padding-inline: 6px;
    }

    .hero-ranked__loading > span:not(.hero-ranked__loading-title) {
        position: relative;
        overflow: hidden;
        height: 48px;
        border: 0;
        border-radius: 10px;
        background: rgba(239, 228, 204, 0.045);
    }

    .hero-ranked__loading > span:not(.hero-ranked__loading-title)::after {
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, transparent, rgba(220, 177, 88, 0.08), transparent);
        content: "";
        transform: translateX(-100%);
        animation: hero-ranked-shimmer 1.8s ease-in-out infinite;
    }

    .hero-ranked__loading-title {
        margin-bottom: 2px;
        color: rgba(239, 228, 204, 0.56);
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        text-align: center;
        text-transform: uppercase;
    }

    .hero-ranked__empty {
        display: grid;
        place-items: center;
        align-content: center;
        gap: 13px;
        min-height: 270px;
        padding: 24px;
        color: rgba(239, 228, 204, 0.62);
        font-size: 0.82rem;
        letter-spacing: 0.04em;
        text-align: center;
    }

    .hero-ranked__empty button {
        min-height: 38px;
        padding: 8px 14px;
        border: 1px solid rgba(220, 177, 88, 0.28);
        border-radius: 9px;
        background: rgba(220, 177, 88, 0.1);
        color: #efe4cc;
        font: inherit;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
    }

    .hero-ranked__noscript {
        margin: 12px 0 0;
        color: rgba(239, 228, 204, 0.65);
        font-size: 0.78rem;
        text-align: center;
    }

    @keyframes hero-ranked-shimmer {
        to {
            transform: translateX(100%);
        }
    }

    @keyframes hero-ranked-live {
        50% {
            box-shadow: 0 0 14px rgba(255, 90, 63, 1);
            transform: scale(1.08);
        }
    }

    @media (max-width: 1080px) {
        .hero-ranked {
            width: min(720px, 100%);
            justify-self: start;
        }

        .hero-ranked__frame {
            min-height: 470px;
        }
    }

    @media (max-width: 720px) {
        .hero-ranked {
            width: 100%;
        }

        .hero-ranked__frame {
            grid-template-rows: auto minmax(262px, 1fr) auto;
            min-height: 0;
            padding: 22px 20px 18px;
            border-radius: 14px;
        }

        .hero-ranked__header {
            padding-bottom: 14px;
        }

        .hero-ranked__header > div > p:last-child {
            display: none;
        }

        .hero-ranked__viewport {
            padding-block: 7px;
        }

        .hero-ranked__footer {
            grid-template-columns: auto 1fr;
            gap: 6px 10px;
            padding-top: 11px;
        }
    }

    @media (max-width: 460px) {
        .hero-ranked__frame {
            padding-inline: 12px;
            border-radius: 12px;
        }

        .hero-ranked__header h2 {
            font-size: 1.22rem;
        }

        .hero-ranked__top-mark {
            min-height: 28px;
            padding-inline: 7px;
            font-size: 0.64rem;
        }

        .hero-ranked__player {
            grid-template-columns: 30px 36px minmax(0, 1fr) auto;
            gap: 7px;
            min-height: 62px;
            padding-inline: 4px;
        }

        .hero-ranked__avatar {
            width: 34px;
            height: 34px;
            font-size: 0.62rem;
        }

        .hero-ranked__identity strong {
            font-size: 0.82rem;
        }

        .hero-ranked__identity small {
            font-size: 0.58rem;
        }

        .hero-ranked__rating {
            min-width: 54px;
        }

        .hero-ranked__rating strong {
            font-size: 0.88rem;
        }

        .hero-ranked__range {
            display: none;
        }

        .hero-ranked__ladder-link {
            align-self: center;
            font-size: 0.66rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-ranked,
        .hero-ranked__eyebrow span,
        .hero-ranked__loading > span::after {
            animation: none;
        }

        .hero-ranked__track {
            transition: none;
        }
    }

    @media (hover: none) {
        .hero-ranked__dossier {
            display: none;
        }
    }
</style>

<script>
    import "../lib/ranked-arena-client";
</script>
