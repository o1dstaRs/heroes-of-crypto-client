---
import { leavingRulesPath } from "../lib/ranked-exit";
import { reputationRulesPath } from "../lib/reputation-rules";
import { content, localPath, type Language } from "../lib/site-data";

interface Props {
    lang: Language;
}

const { lang } = Astro.props;
// Fixed rules: every number is plain text, so the page needs no live response at all.
const rules = content[lang].prizeRules;
---

<section class="subhero">
    <div class="page-shell">
        <p class="eyebrow">{rules.eyebrow}</p>
        <h1>{rules.title}</h1>
        <p>{rules.description}</p>
    </div>
</section>

<section class="section legal-section prize-rules" data-prize-rules data-lang={lang}>
    <article class="page-shell legal-doc">
        <p class="lead">{rules.intro}</p>
        {
            rules.sections.map((section) => (
                <section>
                    <h2>{section.title}</h2>
                    {section.body.map((paragraph) => (
                        <p>{paragraph}</p>
                    ))}
                    {section.items.length > 0 && (
                        <ul>
                            {section.items.map((item) => (
                                <li>{item}</li>
                            ))}
                        </ul>
                    )}
                </section>
            ))
        }
        <footer class="prize-rules-footer">
            <p>
                <strong>{rules.relatedTitle}:</strong>
                <a href={reputationRulesPath(lang)}>{rules.relatedReputation}</a> ·
                <a href={leavingRulesPath(lang)}>{rules.relatedLeaving}</a> ·
                <a href={localPath(lang, "terms-of-service")}>{rules.relatedTerms}</a>
            </p>
        </footer>
    </article>
</section>

<style>
    .prize-rules ul {
        display: grid;
        gap: 10px;
        margin: 14px 0 0;
        padding-left: 1.25em;
        color: rgba(251, 244, 232, 0.86);
    }

    .prize-rules-footer {
        display: grid;
        gap: 8px;
        padding-top: 28px;
        border-top: 1px solid var(--line);
    }

    .prize-rules-footer p {
        margin: 0;
    }
</style>
