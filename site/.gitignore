# dependencies
node_modules/

# build output
dist/

# astro cache
.astro/

# env / secrets
.env
.env.*
!.env.example
# Non-secret build flag: forces the prod game-client URLs (game/beta.heroesofcrypto.io) instead of
# the localhost dev fallbacks in the play/sandbox launcher pages. Committed so `bun run build`
# (CI + manual deploys) always produces a production-correct static site.
!.env.production
# Same deal for the staging build (`bun run build:site:test`, astro --mode test): non-secret origins
# for test.heroesofcrypto.io plus the TEST Google OAuth client. Committed so a staging site deploy
# cannot silently fall back to .env.production and ship a site that calls production cross-origin.
!.env.test

# OS / editor
.DS_Store
*.log
npm-debug.log*
