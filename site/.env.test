# Site build for the TEST box (Ashburn, test.heroesofcrypto.io). Load with `astro build --mode test`
# (see `bun run build:site:test`), which is what makes Astro read THIS file instead of .env.production.
#
# Why this file has to exist: without it the only build mode is production, whose defaults point every
# API at mm./game./auth.heroesofcrypto.io. Deployed to the test box that produces a site which calls
# PRODUCTION cross-origin — and prod's CORS does not allow the test.heroesofcrypto.io origin, so the
# browser blocks every response. That is what made /profile/ show "detailed profile data is
# unavailable" while curl against the same endpoint returned 200.

# Test serves the site AND every API from ONE hostname, with /v1/ proxied to the :3010 monolith.
VITE_HOST_AUTH_API=https://test.heroesofcrypto.io
VITE_HOST_MATCHMAKING_API=https://test.heroesofcrypto.io
VITE_HOST_GAME_API=https://test.heroesofcrypto.io
# Same hostname again: the client is path-routed on the test vhost, not a separate app. subdomain.
VITE_HOST_GAME_CLIENT=https://test.heroesofcrypto.io

# Test uses PRODUCTION route naming (/v1/ranked-profile, not /v1/mm/ranked-profile), so this stays true
# even though the box is not production. Setting it false silently switches every client to the dev
# route shape, which the test server answers with 401.
VITE_IS_PROD=true

# Test has its OWN Google OAuth client (the old one, repurposed); prod is 541514408236-789upk3b… .
# A build carrying the prod id fails login on test with an audience mismatch.
VITE_GOOGLE_CLIENT_ID=541514408236-9sm72qdg2k5uv22d9811stcvqhqcqjl1
